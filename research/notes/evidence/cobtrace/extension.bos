// COBEXT's script: the COB extensions in one unit (research/notes/ingame-wiki-cob-plan.md, L2).
// tools/cob_ext_fixture.py compiles it into a generated unit, COBEXT, which is ARMSOLAR's model and
// FBI under a new name, in an archive written into a test instance's game folder only.
//
// Create and seven sleepers hold records 0..7, so prober runs in record 8 and every getter it
// calls runs in record 9: the two records Impure's raised build adds over the engine's eight.
// Each getter keeps its value in a static (r0..r9, in call order, then done = 1), which the replay
// group's check reads out of the unit's COB object (cob_ext_fixture.py check), and returns it, so
// it is on the script's R line too, which tacob's fixture compares (replay.json, "facts").

piece base, dish1, dish2, dish3, dish4;

static-var me, done, r0, r1, r2, r3, r4, r5, r6, r7, r8, r9;

sleeper()
{
	while( 1 )
	{
		sleep 1000;
	}
}

min_id()
{
	r0 = get 69;
	return (r0);
}

max_id()
{
	r1 = get 70;
	return (r1);
}

my_id()
{
	r2 = get 71;
	return (r2);
}

my_owner()
{
	r3 = get 72(me, 0, 0, 0);
	return (r3);
}

my_build_left()
{
	r4 = get 73(me, 0, 0, 0);
	return (r4);
}

nobodys_build_left()
{
	r5 = get 73(0, 0, 0, 0);
	return (r5);
}

allied_with_me()
{
	r6 = get 74(me, 0, 0, 0);
	return (r6);
}

allied_past_the_array()
{
	r7 = get 74(65537, 0, 0, 0);
	return (r7);
}

mine_is_local()
{
	r8 = get 75(me, 0, 0, 0);
	return (r8);
}

my_kills()
{
	r9 = get 32;
	return (r9);
}

prober()
{
	me = get 71;
	call-script min_id();
	call-script max_id();
	call-script my_id();
	call-script my_owner();
	call-script my_build_left();
	call-script nobodys_build_left();
	call-script allied_with_me();
	call-script allied_past_the_array();
	call-script mine_is_local();
	call-script my_kills();
	done = 1;
	while( 1 )
	{
		sleep 1000;
	}
}

Create()
{
	start-script sleeper();
	start-script sleeper();
	start-script sleeper();
	start-script sleeper();
	start-script sleeper();
	start-script sleeper();
	start-script sleeper();
	start-script prober();
	while( 1 )
	{
		sleep 1000;
	}
}
