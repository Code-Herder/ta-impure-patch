# Wine prefix and game data (large, not source)
/wineprefix/
/tagpu/gamedir/
# tacli runtime: symlink mirrors + cloned wine prefixes
/tagpu/instances/

# Third-party upstream clones (each is its own git repo)
/vendor/

# Ghidra distribution (tools/ghidra-projects IS tracked)
/tools/ghidra/

# Generated wiki output (rebuild with research/build_wiki.py)
/research/site/

# ta3do output: models and pictures derived from the game's own assets
/renders/

# tacob projects: decompiled stock BOS and built COBs (game content, never tracked)
/projects/

# tacob landing 5: the pinned JavaScript the exe build fetches (tools/tacob-vendor.json
# is the manifest and IS tracked), and PyInstaller's output
/tools/vendor/
/dist/
/build/

# throwaway prototypes and scratch work -- never published
/tmp/

# Build artifacts
*.o
*.obj
*.d
/tagpu/tagpu.dll
/tagpu/ddraw/ddraw.dll

# Local Claude session state
.claude/scheduled_tasks.lock
.claude/settings.local.json

__pycache__/
.pytest_cache/

# Disabled nested repo metadata (rename back to .git to restore)
/tagpu/.git.empty-disabled/
/tagpu/ddraw/.git.upstream/

# Game binaries stay out of git
*.pristine
/pristine/*.exe

# Ghidra project DB (embeds game binary, churns every session; symbol exports are tracked instead)
/tools/ghidra-projects/

# Claude worktree checkouts (live git worktrees)
/.claude/worktrees/

# ta-drive per-instance sandboxes (contain game copies, logs, captures)
/tagpu/instances/

# Safety net: no game binaries or TA asset formats from anywhere
*.exe
*.dll
*.hpi
*.ufo
*.ccx
*.gp3
*.gaf
*.cob
*.3do
*.tnt
*.smk
*.pcx

# Local python venv for the undither tooling (opencv is not a repo dependency)
.venv*/

# CC0 texture corpus + training runs for the learned undither restorer (unditherer/fetch_data.py)
.data/

# Learned-restorer bakes for the undither wiki page (21 MB of lossless WebP, regenerated
# by research/build_wiki.py from unditherer/models/full.* whenever missing or stale)
/research/notes/assets/undither/learned/
renders/

# ---------------------------------------------------------------------------
# Publishing (CLAUDE.md "Publishing"): the private side folder, the root symlink
# to the local half of CLAUDE.md, and the per-machine hooks. All three exist
# only in the main checkout and never in the history.
# ---------------------------------------------------------------------------
/_local/
/CLAUDE.local.md
/.githooks/

# Claude Code config: the commands and skills ARE part of this repo, but each
# is re-included by name. Anything else that lands under .claude/ (a personal
# command, a scratch note, the worktrees) stays out by default instead of
# arriving with the next `git add`. Adding a skill costs one line here;
# forgetting it means the skill is missing (which you notice), not something
# private published (which you might not). Git cannot re-include a file whose
# parent directory is excluded, so each level is opened by name.
/.claude/*
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/git_branch_status.md
!/.claude/commands/git_commit_merge_wt.md
!/.claude/commands/git_publish.md
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/ta-capture/
!/.claude/skills/ta-drive/
