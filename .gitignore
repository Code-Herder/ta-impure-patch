# Wine prefix and game data (large, not source)
/wineprefix/
/tagpu/gamedir/
# tacli runtime: symlink mirrors + cloned wine prefixes
/tagpu/instances/

# Third-party upstream clones (each is its own git repo)
/vendor/

# Ghidra distribution (tools/ghidra-projects IS tracked)
/tools/ghidra/

# Generated wiki output (rebuild with research/build_wiki.py)
/research/site/

# ta3do output: models and pictures derived from the game's own assets
/renders/

# Build artifacts
*.o
*.obj
/tagpu/tagpu.dll
/tagpu/ddraw/ddraw.dll

# Local Claude session state
.claude/scheduled_tasks.lock
.claude/settings.local.json

__pycache__/
.pytest_cache/

# Disabled nested repo metadata (rename back to .git to restore)
/tagpu/.git.empty-disabled/
/tagpu/ddraw/.git.upstream/

# Game binaries stay out of git
*.pristine
/pristine/*.exe

# Ghidra project DB (embeds game binary, churns every session; symbol exports are tracked instead)
/tools/ghidra-projects/

# Claude worktree checkouts (live git worktrees)
/.claude/worktrees/

# ta-drive per-instance sandboxes (contain game copies, logs, captures)
/tagpu/instances/

# Safety net: no game binaries or TA asset formats from anywhere
*.exe
*.dll
*.hpi
*.ufo
*.ccx
*.gp3
*.gaf
*.cob
*.3do
*.tnt
*.smk
*.pcx

# Local python venv for the undither tooling (opencv is not a repo dependency)
.venv*/

# CC0 texture corpus + training runs for the learned undither restorer (unditherer/fetch_data.py)
.data/

# Learned-restorer bakes for the undither wiki page (21 MB of lossless WebP, regenerated
# by research/build_wiki.py from unditherer/models/full.* whenever missing or stale)
/research/notes/assets/undither/learned/
