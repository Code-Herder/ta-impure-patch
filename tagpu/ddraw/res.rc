#include "inc/version.h"
#include "inc/git.h"

/* The replay HUD: art/hud/ packed by tools/hudpak.py (Makefile, THE HUD ARCHIVE). */
HUDPAK RCDATA "inc/tagpu_hudpak.bin"

/* The Classic++ restorer's models: unditherer/models/<name>.w32.bin, zstd-compressed by the
   Makefile (THE RESTORER'S MODELS) and read by tagpu_restore_core.c load_weights. */
RMODEL_FULL RCDATA "inc/tagpu_rmodel_full.zst"
RMODEL_TINY RCDATA "inc/tagpu_rmodel_tiny.zst"


1 VERSIONINFO
FILEVERSION VERSION
PRODUCTVERSION VERSION
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "CompanyName", "github.com/FunkyFr3sh"
            VALUE "FileDescription", "DirectDraw replacement"
            VALUE "FileVersion", VERSION_STRING " (git~" GIT_COMMIT ", " GIT_BRANCH ")"
            VALUE "InternalName", "ddraw"
            VALUE "LegalCopyright", "Copyright (c) 2010-2024"
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFileName", "ddraw.dll"
            VALUE "ProductName", "cnc-ddraw"
            VALUE "ProductVersion", VERSION_STRING " (git~" GIT_COMMIT ", " GIT_BRANCH ")"
            VALUE "Comments", "https://github.com/FunkyFr3sh/cnc-ddraw"
        }
    }

    BLOCK "VarFileInfo"
    {
        VALUE "Translation",  0x0409, 0x04B0
    }
}
