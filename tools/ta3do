CHROME_NAMES = ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser"]
VIEWER_HTML = Path(__file__).with_name("ta3do-view.html")
COMPARE_HTML = Path(__file__).with_name("ta3do-compare.html")


def find_chrome() -> str:
    import shutil
    env = os.environ.get("TA3DO_CHROME")
    if env:
        return env
    for name in CHROME_NAMES:
        found = shutil.which(name)
        if found:
            return found
    die("no Chrome/Chromium found (set TA3DO_CHROME)")


class Display:
    """A private X display for headless Chrome.

    Chrome's headless mode still refuses WebGL here unless an X display exists,
    and the user's own desktop is not ours to borrow — so we run our own Xvfb and
    take it down again. If Xvfb is missing we fall back to $DISPLAY.
    """

    def __init__(self, want_xvfb: bool = True):
        import shutil
        self.proc = None
        self.name = os.environ.get("DISPLAY", "")
        if not want_xvfb or not shutil.which("Xvfb"):
            return
        import subprocess
        for number in range(90, 130):
            if Path(f"/tmp/.X11-unix/X{number}").exists():
                continue
            proc = subprocess.Popen(
                ["Xvfb", f":{number}", "-screen", "0", "1280x1280x24", "-nolisten", "tcp"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(100):
                if Path(f"/tmp/.X11-unix/X{number}").exists():
                    self.proc, self.name = proc, f":{number}"
                    return
                if proc.poll() is not None:
                    break
                time.sleep(0.05)
            proc.kill()
        die("could not start Xvfb")

    def close(self):
        if self.proc:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=5)
            except Exception:
                self.proc.kill()


class Viewer:
    """Serves an export directory over loopback so the page can fetch the .glb."""

    def __init__(self, directory: Path, port: int = 0):
        from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
        import threading

        class Quiet(SimpleHTTPRequestHandler):
            def log_message(self, *_args):
                pass

        handler = lambda *a, **k: Quiet(*a, directory=str(directory), **k)  # noqa: E731
        try:
            self.server = ThreadingHTTPServer(("127.0.0.1", port), handler)
        except OSError as err:
            die(f"cannot serve on port {port}: {err}")
        self.port = self.server.server_address[1]
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()

    @property
    def base(self) -> str:
        return f"http://127.0.0.1:{self.port}"

    def close(self):
        self.server.shutdown()
        self.server.server_close()


def shoot(chrome: str, display: str, url: str, png: Path, size, timeout: float,
          budget_ms: int) -> str:
    import subprocess
    import tempfile
    env = dict(os.environ)
    if display:
        env["DISPLAY"] = display
    with tempfile.TemporaryDirectory(prefix="ta3do-chrome-") as profile:
        cmd = [chrome, "--headless=new", "--no-sandbox", "--disable-dev-shm-usage",
               f"--user-data-dir={profile}",
               # SwiftShader through ANGLE: the only WebGL that works headless here
               "--use-gl=angle", "--use-angle=swiftshader", "--enable-unsafe-swiftshader",
               "--hide-scrollbars", "--force-color-profile=srgb",
               "--default-background-color=00000000",
               f"--window-size={size[0]},{size[1]}",
               f"--virtual-time-budget={budget_ms}",
               f"--screenshot={png}", url]
        proc = subprocess.run(cmd, env=env, timeout=timeout,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if not png.exists():
        tail = proc.stderr.decode("latin-1", "replace").strip().splitlines()[-3:]
        return "chrome wrote no screenshot: " + " / ".join(tail)
    return ""


