def add_undither_flags(parser):
    parser.add_argument("--undither", nargs="?", const="learned", metavar="PRESET",
                        choices=UNDITHER_PRESETS,
                        help="restore the textures to true colour first "
                             f"({' | '.join(UNDITHER_PRESETS)}; default learned)")
    parser.add_argument("--undither-python", dest="undither_python",
                        help="interpreter that can import unditherer "
                             "(default: the checkout's .venv-undither)")


def main(argv=None):
    p = argparse.ArgumentParser(prog="ta3do", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--gamedir", help="Total Annihilation directory (default: the "
                                     "checkout's tagpu/gamedir)")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="cmd", required=True)

    ls = sub.add_parser("ls", help="list the models in the mounted archives")
    ls.add_argument("pattern", nargs="?", help="substring to filter on")
    ls.set_defaults(func=cmd_ls)

    info = sub.add_parser("info", help="piece tree, textures and bounds of one model")
    info.add_argument("name", help="unit name (armpw), model name or a .3do file")
    info.add_argument("--keep-selection", action="store_true",
                      help="keep the root's invisible selection quad")
    info.add_argument("--show-hidden", action="store_true",
                      help="keep pieces the unit's script hides at Create (flares)")
    info.set_defaults(func=cmd_info)

    views = sub.add_parser("views", help="the standard camera table")
    views.set_defaults(func=cmd_views)

    ex = sub.add_parser("export", help="write glTF 2.0 (.glb) + texture atlas")
    ex.add_argument("name")
    ex.add_argument("-o", "--out", default="renders", help="output directory")
    ex.add_argument("--keep-selection", action="store_true")
    ex.add_argument("--show-hidden", action="store_true",
                    help="keep pieces the unit's script hides at Create (flares)")
    add_undither_flags(ex)
    ex.set_defaults(func=cmd_export)

    rd = sub.add_parser("render", help="export, then screenshot the standard views")
    rd.add_argument("name")
    rd.add_argument("-o", "--out", default="renders", help="output directory")
    rd.add_argument("--views", nargs="+", metavar="VIEW",
                    help=f"default: {' '.join(DEFAULT_VIEWS)}")
    rd.add_argument("--size", type=int, default=768, help="pixels per side (default 768)")
    rd.add_argument("--fov", type=float, default=22.0, help="perspective FOV in degrees")
    rd.add_argument("--ortho", action="store_true", help="orthographic instead")
    rd.add_argument("--margin", type=float, default=0.08,
                    help="empty fraction of the frame around the model")
    rd.add_argument("--supersample", type=int, default=2,
                    help="render scale before downsampling (default 2)")
    rd.add_argument("--background", help="CSS colour; default is transparent")
    rd.add_argument("--sheet", action="store_true",
                    help="also write one contact sheet of every view")
    rd.add_argument("--keep-selection", action="store_true")
    rd.add_argument("--show-hidden", action="store_true",
                    help="keep pieces the unit's script hides at Create (flares)")
    rd.add_argument("--no-xvfb", action="store_true",
                    help="use $DISPLAY instead of a private Xvfb")
    rd.add_argument("--timeout", type=float, default=120.0, help="seconds per view")
    rd.add_argument("--budget", type=int, default=12000,
                    help="Chrome virtual-time budget in ms")
    add_undither_flags(rd)
    rd.set_defaults(func=cmd_render)

    cp = sub.add_parser("compare",
                        help="export the unit twice, shipped vs undithered, and "
                             "serve a side-by-side page")
    cp.add_argument("name")
    cp.add_argument("-o", "--out", default="renders/compare", help="output directory")
    cp.add_argument("--shots", action="store_true",
                    help="also screenshot the comparison for each view")
    cp.add_argument("--views", nargs="+", metavar="VIEW",
                    help=f"views to screenshot (default: {' '.join(DEFAULT_VIEWS)})")
    cp.add_argument("--size", type=int, default=640,
                    help="pixels per pane (the image is twice this wide)")
    cp.add_argument("--background", help="CSS colour; default is transparent")
    cp.add_argument("--port", type=int, default=0,
                    help="serve on this port instead of a free one")
    cp.add_argument("--no-serve", dest="serve", action="store_false",
                    help="write the files and exit instead of serving")
    cp.add_argument("--keep-selection", action="store_true")
    cp.add_argument("--show-hidden", action="store_true")
    cp.add_argument("--no-xvfb", action="store_true")
    cp.add_argument("--timeout", type=float, default=120.0)
    cp.add_argument("--budget", type=int, default=12000)
    add_undither_flags(cp)
    cp.set_defaults(func=cmd_compare)

    sv = sub.add_parser("serve", help="serve an export directory for interactive viewing")
    sv.add_argument("dir", nargs="?", default="renders")
    sv.add_argument("--port", type=int, default=0,
                    help="serve on this port instead of a free one")
    sv.set_defaults(func=cmd_serve)

    cw = sub.add_parser("check-winding", help="measure which triangle order faces outward")
    cw.add_argument("names", nargs="*", default=["armpw", "armcom", "armstump", "armsolar"])
    cw.set_defaults(func=cmd_check_winding)

    args = p.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
