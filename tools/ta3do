def cmd_ls(args):
    assets = Assets(args.gamedir)
    pattern = (args.pattern or "*").lower()
    rows = []
    for name in sorted(assets.index):
        if not name.startswith("objects3d/") or not name.endswith(".3do"):
            continue
        stem = Path(name).stem
        if pattern != "*" and pattern.strip("*") not in stem:
            continue
        rows.append({"model": stem, "path": name,
                     "archive": assets.index[name].path.name})
    human = "\n".join(f"{r['model']:<20} {r['archive']}" for r in rows)
    out({"count": len(rows), "models": rows}, args.json,
        human + f"\n{len(rows)} models")


def cmd_info(args):
    assets = Assets(args.gamedir)
    label, blob = resolve_model(assets, args.name)
    root = parse_3do(blob)
    bank = TextureBank(assets)
    hidden = frozenset() if args.show_hidden else script_hidden(assets, label)
    model = build_model(label, root, bank, load_palette(assets), args.keep_selection,
                        hidden=hidden)
    lo, hi = model.bounds()
    tree = []
    lines = []
    for piece, depth in root.walk():
        tree.append({"name": piece.name, "depth": depth,
                     "offset": [round(v, 3) for v in piece.offset],
                     "vertices": len(piece.vertices),
                     "primitives": len(piece.primitives)})
        lines.append(f"{'  ' * depth}{piece.name:<14} "
                     f"verts={len(piece.vertices):<4} prims={len(piece.primitives)}")
    textures = sorted({prim.texture for piece, _ in root.walk()
                       for prim in piece.primitives if prim.texture})
    data = {"model": label, "bytes": len(blob), "stats": model.stats,
            "hidden_pieces": model.hidden,
            "atlas": model.atlas.size, "textures": textures,
            "bounds": {"min": [round(v, 3) for v in lo],
                       "max": [round(v, 3) for v in hi],
                       "size": [round(hi[i] - lo[i], 3) for i in range(3)]},
            "pieces": tree}
    human = "\n".join([
        f"{label}: {model.stats['pieces']} pieces, {model.stats['triangles']} triangles, "
        f"{len(textures)} textures, atlas {model.atlas.size}px",
        f"size (x,y,z) = {', '.join(f'{hi[i] - lo[i]:.1f}' for i in range(3))} model units",
        ("hidden by its own script at Create: " + ", ".join(model.hidden)
         if model.hidden else "nothing hidden at Create"),
        "", *lines])
    out(data, args.json, human)


def cmd_views(args):
    rows = [{"view": name, "azimuth": az, "elevation": el,
             "default": name in DEFAULT_VIEWS} for name, (az, el) in VIEWS.items()]
    human = "\n".join(f"{r['view']:<9} az={r['azimuth']:>6.1f}  el={r['elevation']:>5.1f}"
                      f"{'   (default set)' if r['default'] else ''}" for r in rows)
    out({"views": rows, "default": DEFAULT_VIEWS}, args.json, human)


def cmd_export(args):
    assets = Assets(args.gamedir)
    model = load_model(assets, args.name, args.keep_selection, args.show_hidden,
                       undither=args.undither, python=args.undither_python)
