def cmd_render(args):
    assets = Assets(args.gamedir)
    model = load_model(assets, args.name, args.keep_selection, args.show_hidden,
                       undither=args.undither, python=args.undither_python)
    out_dir = Path(args.out)
    written = export_model(model, out_dir)
    viewer_copy = out_dir / VIEWER_HTML.name
    viewer_copy.write_bytes(VIEWER_HTML.read_bytes())

    views = args.views or DEFAULT_VIEWS
    unknown = [v for v in views if v not in VIEWS]
    if unknown:
        die(f"unknown view(s): {', '.join(unknown)} (try `ta3do views`)")

    chrome = find_chrome()
    display = Display(want_xvfb=not args.no_xvfb)
    server = Viewer(out_dir)
    results = []
    try:
        for view in views:
            az, el = VIEWS[view]
            png = out_dir / f"{model.name}-{view}.png"
            if png.exists():
                png.unlink()
            query = (f"?model={model.name}.glb&view={view}&az={az}&el={el}"
                     f"&w={args.size}&h={args.size}&fov={args.fov}"
                     f"&margin={args.margin}&ss={args.supersample}&shot=1"
                     + ("&ortho=1" if args.ortho else "")
                     + (f"&bg={args.background}" if args.background else ""))
            url = f"{server.base}/{VIEWER_HTML.name}{query}"
            error = shoot(chrome, display.name, url, png,
                          (args.size, args.size), args.timeout, args.budget)
            row = {"view": view, "azimuth": az, "elevation": el, "file": str(png),
                   "url": url}
            if error:
                row["error"] = error
            else:
                row["bytes"] = png.stat().st_size
                row["coverage"] = round(png_coverage(png), 4)
                if row["coverage"] < 0.001:
                    row["error"] = "empty frame — nothing was drawn"
            results.append(row)
    finally:
        server.close()
        display.close()

    good = [r for r in results if "error" not in r]
    sheet = None
    if args.sheet and good:
        sheet = out_dir / f"{model.name}-sheet.png"
        sheet.write_bytes(contact_sheet([r["file"] for r in good]))

    bad = [r for r in results if "error" in r]
    data = {"model": model.name, "stats": model.stats,
            "files": [str(p) for p in written] + [r["file"] for r in good]
                     + ([str(sheet)] if sheet else []),
            "views": results}
    lines = [f"{model.name}: {model.stats['triangles']} triangles, "
             f"atlas {model.atlas.size}px"]
    for row in results:
        if "error" in row:
            lines.append(f"  {row['view']:<8} FAILED: {row['error']}")
        else:
            lines.append(f"  {row['view']:<8} {row['file']}  "
                         f"({row['coverage']:.0%} of the frame)")
    if sheet:
        lines.append(f"  sheet    {sheet}")
    human = "\n".join(lines)
    out(data, args.json, human)
    if bad:
        die(f"{len(bad)} view(s) failed: {', '.join(r['view'] for r in bad)}")


def cmd_compare(args):
    """The same unit twice — shipped textures against undithered ones."""
    assets = Assets(args.gamedir)
    out_dir = Path(args.out)
    plain = load_model(assets, args.name, args.keep_selection, args.show_hidden)
    restored = load_model(assets, args.name, args.keep_selection, args.show_hidden,
                          undither=args.undither or "learned",
                          python=args.undither_python)
    written = export_model(plain, out_dir) + export_model(restored, out_dir)
    for page in (VIEWER_HTML, COMPARE_HTML):
        (out_dir / page.name).write_bytes(page.read_bytes())

    preset = args.undither or "learned"
    query = (f"?a={plain.name}.glb&b={restored.name}.glb"
             f"&aa={plain.name}-atlas.png&ab={restored.name}-atlas.png"
             f"&la=as+shipped+(256+colours)&lb=undithered+({preset})")
    server = Viewer(out_dir, port=args.port)
    shots = []
    try:
        if args.shots:
            views = args.views or DEFAULT_VIEWS
            unknown = [v for v in views if v not in VIEWS]
            if unknown:
                die(f"unknown view(s): {', '.join(unknown)} (try `ta3do views`)")
            chrome = find_chrome()
            display = Display(want_xvfb=not args.no_xvfb)
            try:
                for view in views:
                    png = out_dir / f"{plain.name}-compare-{view}.png"
                    url = (f"{server.base}/{COMPARE_HTML.name}{query}&view={view}"
                           f"&w={args.size * 2}&h={args.size}&shot=1"
                           + (f"&bg={args.background}" if args.background else ""))
                    error = shoot(chrome, display.name, url, png,
                                  (args.size * 2, args.size), args.timeout, args.budget)
                    row = {"view": view, "file": str(png)}
                    if error:
                        row["error"] = error
                    else:
                        row["coverage"] = round(png_coverage(png), 4)
                    shots.append(row)
            finally:
                display.close()

        page = f"{server.base}/{COMPARE_HTML.name}{query}&view=quarter"
        data = {"model": plain.name, "undither": {"preset": preset},
                "files": [str(p) for p in written] + [r["file"] for r in shots
                                                      if "error" not in r],
                "shots": shots, "url": page,
                "atlases": {"shipped": f"{plain.name}-atlas.png",
                            "undithered": f"{restored.name}-atlas.png"}}
        lines = [f"{plain.name}: 256 colours vs undithered ({preset}, per GAF frame)"]
        lines += [f"  {Path(p).name}" for p in data["files"]]
        lines.append("")
        lines.append(f"  open: {page}")
        out(data, args.json, "\n".join(lines))
        if args.serve:
            print("  Ctrl-C to stop serving")
            try:
                while True:
                    time.sleep(3600)
            except KeyboardInterrupt:
                pass
    finally:
        server.close()


def cmd_serve(args):
    directory = Path(args.dir)
    if not directory.is_dir():
        die(f"no such directory: {directory}")
    viewer_copy = directory / VIEWER_HTML.name
    viewer_copy.write_bytes(VIEWER_HTML.read_bytes())
    server = Viewer(directory, port=args.port)
    models = sorted(p.name for p in directory.glob("*.glb"))
    first = models[0] if models else ""
    url = f"{server.base}/{VIEWER_HTML.name}?model={first}&view=quarter"
    print(f"serving {directory} at {server.base}")
    print(f"  {url}")
    print("Ctrl-C to stop")
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        pass
    finally:
        server.close()


def cmd_check_winding(args):
    """Evidence for REVERSE_WINDING: how many faces point away from the hull."""
    assets = Assets(args.gamedir)
    bank = TextureBank(assets)
    palette = load_palette(assets)
    rows = []
    for name in args.names:
        label, blob = resolve_model(assets, name)
        root = parse_3do(blob)
        row = {"model": label}
        for reverse in (True, False):
            model = build_model(label, root, bank, palette, reverse=reverse)
            faces = []

            def walk(mesh, base):
                here = [base[i] + mesh.translation[i] for i in range(3)]
                pos, nrm = mesh.positions, mesh.normals
                for t in range(0, len(pos), 9):
                    centre = [(pos[t + i] + pos[t + 3 + i] + pos[t + 6 + i]) / 3 + here[i]
                              for i in range(3)]
                    faces.append((centre, nrm[t:t + 3]))
                for child in mesh.children:
                    walk(child, here)

            walk(model.root, [0.0, 0.0, 0.0])
            if not faces:
                continue
            hub = [sum(f[0][i] for f in faces) / len(faces) for i in range(3)]
            outward = sum(1 for c, n in faces
                          if sum((c[i] - hub[i]) * n[i] for i in range(3)) > 0)
            row["reversed" if reverse else "as_written"] = {
                "outward": outward, "faces": len(faces),
                "fraction": round(outward / len(faces), 3)}
        rows.append(row)
    human = "\n".join(
        f"{r['model']:<12} reversed {r['reversed']['fraction']:.0%} outward   "
        f"as-written {r['as_written']['fraction']:.0%} outward" for r in rows)
    out({"models": rows, "using": "reversed" if REVERSE_WINDING else "as_written"},
        args.json, human)


