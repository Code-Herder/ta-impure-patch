# --------------------------------------------------------------------------- undither

# The exploration lane's textures. `ta3do.undither_frames` already drives the
# unditherer's CLI (indexed PNG in, restored true-colour PNG out, one process
# for a whole batch because loading the CNN costs far more than running it on a
# 32x32 texture) — this is the cache and the batching around it.
#
# WHY A CACHE: the largest stock map is 5062 tiles at ~19 ms each, i.e. ~1.6
# min, and a pack gets rebuilt every time the eye moves. The key is the frame's
# own CONTENT plus the preset and the palette, not (map, preset): tiles recur
# between maps and between builds, and a content key cannot go stale.

CACHE_ENV = "TASCENE_CACHE"
UNDITHER_BATCH = 256                  # frames per unditherer process
CACHE_MAGIC = b"TSU1"


def cache_root(explicit=None) -> Path:
    if explicit:
        return Path(explicit).expanduser()
    env = os.environ.get(CACHE_ENV)
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")
    return Path(base) / "tascene" / "undither"


def _cache_key(frame, palette, preset) -> str:
    h = hashlib.sha256()
    h.update(preset.encode())
    h.update(struct.pack("<3i", frame.width, frame.height,
                         -1 if frame.transparent is None else frame.transparent))
    h.update(bytes(frame.pixels))
    for entry in palette:
        h.update(bytes(entry[:3]))
    return h.hexdigest()


def _cache_read(path: Path):
    try:
        blob = path.read_bytes()
    except OSError:
        return None
    if len(blob) < 8 or blob[:4] != CACHE_MAGIC:
        return None
    w, h = struct.unpack_from("<2H", blob, 4)
    rgba = blob[8:]
    if len(rgba) != w * h * 4:
        return None                     # a truncated write: treat it as a miss
    return (w, h, rgba)


def _cache_write(path: Path, got):
    w, h, rgba = got
    tmp = path.with_suffix(".part")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_bytes(CACHE_MAGIC + struct.pack("<2H", w, h) + rgba)
        tmp.replace(path)               # atomic: two builds can share one cache
    except OSError:
        pass                            # a cache that cannot be written is not fatal


def undither(frames, palette, preset, cdir: Path, python=None, tally=None):
    """{key: GafFrame} -> {key: (w, h, RGBA bytes)}, cached on disk by content."""
    if not frames:
        return {}
    keys = {k: _cache_key(f, palette, preset) for k, f in frames.items()}
    out, todo = {}, {}
    for k, digest in keys.items():
        got = _cache_read(cdir / preset / digest[:2] / f"{digest}.bin")
        if got:
            out[k] = got
        else:
            todo[k] = frames[k]
    if tally is not None:
        tally["frames"] = tally.get("frames", 0) + len(frames)
        tally["cached"] = tally.get("cached", 0) + len(out)
    order = sorted(todo)
    for i in range(0, len(order), UNDITHER_BATCH):
        batch = {k: todo[k] for k in order[i:i + UNDITHER_BATCH]}
        # the keys become filenames inside undither_frames, so give it strings
        # that survive its own sanitiser without colliding
        tags = {f"f{n:05d}": k for n, k in enumerate(batch)}
        got = ta3do.undither_frames({t: batch[k] for t, k in tags.items()},
                                    palette, preset=preset, python=python)
        for tag, k in tags.items():
            out[k] = got[tag]
            _cache_write(cdir / preset / keys[k][:2] / f"{keys[k]}.bin", got[tag])
    return out


# --------------------------------------------------------------------------- features

# terrain-depth.md 3 / tagpu_feat.c: one anchor per 16-px cell, drawn as a GAF
# sprite at the engine's projection with the frame's hotspot subtracted. The
# def's `height` is the tall-vs-flat sort class (< 10 = flat), and animtrans /
# shadtrans are the alpha bits the engine's FeatureDef mask carries.

# The unit atlas is padded so the exploration lane can MIPMAP it: every frame
# gets a replicated border of UNIT_PAD texels and its allocation is aligned to
# UNIT_PAD, so a mip texel at level L <= log2(UNIT_PAD) that touches a frame is
# made only of that frame's own texels. The viewer clamps TEXTURE_MAX_LOD to
# match. Parity never reads outside a frame (NEAREST, UVs on the frame), so the
# padding changes nothing there — the ss=1 fixture md5 is the proof.
UNIT_PAD = 4


def shelf_pack(frames, width=2048, pad=0, align=1):
    """Height-sorted shelf packer -> {key: (x, y)} and the atlas height. With
    `pad` the allocation carries a border and (x, y) is the frame's own origin
    inside it; `align` rounds every allocation up to a multiple."""
    up = lambda v: -(-v // align) * align
    order = sorted(frames, key=lambda k: -frames[k].height)
    place, x, y, shelf = {}, 0, 0, 0
    for key in order:
        f = frames[key]
        w, h = up(f.width + 2 * pad), up(f.height + 2 * pad)
        if w > width:
            continue
        if x + w > width:
            x, y, shelf = 0, y + shelf, 0
        place[key] = (x + pad, y + pad)
        x += w
        shelf = max(shelf, h)
    return place, y + shelf


def blit_frame(dst, aw, bpp, x, y, w, h, row, pad=0):
    """Paint one frame at (x, y) with `pad` replicated border texels around it.
    `row(r)` is the frame's row r as bytes, w*bpp long."""
    for r in range(-pad, h + pad):
        src = row(min(max(r, 0), h - 1))
        line = src[:bpp] * pad + src + src[-bpp:] * pad
        o = ((y + r) * aw + x - pad) * bpp
        dst[o:o + len(line)] = line


def paint_rgba(frames, place, aw, ah, restore, path: Path, pad=0):
    """The R8 atlas's layout, painted from restored true colour. None if off.

    The restorer keeps the colour key's alpha (it inpaints the key index before
    filtering and writes RGBA), so the undithered lane gets its holes for free
    and does not need the index compare the parity shaders do.
    """
    if restore is None or not frames:
        return None
    restored = restore(frames)
    buf = bytearray(aw * ah * 4)
    for key, (x, y) in place.items():
        got = restored.get(key)
        if not got:
            continue
        w, h, px = got
        blit_frame(buf, aw, 4, x, y, w, h, lambda r: px[r * w * 4:(r + 1) * w * 4], pad)
    path.write_bytes(bytes(buf))
    return str(path.relative_to(path.parent.parent)).replace(os.sep, "/")


def build_features(tnt, defs, gafs, out, restore=None, scenario=None):
    """Every feature the map anchors, plus the scenario's GAF ones: sprite
    atlas, instance list, def table. A scenario feature whose def names an
    `object` instead of a `seqname` is a 3DO (every wreck is) and is drawn by
    build_units, exactly as the engine hands it to its 3DO renderer."""
    names = tnt.feature_names()
    anchors = list(tnt.feature_indices())
    used = {}                                  # def index -> name
    for _col, _row, idx in anchors:
        if idx < len(names):
            used.setdefault(idx, names[idx])
    # the scenario's sprite features anchor at their cell, like the map's own;
    # a def the map's table does not carry gets an index past its end
    lower = {n.lower(): i for i, n in enumerate(names)}
    for feat in (scenario or {}).get("features", []):
        name = (feat.get("type") or "").lower()
        body = defs.get(name)
        if not body or not isinstance(feat.get("pos"), list):
            continue
        if not (body.get("seqname") or "").strip():
            continue                           # a 3DO feature: build_units draws it
        idx = lower.get(name)
        if idx is None:
            idx = lower[name] = len(lower)
        used.setdefault(idx, name)
        anchors.append((int(feat["pos"][0]) >> 4, int(feat["pos"][1]) >> 4, idx))

    frames, hotspots, table = {}, {}, {}
    for idx, name in sorted(used.items()):
        body = defs.get(name)
        entry = {"name": name, "height": 0, "footx": 1, "footz": 1,
                 "body": None, "shadow": None, "animtrans": 0, "shadtrans": 0}
        if body:
            entry["height"] = int(float(body.get("height", 0) or 0))
            entry["footx"] = int(float(body.get("footprintx", 1) or 1))
            entry["footz"] = int(float(body.get("footprintz", 1) or 1))
            entry["animtrans"] = 1 if body.get("animtrans", "0").strip() == "1" else 0
            entry["shadtrans"] = 1 if body.get("shadtrans", "0").strip() == "1" else 0
            for slot, key in (("body", "seqname"), ("shadow", "seqnameshad")):
                seq = (body.get(key) or "").strip()
                if not seq:
                    continue
                got = gafs.frame(seq)
                if not got:
                    continue
                frame, hx, hy = got
                frames[seq.upper()] = frame
                hotspots[seq.upper()] = (hx, hy)
                entry[slot] = seq.upper()
        entry["flat"] = 1 if entry["height"] < 10 else 0
        table[idx] = entry

    place, ah = shelf_pack(frames)
    aw = 2048 if frames else 1
    ah = max(1, ah)
    atlas = bytearray(aw * ah)
    rects = {}
    for key, (x, y) in place.items():
        f = frames[key]
        for r in range(f.height):
            o = (y + r) * aw + x
            atlas[o:o + f.width] = f.pixels[r * f.width:(r + 1) * f.width]
        hx, hy = hotspots[key]
        rects[key] = {"x": x, "y": y, "w": f.width, "h": f.height,
                      "hx": hx, "hy": hy, "ck": f.transparent}

    (out / "features").mkdir(parents=True, exist_ok=True)
    (out / "features/atlas.r8.bin").write_bytes(bytes(atlas))
    rgba_file = paint_rgba(frames, place, aw, ah, restore,
                           out / "features/atlas.rgba.bin")
    inst = bytearray()
    kept = 0
    for col, row, idx in anchors:
        entry = table.get(idx)
        if not entry or (entry["body"] is None and entry["shadow"] is None):
            continue
        inst += struct.pack("<3H", col, row, idx)
        kept += 1
    (out / "features/instances.bin").write_bytes(bytes(inst))

    defs_out = {}
    for idx, entry in table.items():
        if entry["body"] is None and entry["shadow"] is None:
            continue
        defs_out[str(idx)] = {
            "name": entry["name"], "height": entry["height"], "flat": entry["flat"],
            "footx": entry["footx"], "footz": entry["footz"],
            "animtrans": entry["animtrans"], "shadtrans": entry["shadtrans"],
            "body": rects.get(entry["body"]), "shadow": rects.get(entry["shadow"]),
        }
    return {"count": kept, "instances": "features/instances.bin",
            "atlas": {"w": aw, "h": ah, "file": "features/atlas.r8.bin",
                      "rgba": rgba_file},
            "defs": defs_out}


# --------------------------------------------------------------------------- shade

# tagpu_render3do.c calibrates the engine's PALETTE.SHD rather than assuming:
# neutral is the row with the most identity entries, and the direction (which
# way along the table is *brighter*) comes from end-row luminance.

SH_ROWS = 32


def shd_neutral(shd: bytes, palette):
    best_row, best_n = 0, -1
    for r in range(SH_ROWS):
        n = sum(1 for i in range(256) if shd[r * 256 + i] == i)
        if n > best_n:
            best_row, best_n = r, n
    lum0 = sum(sum(palette[shd[i]][:3]) for i in range(256))
    lum31 = sum(sum(palette[shd[31 * 256 + i]][:3]) for i in range(256))
    return [best_row, 1 if lum31 >= lum0 else -1]


# --------------------------------------------------------------------------- units

# Bind pose only, by design (tascene-design.md): offline there is no COB VM, so
# pieces sit at their *FromParent offsets with the unit's own yaw applied in the
# viewer. What the engine hides at Create is honoured -- ta3do already scans the
# script for it, and without that a unit renders with its muzzle flares stuck on.
#
# The mesh is stored in MODEL space, not screen space, because tagpu's per-face
# shade row is computed from the POSED normal: rotating first and shading after
# is the only order that gives the same LUT row the engine's own pass would.

UNIT_VSTRIDE = 7                       # x,y,z, u,v, flatCol, colourKey


def feature_object(defs, feat):
    """The 3DO a scenario feature is drawn with (a wreck's `object=`), or None."""
    body = defs.get(feat.get("type") or "") if defs else None
    obj = ((body or {}).get("object") or "").strip().lower()
    return obj or None


def build_units(scenario, assets, out, restore=None, defs=None):
    types = []
    for unit in scenario.get("units", []):
        if unit.get("type") and unit["type"].lower() not in types:
            types.append(unit["type"].lower())
    for group in scenario.get("groups", []):
        for comp in group.get("composition", []):
            if comp.get("type") and comp["type"].lower() not in types:
                types.append(comp["type"].lower())
    # 3DO features (wrecks) ride the unit path: same models3d/ 3DOs, same
    # renderer in the engine, posed by their facing and snapped to the ground
    for feat in scenario.get("features", []):
        obj = feature_object(defs, feat)
        if obj and obj not in types:
            types.append(obj)
    if not types:
        return None

    bank = ta3do.TextureBank(assets)
    models, frames = {}, {}
    for name in types:
        try:
            label, blob = ta3do.resolve_model(assets, name)
            root = ta3do.parse_3do(blob)
        except SystemExit:
            continue
        except Exception:
            continue
        hidden = {h.lower() for h in ta3do.script_hidden(assets, label) or ()}
        models[name] = (label, root, hidden)
        for key, frame in ta3do.model_textures(root, bank).items():
            frames.setdefault(key, frame)

    if not models:
        return None

    place, ah = shelf_pack(frames, pad=UNIT_PAD, align=UNIT_PAD)
    aw, ah = (2048 if frames else 1), max(1, ah)
    atlas = bytearray(aw * ah)
    rects = {}
    for key, (x, y) in place.items():
        f = frames[key]
        blit_frame(atlas, aw, 1, x, y, f.width, f.height,
                   lambda r, f=f: f.pixels[r * f.width:(r + 1) * f.width], UNIT_PAD)
        rects[key] = (x / aw, y / ah, (x + f.width) / aw, (y + f.height) / ah,
                      f.transparent)

    (out / "units").mkdir(parents=True, exist_ok=True)
    (out / "units/atlas.r8.bin").write_bytes(bytes(atlas))
    rgba_file = paint_rgba(frames, place, aw, ah, restore,
                           out / "units/atlas.rgba.bin", UNIT_PAD)

    meshes = {}
    for name, (label, root, hidden) in models.items():
        verts = []
        stats = {"pieces": 0, "faces": 0, "tris": 0, "textured": 0, "flat": 0}

        def emit(piece, ox, oy, oz):
            px, py, pz = ox + piece.offset[0], oy + piece.offset[1], oz + piece.offset[2]
            if piece.name.lower() not in hidden:
                stats["pieces"] += 1
                for prim in piece.primitives:
                    if prim.is_selection or len(prim.indices) < 3:
                        continue
                    rect = rects.get(prim.texture.upper()) if prim.texture else None
                    if rect is None and prim.texture:
                        continue                   # named a texture we cannot resolve
                    flat = None
                    if rect is None:
                        flat = (prim.color & 0xFF) / 255.0
                    stats["faces"] += 1
                    stats["textured" if rect else "flat"] += 1
                    n = len(prim.indices)
                    for k in range(1, n - 1):        # fan from vertex 0 (§1.4)
                        slots = (0, k, k + 1)
                        if any(prim.indices[s] >= len(piece.vertices) for s in slots):
                            continue
                        for slot in slots:
                            vx, vy, vz = piece.vertices[prim.indices[slot]]
                            if rect:
                                # the engine maps a whole GAF frame across the
                                # face's four corners; n-gons collapse onto them
                                c = slot if n <= 4 else slot * 4 // n
                                u = rect[2] if c in (1, 2) else rect[0]
                                v = rect[3] if c >= 2 else rect[1]
                                verts.extend((px + vx, py + vy, pz + vz,
                                              u, v, 0.0, rect[4] / 255.0))
                            else:
                                verts.extend((px + vx, py + vy, pz + vz,
                                              -1.0, -1.0, flat, -1.0))
                        stats["tris"] += 1
            for child in piece.children:
                emit(child, px, py, pz)

        emit(root, 0.0, 0.0, 0.0)
        blob = struct.pack(f"<{len(verts)}f", *verts)
        (out / f"units/{name}.bin").write_bytes(blob)
        meshes[name] = {"file": f"units/{name}.bin", "verts": len(verts) // UNIT_VSTRIDE,
                        "label": label, "stats": stats}

    instances = []
    for unit in scenario.get("units", []):
        key = (unit.get("type") or "").lower()
        if key not in meshes or not isinstance(unit.get("pos"), list):
            continue
        instances.append({"type": key, "pos": [int(unit["pos"][0]), int(unit["pos"][1])],
                          "facing": float(unit.get("facing", 0) or 0),
                          "id": unit.get("id")})
    for feat in scenario.get("features", []):
        obj = feature_object(defs, feat)
        if obj not in meshes or not isinstance(feat.get("pos"), list):
            continue
        instances.append({"type": obj, "pos": [int(feat["pos"][0]), int(feat["pos"][1])],
                          "facing": float(feat.get("facing", 0) or 0),
                          "id": feat.get("id"), "feature": feat.get("type")})
    return {"atlas": {"w": aw, "h": ah, "file": "units/atlas.r8.bin",
                      "rgba": rgba_file, "pad": UNIT_PAD},
            "stride": UNIT_VSTRIDE, "meshes": meshes, "instances": instances}


# --------------------------------------------------------------------------- art light

# "The art already contains the hill" was the exploration lane's open question
# (tascene-design.md). This answers it with a number instead of an opinion.
#
# For every 16-px cell steeper than `--steep`, correlate the mean luminance of
# the tile quadrant PAINTED there against the N.L that quadrant's own gradient
# would receive, sweeping the sun's azimuth. A directional signal (the art was
# painted lit) shows up as the AMPLITUDE of the resulting sinusoid; a material
# confound -- steep cells simply being painted with darker rock -- shifts its
# OFFSET instead, so the two separate.

REC709 = (0.2126, 0.7152, 0.0722)


def _tile_quadrant_luma(tnt, palette):
    """[tile][quadrant] -> mean luminance, quadrants (row&1)*2 + (col&1)."""
    lut = [int(round((REC709[0] * c[0] + REC709[1] * c[1] + REC709[2] * c[2]) * 1000))
           for c in palette]
    get = lut.__getitem__
    out = []
    for i in range(tnt.tiles):
        src = tnt.p_tilegfx + i * TILE_BYTES
        quads = [0, 0, 0, 0]
        for r in range(TILE_PX):
            row = tnt.blob[src + r * TILE_PX: src + (r + 1) * TILE_PX]
            q = (r >> 4) * 2
            quads[q] += sum(map(get, row[:16]))
            quads[q + 1] += sum(map(get, row[16:]))
        out.append([v / 256000.0 for v in quads])
    return out


def art_light(tnt, palette, steep=0.25, elevation=53.1, step=15):
    """(n_steep, [(azimuth, pearson r)]) for one map."""
    quads = _tile_quadrant_luma(tnt, palette)
    heights = tnt.heights()
    tmap = tnt.tilemap()
    W, H, MW = tnt.w16, tnt.h16, tnt.mw
    cells = []
    for r in range(H - 1):
        base, nxt = r * W, (r + 1) * W
        trow = (r >> 1) * MW
        for c in range(W - 1):
            o = (trow + (c >> 1)) * 2
            t = tmap[o] | (tmap[o + 1] << 8)
            if t >= tnt.tiles:
                continue
            h00, h10 = heights[base + c], heights[base + c + 1]
            h01, h11 = heights[nxt + c], heights[nxt + c + 1]
            dx = ((h10 + h11) - (h00 + h01)) / 32.0
            dz = ((h01 + h11) - (h00 + h10)) / 32.0
            if math.hypot(dx, dz) < steep:
                continue
            cells.append((dx, dz, quads[t][(r & 1) * 2 + (c & 1)]))
    curve = []
    e = math.radians(elevation)
    n = len(cells)
    for azi in range(0, 360, step):
        a = math.radians(azi)
        sx_, sy_, sz_ = math.sin(a) * math.cos(e), math.sin(e), -math.cos(a) * math.cos(e)
        sx = sy = sxx = syy = sxy = 0.0
        for dx, dz, b in cells:
            inv = 1.0 / math.hypot(dx, 1.0, dz)
            nl = (-dx * inv) * sx_ + inv * sy_ + (-dz * inv) * sz_
            if nl < 0.0:
                nl = 0.0
            sx += nl; sy += b; sxx += nl * nl; syy += b * b; sxy += nl * b
        if not n:
            curve.append((azi, 0.0))
            continue
        mx, my = sx / n, sy / n
        sdx = math.sqrt(max(sxx / n - mx * mx, 0.0))
        sdy = math.sqrt(max(syy / n - my * my, 0.0))
        curve.append((azi, (sxy / n - mx * my) / (sdx * sdy) if sdx and sdy else 0.0))
    return n, curve


def cmd_artlight(args):
    assets = ta3do.Assets()
    palette = ta3do.load_palette(assets)
    if args.all:
        paths = sorted(assets.glob("maps/*.tnt"))
    else:
        if not args.map:
            die("name a map with --map, or sweep every stock map with --all")
        paths = [map_tnt(assets, args.map)]
    rows = []
    for path in paths:
        try:
            tnt = Tnt(assets.read(path), path)
        except Exception as err:
            print(f"tascene: skipping {path}: {err}", file=sys.stderr)
            continue
        n, curve = art_light(tnt, palette, args.steep, args.elevation)
        peak = max(curve, key=lambda t: t[1])
        trough = min(curve, key=lambda t: t[1])
        rows.append({"map": Path(path).stem, "steep": n,
                     "peakAz": peak[0], "peakR": round(peak[1], 4),
                     "troughAz": trough[0], "troughR": round(trough[1], 4),
                     "amplitude": round(peak[1] - trough[1], 4),
                     "offset": round((peak[1] + trough[1]) / 2, 4),
                     "curve": [[a, round(r, 4)] for a, r in curve]})
        if not args.json:
            row = rows[-1]
            print(f"{row['map'][:28]:28s} steep {row['steep']:7d}  "
                  f"peak {row['peakR']:+.3f} @ az {row['peakAz']:3d}  "
                  f"trough {row['troughR']:+.3f} @ az {row['troughAz']:3d}  "
                  f"amplitude {row['amplitude']:.3f}  offset {row['offset']:+.3f}")
    if args.json:
        ta3do.out({"steep": args.steep, "elevation": args.elevation, "maps": rows},
                  True)


# --------------------------------------------------------------------------- maps

def map_tnt(assets, name: str):
    """A scenario's map name -> its maps/*.tnt path."""
    want = name.strip().lower()
    direct = f"maps/{want}.tnt"
    if assets.has(direct):
        return direct
    for path in assets.glob("maps/*.tnt"):
        if Path(path).stem.lower() == want:
            return path
    # fall back to the .ota's own missionname
    for ota in assets.glob("maps/*.ota"):
        try:
            tdf = parse_tdf(assets.read(ota).decode("latin-1"))
        except Exception:
            continue
        for body in tdf.values():
            if isinstance(body, dict) and body.get("missionname", "").strip().lower() == want:
                cand = ota[:-4] + ".tnt"
                if assets.has(cand):
                    return cand
    die(f"no map named {name!r} in the archives")


# --------------------------------------------------------------------------- view

# resolution.md §3: the viewport rect is {128, 32, W-1, H-33}, so the play area
# is always viewW = W-128, viewH = H-64 with its top-left at (128, 32).
VP_L, VP_T = 128, 32


def viewport(res):
    w, h = res
    return VP_L, VP_T, w - 128, h - 64


def clamp_eye(eye, tnt, vw, vh):
    """The eye is the world position of the viewport's top-left corner."""
    x, y = eye
    maxx = max(0, tnt.w16 * 16 - vw)
    maxy = max(0, tnt.h16 * 16 - vh)
    return [max(0, min(int(x), maxx)), max(0, min(int(y), maxy))]


# --------------------------------------------------------------------------- build

def load_scenario(path: Path):
    try:
        doc = json.loads(path.read_text())
    except Exception as err:
        die(f"{path}: {err}")
    if doc.get("format") != "ta-scenario/1":
        die(f"{path}: not a ta-scenario/1 file")
    return doc


def cmd_build(args):
    scenario = load_scenario(Path(args.scenario))
    setup = scenario.get("setup", {})
    assets = ta3do.Assets()
    palette = ta3do.load_palette(assets)

    mapname = args.map or setup.get("map")
    if not mapname:
        die("scenario has no setup.map and --map was not given")
    tnt_path = map_tnt(assets, mapname)
    tnt = Tnt(assets.read(tnt_path), tnt_path)

    res = [int(v) for v in (args.res or setup.get("res", "1024x768")).lower().split("x")]
    vpL, vpT, vw, vh = viewport(res)

    if args.eye:
        eye = [int(v) for v in args.eye.split(",")]
    else:
        centre = scenario_centre(scenario, tnt)
        eye = [centre[0] - vw // 2, centre[1] - vh // 2]
    eye = clamp_eye(eye, tnt, vw, vh)

    out = Path(args.output)
    (out / "terrain").mkdir(parents=True, exist_ok=True)
    (out / "palette").mkdir(parents=True, exist_ok=True)
    (out / "shaders").mkdir(parents=True, exist_ok=True)

    restore, tally = None, {}
    if args.undither:
        cdir = cache_root(args.cache_dir)
        def restore(frames, _pal=palette, _p=args.undither, _c=cdir, _t=tally):
            return undither(frames, _pal, _p, _c, args.undither_python, _t)

    aw, ah, atlas = tnt.atlas()
    (out / "terrain/atlas.r8.bin").write_bytes(atlas)
    (out / "terrain/tilemap.u16.bin").write_bytes(tnt.tilemap())
    (out / "terrain/height.r8.bin").write_bytes(tnt.heights())
    terr_rgba = None
    if restore:
        _w, _h, rgba = tnt.atlas_rgba(restore(tnt.tile_frames()))
        (out / "terrain/atlas.rgba.bin").write_bytes(rgba)
        terr_rgba = "terrain/atlas.rgba.bin"

    pal = bytearray()
    for i in range(256):
        c = palette[i]
        pal += bytes((c[0], c[1], c[2], 255))
    (out / "palette/pal.bin").write_bytes(bytes(pal))
    shd = assets.read("palettes/palette.shd") if assets.has("palettes/palette.shd") else b""
    if shd:
        (out / "palette/shd.bin").write_bytes(shd)

    for name, src in extract_shaders(SHADER_SET).items():
        (out / "shaders" / name).write_text(src)

    defs = FeatureDefs(assets)
    features = None
    if not args.no_features:
        features = build_features(tnt, defs, GafBank(assets), out, restore, scenario)
    units = None if args.no_units else build_units(scenario, assets, out, restore, defs)

    manifest = {
        "format": "ta-scene/1",
        "scenario": str(args.scenario),
        "map": {
            "name": mapname,
            "file": tnt_path,
            "w16": tnt.w16, "h16": tnt.h16,
            "tilemap": {"w": tnt.mw, "h": tnt.mh, "file": "terrain/tilemap.u16.bin"},
            "atlas": {"w": aw, "h": ah, "cols": ATLAS_COLS, "tiles": tnt.tiles,
                      "pitch": CELL_PITCH, "border": CELL_BORDER,
                      "file": "terrain/atlas.r8.bin", "rgba": terr_rgba},
            "height": {"w": tnt.w16, "h": tnt.h16, "file": "terrain/height.r8.bin"},
            "sealevel": tnt.sealevel,
        },
        "view": {"res": res, "vp": [vpL, vpT, vw, vh], "eye": eye, "zoom": 1.0},
        "palette": {"file": "palette/pal.bin", "shd": "palette/shd.bin" if shd else None,
                    "shdRows": (len(shd) // 256) if shd else 0,
                    "neutral": shd_neutral(shd, palette) if shd else [15, 1]},
        "features": features,
        "units": units,
        "depth": {"terrain": 0.10, "scale": 512.0,
                  "flat0": 0.40, "flatSpan": 0.10, "tall0": 3.0, "rowStep": 4.0,
                  "unit0": 1.0, "shadowTall": 0.30, "shadowFlat": 0.03},
        "shaders": sorted(n for n in extract_shaders(SHADER_SET)),
        # the exploration lane's own depth keys: with a HEIGHTFIELD the ground
        # is per-row, so the parity lane's one global terrain key (and the flat
        # features' global 0.40-0.50 band, which would then sit behind it) do
        # not survive. Lane-local, and making no parity claim -- that is the
        # point of the split (tascene-design.md, "Two lanes").
        "labDepth": {"terrain": 0.10, "flat": 0.50, "tallCol": 0.9},
        "undither": ({"preset": args.undither, "frames": tally.get("frames", 0),
                      "cached": tally.get("cached", 0)} if args.undither else None),
    }
    (out / "scene.json").write_text(json.dumps(manifest, indent=2) + "\n")

    nfeat = features["count"] if features else 0
    nunit = len(units["instances"]) if units else 0
    undithered = (f", undithered {tally.get('frames', 0)} frames "
                  f"({tally.get('cached', 0)} cached)") if args.undither else ""
    ta3do.out({"pack": str(out), "map": mapname, "tiles": tnt.tiles,
               "atlas": [aw, ah], "eye": eye, "res": res,
               "features": nfeat, "units": nunit,
               "undither": manifest["undither"]}, args.json,
              human=(f"{out}: {mapname} {tnt.w16}x{tnt.h16} 16px cells, "
                     f"{tnt.tiles} tiles, atlas {aw}x{ah}, {nfeat} features, "
                     f"{nunit} units, eye {eye[0]},{eye[1]}{undithered}"))


def scenario_centre(scenario, tnt):
    """Where the scenario points the camera, in world units."""
    cam = scenario.get("camera") or {}
    if isinstance(cam.get("at"), list) and len(cam["at"]) == 2:
        return [int(cam["at"][0]), int(cam["at"][1])]
    target = cam.get("center_on")
    if target:
        for unit in scenario.get("units", []) + scenario.get("features", []):
            if unit.get("id") == target and isinstance(unit.get("pos"), list):
                return [int(unit["pos"][0]), int(unit["pos"][1])]
        for group in scenario.get("groups", []):
            if group.get("id") == target and isinstance(group.get("at"), list):
                return [int(group["at"][0]), int(group["at"][1])]
    units = [u for u in scenario.get("units", []) if isinstance(u.get("pos"), list)]
    if units:
        return [sum(u["pos"][0] for u in units) // len(units),
                sum(u["pos"][1] for u in units) // len(units)]
    return [tnt.w16 * 8, tnt.h16 * 8]


# --------------------------------------------------------------------------- serve / shot

VIEWER = HERE / "tascene-view.html"
PRESETS = HERE / "tascene-presets.json"


def cmd_serve(args):
    pack = Path(args.pack).resolve()
    if not (pack / "scene.json").exists():
        die(f"{pack} has no scene.json (run `tascene build` first)")
    _stage_viewer(pack)
    server = ta3do.Viewer(pack, port=args.port)
    url = f"{server.base}/{VIEWER.name}"
    watching = "" if args.no_reload else "  (live: edit the viewer and the page reloads)"
    print(f"serving {pack} at {url}  (ctrl-c to stop){watching}", flush=True)
    try:
        if args.no_reload:
            while True:
                time.sleep(3600)
        else:
            _watch_sources(pack)
    except KeyboardInterrupt:
        pass
    finally:
        server.close()


# The viewer is STAGED into the pack (same-origin fetches), so an edit to
# tools/tascene-view.html reached a running server only by restarting it — and
# then only after a manual browser reload. Both steps were easy to forget and
# the failure mode is silent: you look at the old code and believe the result.
# So the serving copy is re-staged whenever the source changes, and the token
# below is what the page polls to know it should reload itself.
RELOAD_TOKEN = "__reload"


def _source_token() -> str:
    """mtime+size of every checked-in file the served page is built from."""
    parts = []
    for f in (VIEWER, PRESETS):
        st = f.stat() if f.exists() else None
        parts.append(f"{f.name}:{st.st_mtime_ns}:{st.st_size}" if st else f"{f.name}:-")
    return " ".join(parts)


def _watch_sources(pack: Path, interval: float = 0.5):
    (pack / RELOAD_TOKEN).write_text(_source_token())
    last = _source_token()
    while True:
        time.sleep(interval)
        now = _source_token()
        if now == last:
            continue
        last = now
        try:
            _stage_viewer(pack)
        except SystemExit:            # die() inside the stager: keep serving
            print("viewer vanished mid-edit; keeping the last good copy", flush=True)
            continue
        (pack / RELOAD_TOKEN).write_text(now)
        print(f"restaged {VIEWER.name} -> reloading the page", flush=True)


def _stage_viewer(pack: Path):
    """The viewer and its presets are served from the pack: same-origin fetches.

    Both are checked-in lab files, not pack contents — `pack/` is generated and
    disposable, so nothing here may be the only copy of anything.
    """
    if not VIEWER.exists():
        die(f"viewer missing: {VIEWER}")
    (pack / VIEWER.name).write_text(VIEWER.read_text())
    if PRESETS.exists():
        (pack / PRESETS.name).write_text(PRESETS.read_text())


def cmd_shot(args):
    pack = Path(args.pack).resolve()
    if not (pack / "scene.json").exists():
        die(f"{pack} has no scene.json (run `tascene build` first)")
    _stage_viewer(pack)
    scene = json.loads((pack / "scene.json").read_text())
    w, h = scene["view"]["res"]
    png = Path(args.output).expanduser().resolve()
    png.parent.mkdir(parents=True, exist_ok=True)
    if png.exists():
        png.unlink()
    chrome = ta3do.find_chrome()
    display = ta3do.Display()
    server = ta3do.Viewer(pack)
    try:
        query = "?shot=1" + (("&" + args.opts) if args.opts else "")
        url = f"{server.base}/{VIEWER.name}{query}"
        error = ta3do.shoot(chrome, display.name, url, png, (w, h),
                            args.timeout, args.budget)
        if error:
            die(error)
    finally:
        server.close()
        display.close()
    ta3do.out({"png": str(png), "size": [w, h]}, args.json, human=str(png))


# --------------------------------------------------------------------------- ab

# The parity claim, made checkable. Everything here already exists — tacli
# drives the game, glshot captures the GL framebuffer top-down, roster reports
# the live eye — so `ab` is glue, and being glue is the point: a comparison
# that only happens when someone remembers does not happen.

TACLI = HERE / "tacli"


def run_tacli(argv, timeout=600.0, want_json=False):
    cmd = [sys.executable, str(TACLI)] + argv + (["--json"] if want_json else [])
    proc = subprocess.run(cmd, capture_output=True, timeout=timeout)
    text = proc.stdout.decode("utf-8", "replace")
    if proc.returncode != 0:
        tail = proc.stderr.decode("utf-8", "replace").strip().splitlines()[-4:]
        die(f"tacli {' '.join(argv[:2])} failed: " + " / ".join(tail or [text[-200:]]))
    if want_json:
        try:
            return json.loads(text)
        except Exception:
            die(f"tacli {' '.join(argv[:2])}: not JSON: {text[:200]}")
    return text


def read_ppm(path: Path):
    blob = path.read_bytes()
    if not blob.startswith(b"P6"):
        die(f"{path}: not a P6 PPM")
    fields, pos = [], 2
    while len(fields) < 3:
        while pos < len(blob) and blob[pos:pos + 1].isspace():
            pos += 1
        if blob[pos:pos + 1] == b"#":
            while pos < len(blob) and blob[pos] != 0x0A:
                pos += 1
            continue
        start = pos
        while pos < len(blob) and not blob[pos:pos + 1].isspace():
            pos += 1
        fields.append(int(blob[start:pos]))
    w, h, _maxv = fields
    return w, h, blob[pos + 1:pos + 1 + w * h * 3]


def diff_rgb(a, b, w, h, rect):
    """Differing pixels and mean abs error inside rect, ignoring nothing."""
    x0, y0, rw, rh = rect
    n, total = 0, 0
    for y in range(y0, min(y0 + rh, h)):
        row = y * w
        for x in range(x0, min(x0 + rw, w)):
            o = (row + x) * 3
            d = (abs(a[o] - b[o]) + abs(a[o + 1] - b[o + 1]) + abs(a[o + 2] - b[o + 2]))
            if d:
                n += 1
                total += d
    px = max(1, min(rw, w - x0) * min(rh, h - y0))
    return n, total / (3.0 * px), px


GAP = 4


def panel(images, out_png):
    """Side-by-side composite, stdlib only — ta3do owns the PNG codec.

    tools/sbs.py does this with PIL and labels; this stays inside tascene's
    stdlib-only budget, so the panel is unlabelled and the numbers are printed.
    """
    W = sum(w for _l, _rgb, w, _h in images) + GAP * (len(images) - 1)
    H = max(h for _l, _rgb, _w, h in images)
    canvas = bytearray(b"\x18\x18\x18\xff" * (W * H))
    x = 0
    for _label, rgb, w, h in images:
        for y in range(h):
            src, dst = y * w * 3, (y * W + x) * 4
            for i in range(w):
                canvas[dst + i * 4:dst + i * 4 + 3] = rgb[src + i * 3:src + i * 3 + 3]
        x += w + GAP
    out_png.write_bytes(ta3do.write_png(W, H, bytes(canvas)))


def cmd_ab(args):
    scenario_path = Path(args.scenario)
    scenario = load_scenario(scenario_path)
    out = Path(args.output)
    out.mkdir(parents=True, exist_ok=True)

    if not args.no_launch:
        load = ["scenario", "load", args.name, str(scenario_path), "--restart"]
        if args.los is not None:
            load += ["--los", str(args.los)]
        if args.mapping is not None:
            load += ["--mapping", str(args.mapping)]
        print(f"tascene: launching {args.name} with {scenario_path.name} ...")
        run_tacli(load, timeout=args.launch_timeout)

    if args.eye:
        ex, ey = args.eye.split(",")
        run_tacli(["eye", args.name, ex, ey])

    # `scenario load` returns when the applier has answered, but the overlay
    # logs its roster block on its own cadence — so the newest `units:` line can
    # still be the one from boot, whose eye is (0,0). Waiting for a roster that
    # actually has units is the difference between a parity number and a
    # meaningless 95% diff against the loading screen.
    roster, eye = None, None
    deadline = time.time() + args.settle
    while time.time() < deadline:
        roster = run_tacli(["roster", args.name], want_json=True)
        eye = roster.get("eye")
        if eye and (eye[0] or eye[1]) and roster.get("units"):
            break
        time.sleep(2.0)
    if not eye or not (eye[0] or eye[1]) or not roster.get("units"):
        die(f"no settled game state after {args.settle:g}s "
            f"(eye={eye}, units={len(roster.get('units') or []) if roster else 0}) — "
            "the roster still reads the boot frame, so any diff would be noise")
    print(f"tascene: live eye {eye[0]},{eye[1]}, {len(roster['units'])} units")

    ppm = out / "engine.ppm"
    run_tacli(["glshot", args.name, "-o", str(ppm)])
    ew, eh, engine = read_ppm(ppm)

    pack = out / "pack"
    build_argv = [str(scenario_path), "-o", str(pack), "--eye", f"{eye[0]},{eye[1]}",
                  "--res", f"{ew}x{eh}"]
    main(["build"] + build_argv)

    ours_png = out / "browser.png"
    main(["shot", str(pack), "-o", str(ours_png)] + (["--opts", args.opts] if args.opts else []))
    ow, oh, _ch, ours = ta3do.read_png(ours_png.read_bytes())
    if _ch == 4:
        ours = bytes(b for i, b in enumerate(ours) if i % 4 != 3)

    if (ow, oh) != (ew, eh):
        die(f"size mismatch: engine {ew}x{eh}, browser {ow}x{oh}")

    vpL, vpT, vw, vh = viewport([ew, eh])
    n, mae, px = diff_rgb(engine, ours, ew, eh, (vpL, vpT, vw, vh))
    panel([("engine", engine, ew, eh), ("tascene", ours, ow, oh)], out / "ab.png")

    result = {"eye": eye, "res": [ew, eh], "viewport": [vpL, vpT, vw, vh],
              "differing": n, "viewport_px": px, "pct": round(100.0 * n / px, 3),
              "mean_abs": round(mae, 3), "panel": str(out / "ab.png")}
    ta3do.out(result, args.json,
              human=(f"engine vs tascene inside the viewport: {n}/{px} px differ "
                     f"({100.0 * n / px:.2f}%), mean abs {mae:.2f}/255\n"
                     f"panel: {out / 'ab.png'}"))


# --------------------------------------------------------------------------- CLI

def main(argv=None):
    ap = argparse.ArgumentParser(prog="tascene", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    b = sub.add_parser("build", help="compile a scenario into a scene pack")
    b.add_argument("scenario")
    b.add_argument("-o", "--output", required=True)
    b.add_argument("--map", help="override setup.map")
    b.add_argument("--res", help="override setup.res, e.g. 1024x768")
    b.add_argument("--eye", help="viewport top-left in world units, 'X,Y'")
    b.add_argument("--no-units", action="store_true",
                   help="skip unit meshes")
    b.add_argument("--no-features", action="store_true",
                   help="terrain only (a smaller pack, and a terrain-only diff)")
    b.add_argument("--undither", nargs="?", const="learned", metavar="PRESET",
                   choices=ta3do.UNDITHER_PRESETS,
                   help="also pack true-colour atlases for the EXPLORATION lane "
                        f"({' | '.join(ta3do.UNDITHER_PRESETS)}; default learned). "
                        "The parity lane keeps its palette indices either way")
    b.add_argument("--undither-python", dest="undither_python",
                   help="interpreter that can import unditherer "
                        "(default: the checkout's .venv-undither)")
    b.add_argument("--cache-dir", dest="cache_dir",
                   help=f"restored-frame cache (default ${CACHE_ENV} or "
                        "~/.cache/tascene/undither)")
    b.add_argument("--json", action="store_true")
    b.set_defaults(func=cmd_build)

    s = sub.add_parser("serve", help="serve a pack for interactive viewing")
    s.add_argument("pack")
    s.add_argument("--port", type=int, default=0)
    s.add_argument("--no-reload", action="store_true",
                   help="do not re-stage the viewer on edit, and do not let the "
                        "page reload itself (the pre-live-reload behaviour)")
    s.set_defaults(func=cmd_serve)

    t = sub.add_parser("shot", help="headless screenshot of a pack")
    t.add_argument("pack")
    t.add_argument("-o", "--output", required=True)
    t.add_argument("--opts", help="viewer query string, e.g. 'preset=relief' or "
                                  "'a=engine&b=restored&wipe=0.5'")
    t.add_argument("--timeout", type=float, default=90.0)
    t.add_argument("--budget", type=int, default=8000,
                   help="chrome --virtual-time-budget in ms")
    t.add_argument("--json", action="store_true")
    t.set_defaults(func=cmd_shot)

    al = sub.add_parser("artlight",
                        help="is the map art already painted lit? sweep the sun "
                             "and correlate against the heightfield's own slope")
    al.add_argument("--map", help="map name (default: --all)")
    al.add_argument("--all", action="store_true", help="every stock map (slow)")
    al.add_argument("--steep", type=float, default=0.25,
                    help="only cells with |grad h| at least this (0.25 = ~14 deg)")
    al.add_argument("--elevation", type=float, default=53.1,
                    help="sun elevation in degrees (default: the engine's own)")
    al.add_argument("--json", action="store_true")
    al.set_defaults(func=cmd_artlight)

    ab = sub.add_parser("ab", help="drive the game and the browser, and diff them")
    ab.add_argument("scenario")
    ab.add_argument("--name", default="tascene", help="instance name")
    ab.add_argument("-o", "--output", default="ab-out")
    ab.add_argument("--eye", help="pin the eye to 'X,Y' before capturing")
    ab.add_argument("--opts", help="viewer query string")
    ab.add_argument("--no-launch", action="store_true",
                    help="use an instance that is already running")
    ab.add_argument("--los", type=int, choices=(0, 1, 2), default=0,
                    help="SKIRMISH Line of Sight (0 = Permanent: no grey fog)")
    ab.add_argument("--mapping", type=int, choices=(0, 1), default=1)
    ab.add_argument("--launch-timeout", type=float, default=600.0)
    ab.add_argument("--settle", type=float, default=90.0,
                    help="seconds to wait for a roster with units and a real eye")
    ab.add_argument("--json", action="store_true")
    ab.set_defaults(func=cmd_ab)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    main()
