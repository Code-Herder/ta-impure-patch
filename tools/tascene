#!/usr/bin/env python3
"""tascene — compile a Total Annihilation scenario into a browser scene pack.

    tools/tascene build scenarios/tascene-parity.json -o /tmp/pack
    tools/tascene serve /tmp/pack
    tools/tascene shot  /tmp/pack --opts 'pass=terrain' -o shot.png
    tools/tascene ab    scenarios/tascene-parity.json

The pack is everything the browser lab needs to draw a real map with real units,
read straight out of the game's own archives — no game running, nothing unpacked.
`tools/tascene-view.html` draws it in WebGL2 using **tagpu's own shaders**, which
this tool extracts from the C sources at export time so the two cannot drift.

Design and locked decisions: research/notes/tascene-design.md
Formats: research/notes/file-formats.md (TNT is §6, verified across 275 maps)
The draw this reproduces: research/notes/terrain-depth.md §1-§3

Everything is stdlib-only. The asset stack (HPI/VFS, palette, GAF, 3DO, atlas,
PNG, the local server and the headless-Chrome shooter) is `tools/ta3do`, loaded
as a module the way tools/test_ta3do.py already loads it.
"""

import argparse
import hashlib
import json
import math
import os
import re
import struct
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
SRC_ROOT = HERE.parent               # this checkout — where tagpu's C sources are


def _load_ta3do():
    loader = SourceFileLoader("ta3do", str(HERE / "ta3do"))
    import importlib.util
    spec = importlib.util.spec_from_loader("ta3do", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ta3do = _load_ta3do()


def die(msg):
    print(f"tascene: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------------------- TNT

# §6, VERIFIED against all 275 stock maps (2026-09-03): every block offset is
# predicted exactly by the previous block's size and the header's counts.
#   header      64 bytes, 16 int32 LE
#   mapdata     u16 tile index per 32-px cell, row-major, stride W/2
#   mapattr     4 B per 16-px cell, row-major, stride W:
#                 byte0 = height 0..255, bytes1-2 = u16 feature index, byte3 = 0
#   tilegfx     tiles x 1024 B, 32x32 8bpp
#   tileanim    tileanims x 132 B = int32 + name -- the FEATURE NAME table
#   minimap     int32 w, int32 h, then w*h 8bpp.  Ends the file.

TNT_HDR = "<3i2I I 2i I i I i 4i"
TILE_PX = 32
TILE_BYTES = 0x400
ATLAS_COLS = 64                      # tagpu_terr.c: 64 tiles per atlas row
# THE GUARD RAIL, copied from tagpu_terr.c (CELL_BORDER / CELL_PITCH). Cells sit
# one texel apart and that texel is a COPY of the cell's last row/column. A
# fragment centre landing exactly on a quad's far edge interpolates v to exactly
# v1, and GL_NEAREST resolves that to floor(v1*H) = the first texel of the NEXT
# cell -- the unrelated tile 64 cells later in the atlas, i.e. blue hairlines
# along tile edges. The quad still spans exactly TILE_PX texels, so sampling at
# 1:1 is bit-identical to the un-padded atlas; it is the cases that are NOT 1:1
# that this saves. The parity lane never hit it (its quads are integer-aligned);
# the exploration lane displaces y by relief*h/2, which is a half-pixel whenever
# the height is odd, and the hairlines came straight back.
CELL_BORDER = 1
CELL_PITCH = TILE_PX + 2 * CELL_BORDER   # 34
ATLAS_W = ATLAS_COLS * CELL_PITCH        # 2176


class Tnt:
    def __init__(self, blob: bytes, name: str = ""):
        if len(blob) < 64:
            raise ValueError("TNT shorter than its header")
        (self.version, self.w16, self.h16, self.p_mapdata, self.p_mapattr,
         self.p_tilegfx, self.tiles, self.tileanims, self.p_tileanim,
         self.sealevel, self.p_minimap, self.unknown1,
         *_pad) = struct.unpack_from(TNT_HDR, blob, 0)
        if self.version not in (0x2000, 0x1020):
            raise ValueError(f"unknown TNT version 0x{self.version:X}")
        if self.version != 0x2000:
            raise ValueError("legacy TNT (0x1020) not implemented")
        self.blob = blob
        self.name = name
        self.mw = self.w16 // 2          # map width in 32-px cells
        self.mh = self.h16 // 2
        self.check()

    def check(self):
        """The arithmetic that verified the format; a mismatch means we misread."""
        md = self.mw * self.mh * 2
        for got, want, what in (
            (self.p_mapdata, 64, "mapdata"),
            (self.p_tilegfx, self.p_mapattr + self.w16 * self.h16 * 4, "tilegfx"),
            (self.p_tileanim, self.p_tilegfx + self.tiles * TILE_BYTES, "tileanim"),
            (self.p_minimap, self.p_tileanim + self.tileanims * 132, "minimap"),
        ):
            if got != want:
                raise ValueError(f"{self.name}: {what} at {got}, expected {want}")
        if not (self.p_mapdata + md <= self.p_mapattr <= self.p_mapdata + md + 15):
            raise ValueError(f"{self.name}: mapattr {self.p_mapattr} not just past mapdata")

    def tilemap(self) -> bytes:
        """u16 per 32-px cell, row-major, stride self.mw."""
        return self.blob[self.p_mapdata:self.p_mapdata + self.mw * self.mh * 2]

    def heights(self) -> bytes:
        """byte per 16-px cell, row-major, stride self.w16 — mapattr byte 0."""
        a = self.blob[self.p_mapattr:self.p_mapattr + self.w16 * self.h16 * 4]
        return bytes(a[0::4])

    def feature_indices(self):
        """(col, row, u16 def index) for every 16-px cell that anchors a feature."""
        a = self.blob[self.p_mapattr:self.p_mapattr + self.w16 * self.h16 * 4]
        out = []
        for i in range(self.w16 * self.h16):
            idx = a[i * 4 + 1] | (a[i * 4 + 2] << 8)
            if idx < 0xFFFB:
                out.append((i % self.w16, i // self.w16, idx))
        return out

    def feature_names(self):
        """The tileanim block: the map's own feature name table."""
        names = []
        for i in range(self.tileanims):
            rec = self.blob[self.p_tileanim + i * 132: self.p_tileanim + (i + 1) * 132]
            names.append(rec[4:].split(b"\0")[0].decode("latin-1"))
        return names

    def atlas(self):
        """One R8 atlas of 34x34 guarded cells, 64 per row — tagpu_terr.c's layout."""
        rows = (self.tiles + ATLAS_COLS - 1) // ATLAS_COLS
        h = rows * CELL_PITCH
        buf = bytearray(ATLAS_W * h)
        for i in range(self.tiles):
            src = self.p_tilegfx + i * TILE_BYTES
            ox = (i % ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            oy = (i // ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            for r in range(TILE_PX):
                row = self.blob[src + r * TILE_PX: src + (r + 1) * TILE_PX]
                o = (oy + r) * ATLAS_W + ox
                buf[o - 1] = row[0]                       # left  border column
                buf[o:o + TILE_PX] = row
                buf[o + TILE_PX] = row[TILE_PX - 1]       # right border column
            top = (oy - 1) * ATLAS_W + ox - 1
            first = (oy) * ATLAS_W + ox - 1
            buf[top:top + CELL_PITCH] = buf[first:first + CELL_PITCH]
            bot = (oy + TILE_PX) * ATLAS_W + ox - 1
            last = (oy + TILE_PX - 1) * ATLAS_W + ox - 1
            buf[bot:bot + CELL_PITCH] = buf[last:last + CELL_PITCH]
        return ATLAS_W, h, bytes(buf)

    def minimap(self):
        w, h = struct.unpack_from("<2i", self.blob, self.p_minimap)
        px = self.blob[self.p_minimap + 8: self.p_minimap + 8 + w * h]
        return w, h, px

    def tile_frames(self):
        """{index: GafFrame} — the tiles as the unditherer wants them, one 32x32
        image each. Per-tile is the whole story: a tile restored in isolation
        differs from the same tile restored inside a 3x3 patch of its real map
        neighbours by 2.03/255 on the edge ring and 0.45/255 inside it, so there
        is deliberately no neighbour-context machinery here (tascene-design.md).
        """
        out = {}
        for i in range(self.tiles):
            src = self.p_tilegfx + i * TILE_BYTES
            out[i] = ta3do.GafFrame(TILE_PX, TILE_PX,
                                    bytearray(self.blob[src:src + TILE_BYTES]), None)
        return out

    def atlas_rgba(self, restored):
        """The same guarded layout as atlas(), painted from restored true colour."""
        rows = (self.tiles + ATLAS_COLS - 1) // ATLAS_COLS
        h = rows * CELL_PITCH
        buf = bytearray(ATLAS_W * h * 4)
        for i in range(self.tiles):
            got = restored.get(i)
            if not got:
                continue
            _w, _h, px = got
            ox = (i % ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            oy = (i // ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            for r in range(TILE_PX):
                row = px[r * TILE_PX * 4:(r + 1) * TILE_PX * 4]
                o = ((oy + r) * ATLAS_W + ox) * 4
                buf[o - 4:o] = row[0:4]                             # left  border
                buf[o:o + TILE_PX * 4] = row
                buf[o + TILE_PX * 4:o + (TILE_PX + 1) * 4] = row[-4:]  # right border
            top = ((oy - 1) * ATLAS_W + ox - 1) * 4
            first = (oy * ATLAS_W + ox - 1) * 4
            buf[top:top + CELL_PITCH * 4] = buf[first:first + CELL_PITCH * 4]
            bot = ((oy + TILE_PX) * ATLAS_W + ox - 1) * 4
            last = ((oy + TILE_PX - 1) * ATLAS_W + ox - 1) * 4
            buf[bot:bot + CELL_PITCH * 4] = buf[last:last + CELL_PITCH * 4]
        return ATLAS_W, h, bytes(buf)


# --------------------------------------------------------------------------- TDF

def parse_tdf(text: str):
    """TA's brace/key=value format -> nested dict, section names lowercased.

    Tolerant by design: stock content has stray semicolons, comments and the
    occasional unterminated block, and a strict parser would reject real maps.
    """
    text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
    text = re.sub(r"//[^\n]*", " ", text)
    root, stack = {}, []
    cur = root
    for tok in re.finditer(r"\[([^\]]*)\]|([{}])|([^;{}\[\]]+)", text):
        section, brace, body = tok.group(1), tok.group(2), tok.group(3)
        if section is not None:
            child = {}
            cur.setdefault(section.strip().lower(), child)
            pending = cur[section.strip().lower()]
            stack.append((cur, pending))
            continue
        if brace == "{":
            if stack:
                cur = stack[-1][1]
            continue
        if brace == "}":
            if stack:
                cur = stack.pop()[0]
            continue
        if body and "=" in body:
            k, _, v = body.partition("=")
            k = k.strip().lower()
            if k:
                cur[k] = v.strip()
    return root


class FeatureDefs:
    """Every [name] block in features/**/*.tdf, indexed by lowercase name."""

    def __init__(self, assets):
        self.defs = {}
        for path in assets.glob("features/*/*.tdf") + assets.glob("features/*.tdf"):
            try:
                blob = assets.read(path).decode("latin-1")
            except Exception:
                continue
            for name, body in parse_tdf(blob).items():
                if isinstance(body, dict) and body:
                    self.defs.setdefault(name, body)

    def get(self, name):
        return self.defs.get(name.lower())


# --------------------------------------------------------------------------- GAF

def gaf_hotspot(blob, offset):
    """The frame's hotspot — gaf_frame() in ta3do drops it, and features need it."""
    _w, _h, x, y = struct.unpack_from("<HHhh", blob, offset)
    return x, y


class GafBank:
    """anims/*.gaf, resolved by entry name — where feature sprites live."""

    def __init__(self, assets):
        self.assets = assets
        self._index = None

    def index(self):
        if self._index is None:
            self._index = {}
            for path in self.assets.glob("anims/*.gaf"):
                try:
                    blob = self.assets.read(path)
                    for name, off in ta3do.gaf_entries(blob).items():
                        self._index.setdefault(name, (path, off))
                except Exception:
                    continue
        return self._index

    def frame(self, seq):
        hit = self.index().get(seq.upper())
        if not hit:
            return None
        path, off = hit
        blob = self.assets.read(path)
        frame = ta3do.gaf_frame(blob, off)
        hx, hy = gaf_hotspot(blob, off)
        return frame, hx, hy


# --------------------------------------------------------------------------- shaders

# tagpu keeps its GLSL as C string literals with a small #define include system.
# We parse it out rather than keeping a copy: tagpu stays authoritative and the
# browser is provably never stale (tascene-design.md, "Shader sharing").

GLSL_ES_HEADER = ("#version 300 es\n"
                  "precision highp float;\n"
                  "precision highp int;\n"
                  "precision highp sampler2D;\n")


def _unescape(lit: str) -> str:
    return (lit.replace("\\n", "\n").replace("\\t", "\t")
               .replace('\\"', '"').replace("\\\\", "\\"))


def _strip_comments(text: str) -> str:
    return re.sub(r"/\*.*?\*/", " ", text, flags=re.S)


def read_glsl_macros(header: Path):
    """#define NAME [ (ARGS) ] followed by continued "..." literals."""
    text = _strip_comments(header.read_text())
    # rejoin backslash continuations into one logical line per #define
    text = re.sub(r"\\\n", " ", text)
    macros = {}
    # `TAGPU_\w+`, not `TAGPU_GLSL_\w+`: shader bodies also use plain value
    # macros from the same header — `TAGPU_EDGE_NUDGE` ("0.03125", the sub-pixel
    # tile-seam nudge) sits inside terrain VS's `vec2(...)`. Matching only the
    # GLSL_ prefix dropped it and emitted `vec2()`, which does not compile.
    #
    # `[ \t]*` and not `\s+`: a macro body must be on the #define's own line.
    # With `\s+` the guard `#define TAGPU_GLSL_H` (empty body) swallowed the
    # NEXT macro's text, and that macro then silently ceased to exist.
    for m in re.finditer(r"#define[ \t]+(TAGPU_\w+)(\([^)]*\))?[ \t]*(.*)", text):
        name, args, body = m.group(1), m.group(2), m.group(3)
        params = [a.strip() for a in args[1:-1].split(",")] if args else None
        macros[name] = (params, body)
    return macros


def _macro_body(body: str, params, args) -> str:
    """A macro body is string literals interleaved with bare parameter tokens.

    TAGPU_GLSL_FOG_SHADE(I) is written `"...(" I ", 0)..."`, so collecting only
    the quoted runs silently drops the argument — the substitution has to walk
    literals and bare identifiers together.
    """
    out = []
    for tok in re.finditer(r'"(?:[^"\\]|\\.)*"|[A-Za-z_]\w*', body):
        text = tok.group(0)
        if text.startswith('"'):
            out.append(_unescape(text[1:-1]))
        elif params and text in params:
            out.append(args[params.index(text)])
    return "".join(out)


def expand_glsl(body: str, macros) -> str:
    """Concatenate string literals and expand TAGPU_GLSL_* invocations in order."""
    out = []
    i = 0
    for tok in re.finditer(r'"(?:[^"\\]|\\.)*"|TAGPU_\w+(?:\("(?:[^"\\]|\\.)*"\))?', body):
        if tok.start() < i:
            continue
        i = tok.end()
        text = tok.group(0)
        if text.startswith('"'):
            out.append(_unescape(text[1:-1]))
            continue
        name = re.match(r"TAGPU_\w+", text).group(0)
        if name not in macros:
            # never drop it: a silently missing token is a shader that either
            # fails to compile or, worse, compiles and renders subtly wrong
            raise ValueError(f"unknown macro {name} — is it defined outside "
                             "tagpu_glsl.h?")
        params, mbody = macros[name]
        args = []
        if params:
            arg = re.search(r'\("((?:[^"\\]|\\.)*)"\)', text)
            if not arg:
                raise ValueError(f"{name} used without its argument")
            args = [_unescape(arg.group(1))]
        out.append(_macro_body(mbody, params, args))
    return "".join(out)


def extract_shaders(pairs):
    """[(c_source, {glsl_name: c_symbol})] -> {glsl_name: source}, GLSL ES 300."""
    macros = read_glsl_macros(SRC_ROOT / "tagpu/ddraw/src/tagpu_glsl.h")
    out = {}
    for src, wanted in pairs:
        path = SRC_ROOT / "tagpu/ddraw/src" / src
        if not path.exists():
            die(f"no such tagpu source: {path}")
        text = _strip_comments(path.read_text())
        for glsl_name, symbol in wanted.items():
            m = re.search(r"static const char\*\s+" + re.escape(symbol) + r"\s*=(.*?);\s*\n",
                          text, flags=re.S)
            if not m:
                die(f"{src}: cannot find `static const char* {symbol} =`")
            body = expand_glsl(m.group(1), macros)
            if not body.startswith("#version 330 core\n"):
                die(f"{src}:{symbol} does not start with #version 330 core")
            out[glsl_name] = GLSL_ES_HEADER + body[len("#version 330 core\n"):]
    return out


