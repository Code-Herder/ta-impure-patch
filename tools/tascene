from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
SRC_ROOT = HERE.parent               # this checkout — where tagpu's C sources are


def _load_ta3do():
    loader = SourceFileLoader("ta3do", str(HERE / "ta3do"))
    import importlib.util
    spec = importlib.util.spec_from_loader("ta3do", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ta3do = _load_ta3do()


def die(msg):
    print(f"tascene: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------------------- TNT

# §6, VERIFIED against all 275 stock maps (2026-09-03): every block offset is
# predicted exactly by the previous block's size and the header's counts.
#   header      64 bytes, 16 int32 LE
#   mapdata     u16 tile index per 32-px cell, row-major, stride W/2
#   mapattr     4 B per 16-px cell, row-major, stride W:
#                 byte0 = height 0..255, bytes1-2 = u16 feature index, byte3 = 0
#   tilegfx     tiles x 1024 B, 32x32 8bpp
#   tileanim    tileanims x 132 B = int32 + name -- the FEATURE NAME table
#   minimap     int32 w, int32 h, then w*h 8bpp.  Ends the file.

TNT_HDR = "<3i2I I 2i I i I i 4i"
TILE_PX = 32
TILE_BYTES = 0x400
ATLAS_COLS = 64                      # tagpu_terr.c: 64 tiles per atlas row
# THE GUARD RAIL, copied from tagpu_terr.c (CELL_BORDER / CELL_PITCH). Cells sit
# one texel apart and that texel is a COPY of the cell's last row/column. A
# fragment centre landing exactly on a quad's far edge interpolates v to exactly
# v1, and GL_NEAREST resolves that to floor(v1*H) = the first texel of the NEXT
# cell -- the unrelated tile 64 cells later in the atlas, i.e. blue hairlines
# along tile edges. The quad still spans exactly TILE_PX texels, so sampling at
# 1:1 is bit-identical to the un-padded atlas; it is the cases that are NOT 1:1
# that this saves. The parity lane never hit it (its quads are integer-aligned);
# the exploration lane displaces y by relief*h/2, which is a half-pixel whenever
# the height is odd, and the hairlines came straight back.
CELL_BORDER = 1
CELL_PITCH = TILE_PX + 2 * CELL_BORDER   # 34
ATLAS_W = ATLAS_COLS * CELL_PITCH        # 2176


class Tnt:
    def __init__(self, blob: bytes, name: str = ""):
        if len(blob) < 64:
            raise ValueError("TNT shorter than its header")
        (self.version, self.w16, self.h16, self.p_mapdata, self.p_mapattr,
         self.p_tilegfx, self.tiles, self.tileanims, self.p_tileanim,
         self.sealevel, self.p_minimap, self.unknown1,
         *_pad) = struct.unpack_from(TNT_HDR, blob, 0)
        if self.version not in (0x2000, 0x1020):
            raise ValueError(f"unknown TNT version 0x{self.version:X}")
        if self.version != 0x2000:
            raise ValueError("legacy TNT (0x1020) not implemented")
        self.blob = blob
        self.name = name
        self.mw = self.w16 // 2          # map width in 32-px cells
        self.mh = self.h16 // 2
        self.check()

    def check(self):
        """The arithmetic that verified the format; a mismatch means we misread."""
        md = self.mw * self.mh * 2
        for got, want, what in (
            (self.p_mapdata, 64, "mapdata"),
            (self.p_tilegfx, self.p_mapattr + self.w16 * self.h16 * 4, "tilegfx"),
            (self.p_tileanim, self.p_tilegfx + self.tiles * TILE_BYTES, "tileanim"),
            (self.p_minimap, self.p_tileanim + self.tileanims * 132, "minimap"),
        ):
            if got != want:
                raise ValueError(f"{self.name}: {what} at {got}, expected {want}")
        if not (self.p_mapdata + md <= self.p_mapattr <= self.p_mapdata + md + 15):
            raise ValueError(f"{self.name}: mapattr {self.p_mapattr} not just past mapdata")

    def tilemap(self) -> bytes:
        """u16 per 32-px cell, row-major, stride self.mw."""
        return self.blob[self.p_mapdata:self.p_mapdata + self.mw * self.mh * 2]

    def heights(self) -> bytes:
        """byte per 16-px cell, row-major, stride self.w16 — mapattr byte 0."""
        a = self.blob[self.p_mapattr:self.p_mapattr + self.w16 * self.h16 * 4]
        return bytes(a[0::4])

    def feature_indices(self):
        """(col, row, u16 def index) for every 16-px cell that anchors a feature."""
        a = self.blob[self.p_mapattr:self.p_mapattr + self.w16 * self.h16 * 4]
        out = []
        for i in range(self.w16 * self.h16):
            idx = a[i * 4 + 1] | (a[i * 4 + 2] << 8)
            if idx < 0xFFFB:
                out.append((i % self.w16, i // self.w16, idx))
        return out

    def feature_names(self):
        """The tileanim block: the map's own feature name table."""
        names = []
        for i in range(self.tileanims):
            rec = self.blob[self.p_tileanim + i * 132: self.p_tileanim + (i + 1) * 132]
            names.append(rec[4:].split(b"\0")[0].decode("latin-1"))
        return names

    def atlas(self):
        """One R8 atlas of 34x34 guarded cells, 64 per row — tagpu_terr.c's layout."""
        rows = (self.tiles + ATLAS_COLS - 1) // ATLAS_COLS
        h = rows * CELL_PITCH
        buf = bytearray(ATLAS_W * h)
        for i in range(self.tiles):
            src = self.p_tilegfx + i * TILE_BYTES
            ox = (i % ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            oy = (i // ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            for r in range(TILE_PX):
                row = self.blob[src + r * TILE_PX: src + (r + 1) * TILE_PX]
                o = (oy + r) * ATLAS_W + ox
                buf[o - 1] = row[0]                       # left  border column
                buf[o:o + TILE_PX] = row
                buf[o + TILE_PX] = row[TILE_PX - 1]       # right border column
            top = (oy - 1) * ATLAS_W + ox - 1
            first = (oy) * ATLAS_W + ox - 1
            buf[top:top + CELL_PITCH] = buf[first:first + CELL_PITCH]
            bot = (oy + TILE_PX) * ATLAS_W + ox - 1
            last = (oy + TILE_PX - 1) * ATLAS_W + ox - 1
            buf[bot:bot + CELL_PITCH] = buf[last:last + CELL_PITCH]
        return ATLAS_W, h, bytes(buf)

    def minimap(self):
        w, h = struct.unpack_from("<2i", self.blob, self.p_minimap)
        px = self.blob[self.p_minimap + 8: self.p_minimap + 8 + w * h]
        return w, h, px

    def tile_frames(self):
        """{index: GafFrame} — the tiles as the unditherer wants them, one 32x32
        image each. Per-tile is the whole story: a tile restored in isolation
        differs from the same tile restored inside a 3x3 patch of its real map
        neighbours by 2.03/255 on the edge ring and 0.45/255 inside it, so there
        is deliberately no neighbour-context machinery here (tascene-design.md).
        """
        out = {}
        for i in range(self.tiles):
            src = self.p_tilegfx + i * TILE_BYTES
            out[i] = ta3do.GafFrame(TILE_PX, TILE_PX,
                                    bytearray(self.blob[src:src + TILE_BYTES]), None)
        return out

    def atlas_rgba(self, restored):
        """The same guarded layout as atlas(), painted from restored true colour."""
        rows = (self.tiles + ATLAS_COLS - 1) // ATLAS_COLS
        h = rows * CELL_PITCH
        buf = bytearray(ATLAS_W * h * 4)
        for i in range(self.tiles):
            got = restored.get(i)
            if not got:
                continue
            _w, _h, px = got
            ox = (i % ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            oy = (i // ATLAS_COLS) * CELL_PITCH + CELL_BORDER
            for r in range(TILE_PX):
                row = px[r * TILE_PX * 4:(r + 1) * TILE_PX * 4]
                o = ((oy + r) * ATLAS_W + ox) * 4
                buf[o - 4:o] = row[0:4]                             # left  border
                buf[o:o + TILE_PX * 4] = row
                buf[o + TILE_PX * 4:o + (TILE_PX + 1) * 4] = row[-4:]  # right border
            top = ((oy - 1) * ATLAS_W + ox - 1) * 4
            first = (oy * ATLAS_W + ox - 1) * 4
            buf[top:top + CELL_PITCH * 4] = buf[first:first + CELL_PITCH * 4]
            bot = ((oy + TILE_PX) * ATLAS_W + ox - 1) * 4
            last = ((oy + TILE_PX - 1) * ATLAS_W + ox - 1) * 4
            buf[bot:bot + CELL_PITCH * 4] = buf[last:last + CELL_PITCH * 4]
        return ATLAS_W, h, bytes(buf)


# --------------------------------------------------------------------------- TDF

def parse_tdf(text: str):
    """TA's brace/key=value format -> nested dict, section names lowercased.

    Tolerant by design: stock content has stray semicolons, comments and the
    occasional unterminated block, and a strict parser would reject real maps.
    """
    text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
    text = re.sub(r"//[^\n]*", " ", text)
    root, stack = {}, []
    cur = root
    for tok in re.finditer(r"\[([^\]]*)\]|([{}])|([^;{}\[\]]+)", text):
        section, brace, body = tok.group(1), tok.group(2), tok.group(3)
        if section is not None:
            child = {}
            cur.setdefault(section.strip().lower(), child)
            pending = cur[section.strip().lower()]
            stack.append((cur, pending))
            continue
        if brace == "{":
            if stack:
                cur = stack[-1][1]
            continue
        if brace == "}":
            if stack:
                cur = stack.pop()[0]
            continue
        if body and "=" in body:
            k, _, v = body.partition("=")
            k = k.strip().lower()
            if k:
                cur[k] = v.strip()
    return root


class FeatureDefs:
    """Every [name] block in features/**/*.tdf, indexed by lowercase name."""

    def __init__(self, assets):
        self.defs = {}
        for path in assets.glob("features/*/*.tdf") + assets.glob("features/*.tdf"):
            try:
                blob = assets.read(path).decode("latin-1")
            except Exception:
                continue
            for name, body in parse_tdf(blob).items():
                if isinstance(body, dict) and body:
                    self.defs.setdefault(name, body)

    def get(self, name):
        return self.defs.get(name.lower())


# --------------------------------------------------------------------------- GAF

def gaf_hotspot(blob, offset):
    """The frame's hotspot — gaf_frame() in ta3do drops it, and features need it."""
    _w, _h, x, y = struct.unpack_from("<HHhh", blob, offset)
    return x, y


class GafBank:
    """anims/*.gaf, resolved by entry name — where feature sprites live."""

    def __init__(self, assets):
        self.assets = assets
        self._index = None

    def index(self):
        if self._index is None:
            self._index = {}
            for path in self.assets.glob("anims/*.gaf"):
                try:
                    blob = self.assets.read(path)
                    for name, off in ta3do.gaf_entries(blob).items():
                        self._index.setdefault(name, (path, off))
                except Exception:
                    continue
        return self._index

    def frame(self, seq):
        hit = self.index().get(seq.upper())
        if not hit:
            return None
        path, off = hit
        blob = self.assets.read(path)
        frame = ta3do.gaf_frame(blob, off)
        hx, hy = gaf_hotspot(blob, off)
        return frame, hx, hy


# --------------------------------------------------------------------------- shaders

# tagpu keeps its GLSL as C string literals with a small #define include system.
# We parse it out rather than keeping a copy: tagpu stays authoritative and the
# browser is provably never stale (tascene-design.md, "Shader sharing").

GLSL_ES_HEADER = ("#version 300 es\n"
                  "precision highp float;\n"
                  "precision highp int;\n"
                  "precision highp sampler2D;\n"
                  "precision highp sampler2DShadow;\n")   # the Classic++ shadow map's compare view (G14i)


def _unescape(lit: str) -> str:
    return (lit.replace("\\n", "\n").replace("\\t", "\t")
               .replace('\\"', '"').replace("\\\\", "\\"))


def _strip_comments(text: str) -> str:
    return re.sub(r"/\*.*?\*/", " ", text, flags=re.S)


def read_glsl_macros(header: Path):
    """#define NAME [ (ARGS) ] followed by continued "..." literals."""
    text = _strip_comments(header.read_text())
    # rejoin backslash continuations into one logical line per #define
    text = re.sub(r"\\\n", " ", text)
    macros = {}
    # `TAGPU_\w+`, not `TAGPU_GLSL_\w+`: shader bodies also use plain value
    # macros from the same header — `TAGPU_EDGE_NUDGE` ("0.03125", the sub-pixel
    # tile-seam nudge) sits inside terrain VS's `vec2(...)`. Matching only the
    # GLSL_ prefix dropped it and emitted `vec2()`, which does not compile.
    #
    # `[ \t]*` and not `\s+`: a macro body must be on the #define's own line.
    # With `\s+` the guard `#define TAGPU_GLSL_H` (empty body) swallowed the
    # NEXT macro's text, and that macro then silently ceased to exist.
    for m in re.finditer(r"#define[ \t]+(TAGPU_\w+)(\([^)]*\))?[ \t]*(.*)", text):
        name, args, body = m.group(1), m.group(2), m.group(3)
        params = [a.strip() for a in args[1:-1].split(",")] if args else None
        macros[name] = (params, body)
    return macros


def _macro_body(body: str, params, args) -> str:
    """A macro body is string literals interleaved with bare parameter tokens.

    TAGPU_GLSL_FOG_SHADE(I) is written `"...(" I ", 0)..."`, so collecting only
    the quoted runs silently drops the argument — the substitution has to walk
    literals and bare identifiers together.
    """
    out = []
    for tok in re.finditer(r'"(?:[^"\\]|\\.)*"|[A-Za-z_]\w*', body):
        text = tok.group(0)
        if text.startswith('"'):
            out.append(_unescape(text[1:-1]))
        elif params and text in params:
            out.append(args[params.index(text)])
    return "".join(out)


def expand_glsl(body: str, macros) -> str:
    """Concatenate string literals and expand TAGPU_GLSL_* invocations in order."""
    out = []
    i = 0
    for tok in re.finditer(r'"(?:[^"\\]|\\.)*"|TAGPU_\w+(?:\("(?:[^"\\]|\\.)*"\))?', body):
        if tok.start() < i:
            continue
        i = tok.end()
        text = tok.group(0)
        if text.startswith('"'):
            out.append(_unescape(text[1:-1]))
            continue
        name = re.match(r"TAGPU_\w+", text).group(0)
        if name not in macros:
            # never drop it: a silently missing token is a shader that either
            # fails to compile or, worse, compiles and renders subtly wrong
            raise ValueError(f"unknown macro {name} — is it defined outside "
                             "tagpu_glsl.h?")
        params, mbody = macros[name]
        args = []
        if params:
            arg = re.search(r'\("((?:[^"\\]|\\.)*)"\)', text)
            if not arg:
                raise ValueError(f"{name} used without its argument")
            args = [_unescape(arg.group(1))]
        out.append(_macro_body(mbody, params, args))
    return "".join(out)


def extract_shaders(pairs):
    """[(c_source, {glsl_name: c_symbol})] -> {glsl_name: source}, GLSL ES 300."""
    macros = read_glsl_macros(SRC_ROOT / "tagpu/ddraw/src/tagpu_glsl.h")
    out = {}
    for src, wanted in pairs:
        path = SRC_ROOT / "tagpu/ddraw/src" / src
        if not path.exists():
            die(f"no such tagpu source: {path}")
        text = _strip_comments(path.read_text())
        for glsl_name, symbol in wanted.items():
            m = re.search(r"static const char\*\s+" + re.escape(symbol) + r"\s*=(.*?);\s*\n",
                          text, flags=re.S)
            if not m:
                die(f"{src}: cannot find `static const char* {symbol} =`")
            body = expand_glsl(m.group(1), macros)
            if not body.startswith("#version 330 core\n"):
                die(f"{src}:{symbol} does not start with #version 330 core")
            out[glsl_name] = GLSL_ES_HEADER + body[len("#version 330 core\n"):]
    return out


SHADER_SET = [("tagpu_terr.c", {"terrain.vert": "VS", "terrain.frag": "FS"}),
              ("tagpu_feat.c", {"sprite.vert": "VS", "sprite.frag": "FS"}),
              ("tagpu_native.c", {"unit.vert": "VS", "unit.frag": "FS"})]

# The GLSL restorer's shaders (renderers.md 4c) live as macros in their own
# header, with no #version line: the DLL prefixes "#version 330 core" and the
# lab "#version 300 es" plus the NK/WMAX defines, and the body is the same
# bytes on both sides -- that is the whole point of extracting rather than
# copying (tascene-restore.js is the driver, not a second shader).
RESTORE_HEADER = "tagpu_restore_glsl.h"
RESTORE_SHADERS = {"restore_fs.vert": "TAGPU_RESTORE_FS_VS",
                   "restore_fill.frag": "TAGPU_RESTORE_FILL_FS",
                   "restore_conv.frag": "TAGPU_RESTORE_CONV_FS",
                   "restore_out.vert": "TAGPU_RESTORE_OUT_VS",
                   "restore_out.frag": "TAGPU_RESTORE_OUT_FS"}
RESTORE_MODELS = ("full", "tiny")


def extract_restore_shaders():
    """{glsl_name: body} from tagpu_restore_glsl.h, bodies without a #version."""
    header = SRC_ROOT / "tagpu/ddraw/src" / RESTORE_HEADER
    if not header.exists():
        die(f"no such tagpu header: {header}")
    macros = read_glsl_macros(header)
    out = {}
    for glsl_name, symbol in RESTORE_SHADERS.items():
        if symbol not in macros:
            die(f"{RESTORE_HEADER}: no macro {symbol}")
        params, body = macros[symbol]
        text = _macro_body(body, params, [])
        if not text.strip():
            die(f"{RESTORE_HEADER}: {symbol} is empty")
        out[glsl_name] = text
    return out


def restore_weights():
    """{model: path} of the shipped weight files (unditherer export-weights)."""
    found = {}
    for name in RESTORE_MODELS:
        path = SRC_ROOT / "unditherer/models" / f"{name}.w32.bin"
        if path.exists():
            found[name] = path
    return found


# --------------------------------------------------------------------------- undither

# The exploration lane's textures. `ta3do.undither_frames` already drives the
# unditherer's CLI (indexed PNG in, restored true-colour PNG out, one process
# for a whole batch because loading the CNN costs far more than running it on a
# 32x32 texture) — this is the cache and the batching around it.
#
# WHY A CACHE: the largest stock map is 5062 tiles at ~19 ms each, i.e. ~1.6
# min, and a pack gets rebuilt every time the eye moves. The key is the frame's
# own CONTENT plus the preset and the palette, not (map, preset): tiles recur
# between maps and between builds, and a content key cannot go stale.

CACHE_ENV = "TASCENE_CACHE"
UNDITHER_BATCH = 256                  # frames per unditherer process
# TSU2 since 2026-09-05: TSU1 entries were restored by torch on CUDA with
# cuDNN's default TF32 convolutions, which differ from fp32 by one level on
# ~0.6 % of bytes (unditherer/infer.py); bumping the magic makes them misses.
CACHE_MAGIC = b"TSU2"


def cache_root(explicit=None) -> Path:
    if explicit:
        return Path(explicit).expanduser()
    env = os.environ.get(CACHE_ENV)
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")
    return Path(base) / "tascene" / "undither"


def _cache_key(frame, palette, preset) -> str:
    h = hashlib.sha256()
    h.update(preset.encode())
    h.update(struct.pack("<3i", frame.width, frame.height,
                         -1 if frame.transparent is None else frame.transparent))
    h.update(bytes(frame.pixels))
    for entry in palette:
        h.update(bytes(entry[:3]))
    return h.hexdigest()


def _cache_read(path: Path):
    try:
        blob = path.read_bytes()
    except OSError:
        return None
    if len(blob) < 8 or blob[:4] != CACHE_MAGIC:
        return None
    w, h = struct.unpack_from("<2H", blob, 4)
    rgba = blob[8:]
    if len(rgba) != w * h * 4:
        return None                     # a truncated write: treat it as a miss
    return (w, h, rgba)


def _cache_write(path: Path, got):
    w, h, rgba = got
    tmp = path.with_suffix(".part")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_bytes(CACHE_MAGIC + struct.pack("<2H", w, h) + rgba)
        tmp.replace(path)               # atomic: two builds can share one cache
    except OSError:
        pass                            # a cache that cannot be written is not fatal


def undither(frames, palette, preset, cdir: Path, python=None, tally=None):
    """{key: GafFrame} -> {key: (w, h, RGBA bytes)}, cached on disk by content."""
    if not frames:
        return {}
    keys = {k: _cache_key(f, palette, preset) for k, f in frames.items()}
    out, todo = {}, {}
    for k, digest in keys.items():
        got = _cache_read(cdir / preset / digest[:2] / f"{digest}.bin")
        if got:
            out[k] = got
        else:
            todo[k] = frames[k]
    if tally is not None:
        tally["frames"] = tally.get("frames", 0) + len(frames)
        tally["cached"] = tally.get("cached", 0) + len(out)
    order = sorted(todo)
    for i in range(0, len(order), UNDITHER_BATCH):
        batch = {k: todo[k] for k in order[i:i + UNDITHER_BATCH]}
        # the keys become filenames inside undither_frames, so give it strings
        # that survive its own sanitiser without colliding
        tags = {f"f{n:05d}": k for n, k in enumerate(batch)}
        got = ta3do.undither_frames({t: batch[k] for t, k in tags.items()},
                                    palette, preset=preset, python=python)
        for tag, k in tags.items():
            out[k] = got[tag]
            _cache_write(cdir / preset / keys[k][:2] / f"{keys[k]}.bin", got[tag])
    return out


# --------------------------------------------------------------------------- features

# terrain-depth.md 3 / tagpu_feat.c: one anchor per 16-px cell, drawn as a GAF
# sprite at the engine's projection with the frame's hotspot subtracted. The
# def's `height` is the tall-vs-flat sort class (< 10 = flat), and animtrans /
# shadtrans are the alpha bits the engine's FeatureDef mask carries.

# The unit atlas is padded so the exploration lane can MIPMAP it: every frame
# gets a replicated border of UNIT_PAD texels and its allocation is aligned to
# UNIT_PAD, so a mip texel at level L <= log2(UNIT_PAD) that touches a frame is
# made only of that frame's own texels. The viewer clamps TEXTURE_MAX_LOD to
# match. Parity never reads outside a frame (NEAREST, UVs on the frame), so the
# padding changes nothing there — the ss=1 fixture md5 is the proof.
UNIT_PAD = 4


def shelf_pack(frames, width=2048, pad=0, align=1):
    """Height-sorted shelf packer -> {key: (x, y)} and the atlas height. With
    `pad` the allocation carries a border and (x, y) is the frame's own origin
    inside it; `align` rounds every allocation up to a multiple."""
    up = lambda v: -(-v // align) * align
    order = sorted(frames, key=lambda k: -frames[k].height)
    place, x, y, shelf = {}, 0, 0, 0
    for key in order:
        f = frames[key]
        w, h = up(f.width + 2 * pad), up(f.height + 2 * pad)
        if w > width:
            continue
        if x + w > width:
            x, y, shelf = 0, y + shelf, 0
        place[key] = (x + pad, y + pad)
        x += w
        shelf = max(shelf, h)
    return place, y + shelf


def blit_frame(dst, aw, bpp, x, y, w, h, row, pad=0):
    """Paint one frame at (x, y) with `pad` replicated border texels around it.
    `row(r)` is the frame's row r as bytes, w*bpp long."""
    for r in range(-pad, h + pad):
        src = row(min(max(r, 0), h - 1))
        line = src[:bpp] * pad + src + src[-bpp:] * pad
        o = ((y + r) * aw + x - pad) * bpp
        dst[o:o + len(line)] = line


def paint_rgba(frames, place, aw, ah, restore, path: Path, pad=0):
    """The R8 atlas's layout, painted from restored true colour. None if off.

    The restorer keeps the colour key's alpha (it inpaints the key index before
    filtering and writes RGBA), so the undithered lane gets its holes for free
    and does not need the index compare the parity shaders do.
    """
    if restore is None or not frames:
        return None
    restored = restore(frames)
    buf = bytearray(aw * ah * 4)
    for key, (x, y) in place.items():
        got = restored.get(key)
        if not got:
            continue
        w, h, px = got
        blit_frame(buf, aw, 4, x, y, w, h, lambda r: px[r * w * 4:(r + 1) * w * 4], pad)
    path.write_bytes(bytes(buf))
    return str(path.relative_to(path.parent.parent)).replace(os.sep, "/")


def build_features(tnt, defs, gafs, out, restore=None, scenario=None):
    """Every feature the map anchors, plus the scenario's GAF ones: sprite
    atlas, instance list, def table. A scenario feature whose def names an
    `object` instead of a `seqname` is a 3DO (every wreck is) and is drawn by
    build_units, exactly as the engine hands it to its 3DO renderer."""
    names = tnt.feature_names()
    anchors = list(tnt.feature_indices())
    used = {}                                  # def index -> name
    for _col, _row, idx in anchors:
        if idx < len(names):
            used.setdefault(idx, names[idx])
    # the scenario's sprite features anchor at their cell, like the map's own;
    # a def the map's table does not carry gets an index past its end
    lower = {n.lower(): i for i, n in enumerate(names)}
    for feat in (scenario or {}).get("features", []):
        name = (feat.get("type") or "").lower()
        body = defs.get(name)
        if not body or not isinstance(feat.get("pos"), list):
            continue
        if not (body.get("seqname") or "").strip():
            continue                           # a 3DO feature: build_units draws it
        idx = lower.get(name)
        if idx is None:
            idx = lower[name] = len(lower)
        used.setdefault(idx, name)
        anchors.append((int(feat["pos"][0]) >> 4, int(feat["pos"][1]) >> 4, idx))

    frames, hotspots, table = {}, {}, {}
    for idx, name in sorted(used.items()):
        body = defs.get(name)
        entry = {"name": name, "height": 0, "footx": 1, "footz": 1,
                 "body": None, "shadow": None, "animtrans": 0, "shadtrans": 0}
        if body:
            entry["height"] = int(float(body.get("height", 0) or 0))
            entry["footx"] = int(float(body.get("footprintx", 1) or 1))
            entry["footz"] = int(float(body.get("footprintz", 1) or 1))
            entry["animtrans"] = 1 if body.get("animtrans", "0").strip() == "1" else 0
            entry["shadtrans"] = 1 if body.get("shadtrans", "0").strip() == "1" else 0
            for slot, key in (("body", "seqname"), ("shadow", "seqnameshad")):
                seq = (body.get(key) or "").strip()
                if not seq:
                    continue
                got = gafs.frame(seq)
                if not got:
                    continue
                frame, hx, hy = got
                frames[seq.upper()] = frame
                hotspots[seq.upper()] = (hx, hy)
                entry[slot] = seq.upper()
        entry["flat"] = 1 if entry["height"] < 10 else 0
        table[idx] = entry

    place, ah = shelf_pack(frames)
    aw = 2048 if frames else 1
    ah = max(1, ah)
    atlas = bytearray(aw * ah)
    rects = {}
    for key, (x, y) in place.items():
        f = frames[key]
        for r in range(f.height):
            o = (y + r) * aw + x
            atlas[o:o + f.width] = f.pixels[r * f.width:(r + 1) * f.width]
        hx, hy = hotspots[key]
        rects[key] = {"x": x, "y": y, "w": f.width, "h": f.height,
                      "hx": hx, "hy": hy, "ck": f.transparent}

    (out / "features").mkdir(parents=True, exist_ok=True)
    (out / "features/atlas.r8.bin").write_bytes(bytes(atlas))
    rgba_file = paint_rgba(frames, place, aw, ah, restore,
                           out / "features/atlas.rgba.bin")
    inst = bytearray()
    kept = 0
    for col, row, idx in anchors:
        entry = table.get(idx)
        if not entry or (entry["body"] is None and entry["shadow"] is None):
            continue
        inst += struct.pack("<3H", col, row, idx)
        kept += 1
    (out / "features/instances.bin").write_bytes(bytes(inst))

    defs_out = {}
    for idx, entry in table.items():
        if entry["body"] is None and entry["shadow"] is None:
            continue
        defs_out[str(idx)] = {
            "name": entry["name"], "height": entry["height"], "flat": entry["flat"],
            "footx": entry["footx"], "footz": entry["footz"],
            "animtrans": entry["animtrans"], "shadtrans": entry["shadtrans"],
            "body": rects.get(entry["body"]), "shadow": rects.get(entry["shadow"]),
        }
    return {"count": kept, "instances": "features/instances.bin",
            "atlas": {"w": aw, "h": ah, "file": "features/atlas.r8.bin",
                      "rgba": rgba_file},
            "defs": defs_out}


# --------------------------------------------------------------------------- shade

# tagpu_render3do.c calibrates the engine's PALETTE.SHD rather than assuming:
# neutral is the row with the most identity entries, and the direction (which
# way along the table is *brighter*) comes from end-row luminance.

SH_ROWS = 32


def shd_neutral(shd: bytes, palette):
    best_row, best_n = 0, -1
    for r in range(SH_ROWS):
        n = sum(1 for i in range(256) if shd[r * 256 + i] == i)
        if n > best_n:
            best_row, best_n = r, n
    lum0 = sum(sum(palette[shd[i]][:3]) for i in range(256))
    lum31 = sum(sum(palette[shd[31 * 256 + i]][:3]) for i in range(256))
    return [best_row, 1 if lum31 >= lum0 else -1]


# --------------------------------------------------------------------------- units

# Bind pose only, by design (tascene-design.md): offline there is no COB VM, so
# pieces sit at their *FromParent offsets with the unit's own yaw applied in the
# viewer. What the engine hides at Create is honoured -- ta3do already scans the
# script for it, and without that a unit renders with its muzzle flares stuck on.
#
# The mesh is stored in MODEL space, not screen space, because tagpu's per-face
# shade row is computed from the POSED normal: rotating first and shading after
# is the only order that gives the same LUT row the engine's own pass would.

UNIT_VSTRIDE = 7                       # x,y,z, u,v, flatCol, colourKey


def feature_object(defs, feat):
    """The 3DO a scenario feature is drawn with (a wreck's `object=`), or None."""
    body = defs.get(feat.get("type") or "") if defs else None
    obj = ((body or {}).get("object") or "").strip().lower()
    return obj or None


def unit_facts(assets, key, cache):
    """The engine's shadow branch, its gate and the cruise altitude, from the FBI.

    `shadows-cloak.md` §3: a completed MOBILE unit gets the silhouette drop
    shadow unless its FBI says `noshadow`, `canhover` or `floater`; a STRUCTURE
    (`slant`) takes the engine's cached slant projection, gated by `noshadow`
    alone -- that branch tests neither `canhover` nor `floater` -- except a
    `digger` structure, which the engine sends down the silhouette branch.
    `BMcode` is TA's own mobile flag and stands in for the engine's runtime
    `0x20000000` structure bit: checked on the fixtures, ARMSOLAR and ARMMEX
    read 0, ARMCOM and ARMPW read 1.

    `agl` is how far off the ground the unit sits. Aircraft are the only units
    with one, and it is the FBI's own `CruiseAlt` -- ARMFIG 110, ARMTHUND 200,
    ARMPEEP 180, ARMATLAS 90, ARMBRAWL 60. Measured in the game the same day,
    a patrolling Freedom Fighter reads altitude 198-240 over ground 67-84, so
    ground + CruiseAlt is the right still-frame model for a lab that has no
    flight dynamics.
    """
    if key in cache:
        return cache[key]
    try:
        fbi = ta3do.fbi_fields(assets, key)
    except Exception:
        fbi = {}

    def flag(name):
        return (fbi.get(name, "0") or "0").strip() not in ("", "0")

    mobile = (fbi.get("bmcode", "1") or "1").strip() != "0"
    try:
        cruise = int(float((fbi.get("cruisealt", "0") or "0").strip()))
    except ValueError:
        cruise = 0
    slant = not mobile and not flag("digger")
    fact = {"shadow": bool(not flag("noshadow") and
                           (slant or (not flag("canhover") and not flag("floater")))),
            "slant": slant,
            "agl": cruise if flag("canfly") else 0}
    cache[key] = fact
    return fact


def build_units(scenario, assets, out, restore=None, defs=None):
    types = []
    for unit in scenario.get("units", []):
        if unit.get("type") and unit["type"].lower() not in types:
            types.append(unit["type"].lower())
    for group in scenario.get("groups", []):
        for comp in group.get("composition", []):
            if comp.get("type") and comp["type"].lower() not in types:
                types.append(comp["type"].lower())
    # 3DO features (wrecks) ride the unit path: same models3d/ 3DOs, same
    # renderer in the engine, posed by their facing and snapped to the ground
    for feat in scenario.get("features", []):
        obj = feature_object(defs, feat)
        if obj and obj not in types:
            types.append(obj)
    if not types:
        return None

    bank = ta3do.TextureBank(assets)
    models, frames = {}, {}
    for name in types:
        try:
            label, blob = ta3do.resolve_model(assets, name)
            root = ta3do.parse_3do(blob)
        except SystemExit:
            continue
        except Exception:
            continue
        hidden = {h.lower() for h in ta3do.script_hidden(assets, label) or ()}
        # the pieces the script marks dont-cache at Create: visible, but they
        # cast no structure shadow (the engine's flag bit1, `slant` below)
        uncached = {h.lower() for h in ta3do.script_dontcache(assets, label) or ()}
        models[name] = (label, root, hidden, uncached)
        for key, frame in ta3do.model_textures(root, bank).items():
            frames.setdefault(key, frame)

    if not models:
        return None

    place, ah = shelf_pack(frames, pad=UNIT_PAD, align=UNIT_PAD)
    aw, ah = (2048 if frames else 1), max(1, ah)
    atlas = bytearray(aw * ah)
    rects = {}
    for key, (x, y) in place.items():
        f = frames[key]
        blit_frame(atlas, aw, 1, x, y, f.width, f.height,
                   lambda r, f=f: f.pixels[r * f.width:(r + 1) * f.width], UNIT_PAD)
        rects[key] = (x / aw, y / ah, (x + f.width) / aw, (y + f.height) / ah,
                      f.transparent)

    (out / "units").mkdir(parents=True, exist_ok=True)
    (out / "units/atlas.r8.bin").write_bytes(bytes(atlas))
    rgba_file = paint_rgba(frames, place, aw, ah, restore,
                           out / "units/atlas.rgba.bin", UNIT_PAD)

    meshes = {}
    for name, (label, root, hidden, uncached) in models.items():
        verts = []
        slant = []
        stats = {"pieces": 0, "faces": 0, "tris": 0, "textured": 0, "flat": 0,
                 "slantTris": 0}

        def emit(piece, ox, oy, oz):
            px, py, pz = ox + piece.offset[0], oy + piece.offset[1], oz + piece.offset[2]
            if piece.name.lower() not in hidden:
                stats["pieces"] += 1
                # THE STRUCTURE SHADOW'S CASTERS, by the engine's own raster
                # (`0x45A610`, shadows-cloak.md 3): a piece with its visible and
                # cached bits, EVERY face of it -- no material, no quad rule,
                # no texture key -- and only face 0 skipped, when the piece
                # has a selection primitive. Model space; the viewer projects
                # (x + y/4, -z - y/4) with the engine's integer snapping.
                if piece.name.lower() not in uncached:
                    for i, prim in enumerate(piece.primitives):
                        if (i == 0 and piece.sel_prim != -1) or len(prim.indices) < 3:
                            continue
                        n = len(prim.indices)
                        for k in range(1, n - 1):
                            slots = (0, k, k + 1)
                            if any(prim.indices[s] >= len(piece.vertices) for s in slots):
                                continue
                            for slot in slots:
                                vx, vy, vz = piece.vertices[prim.indices[slot]]
                                slant.extend((px + vx, py + vy, pz + vz))
                            stats["slantTris"] += 1
                for prim in piece.primitives:
                    if prim.is_selection or len(prim.indices) < 3:
                        continue
                    rect = rects.get(prim.texture.upper()) if prim.texture else None
                    if rect is None and prim.texture:
                        continue                   # named a texture we cannot resolve
                    flat = None
                    if rect is None:
                        flat = (prim.color & 0xFF) / 255.0
                    stats["faces"] += 1
                    stats["textured" if rect else "flat"] += 1
                    n = len(prim.indices)
                    for k in range(1, n - 1):        # fan from vertex 0 (§1.4)
                        slots = (0, k, k + 1)
                        if any(prim.indices[s] >= len(piece.vertices) for s in slots):
                            continue
                        for slot in slots:
                            vx, vy, vz = piece.vertices[prim.indices[slot]]
                            if rect:
                                # the engine maps a whole GAF frame across the
                                # face's four corners; n-gons collapse onto them
                                c = slot if n <= 4 else slot * 4 // n
                                u = rect[2] if c in (1, 2) else rect[0]
                                v = rect[3] if c >= 2 else rect[1]
                                verts.extend((px + vx, py + vy, pz + vz,
                                              u, v, 0.0, rect[4] / 255.0))
                            else:
                                verts.extend((px + vx, py + vy, pz + vz,
                                              -1.0, -1.0, flat, -1.0))
                        stats["tris"] += 1
            for child in piece.children:
                emit(child, px, py, pz)

        emit(root, 0.0, 0.0, 0.0)
        blob = struct.pack(f"<{len(verts)}f", *verts)
        (out / f"units/{name}.bin").write_bytes(blob)
        (out / f"units/{name}.slant.bin").write_bytes(struct.pack(f"<{len(slant)}f", *slant))
        meshes[name] = {"file": f"units/{name}.bin", "verts": len(verts) // UNIT_VSTRIDE,
                        "slant": {"file": f"units/{name}.slant.bin", "verts": len(slant) // 3},
                        "label": label, "stats": stats}

    instances = []
    fbi_cache = {}
    for unit in scenario.get("units", []):
        key = (unit.get("type") or "").lower()
        if key not in meshes or not isinstance(unit.get("pos"), list):
            continue
        f = unit_facts(assets, key, fbi_cache)
        inst = {"type": key, "pos": [int(unit["pos"][0]), int(unit["pos"][1])],
                "facing": float(unit.get("facing", 0) or 0),
                "id": unit.get("id"), "shadow": f["shadow"], "slant": f["slant"],
                "agl": f["agl"]}
        # a scenario `height` is an ABSOLUTE altitude and the lab snaps to the
        # terrain it has, so hand the number over and let the viewer subtract
        # the ground under the unit -- the builder never reads the height map
        if isinstance(unit.get("height"), (int, float)):
            inst["alt"] = int(unit["height"])
        instances.append(inst)
    for feat in scenario.get("features", []):
        obj = feature_object(defs, feat)
        if obj not in meshes or not isinstance(feat.get("pos"), list):
            continue
        # a 3DO wreck keeps the ENGINE's FShadow feature shadow, which is in the
        # feature's own frames; the native pass draws it none (shadows-cloak.md
        # "What our GL renderer must do"), so neither does the lab
        instances.append({"type": obj, "pos": [int(feat["pos"][0]), int(feat["pos"][1])],
                          "facing": float(feat.get("facing", 0) or 0),
                          "id": feat.get("id"), "feature": feat.get("type"),
                          "shadow": False, "slant": False, "agl": 0})
    # every frame's own rect (inside its pad) and colour key, so `tascene
    # unitdiff` can find the DLL's dumped twin entries in this atlas
    frame_rects = {key: {"x": x, "y": y, "w": frames[key].width, "h": frames[key].height,
                         "key": -1 if frames[key].transparent is None else frames[key].transparent}
                   for key, (x, y) in place.items()}
    return {"atlas": {"w": aw, "h": ah, "file": "units/atlas.r8.bin",
                      "rgba": rgba_file, "pad": UNIT_PAD, "frames": frame_rects},
            "stride": UNIT_VSTRIDE, "meshes": meshes, "instances": instances}


# --------------------------------------------------------------------------- art light

# "The art already contains the hill" was the exploration lane's open question
# (tascene-design.md). This answers it with a number instead of an opinion.
#
# For every 16-px cell steeper than `--steep`, correlate the mean luminance of
# the tile quadrant PAINTED there against the N.L that quadrant's own gradient
# would receive, sweeping the sun's azimuth. A directional signal (the art was
# painted lit) shows up as the AMPLITUDE of the resulting sinusoid; a material
# confound -- steep cells simply being painted with darker rock -- shifts its
# OFFSET instead, so the two separate.

REC709 = (0.2126, 0.7152, 0.0722)


def _tile_quadrant_luma(tnt, palette):
    """[tile][quadrant] -> mean luminance, quadrants (row&1)*2 + (col&1)."""
    lut = [int(round((REC709[0] * c[0] + REC709[1] * c[1] + REC709[2] * c[2]) * 1000))
           for c in palette]
    get = lut.__getitem__
    out = []
    for i in range(tnt.tiles):
        src = tnt.p_tilegfx + i * TILE_BYTES
        quads = [0, 0, 0, 0]
        for r in range(TILE_PX):
            row = tnt.blob[src + r * TILE_PX: src + (r + 1) * TILE_PX]
            q = (r >> 4) * 2
            quads[q] += sum(map(get, row[:16]))
            quads[q + 1] += sum(map(get, row[16:]))
        out.append([v / 256000.0 for v in quads])
    return out


def art_light(tnt, palette, steep=0.25, elevation=53.1, step=15):
    """(n_steep, [(azimuth, pearson r)]) for one map."""
    quads = _tile_quadrant_luma(tnt, palette)
    heights = tnt.heights()
    tmap = tnt.tilemap()
    W, H, MW = tnt.w16, tnt.h16, tnt.mw
    cells = []
    for r in range(H - 1):
        base, nxt = r * W, (r + 1) * W
        trow = (r >> 1) * MW
        for c in range(W - 1):
            o = (trow + (c >> 1)) * 2
            t = tmap[o] | (tmap[o + 1] << 8)
            if t >= tnt.tiles:
                continue
            h00, h10 = heights[base + c], heights[base + c + 1]
            h01, h11 = heights[nxt + c], heights[nxt + c + 1]
            dx = ((h10 + h11) - (h00 + h01)) / 32.0
            dz = ((h01 + h11) - (h00 + h10)) / 32.0
            if math.hypot(dx, dz) < steep:
                continue
            cells.append((dx, dz, quads[t][(r & 1) * 2 + (c & 1)]))
    curve = []
    e = math.radians(elevation)
    n = len(cells)
    for azi in range(0, 360, step):
        a = math.radians(azi)
        sx_, sy_, sz_ = math.sin(a) * math.cos(e), math.sin(e), -math.cos(a) * math.cos(e)
        sx = sy = sxx = syy = sxy = 0.0
        for dx, dz, b in cells:
            inv = 1.0 / math.hypot(dx, 1.0, dz)
            nl = (-dx * inv) * sx_ + inv * sy_ + (-dz * inv) * sz_
            if nl < 0.0:
                nl = 0.0
            sx += nl; sy += b; sxx += nl * nl; syy += b * b; sxy += nl * b
        if not n:
            curve.append((azi, 0.0))
            continue
        mx, my = sx / n, sy / n
        sdx = math.sqrt(max(sxx / n - mx * mx, 0.0))
        sdy = math.sqrt(max(syy / n - my * my, 0.0))
        curve.append((azi, (sxy / n - mx * my) / (sdx * sdy) if sdx and sdy else 0.0))
    return n, curve


def cmd_artlight(args):
    assets = ta3do.Assets()
    palette = ta3do.load_palette(assets)
    if args.all:
        paths = sorted(assets.glob("maps/*.tnt"))
    else:
        if not args.map:
            die("name a map with --map, or sweep every stock map with --all")
        paths = [map_tnt(assets, args.map)]
    rows = []
    for path in paths:
        try:
            tnt = Tnt(assets.read(path), path)
        except Exception as err:
            print(f"tascene: skipping {path}: {err}", file=sys.stderr)
            continue
        n, curve = art_light(tnt, palette, args.steep, args.elevation)
        peak = max(curve, key=lambda t: t[1])
        trough = min(curve, key=lambda t: t[1])
        rows.append({"map": Path(path).stem, "steep": n,
                     "peakAz": peak[0], "peakR": round(peak[1], 4),
                     "troughAz": trough[0], "troughR": round(trough[1], 4),
                     "amplitude": round(peak[1] - trough[1], 4),
                     "offset": round((peak[1] + trough[1]) / 2, 4),
                     "curve": [[a, round(r, 4)] for a, r in curve]})
        if not args.json:
            row = rows[-1]
            print(f"{row['map'][:28]:28s} steep {row['steep']:7d}  "
                  f"peak {row['peakR']:+.3f} @ az {row['peakAz']:3d}  "
                  f"trough {row['troughR']:+.3f} @ az {row['troughAz']:3d}  "
                  f"amplitude {row['amplitude']:.3f}  offset {row['offset']:+.3f}")
    if args.json:
        ta3do.out({"steep": args.steep, "elevation": args.elevation, "maps": rows},
                  True)


# --------------------------------------------------------------------------- maps

def map_tnt(assets, name: str):
    """A scenario's map name -> its maps/*.tnt path."""
    want = name.strip().lower()
    direct = f"maps/{want}.tnt"
    if assets.has(direct):
        return direct
    for path in assets.glob("maps/*.tnt"):
        if Path(path).stem.lower() == want:
            return path
    # fall back to the .ota's own missionname
    for ota in assets.glob("maps/*.ota"):
        try:
            tdf = parse_tdf(assets.read(ota).decode("latin-1"))
        except Exception:
            continue
        for body in tdf.values():
            if isinstance(body, dict) and body.get("missionname", "").strip().lower() == want:
                cand = ota[:-4] + ".tnt"
                if assets.has(cand):
                    return cand
    die(f"no map named {name!r} in the archives")


# --------------------------------------------------------------------------- view

# resolution.md §3: the viewport rect is {128, 32, W-1, H-33}, so the play area
# is always viewW = W-128, viewH = H-64 with its top-left at (128, 32).
VP_L, VP_T = 128, 32


def viewport(res):
    w, h = res
    return VP_L, VP_T, w - 128, h - 64


def clamp_eye(eye, tnt, vw, vh):
    """The eye is the world position of the viewport's top-left corner."""
    x, y = eye
    maxx = max(0, tnt.w16 * 16 - vw)
    maxy = max(0, tnt.h16 * 16 - vh)
    return [max(0, min(int(x), maxx)), max(0, min(int(y), maxy))]


