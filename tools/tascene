# The GLSL restorer's bench (renderers.md 4c, Q2/Q3): the viewer under
# restore=glsl&restorediff=1 in headless Chrome, its report read out of the DOM.
# SwiftShader is the default renderer (deterministic, slow); --gpu vulkan asks
# ANGLE for the real adapter, which is where the wall times mean anything.

def cmd_restore(args):
    pack = Path(args.pack).resolve()
    if not (pack / "scene.json").exists():
        die(f"{pack} has no scene.json (run `tascene build` first)")
    _stage_viewer(pack)
    scene = json.loads((pack / "scene.json").read_text())
    if not scene.get("restore"):
        die(f"{pack} was built before the restorer: rebuild it")
    if args.diff and not scene["map"]["atlas"].get("rgba"):
        die(f"{pack} has no terrain/atlas.rgba.bin to diff against: rebuild with --undither")
    w, h = scene["view"]["res"]
    q = {"shot": "1", "lane": "classicpp", "restore": "glsl", "model": args.model,
         "precision": args.precision, "restorediff": "1" if args.diff else "0",
         "pass": "terrain,features"}      # both restored atlases; units are not restored in the page
    if args.nk:
        q["nk"] = str(args.nk)
    if args.opts:
        for k, v in urllib.parse.parse_qsl(args.opts):
            q[k] = v
    chrome = ta3do.find_chrome()
    display = ta3do.Display()
    server = ta3do.Viewer(pack)
    try:
        url = f"{server.base}/{VIEWER.name}?" + urllib.parse.urlencode(q)
        dom, error = ta3do.dump_dom(chrome, display.name, url, (w, h), args.timeout,
                                    args.budget, gpu=args.gpu)
        if error:
            die(error)
    finally:
        server.close()
        display.close()
    m = re.search(r'<pre id="restore-report"[^>]*>(.*?)</pre>', dom, flags=re.S)
    if not m:
        err = re.search(r'<pre id="err"[^>]*>(.*?)</pre>', dom, flags=re.S)
        die("the page produced no restore report" +
            (": " + html.unescape(err.group(1)).strip()[:600] if err else " (and no error banner)"))
    rep = json.loads(html.unescape(m.group(1)))
    rep["renderer"] = args.gpu or "swiftshader"
    if args.save_features:
        fm = re.search(r'<pre id="restore-features"[^>]*>(.*?)</pre>', dom, flags=re.S)
        if not fm:
            die("--save-features needs --diff and a pack with features")
        Path(args.save_features).expanduser().write_bytes(base64.b64decode(html.unescape(fm.group(1)).strip()))
        rep["saved_features"] = str(args.save_features)
    verdict = None
    if args.diff:
        d = rep["diff"]
        verdict = (f"{'PASS' if d['pass'] else 'FAIL'}: max {d['max']} level(s), "
                   f"{d['differing']}/{d['bytes']} interior bytes differ ({d['pct']:.4f}%), "
                   f"guard ring {d['ring']}/{d['ring_bytes']} not a copy of the edge, "
                   f"worst tile {d['worst']} ({d['worst_bytes']} bytes)")
    gpu = rep.get("gpu_ms")
    ms = lambda v: f"{v['gpu_ms']:.0f} ms GPU" if gpu is not None else f"{v['ms']:.0f} ms wall"
    by = ", ".join(f"S{k}: {v['frames']} frames in {v['batches']} batches {ms(v)}"
                   for k, v in rep["by_slot"].items())
    total = (f"{rep['wall_ms']:.0f} ms wall" +
             (f", {gpu:.0f} ms GPU (first batch {rep['first_gpu_ms']:.0f} ms)" if gpu is not None
              else " (no GPU timer)"))
    human = (f"{rep['model']} {rep['precision']} nk={rep['nk']} on {rep['renderer']}: "
             f"{rep['frames']} frames ({rep['wrapped']} wrap-padded), {rep['draws']} draws, "
             f"{total}; {by}"
             + (f"\n{verdict}" if verdict else "") + (f"\nGL error 0x{rep['gl_error']:x}" if rep.get("gl_error") else ""))
    # the feature atlas: colour-keyed frames, two bands (renderers.md 4c). The
    # bar applies to `far` -- opaque texels beyond the model's reach of any
    # keyed texel; `near` is where the inpaint stand-in differs from TELEA by
    # construction, reported for the eye
    feat = rep.get("features")
    failed = bool(args.diff and not rep["diff"]["pass"])
    if feat:
        fb = ", ".join(f"S{k}: {v['frames']} in {v['batches']} batch{'es' if v['batches'] != 1 else ''}"
                       f" ({v['cols']}x{v['cols']} slots) {ms(v)}"
                       for k, v in feat["by_slot"].items())
        human += (f"\nfeatures: {feat['frames']} frames ({feat['keyed']} keyed, {feat['wrapped']} wrap-padded), "
                  f"{feat['draws']} draws, {feat['wall_ms']:.0f} ms wall"
                  + (f", {feat['gpu_ms']:.0f} ms GPU" if feat.get("gpu_ms") is not None else "")
                  + f"; {fb}")
        d = feat.get("diff")
        if d:
            human += (f"\n  far band (> {d['radius']} px from any key): "
                      f"{'PASS' if d['far']['pass'] else 'FAIL'}: max {d['far']['max']} level(s), "
                      f"{d['far']['differing']}/{d['far']['bytes']} bytes differ ({d['far']['pct']:.4f}%)"
                      f"\n  near band: max {d['near']['max']} level(s), mean {d['near']['mean']:.3f}, "
                      f"{d['near']['differing']}/{d['near']['bytes']} bytes differ ({d['near']['pct']:.2f}%); "
                      f"{d['keyed_texels']} keyed texels, alpha wrong on {d['alpha_bad']}, "
                      f"worst frame {d['worst']} ({d['worst_bytes']} bytes)")
            if not d["pass"]:
                failed = True
        elif args.diff:
            human += "\n  (no features/atlas.rgba.bin in the pack: not diffed)"
    ta3do.out(rep, args.json, human=human)
    if failed:
        sys.exit(1)


# The in-game proof (renderers.md 4c Q8): tagpu_restoredump.on makes the DLL
# write its finished atlas once, as raw RGBA in the terrain pass's layout, and
# this holds it to the pack's atlas with the same bar as `restore` -- same
# tiles, same 2176-wide 34-pitch cells, same order, so the file diffs byte for
# byte with no re-layout.

def cmd_restorediff(args):
    pack = Path(args.pack).resolve()
    if not (pack / "scene.json").exists():
        die(f"{pack} has no scene.json (run `tascene build` first)")
    scene = json.loads((pack / "scene.json").read_text())
    atlas = scene["map"]["atlas"]
    if not atlas.get("rgba"):
        die(f"{pack} has no terrain/atlas.rgba.bin: rebuild with --undither")
    ref = (pack / atlas["rgba"]).read_bytes()
    dump = Path(args.dump).expanduser()
    got = dump.read_bytes()
    W, H = atlas["w"], atlas["h"]
    if len(got) != W * H * 4:
        die(f"{dump}: {len(got)} bytes, but the pack's atlas is {W}x{H} RGBA = {W * H * 4} bytes "
            f"(a different map, or a different tile count: the dump names its size in tagpu.log)")
    pitch, border, cols, tiles = atlas.get("pitch", 32), atlas.get("border", 0), atlas["cols"], atlas["tiles"]
    hist = [0] * 256
    inner = differing = ring = ring_bytes = 0
    worst, worst_n = -1, 0
    for i in range(tiles):
        ax, ay = (i % cols) * pitch + border, (i // cols) * pitch + border
        n = 0
        for y in range(-border, 32 + border):
            row = (ay + y) * W
            ey = min(max(y, 0), 31)
            for x in range(-border, 32 + border):
                o = (row + ax + x) * 4
                if 0 <= x < 32 and 0 <= y < 32:
                    for c in range(3):
                        d = abs(got[o + c] - ref[o + c])
                        inner += 1
                        if d:
                            differing += 1
                            n += 1
                            hist[d] += 1
                else:
                    e = ((ay + ey) * W + ax + min(max(x, 0), 31)) * 4
                    for c in range(3):
                        ring_bytes += 1
                        if got[o + c] != got[e + c]:
                            ring += 1
        if n > worst_n:
            worst, worst_n = i, n
    mx = max((d for d in range(1, 256) if hist[d]), default=0)
    pct = 100.0 * differing / max(1, inner)
    ok = mx <= 1 and pct < 0.01 and ring == 0
    rep = {"pack": str(pack), "dump": str(dump), "tiles": tiles, "bytes": inner, "differing": differing,
           "pct": pct, "max": mx, "hist": hist[1:mx + 1], "ring": ring, "ring_bytes": ring_bytes,
           "worst": worst, "worst_bytes": worst_n, "pass": ok}
    ta3do.out(rep, args.json,
              human=(f"{'PASS' if ok else 'FAIL'}: {tiles} tiles, max {mx} level(s), "
                     f"{differing}/{inner} interior bytes differ ({pct:.4f}%), "
                     f"guard ring {ring}/{ring_bytes} not a copy of the edge, "
                     f"worst tile {worst} ({worst_n} bytes)"))
    if not ok:
        sys.exit(1)


# The lazy GAF restore's in-game proof (renderers.md 4b Option 4 / 4c):
# tagpu_restoredump.on makes the DLL write each GAF atlas's restored twin
# once (tagpu_gaf.c dump_if_armed) -- <prefix>.r8, .rgba and .idx -- and this
# finds every dumped entry's frame in the pack (same size, identical palette
# indices) and holds the twin to the two-band bar tascene-restore.js
# diffFrames applies in the lab: the Q2 bar beyond the model's reach of any
# keyed texel, the near band reported; alpha 0 on the key, the 1-texel border
# a copy of the edge.

def _frame_bands(got, ref, r8, W, x, y, w, h, key, wrap, border, radius, acc):
    """one frame's bytes into acc (far/near/alpha/ring tallies); `border` is
    the replicated ring around the frame the dump is expected to carry"""
    keyed = [[r8[(y + j) * W + x + i] == key for i in range(w)] for j in range(h)] if key >= 0 else None
    def dist(i, j):
        if keyed is None:
            return radius + 1
        for r in range(1, radius + 1):
            for t in range(-r, r):
                for dx, dy in ((t, -r), (r, t), (-t, r), (-r, -t)):
                    tx, ty = i + dx, j + dy
                    if wrap:
                        tx %= w; ty %= h
                    elif tx < 0 or ty < 0 or tx >= w or ty >= h:
                        continue
                    if keyed[ty][tx]:
                        return r
        return radius + 1
    n = 0
    for j in range(-border, h + border):
        for i in range(-border, w + border):
            o = ((y + j) * W + x + i) * 4
            if not (0 <= i < w and 0 <= j < h):
                ci, cj = min(max(i, 0), w - 1), min(max(j, 0), h - 1)
                e = ((y + cj) * W + x + ci) * 4
                for c in range(4):
                    acc["ring_bytes"] += 1
                    if got[o + c] != got[e + c]:
                        acc["ring"] += 1
                continue
            if keyed is not None and keyed[j][i]:
                acc["keyed"] += 1
                if got[o + 3] != 0:
                    acc["alpha_bad"] += 1
                continue
            acc["opaque"] += 1
            if got[o + 3] != 255:
                acc["alpha_bad"] += 1
            band = acc["far"] if dist(i, j) > radius else acc["near"]
            for c in range(3):
                d = abs(got[o + c] - ref[o + c])
                band["bytes"] += 1
                if d:
                    band["differing"] += 1; n += 1
                    band["hist"][d] += 1
                    band["max"] = max(band["max"], d)
                    band["sum"] += d
    return n


def _pack_atlas(args, section, what):
    """(pack, section dict, W, H, r8 bytes, rgba bytes) of one restored atlas"""
    pack = Path(args.pack).resolve()
    if not (pack / "scene.json").exists():
        die(f"{pack} has no scene.json (run `tascene build` first)")
    scene = json.loads((pack / "scene.json").read_text())
    sec = scene.get(section)
    if not sec or not sec["atlas"].get("rgba"):
        die(f"{pack} has no {what}: rebuild with --undither")
    return (pack, sec, sec["atlas"]["w"], sec["atlas"]["h"],
            (pack / sec["atlas"]["file"]).read_bytes(), (pack / sec["atlas"]["rgba"]).read_bytes())


def _atlasdiff(args, pack, PW, PH, pr8, prgba, frames, border):
    """Hold a DLL-dumped atlas twin (prefix.{r8,rgba,idx}) to the pack's, frame
    by frame: `frames` maps (w, h, R8 bytes) -> (rect, name); `border` is the
    replicated ring each dumped entry carries (1 for the sprite atlases, the
    pack's pad for units)."""
    prefix = Path(args.prefix).expanduser()
    idx = [tuple(int(v) for v in line.split()) for line in (prefix.with_suffix(".idx")).read_text().split("\n") if line.strip()]
    gr8 = prefix.with_suffix(".r8").read_bytes()
    grgba = prefix.with_suffix(".rgba").read_bytes()
    dim = int(round(len(gr8) ** 0.5))
    if dim * dim != len(gr8) or len(grgba) != dim * dim * 4:
        die(f"{prefix}: .r8 is {len(gr8)} bytes and .rgba {len(grgba)}: not one square atlas and its twin")
    depth = args.radius
    # the reference from the pack, laid out at the dump's rects
    ref = bytearray(len(grgba))
    matched, unmatched, radius = [], [], depth
    for (x, y, w, h, key, wrap) in idx:
        px = b"".join(gr8[(y + j) * dim + x:(y + j) * dim + x + w] for j in range(h))
        hit = frames.get((w, h, px))
        if not hit:
            unmatched.append((x, y, w, h)); continue
        r, name = hit
        for j in range(h):
            so = ((r["y"] + j) * PW + r["x"]) * 4
            do = ((y + j) * dim + x) * 4
            ref[do:do + w * 4] = prgba[so:so + w * 4]
        matched.append((x, y, w, h, key, wrap, name))
    acc = {"far": {"bytes": 0, "differing": 0, "max": 0, "sum": 0, "hist": [0] * 256},
           "near": {"bytes": 0, "differing": 0, "max": 0, "sum": 0, "hist": [0] * 256},
           "keyed": 0, "opaque": 0, "alpha_bad": 0, "ring": 0, "ring_bytes": 0}
    worst, worst_n = None, 0
    for (x, y, w, h, key, wrap, name) in matched:
        n = _frame_bands(grgba, ref, gr8, dim, x, y, w, h, key, wrap, border, radius, acc)
        if n > worst_n:
            worst, worst_n = name, n
    far, near = acc["far"], acc["near"]
    pct = lambda b: 100.0 * b["differing"] / max(1, b["bytes"])
    far_pass = far["max"] <= 1 and pct(far) < 0.01
    ok = far_pass and acc["alpha_bad"] == 0 and acc["ring"] == 0 and bool(matched)
    rep = {"pack": str(pack), "dump": str(prefix), "atlas": dim, "entries": len(idx), "matched": len(matched),
           "unmatched": unmatched, "radius": radius,
           "far": {"bytes": far["bytes"], "differing": far["differing"], "pct": pct(far), "max": far["max"],
                   "hist": far["hist"][1:far["max"] + 1], "pass": far_pass},
           "near": {"bytes": near["bytes"], "differing": near["differing"], "pct": pct(near), "max": near["max"],
                    "mean": near["sum"] / max(1, near["bytes"]), "hist": near["hist"][1:near["max"] + 1]},
           "keyed_texels": acc["keyed"], "opaque_texels": acc["opaque"], "alpha_bad": acc["alpha_bad"],
           "ring": acc["ring"], "ring_bytes": acc["ring_bytes"], "worst": worst, "worst_bytes": worst_n, "pass": ok}
    human = (f"{'PASS' if ok else 'FAIL'}: {len(matched)} of {len(idx)} dumped entries found in the pack"
             + (f" ({len(unmatched)} not in the pack: not diffed)" if unmatched else "") +
             f"\n  far band (> {radius} px from any key): {'PASS' if far_pass else 'FAIL'}: max {far['max']} level(s), "
             f"{far['differing']}/{far['bytes']} bytes differ ({pct(far):.4f}%)"
             f"\n  near band: max {near['max']} level(s), mean {rep['near']['mean']:.3f}, "
             f"{near['differing']}/{near['bytes']} bytes differ ({pct(near):.2f}%); "
             f"{acc['keyed']} keyed texels, alpha wrong on {acc['alpha_bad']}, "
             f"border {acc['ring']}/{acc['ring_bytes']} not a copy of the edge, worst frame {worst} ({worst_n} bytes)")
    ta3do.out(rep, args.json, human=human)
    if not ok:
        sys.exit(1)


def cmd_featdiff(args):
    pack, feat, PW, PH, pr8, prgba = _pack_atlas(args, "features", "features/atlas.rgba.bin")
    # the pack's frames, keyed on (w, h, the R8 bytes)
    frames = {}
    for d in feat["defs"].values():
        for slot in ("body", "shadow"):
            r = d.get(slot)
            if not r:
                continue
            px = b"".join(pr8[(r["y"] + j) * PW + r["x"]:(r["y"] + j) * PW + r["x"] + r["w"]] for j in range(r["h"]))
            frames[(r["w"], r["h"], px)] = (r, d["name"])
    _atlasdiff(args, pack, PW, PH, pr8, prgba, frames, 1)


def cmd_unitdiff(args):
    """The unit atlas's twin (tagpu_render3do.c, G14g) against the pack's
    units/atlas.rgba.bin. The DLL pads every unit frame by the same UNIT_PAD
    the pack does, so the ring check covers the whole 4-texel border."""
    pack, units, PW, PH, pr8, prgba = _pack_atlas(args, "units", "units/atlas.rgba.bin")
    rects = units["atlas"].get("frames")
    if not rects:
        die(f"{pack}: units/atlas has no per-frame rects (rebuild with a tascene that writes them)")
    frames = {}
    for name, r in rects.items():
        px = b"".join(pr8[(r["y"] + j) * PW + r["x"]:(r["y"] + j) * PW + r["x"] + r["w"]] for j in range(r["h"]))
        frames[(r["w"], r["h"], px)] = (r, name)
    _atlasdiff(args, pack, PW, PH, pr8, prgba, frames, units["atlas"].get("pad", UNIT_PAD))


# --------------------------------------------------------------------------- ab

# The parity claim, made checkable. Everything here already exists — tacli
# drives the game, glshot captures the GL framebuffer top-down, roster reports
# the live eye — so `ab` is glue, and being glue is the point: a comparison
# that only happens when someone remembers does not happen.

TACLI = HERE / "tacli"


def run_tacli(argv, timeout=600.0, want_json=False):
    cmd = [sys.executable, str(TACLI)] + argv + (["--json"] if want_json else [])
    proc = subprocess.run(cmd, capture_output=True, timeout=timeout)
    text = proc.stdout.decode("utf-8", "replace")
    if proc.returncode != 0:
        tail = proc.stderr.decode("utf-8", "replace").strip().splitlines()[-4:]
        die(f"tacli {' '.join(argv[:2])} failed: " + " / ".join(tail or [text[-200:]]))
    if want_json:
        try:
            return json.loads(text)
        except Exception:
            die(f"tacli {' '.join(argv[:2])}: not JSON: {text[:200]}")
    return text


def read_ppm(path: Path):
    blob = path.read_bytes()
    if not blob.startswith(b"P6"):
        die(f"{path}: not a P6 PPM")
    fields, pos = [], 2
    while len(fields) < 3:
        while pos < len(blob) and blob[pos:pos + 1].isspace():
            pos += 1
        if blob[pos:pos + 1] == b"#":
            while pos < len(blob) and blob[pos] != 0x0A:
                pos += 1
            continue
        start = pos
        while pos < len(blob) and not blob[pos:pos + 1].isspace():
            pos += 1
        fields.append(int(blob[start:pos]))
    w, h, _maxv = fields
    return w, h, blob[pos + 1:pos + 1 + w * h * 3]


def diff_rgb(a, b, w, h, rect):
    """Differing pixels and mean abs error inside rect, ignoring nothing."""
    x0, y0, rw, rh = rect
    n, total = 0, 0
    for y in range(y0, min(y0 + rh, h)):
        row = y * w
        for x in range(x0, min(x0 + rw, w)):
            o = (row + x) * 3
            d = (abs(a[o] - b[o]) + abs(a[o + 1] - b[o + 1]) + abs(a[o + 2] - b[o + 2]))
            if d:
                n += 1
                total += d
    px = max(1, min(rw, w - x0) * min(rh, h - y0))
    return n, total / (3.0 * px), px


GAP = 4


def panel(images, out_png):
    """Side-by-side composite, stdlib only — ta3do owns the PNG codec.

    tools/sbs.py does this with PIL and labels; this stays inside tascene's
    stdlib-only budget, so the panel is unlabelled and the numbers are printed.
    """
    W = sum(w for _l, _rgb, w, _h in images) + GAP * (len(images) - 1)
    H = max(h for _l, _rgb, _w, h in images)
    canvas = bytearray(b"\x18\x18\x18\xff" * (W * H))
    x = 0
    for _label, rgb, w, h in images:
        for y in range(h):
            src, dst = y * w * 3, (y * W + x) * 4
            for i in range(w):
                canvas[dst + i * 4:dst + i * 4 + 3] = rgb[src + i * 3:src + i * 3 + 3]
        x += w + GAP
    out_png.write_bytes(ta3do.write_png(W, H, bytes(canvas)))


def cmd_ab(args):
    scenario_path = Path(args.scenario)
    scenario = load_scenario(scenario_path)
    out = Path(args.output)
    out.mkdir(parents=True, exist_ok=True)

    if not args.no_launch:
        load = ["scenario", "load", args.name, str(scenario_path), "--restart"]
        if args.los is not None:
            load += ["--los", str(args.los)]
        if args.mapping is not None:
            load += ["--mapping", str(args.mapping)]
        print(f"tascene: launching {args.name} with {scenario_path.name} ...")
        run_tacli(load, timeout=args.launch_timeout)

    if args.eye:
        ex, ey = args.eye.split(",")
        run_tacli(["eye", args.name, ex, ey])

    # `scenario load` returns when the applier has answered, but the overlay
    # logs its roster block on its own cadence — so the newest `units:` line can
    # still be the one from boot, whose eye is (0,0). Waiting for a roster that
    # actually has units is the difference between a parity number and a
    # meaningless 95% diff against the loading screen.
    roster, eye = None, None
    deadline = time.time() + args.settle
    while time.time() < deadline:
        roster = run_tacli(["roster", args.name], want_json=True)
        eye = roster.get("eye")
        if eye and (eye[0] or eye[1]) and roster.get("units"):
            break
        time.sleep(2.0)
    if not eye or not (eye[0] or eye[1]) or not roster.get("units"):
        die(f"no settled game state after {args.settle:g}s "
            f"(eye={eye}, units={len(roster.get('units') or []) if roster else 0}) — "
            "the roster still reads the boot frame, so any diff would be noise")
    print(f"tascene: live eye {eye[0]},{eye[1]}, {len(roster['units'])} units")

    ppm = out / "engine.ppm"
    run_tacli(["glshot", args.name, "-o", str(ppm)])
    ew, eh, engine = read_ppm(ppm)

    pack = out / "pack"
    build_argv = [str(scenario_path), "-o", str(pack), "--eye", f"{eye[0]},{eye[1]}",
                  "--res", f"{ew}x{eh}"]
    main(["build"] + build_argv)

    ours_png = out / "browser.png"
    main(["shot", str(pack), "-o", str(ours_png)] + (["--opts", args.opts] if args.opts else []))
    ow, oh, _ch, ours = ta3do.read_png(ours_png.read_bytes())
    if _ch == 4:
        ours = bytes(b for i, b in enumerate(ours) if i % 4 != 3)

    if (ow, oh) != (ew, eh):
        die(f"size mismatch: engine {ew}x{eh}, browser {ow}x{oh}")

    vpL, vpT, vw, vh = viewport([ew, eh])
    n, mae, px = diff_rgb(engine, ours, ew, eh, (vpL, vpT, vw, vh))
    panel([("engine", engine, ew, eh), ("tascene", ours, ow, oh)], out / "ab.png")

    result = {"eye": eye, "res": [ew, eh], "viewport": [vpL, vpT, vw, vh],
              "differing": n, "viewport_px": px, "pct": round(100.0 * n / px, 3),
              "mean_abs": round(mae, 3), "panel": str(out / "ab.png")}
    ta3do.out(result, args.json,
              human=(f"engine vs tascene inside the viewport: {n}/{px} px differ "
                     f"({100.0 * n / px:.2f}%), mean abs {mae:.2f}/255\n"
                     f"panel: {out / 'ab.png'}"))


# --------------------------------------------------------------------------- CLI

def main(argv=None):
    ap = argparse.ArgumentParser(prog="tascene", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    b = sub.add_parser("build", help="compile a scenario into a scene pack")
    b.add_argument("scenario")
    b.add_argument("-o", "--output", required=True)
    b.add_argument("--map", help="override setup.map")
    b.add_argument("--res", help="override setup.res, e.g. 1024x768")
    b.add_argument("--eye", help="viewport top-left in world units, 'X,Y'")
    b.add_argument("--no-units", action="store_true",
                   help="skip unit meshes")
    b.add_argument("--no-features", action="store_true",
                   help="terrain only (a smaller pack, and a terrain-only diff)")
    b.add_argument("--undither", nargs="?", const="learned", metavar="PRESET",
                   choices=ta3do.UNDITHER_PRESETS,
                   help="also pack true-colour atlases for the EXPLORATION lane "
                        f"({' | '.join(ta3do.UNDITHER_PRESETS)}; default learned). "
                        "The parity lane keeps its palette indices either way")
    b.add_argument("--undither-python", dest="undither_python",
                   help="interpreter that can import unditherer "
                        "(default: the checkout's .venv-undither)")
    b.add_argument("--cache-dir", dest="cache_dir",
                   help=f"restored-frame cache (default ${CACHE_ENV} or "
                        "~/.cache/tascene/undither)")
    b.add_argument("--json", action="store_true")
    b.set_defaults(func=cmd_build)

    s = sub.add_parser("serve", help="serve a pack for interactive viewing")
    s.add_argument("pack")
    s.add_argument("--port", type=int, default=0)
    s.add_argument("--host", default="127.0.0.1",
                   help="interface to bind (default loopback). Name ONE interface "
                        "to reach the page from another machine — a Tailscale "
                        "100.x address, say — rather than 0.0.0.0")
    s.add_argument("--no-reload", action="store_true",
                   help="do not re-stage the viewer on edit, and do not let the "
                        "page reload itself (the pre-live-reload behaviour)")
    s.set_defaults(func=cmd_serve)

    t = sub.add_parser("shot", help="headless screenshot of a pack")
    t.add_argument("pack")
    t.add_argument("-o", "--output", required=True)
    t.add_argument("--opts", help="viewer query string, e.g. 'preset=relief' or "
                                  "'a=engine&b=restored&wipe=0.5'")
    t.add_argument("--timeout", type=float, default=90.0)
    t.add_argument("--budget", type=int, default=8000,
                   help="chrome --virtual-time-budget in ms")
    t.add_argument("--json", action="store_true")
    t.set_defaults(func=cmd_shot)

    rs = sub.add_parser("restore", help="run the GLSL restorer on a pack's terrain and feature "
                                          "atlases in headless Chrome and diff them against the pack's")
    rs.add_argument("pack")
    rs.add_argument("--model", choices=("full", "tiny"), default="full")
    rs.add_argument("--precision", choices=("fp32", "fp16"), default="fp32")
    rs.add_argument("--nk", type=int, help="output channel-tiles per conv draw (default: the device's max)")
    rs.add_argument("--no-diff", dest="diff", action="store_false",
                    help="time it only; do not diff against terrain/atlas.rgba.bin")
    rs.add_argument("--save-features", metavar="RGBA",
                    help="write the restored feature atlas (raw RGBA, the pack's layout) here")
    rs.add_argument("--gpu", choices=("vulkan", "gl"),
                    help="ANGLE backend on the real adapter instead of SwiftShader")
    rs.add_argument("--opts", help="extra viewer query, e.g. 'eye=0,0'")
    rs.add_argument("--timeout", type=float, default=900.0)
    rs.add_argument("--budget", type=int, default=60000,
                    help="chrome --virtual-time-budget in ms")
    rs.add_argument("--json", action="store_true")
    rs.set_defaults(func=cmd_restore)

    rd = sub.add_parser("restorediff", help="diff the DLL's tagpu_restore.rgba dump against a "
                                              "pack's restored terrain atlas (the in-game proof)")
    rd.add_argument("pack")
    rd.add_argument("dump", help="gamedir/tagpu_restore.rgba, written under tagpu_restoredump.on")
    rd.add_argument("--json", action="store_true")
    rd.set_defaults(func=cmd_restorediff)
    fd = sub.add_parser("featdiff", help="hold a GAF atlas's restored twin dumped by the DLL "
                                           "(tagpu_restoredump.on) to the pack's restored feature atlas")
    fd.add_argument("pack")
    fd.add_argument("prefix", help="the dump's path without its extension, e.g. <gamedir>/tagpu_restore_feat")
    fd.add_argument("--radius", type=int, default=12, help="the model's depth: the far band starts past it")
    fd.add_argument("--json", action="store_true")
    fd.set_defaults(func=cmd_featdiff)
    ud = sub.add_parser("unitdiff", help="hold the unit atlas's restored twin dumped by the DLL "
                                           "(tagpu_restoredump.on) to the pack's restored unit atlas")
    ud.add_argument("pack")
    ud.add_argument("prefix", help="the dump's path without its extension, e.g. <gamedir>/tagpu_restore_unit")
    ud.add_argument("--radius", type=int, default=12, help="the model's depth: the far band starts past it")
    ud.add_argument("--json", action="store_true")
    ud.set_defaults(func=cmd_unitdiff)

    al = sub.add_parser("artlight",
                        help="is the map art already painted lit? sweep the sun "
                             "and correlate against the heightfield's own slope")
    al.add_argument("--map", help="map name (default: --all)")
    al.add_argument("--all", action="store_true", help="every stock map (slow)")
    al.add_argument("--steep", type=float, default=0.25,
                    help="only cells with |grad h| at least this (0.25 = ~14 deg)")
    al.add_argument("--elevation", type=float, default=53.1,
                    help="sun elevation in degrees (default: the engine's own)")
    al.add_argument("--json", action="store_true")
    al.set_defaults(func=cmd_artlight)

    ab = sub.add_parser("ab", help="drive the game and the browser, and diff them")
    ab.add_argument("scenario")
    ab.add_argument("--name", default="tascene", help="instance name")
    ab.add_argument("-o", "--output", default="ab-out")
    ab.add_argument("--eye", help="pin the eye to 'X,Y' before capturing")
    ab.add_argument("--opts", help="viewer query string")
    ab.add_argument("--no-launch", action="store_true",
                    help="use an instance that is already running")
    ab.add_argument("--los", type=int, choices=(0, 1, 2), default=0,
                    help="SKIRMISH Line of Sight (0 = Permanent: no grey fog)")
    ab.add_argument("--mapping", type=int, choices=(0, 1), default=1)
    ab.add_argument("--launch-timeout", type=float, default=600.0)
    ab.add_argument("--settle", type=float, default=90.0,
                    help="seconds to wait for a roster with units and a real eye")
    ab.add_argument("--json", action="store_true")
    ab.set_defaults(func=cmd_ab)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    main()
