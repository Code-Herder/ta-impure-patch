def cmd_compile(args):
    text = Path(args.source).read_text(encoding="latin-1")
    cob = compile_bos(text, args.source, args.include or ())
    blob = write_cob(cob)
    out = Path(args.output) if args.output else Path(args.source).with_suffix(".cob")
    out.write_bytes(blob)
    print(f"{out}: {len(cob.scripts)} scripts, {len(cob.pieces)} pieces, {len(cob.code)} words, "
          f"{cob.statics} statics, {len(blob)} bytes")


def cmd_decompile(args):
    blob, unit = read_cob_source(args.source, args.gamedir)
    cob = read_cob(blob)
    text, failures = decompile_cob(cob, unit)
    if args.output:
        Path(args.output).write_text(text, encoding="latin-1")
    else:
        sys.stdout.write(text)
    for name, msg in failures:
        print(f"tacob: {unit}: {msg}", file=sys.stderr)
    if failures:
        raise SystemExit(1)


def cmd_dump(args):
    blob, _unit = read_cob_source(args.source, args.gamedir)
    print(listing(read_cob(blob), args.script))


def roundtrip_one(blob: bytes, unit: str):
    """One unit through decompile → compile; a dict the gate and the tests both read."""
    result = {"unit": unit, "ok": False}
    try:
        cob = read_cob(blob)
    except TacobError as e:
        result["error"] = f"read: {e}"
        return result, None
    text, failures = decompile_cob(cob, unit)
    result["scripts"] = len(cob.scripts)
    if failures:
        result["error"] = "decompile: " + "; ".join(f"{n}: {m}" for n, m in failures)
        return result, text
    try:
        rebuilt = write_cob(compile_bos(text, f"{unit}.bos"))
    except CompileError as e:
        result["error"] = f"compile: {e}"
        return result, text
    if rebuilt == blob:
        result["ok"] = True
        return result, text
    n = min(len(rebuilt), len(blob))
    diff = next((k for k in range(n) if rebuilt[k] != blob[k]), n)
    result["error"] = f"bytes differ at offset {diff} (sizes {len(blob)} vs {len(rebuilt)})"
    if HEADER.size <= diff < HEADER.size + 4 * len(cob.code):
        word = (diff - HEADER.size) // 4
        script = next((nm for nm, s, e in script_ranges(cob) if s <= word < e), "?")
        result["error"] += f"; code word {word} in {script}"
    return result, text


def cmd_roundtrip(args):
    units = []
    if args.all:
        ta3do = load_ta3do()
        assets = ta3do.Assets(args.gamedir)
        for path in assets.glob("scripts/*.cob"):
            units.append((assets.read(path), Path(path).stem))
    for spec in args.units:
        units.append(read_cob_source(spec, args.gamedir))
    if not units:
        raise TacobError("nothing to round-trip: give unit names or --all")
    out_dir = Path(args.out) if args.out else None
    if out_dir:
        out_dir.mkdir(parents=True, exist_ok=True)
    results = []
    for blob, unit in units:
        result, text = roundtrip_one(blob, unit)
        results.append(result)
        if out_dir and text is not None:
            (out_dir / f"{unit}.bos").write_text(text, encoding="latin-1")
        if not args.json:
            print(f"{'ok  ' if result['ok'] else 'FAIL'} {unit:<12} {result.get('error', '')}")
    failed = [r for r in results if not r["ok"]]
    summary = {"units": len(results), "identical": len(results) - len(failed), "failed": failed}
    if args.json:
        print(json.dumps(summary, indent=1))
    else:
        print(f"{summary['identical']} of {summary['units']} byte-identical")
    if failed:
        raise SystemExit(1)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="tacob", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("compile", help="BOS -> COB")
    p.add_argument("source")
    p.add_argument("-o", "--output")
    p.add_argument("-I", "--include", action="append", help="include search directory")
    p.set_defaults(fn=cmd_compile)

    p = sub.add_parser("decompile", help="COB -> BOS (a file, or a stock unit name)")
    p.add_argument("source")
    p.add_argument("-o", "--output")
    p.add_argument("--gamedir")
    p.set_defaults(fn=cmd_decompile)

    p = sub.add_parser("dump", help="opcode listing")
    p.add_argument("source")
    p.add_argument("script", nargs="?")
    p.add_argument("--gamedir")
    p.set_defaults(fn=cmd_dump)

    p = sub.add_parser("roundtrip", help="decompile, recompile, compare bytes")
    p.add_argument("units", nargs="*")
    p.add_argument("--all", action="store_true", help="every scripts/*.cob in the game's archives")
    p.add_argument("--out", help="write the decompiled BOS files here")
    p.add_argument("--json", action="store_true")
    p.add_argument("--gamedir")
    p.set_defaults(fn=cmd_roundtrip)

    p = sub.add_parser("run", help="replay a landing-2 fixture on the VM and diff both oracles")
    p.add_argument("classes", nargs="*", help="kbot, tank, building, death, fighter, gunship, "
                                              "bomber, ship, sub")
    p.add_argument("--all", action="store_true", help="every fixture — the landing-3 gate")
    p.add_argument("--print-trace", action="store_true", help="write the replayed lines to stdout")
    p.add_argument("--trace-out", help="write the replayed lines to this file")
    p.add_argument("--no-pose", action="store_true", help="skip the posedump comparison")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("fit-world", help="derive replay.json's get timelines from the fixtures")
    p.add_argument("classes", nargs="*")
    p.add_argument("--all", action="store_true")
    p.set_defaults(fn=cmd_fit)

    args = ap.parse_args(argv)
    try:
        args.fn(args)
    except TacobError as e:
        print(f"tacob: {e}", file=sys.stderr)
