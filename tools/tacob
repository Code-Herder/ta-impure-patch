TOKEN_RE = re.compile(r"""
    (?P<ws>\s+)
  | (?P<lin>\[\s*[-+]?(?:\d+\.?\d*|\.\d+)\s*\])
  | (?P<ang><\s*[-+]?(?:\d+\.?\d*|\.\d+)\s*>)
  | (?P<hex>0[xX][0-9A-Fa-f]+)
  | (?P<int>\d+)
  | (?P<str>"[^"\n]*")
  | (?P<name>[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z_][A-Za-z0-9_]*)*)
  | (?P<op>\|\||&&|==|!=|<=|>=|[-+*/%&|^~!<>=(){};,])
""", re.X)


class Token:
    __slots__ = ("kind", "value", "file", "line")

    def __init__(self, kind, value, file, line):
        self.kind, self.value, self.file, self.line = kind, value, file, line

    def __repr__(self):
        return f"{self.kind}:{self.value!r}"

    @property
    def where(self):
        return f"{self.file}:{self.line}"


def strip_comments(text: str) -> str:
    out = []
    i, n = 0, len(text)
    while i < n:
        if text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            if j < 0:
                raise CompileError("unterminated /* comment")
            out.append("\n" * text.count("\n", i, j + 2))
            i = j + 2
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def lex_line(line: str, file: str, lineno: int):
    tokens = []
    pos = 0
    while pos < len(line):
        m = TOKEN_RE.match(line, pos)
        if not m:
            raise CompileError(f"{file}:{lineno}: cannot read {line[pos:pos + 12]!r}")
        kind = m.lastgroup
        text = m.group(kind)
        if kind == "ws":
            pos = m.end()
            continue
        if kind == "name":
            low = text.lower()
            if "-" in text and low not in KEYWORDS:
                # `heading-pitch` is a subtraction: keep the first identifier only
                text = text.split("-", 1)[0]
                low = text.lower()
                m_end = pos + len(text)
            else:
                m_end = m.end()
            tokens.append(Token("kw" if low in KEYWORDS else "name",
                                low if low in KEYWORDS else text, file, lineno))
            pos = m_end
            continue
        if kind == "int":
            tokens.append(Token("int", int(text), file, lineno))
        elif kind == "hex":
            tokens.append(Token("int", int(text, 16), file, lineno))
        elif kind == "lin":
            tokens.append(Token("lin", float(text[1:-1]), file, lineno))
        elif kind == "ang":
            tokens.append(Token("ang", float(text[1:-1]), file, lineno))
        elif kind == "str":
            tokens.append(Token("str", text[1:-1], file, lineno))
        else:
            tokens.append(Token("op", text, file, lineno))
        pos = m.end()
    return tokens


class Preprocessor:
    """#include, object-like #define, #ifdef/#ifndef/#else/#endif, #undef. Nothing else."""

    MAX_DEPTH = 64

    def __init__(self, include_dirs=(), reader=None):
        self.include_dirs = [Path(d) for d in include_dirs]
        self.macros = {}
        self.tokens = []
        self.reader = reader  # name -> text, for tests and archives
        self.depth = 0

    def run(self, text: str, file: str = "<bos>"):
        self.depth += 1
        if self.depth > self.MAX_DEPTH:
            raise CompileError(f"{file}: includes nest deeper than {self.MAX_DEPTH}")
        try:
            self._run(strip_comments(text), file)
        finally:
            self.depth -= 1
        return self.tokens

    def _run(self, text, file):
        stack = []  # [active_before, active_now, seen_else]
        for lineno, line in enumerate(text.split("\n"), 1):
            stripped = line.strip()
            active = all(frame[1] for frame in stack)
            if stripped.startswith("#"):
                parts = stripped[1:].strip().split(None, 1)
                directive = parts[0].lower() if parts else ""
                rest = parts[1].strip() if len(parts) > 1 else ""
                where = f"{file}:{lineno}"
                if directive in ("ifdef", "ifndef"):
                    if not rest:
                        raise CompileError(f"{where}: #{directive} needs a name")
                    cond = (rest.split()[0] in self.macros) == (directive == "ifdef")
                    stack.append([active, cond, False])
                elif directive == "else":
                    if not stack or stack[-1][2]:
                        raise CompileError(f"{where}: #else without #if")
                    stack[-1][1] = not stack[-1][1]
                    stack[-1][2] = True
                elif directive == "endif":
                    if not stack:
                        raise CompileError(f"{where}: #endif without #if")
                    stack.pop()
                elif not active:
                    continue
                elif directive == "define":
                    self._define(rest, where)
                elif directive == "undef":
                    self.macros.pop(rest.split()[0], None) if rest else None
                elif directive == "include":
                    self._include(rest, where)
                elif directive in ("if", "elif"):
                    raise CompileError(f"{where}: #{directive} is not supported (use #ifdef)")
                else:
                    raise CompileError(f"{where}: unknown directive #{directive}")
                continue
            if not active:
                continue
            for tok in lex_line(line, file, lineno):
                self._emit(tok, 0)
        if stack:
            raise CompileError(f"{file}: #ifdef without #endif")

    def _define(self, rest, where):
        m = re.match(r"([A-Za-z_][A-Za-z0-9_]*)(\(?)(.*)$", rest)
        if not m:
            raise CompileError(f"{where}: bad #define")
        name, paren, body = m.group(1), m.group(2), m.group(3)
        if paren:
            raise CompileError(f"{where}: function-like macro {name} is not supported")
        self.macros[name] = lex_line(body, where.split(":")[0], int(where.rsplit(":", 1)[1]))

    def _include(self, rest, where):
        m = re.match(r'"([^"]+)"|<([^>]+)>', rest)
        if not m:
            raise CompileError(f"{where}: #include needs a quoted file name")
        name = m.group(1) or m.group(2)
        text = self.reader(name) if self.reader else None
        if text is None:
            for d in self.include_dirs + [INCLUDE_DIR]:
                path = d / name
                if path.is_file():
                    text = path.read_text(encoding="latin-1")
                    break
                for cand in d.iterdir() if d.is_dir() else ():
                    if cand.name.lower() == name.lower() and cand.is_file():
                        text = cand.read_text(encoding="latin-1")
                        break
                if text is not None:
                    break
        if text is None:
            raise CompileError(f"{where}: cannot find include {name!r}")
        self.run(text, name)

    def _emit(self, tok, depth):
        if tok.kind == "name" and tok.value in self.macros:
            if depth > self.MAX_DEPTH:
                raise CompileError(f"{tok.where}: macro {tok.value} expands forever")
            for sub in self.macros[tok.value]:
                self._emit(Token(sub.kind, sub.value, tok.file, tok.line), depth + 1)
            return
        self.tokens.append(tok)


# --------------------------------------------------------------------------- AST + parser

class Node:
    def __init__(self, kind, **fields):
        self.kind = kind
        self.__dict__.update(fields)

    def __repr__(self):
        return f"Node({self.kind}, {', '.join(f'{k}={v!r}' for k, v in self.__dict__.items() if k != 'kind')})"


class Function:
    def __init__(self, name, params, tok=None):
        self.name = name
        self.params = list(params)
        self.locals = []
        self.body = []
        self.tok = tok


class Program:
    def __init__(self):
        self.pieces = []
        self.statics = []
        self.functions = []


class Parser:
    def __init__(self, tokens):
        self.toks = tokens + [Token("eof", None, tokens[-1].file if tokens else "<bos>",
                                    tokens[-1].line if tokens else 0)]
        self.i = 0
        self.program = Program()
        self.fn = None

    # -- token helpers
    def peek(self, k=0):
        return self.toks[min(self.i + k, len(self.toks) - 1)]

    def next(self):
        tok = self.toks[self.i]
        self.i += 1
        return tok

    def at(self, kind, value=None):
        tok = self.peek()
        return tok.kind == kind and (value is None or tok.value == value)

    def accept(self, kind, value=None):
        if self.at(kind, value):
            return self.next()
        return None

    def expect(self, kind, value=None, what=None):
        tok = self.peek()
        if not self.at(kind, value):
            want = what or (value if value is not None else kind)
            raise CompileError(f"{tok.where}: expected {want}, found {self._show(tok)}")
        return self.next()

    @staticmethod
    def _show(tok):
        if tok.kind == "eof":
            return "end of file"
        return repr(tok.value)

    def name(self, what="a name"):
        tok = self.peek()
        if tok.kind == "kw" and tok.value in SOFT_KEYWORDS:
            return self.next().value
        if tok.kind != "name":
            raise CompileError(f"{tok.where}: expected {what}, found {self._show(tok)}")
        return self.next().value

    # -- top level
    def parse(self) -> Program:
        while not self.at("eof"):
            if self.accept("kw", "piece"):
                self.program.pieces += self.name_list()
            elif self.accept("kw", "static-var"):
                self.program.statics += self.name_list()
            elif self.at("name"):
                self.program.functions.append(self.function())
            elif self.accept("op", ";"):
                continue
            else:
                tok = self.peek()
                raise CompileError(f"{tok.where}: expected a declaration or a script, found {self._show(tok)}")
        return self.program

    def name_list(self):
        names = [self.name()]
        while self.accept("op", ","):
            names.append(self.name())
        self.expect("op", ";")
        return names

    def function(self):
        tok = self.peek()
        name = self.name("a script name")
        self.expect("op", "(")
        params = []
        if not self.at("op", ")"):
            params.append(self.name("a parameter name"))
            while self.accept("op", ","):
                params.append(self.name("a parameter name"))
        self.expect("op", ")")
        fn = Function(name, params, tok)
        self.fn = fn
        self.expect("op", "{")
        fn.body = self.statements_until("}")
        self.fn = None
        return fn

    # -- statements
    def statements_until(self, closer):
        stmts = []
        while not self.at("op", closer):
            if self.at("eof"):
                raise CompileError(f"{self.peek().where}: missing '{closer}'")
            stmt = self.statement()
            if stmt is not None:
                stmts.append(stmt)
        self.next()
        return stmts

    def block_or_statement(self):
        if self.accept("op", "{"):
            return self.statements_until("}")
        stmt = self.statement()
        return [] if stmt is None else [stmt]

    def statement(self):
        tok = self.peek()
        if tok.kind == "op":
            if tok.value == ";":
                self.next()
                return None
            if tok.value == "{":
                self.next()
                return Node("block", body=self.statements_until("}"))
            raise CompileError(f"{tok.where}: unexpected {tok.value!r}")
        if tok.kind == "name" or (tok.kind == "kw" and tok.value in SOFT_KEYWORDS
                                  and self.peek(1).kind == "op" and self.peek(1).value == "="):
            target = self.next().value
            self.expect("op", "=", "'='")
            expr = self.expression()
            self.expect("op", ";")
            return Node("assign", target=target, expr=expr, tok=tok)
        if tok.kind != "kw":
            raise CompileError(f"{tok.where}: unexpected {self._show(tok)}")
        kw = self.next().value
        method = getattr(self, "stmt_" + kw.replace("-", "_"), None)
        if method is None:
            raise CompileError(f"{tok.where}: '{kw}' cannot start a statement")
        return method(tok)

    def stmt_var(self, tok):
        names = self.name_list()
        self.fn.locals += names
        return None

    def stmt_if(self, tok):
        self.expect("op", "(")
        cond = self.expression()
        self.expect("op", ")")
        then = self.block_or_statement()
        other = None
        if self.accept("kw", "else"):
            other = self.block_or_statement()
        return Node("if", cond=cond, then=then, other=other)

    def stmt_while(self, tok):
        self.expect("op", "(")
        cond = self.expression()
        self.expect("op", ")")
        return Node("while", cond=cond, body=self.block_or_statement())

    def stmt_for(self, tok):
        raise CompileError(f"{tok.where}: 'for' is not BOS — use while")

    def stmt_else(self, tok):
        raise CompileError(f"{tok.where}: 'else' without 'if'")

    def stmt_return(self, tok):
        expr = None
        if not self.at("op", ";"):
            expr = self.expression()
        self.expect("op", ";")
        return Node("return", expr=expr)

    def piece_axis(self, link):
        piece = self.name("a piece name")
        self.expect("kw", link)
        axis = self.expect("kw", None, "x-axis, y-axis or z-axis")
        if axis.value not in AXES:
            raise CompileError(f"{axis.where}: expected an axis, found {axis.value!r}")
        return piece, AXES[axis.value]

    def _move_turn(self, tok, kind):
        piece, axis = self.piece_axis("to")
        dest = self.expression()
        if self.accept("kw", "now"):
            self.expect("op", ";")
            return Node(kind, piece=piece, axis=axis, dest=dest, speed=None, tok=tok)
        self.expect("kw", "speed")
        speed = self.expression()
        self.expect("op", ";")
        return Node(kind, piece=piece, axis=axis, dest=dest, speed=speed, tok=tok)

    def stmt_move(self, tok):
        return self._move_turn(tok, "move")

    def stmt_turn(self, tok):
        return self._move_turn(tok, "turn")

    def stmt_spin(self, tok):
        piece, axis = self.piece_axis("around")
        self.expect("kw", "speed")
        speed = self.expression()
        accel = None
        if self.accept("kw", "accelerate"):
            accel = self.expression()
        self.expect("op", ";")
        return Node("spin", piece=piece, axis=axis, speed=speed, accel=accel, tok=tok)

    def stmt_stop_spin(self, tok):
        piece, axis = self.piece_axis("around")
        decel = None
        if self.accept("kw", "decelerate"):
            decel = self.expression()
        self.expect("op", ";")
        return Node("stop-spin", piece=piece, axis=axis, decel=decel, tok=tok)

    def stmt_wait_for_turn(self, tok):
        piece, axis = self.piece_axis("around")
        self.expect("op", ";")
        return Node("wait-for-turn", piece=piece, axis=axis, tok=tok)

    def stmt_wait_for_move(self, tok):
        piece, axis = self.piece_axis("along")
        self.expect("op", ";")
        return Node("wait-for-move", piece=piece, axis=axis, tok=tok)

    def _piece_op(self, tok, kw):
        piece = self.name("a piece name")
        self.expect("op", ";")
        return Node("piece-op", op=PIECE_OPS[kw], piece=piece, tok=tok)

    def stmt_show(self, tok):
        return self._piece_op(tok, "show")

    def stmt_hide(self, tok):
        return self._piece_op(tok, "hide")

    def stmt_cache(self, tok):
        return self._piece_op(tok, "cache")

    def stmt_dont_cache(self, tok):
        return self._piece_op(tok, "dont-cache")

    def stmt_shade(self, tok):
        return self._piece_op(tok, "shade")

    def stmt_dont_shade(self, tok):
        return self._piece_op(tok, "dont-shade")

    def stmt_emit_sfx(self, tok):
        sfx = self.expression()
        self.expect("kw", "from")
        piece = self.name("a piece name")
        self.expect("op", ";")
        return Node("emit-sfx", sfx=sfx, piece=piece, tok=tok)

    def stmt_explode(self, tok):
        piece = self.name("a piece name")
        self.expect("kw", "type")
        flags = self.expression()
        self.expect("op", ";")
        return Node("explode", piece=piece, flags=flags, tok=tok)

    def _one_expr(self, tok, kind):
        expr = self.expression()
        self.expect("op", ";")
        return Node(kind, expr=expr, tok=tok)

    def stmt_sleep(self, tok):
        return self._one_expr(tok, "sleep")

    def stmt_signal(self, tok):
        return self._one_expr(tok, "signal")

    def stmt_set_signal_mask(self, tok):
        return self._one_expr(tok, "set-signal-mask")

    def stmt_drop_unit(self, tok):
        return self._one_expr(tok, "drop-unit")

    def _call(self, tok, kind):
        name = self.name("a script name")
        self.expect("op", "(")
        args = []
        if not self.at("op", ")"):
            args.append(self.expression())
            while self.accept("op", ","):
                args.append(self.expression())
        self.expect("op", ")")
        self.expect("op", ";")
        return Node(kind, name=name, args=args, tok=tok)

    def stmt_start_script(self, tok):
        return self._call(tok, "start-script")

    def stmt_call_script(self, tok):
        return self._call(tok, "call-script")

    def stmt_set(self, tok):
        value_id = self.value_id()
        self.expect("kw", "to")
        expr = self.expression()
        self.expect("op", ";")
        return Node("set", value_id=value_id, expr=expr, tok=tok)

    def stmt_attach_unit(self, tok):
        unit = self.expression()
        self.expect("kw", "to")
        piece = self.expression()
        pos = None
        if not self.at("op", ";"):
            pos = self.expression()
        self.expect("op", ";")
        return Node("attach-unit", unit=unit, piece=piece, pos=pos, tok=tok)

    # The two the community's BOS has and this engine does not run. `0x10072000`
    # and `0x10073000` are missing from the dispatch chain at 0x4B1B48..0x4B1B60,
    # so the *thread* dies there, silently, and everything after the statement
    # never runs (exe-reverse-engineering.md §"Opcodes this engine does not
    # implement"). Refusing beats emitting: the operand encodings are the
    # community's too, and a file that round-trips a guess is worse than one that
    # will not build. No stock script uses either — all 278 decoded.
    def _unimplemented(self, tok, name):
        raise CompileError(
            f"{tok.where}: {name} is not an opcode retail TA dispatches — the thread "
            f"that runs it is killed on the spot (0x4B1B60) and the rest of the script "
            f"never happens. No stock script uses it; its operand encoding is the "
            f"community's and unverified here, so tacob will not emit one.")

    def stmt_play_sound(self, tok):
        self._unimplemented(tok, "play-sound")

    def stmt_map_command(self, tok):
        self._unimplemented(tok, "map-command")

    def value_id(self):
        tok = self.peek()
        if tok.kind == "int":
            return self.next().value
        name = self.name("a value name such as HEALTH")
        if name.upper() in VALUE_IDS:
            return VALUE_IDS[name.upper()]
        raise CompileError(f"{tok.where}: unknown value {name!r} (retail ids are HEALTH, ACTIVATION, ... or a number)")

    # -- expressions (precedence climbing)
    def expression(self, min_prec=1):
        left = self.unary()
        while True:
            tok = self.peek()
            if tok.kind != "op" or tok.value not in PRECEDENCE or PRECEDENCE[tok.value] < min_prec:
                return left
            op = self.next().value
            right = self.expression(PRECEDENCE[op] + 1)
            left = Node("bin", op=op, left=left, right=right)

    def unary(self):
        tok = self.peek()
        if tok.kind == "op" and tok.value in ("!", "~", "-", "+"):
            self.next()
            operand = self.unary()
            if tok.value == "+":
                return operand
            if tok.value == "-":
                if operand.kind == "int" and operand.name is None:
                    operand.value = -operand.value
                    return operand
                return Node("neg", expr=operand)
            return Node("not" if tok.value == "!" else "bnot", expr=operand)
        return self.primary()

    def primary(self):
        tok = self.next()
        if tok.kind == "int":
            return Node("int", value=tok.value, fmt="int", name=None)
        if tok.kind == "lin":
            return Node("int", value=linear_word(tok.value), fmt="lin", name=None)
        if tok.kind == "ang":
            return Node("int", value=angular_word(tok.value), fmt="ang", name=None)
        if tok.kind == "op" and tok.value == "(":
            expr = self.expression()
            self.expect("op", ")")
            return expr
        if tok.kind == "kw" and tok.value == "get":
            value_id = self.value_id()
            args = []
            if self.accept("op", "("):
                if not self.at("op", ")"):
                    args.append(self.expression())
                    while self.accept("op", ","):
                        args.append(self.expression())
                self.expect("op", ")")
            if len(args) > 4:
                raise CompileError(f"{tok.where}: get takes at most four arguments")
            return Node("get", value_id=value_id, args=args, tok=tok)
        if tok.kind == "kw" and tok.value == "rand":
            self.expect("op", "(")
            lo = self.expression()
            self.expect("op", ",")
            hi = self.expression()
            self.expect("op", ")")
            return Node("rand", lo=lo, hi=hi)
        if tok.kind == "name" or (tok.kind == "kw" and tok.value in SOFT_KEYWORDS):
            return Node("name", name=tok.value, tok=tok)
        raise CompileError(f"{tok.where}: expected a value, found {self._show(tok)}")


# --------------------------------------------------------------------------- compiler

class Assembler:
    def __init__(self):
        self.words = []
        self.fixups = []  # (word index, label)
        self.labels = {}
        self.last_op = -1

    def emit(self, name, *args):
        self.last_op = len(self.words)
        self.words.append(OP[name])
        self.words.extend(a & 0xFFFFFFFF for a in args)

    def last_inline(self):
        """True when the final word is an inline operand rather than an opcode."""
        return self.last_op != len(self.words) - 1

    def new_label(self):
        return object()

    def place(self, label):
        self.labels[label] = len(self.words)

    def jump(self, name, label):
        self.last_op = len(self.words)
        self.words.append(OP[name])
        self.fixups.append((len(self.words), label))
        self.words.append(0)

    def resolve(self):
        for index, label in self.fixups:
            self.words[index] = self.labels[label]
        self.fixups = []


class Compiler:
    def __init__(self, program: Program):
        self.program = program
        self.pieces = {}
        for i, name in enumerate(program.pieces):
            if name.lower() in self.pieces:
                raise CompileError(f"piece {name!r} declared twice")
            self.pieces[name.lower()] = i
        self.statics = {}
        for i, name in enumerate(program.statics):
            if name.lower() in self.statics:
                raise CompileError(f"static-var {name!r} declared twice")
            self.statics[name.lower()] = i
        self.functions = {}
        for i, fn in enumerate(program.functions):
            if fn.name.lower() in self.functions:
                raise CompileError(f"{fn.tok.where}: script {fn.name!r} defined twice")
            self.functions[fn.name.lower()] = i
        self.asm = Assembler()
        self.locals = {}

    def compile(self) -> Cob:
        entries = []
        for fn in self.program.functions:
            entries.append(len(self.asm.words))
            self.function(fn)
        self.asm.resolve()
        scripts = [(fn.name, entry) for fn, entry in zip(self.program.functions, entries)]
        return Cob(scripts, self.program.pieces, len(self.program.statics), self.asm.words)

    def function(self, fn: Function):
        self.locals = {}
        for name in fn.params + fn.locals:
            if name.lower() in self.locals:
                raise CompileError(f"{fn.tok.where}: {fn.name}: local {name!r} declared twice")
            self.locals[name.lower()] = len(self.locals)
        start = len(self.asm.words)
        for _ in self.locals:
            self.asm.emit("CREATE_LOCAL_VAR")
        self.statements(fn.body)
        # Scriptor's implicit `return (0)`: appended unless this script's last opcode is
        # already a RETURN — a script ending in `if( x ) { ...; return (0); }` gets none,
        # and falls through into the next script when the condition fails (ARMPW FirePrimary).
        words = self.asm.words
        if len(words) == start or words[-1] != OP["RETURN"] or self.asm.last_inline():
            self.asm.emit("PUSH_CONSTANT", 0)
            self.asm.emit("RETURN")

    def piece(self, name, tok):
        index = self.pieces.get(name.lower())
        if index is None:
            raise CompileError(f"{tok.where}: unknown piece {name!r}")
        return index

    def statements(self, stmts):
        for stmt in stmts:
            self.statement(stmt)

    def statement(self, s: Node):
        asm = self.asm
        k = s.kind
        if k == "block":
            self.statements(s.body)
        elif k == "assign":
            self.expr(s.expr)
            low = s.target.lower()
            if low in self.locals:
                asm.emit("POP_LOCAL_VAR", self.locals[low])
            elif low in self.statics:
                asm.emit("POP_STATIC_VAR", self.statics[low])
            else:
                raise CompileError(f"{s.tok.where}: cannot assign to {s.target!r} (not a var or static-var)")
        elif k in ("move", "turn"):
            piece = self.piece(s.piece, s.tok)
            if s.speed is None:
                self.expr(s.dest)
                asm.emit("MOVE_NOW" if k == "move" else "TURN_NOW", piece, s.axis)
            else:
                self.expr(s.speed)
                self.expr(s.dest)
                asm.emit("MOVE" if k == "move" else "TURN", piece, s.axis)
        elif k == "spin":
            piece = self.piece(s.piece, s.tok)
            self.expr(s.accel) if s.accel is not None else asm.emit("PUSH_CONSTANT", 0)
            self.expr(s.speed)
            asm.emit("SPIN", piece, s.axis)
        elif k == "stop-spin":
            piece = self.piece(s.piece, s.tok)
            self.expr(s.decel) if s.decel is not None else asm.emit("PUSH_CONSTANT", 0)
            asm.emit("STOP_SPIN", piece, s.axis)
        elif k == "wait-for-turn":
            asm.emit("WAIT_FOR_TURN", self.piece(s.piece, s.tok), s.axis)
        elif k == "wait-for-move":
            asm.emit("WAIT_FOR_MOVE", self.piece(s.piece, s.tok), s.axis)
        elif k == "piece-op":
            asm.emit(s.op, self.piece(s.piece, s.tok))
        elif k == "emit-sfx":
            self.expr(s.sfx)
            asm.emit("EMIT_SFX", self.piece(s.piece, s.tok))
        elif k == "explode":
            self.expr(s.flags)
            asm.emit("EXPLODE", self.piece(s.piece, s.tok))
        elif k in ("sleep", "signal", "set-signal-mask", "drop-unit"):
            self.expr(s.expr)
            asm.emit({"sleep": "SLEEP", "signal": "SIGNAL", "set-signal-mask": "SET_SIGNAL_MASK",
                      "drop-unit": "DROP_UNIT"}[k])
        elif k in ("start-script", "call-script"):
            index = self.functions.get(s.name.lower())
            if index is None:
                raise CompileError(f"{s.tok.where}: unknown script {s.name!r}")
            for arg in s.args:
                self.expr(arg)
            asm.emit("START_SCRIPT" if k == "start-script" else "CALL_SCRIPT", index, len(s.args))
        elif k == "set":
            asm.emit("PUSH_CONSTANT", s.value_id)
            self.expr(s.expr)
            asm.emit("SET")
        elif k == "attach-unit":
            self.expr(s.unit)
            self.expr(s.piece)
            self.expr(s.pos) if s.pos is not None else asm.emit("PUSH_CONSTANT", 0)
            asm.emit("ATTACH_UNIT")
        elif k == "return":
            if s.expr is None:
                asm.emit("PUSH_CONSTANT", 0)
            else:
                self.expr(s.expr)
            asm.emit("RETURN")
        elif k == "if":
            self.expr(s.cond)
            end = asm.new_label()
            if s.other is None:
                asm.jump("JUMP_NOT_EQUAL", end)
                self.statements(s.then)
            else:
                other = asm.new_label()
                asm.jump("JUMP_NOT_EQUAL", other)
                self.statements(s.then)
                asm.jump("JUMP", end)
                asm.place(other)
                self.statements(s.other)
            asm.place(end)
        elif k == "while":
            top, end = asm.new_label(), asm.new_label()
            asm.place(top)
            self.expr(s.cond)
            asm.jump("JUMP_NOT_EQUAL", end)
            self.statements(s.body)
            asm.jump("JUMP", top)
            asm.place(end)
        else:
            raise CompileError(f"internal: unknown statement {k}")

    def expr(self, e: Node):
        asm = self.asm
        k = e.kind
        if k == "int":
            asm.emit("PUSH_CONSTANT", e.value)
        elif k == "name":
            low = e.name.lower()
            if low in self.locals:
                asm.emit("PUSH_LOCAL_VAR", self.locals[low])
            elif low in self.statics:
                asm.emit("PUSH_STATIC_VAR", self.statics[low])
            elif low in self.pieces:
                asm.emit("PUSH_CONSTANT", self.pieces[low])
            elif e.name.upper() in BUILTINS:
                asm.emit("PUSH_CONSTANT", BUILTINS[e.name.upper()])
            else:
                raise CompileError(f"{e.tok.where}: unknown name {e.name!r} (not a var, static-var, piece or #define)")
        elif k == "bin":
            self.expr(e.left)
            self.expr(e.right)
            asm.emit(BINARY_OPS[e.op])
        elif k == "neg":
            asm.emit("PUSH_CONSTANT", 0)
            self.expr(e.expr)
            asm.emit("SUB")
        elif k == "not":
            self.expr(e.expr)
            asm.emit("NOT")
        elif k == "bnot":
            self.expr(e.expr)
            asm.emit("BITWISE_NOT")
        elif k == "get":
            asm.emit("PUSH_CONSTANT", e.value_id)
            if not e.args:
                asm.emit("GET_UNIT_VALUE")
            else:
                for arg in e.args:
                    self.expr(arg)
                for _ in range(4 - len(e.args)):
                    asm.emit("PUSH_CONSTANT", 0)
                asm.emit("GET")
        elif k == "rand":
            self.expr(e.lo)
            self.expr(e.hi)
            asm.emit("RAND")
        else:
            raise CompileError(f"internal: unknown expression {k}")


def parse_bos(text: str, file: str = "<bos>", include_dirs=(), reader=None) -> Program:
    """Preprocess and parse. The editor stops here to lint; the compiler goes on."""
    return Parser(Preprocessor(include_dirs, reader).run(text, file)).parse()


def compile_bos(text: str, file: str = "<bos>", include_dirs=(), reader=None) -> Cob:
    return Compiler(parse_bos(text, file, include_dirs, reader)).compile()


# --------------------------------------------------------------------------- decompiler

class Value:
    """An expression on the decompiler's stack, with the word where it started."""
    __slots__ = ("node", "start")

    def __init__(self, node, start):
        self.node, self.start = node, start


def const(value, fmt="int", name=None):
    return Node("int", value=value, fmt=fmt, name=name)


class ScriptDecompiler:
    def __init__(self, cob: Cob, name, start, end, params, local_names):
        self.cob = cob
        self.name = name
        self.start, self.end = start, end
        self.ops = decode(cob.code, start, end)
        self.by_pc = {op.pc: i for i, op in enumerate(self.ops)}
        self.params = params
        self.local_names = local_names
        self.script_names = [n for n, _ in cob.scripts]
        self.piece_result = bool(PIECE_RESULT_SCRIPTS.match(name))

    def fail(self, pc, msg):
        raise DecompileError(f"{self.name} at word {pc}: {msg}")

    def run(self):
        i = 0
        ncreate = 0
        while i < len(self.ops) and self.ops[i].name == "CREATE_LOCAL_VAR":
            ncreate += 1
            i += 1
        if len(self.local_names) != ncreate:
            self.fail(self.start, f"internal: {ncreate} locals but {len(self.local_names)} names")
        body, i = self.statements(i, self.end)
        if i != len(self.ops):
            self.fail(self.ops[i].pc, "code after the script's last statement")
        # Scriptor's implicit return: the last opcode is always a RETURN, and a trailing
        # `return (0)` at top level is the one it appended (dropping it is exact either way).
        if not self.ops or self.ops[-1].name != "RETURN":
            self.fail(self.end - 1, "script does not end with a return")
        if body and body[-1].kind == "return" and body[-1].expr.kind == "int" \
                and body[-1].expr.value == 0 and body[-1].expr.name is None:
            body.pop()
        return body

    def piece_name(self, index, pc):
        if not 0 <= index < len(self.cob.pieces):
            self.fail(pc, f"piece index {index} out of range")
        return self.cob.pieces[index]

    def local(self, index, pc):
        if not 0 <= index < len(self.local_names):
            self.fail(pc, f"local {index} was never created")
        return self.local_names[index]

    def static(self, index, pc):
        if not 0 <= index < self.cob.statics:
            self.fail(pc, f"static {index} beyond the declared {self.cob.statics}")
        return f"static_var_{index + 1}"

    def index_of(self, target, pc):
        i = self.by_pc.get(target)
        if i is None:
            if target == self.end:
                return len(self.ops)
            self.fail(pc, f"jump to word {target}, which is not an instruction boundary")
        return i

    def statements(self, i, end_pc):
        """Parse ops[i:] while their pc < end_pc; returns (statements, next index)."""
        stmts = []
        stack = []

        def pop(pc):
            if not stack:
                self.fail(pc, "operand stack empty")
            return stack.pop()

        def push(node, start):
            stack.append(Value(node, start))

        def stmt(node):
            if stack:
                self.fail(op.pc, "a value is left on the stack before a statement")
            stmts.append(node)

        while i < len(self.ops) and self.ops[i].pc < end_pc:
            op = self.ops[i]
            n = op.name
            a = op.args
            if n == "PUSH_CONSTANT":
                push(const(a[0]), op.pc)
            elif n == "PUSH_LOCAL_VAR":
                push(Node("name", name=self.local(a[0], op.pc)), op.pc)
            elif n == "PUSH_STATIC_VAR":
                push(Node("name", name=self.static(a[0], op.pc)), op.pc)
            elif n in OPCODE_TO_OPERATOR:
                r = pop(op.pc)
                l = pop(op.pc)
                push(Node("bin", op=OPCODE_TO_OPERATOR[n], left=l.node, right=r.node), l.start)
            elif n == "NOT":
                v = pop(op.pc)
                push(Node("not", expr=v.node), v.start)
            elif n == "BITWISE_NOT":
                v = pop(op.pc)
                push(Node("bnot", expr=v.node), v.start)
            elif n == "RAND":
                hi = pop(op.pc)
                lo = pop(op.pc)
                push(Node("rand", lo=lo.node, hi=hi.node), lo.start)
            elif n == "GET_UNIT_VALUE":
                vid = pop(op.pc)
                push(Node("get", value_id=self.value_id(vid.node, op.pc), args=[]), vid.start)
            elif n == "GET":
                args = [pop(op.pc) for _ in range(4)][::-1]
                vid = pop(op.pc)
                nodes = [v.node for v in args]
                while nodes and nodes[-1].kind == "int" and nodes[-1].value == 0:
                    nodes.pop()
                value_id = self.value_id(vid.node, op.pc)
                if value_id in PIECE_ARG_VALUES and nodes and nodes[0].kind == "int" \
                        and nodes[0].name is None and 0 <= nodes[0].value < len(self.cob.pieces):
                    nodes[0] = const(nodes[0].value, "piece", self.cob.pieces[nodes[0].value])
                push(Node("get", value_id=value_id, args=nodes), vid.start)
            elif n == "POP_LOCAL_VAR":
                v = pop(op.pc)
                node = v.node
                if self.piece_result and node.kind == "int" and 0 <= node.value < len(self.cob.pieces) \
                        and a[0] < len(self.params):
                    node = const(node.value, "piece", self.cob.pieces[node.value])
                stmt(Node("assign", target=self.local(a[0], op.pc), expr=node))
            elif n == "POP_STATIC_VAR":
                v = pop(op.pc)
                stmt(Node("assign", target=self.static(a[0], op.pc), expr=v.node))
            elif n in ("MOVE", "TURN"):
                dest = pop(op.pc)
                speed = pop(op.pc)
                fmt = "lin" if n == "MOVE" else "ang"
                stmt(Node(n.lower(), piece=self.piece_name(a[0], op.pc), axis=a[1],
                          dest=self.tag(dest.node, fmt), speed=self.tag(speed.node, fmt)))
            elif n in ("MOVE_NOW", "TURN_NOW"):
                dest = pop(op.pc)
                fmt = "lin" if n == "MOVE_NOW" else "ang"
                stmt(Node(n[:4].lower(), piece=self.piece_name(a[0], op.pc), axis=a[1],
                          dest=self.tag(dest.node, fmt), speed=None))
            elif n == "SPIN":
                speed = pop(op.pc)
                accel = pop(op.pc)
                acc = self.tag(accel.node, "ang")
                if acc.kind == "int" and acc.value == 0:
                    acc = None
                stmt(Node("spin", piece=self.piece_name(a[0], op.pc), axis=a[1],
                          speed=self.tag(speed.node, "ang"), accel=acc))
            elif n == "STOP_SPIN":
                decel = self.tag(pop(op.pc).node, "ang")
                if decel.kind == "int" and decel.value == 0:
                    decel = None
                stmt(Node("stop-spin", piece=self.piece_name(a[0], op.pc), axis=a[1], decel=decel))
            elif n in ("WAIT_FOR_TURN", "WAIT_FOR_MOVE"):
                stmt(Node(n.lower().replace("_", "-"), piece=self.piece_name(a[0], op.pc), axis=a[1]))
            elif n in PIECE_OP_KEYWORDS:
                stmt(Node("piece-op", op=n, piece=self.piece_name(a[0], op.pc)))
            elif n == "EMIT_SFX":
                sfx = pop(op.pc)
                stmt(Node("emit-sfx", sfx=self.tag(sfx.node, "sfx"), piece=self.piece_name(a[0], op.pc)))
            elif n == "EXPLODE":
                flags = pop(op.pc)
                stmt(Node("explode", piece=self.piece_name(a[0], op.pc), flags=self.tag(flags.node, "explode")))
            elif n in ("SLEEP", "SIGNAL", "SET_SIGNAL_MASK", "DROP_UNIT"):
                v = pop(op.pc)
                stmt(Node(n.lower().replace("_", "-"), expr=v.node))
            elif n in ("START_SCRIPT", "CALL_SCRIPT"):
                if not 0 <= a[0] < len(self.script_names):
                    self.fail(op.pc, f"script index {a[0]} out of range")
                args = [pop(op.pc) for _ in range(a[1])][::-1]
                stmt(Node(n.lower().replace("_", "-"), name=self.script_names[a[0]],
                          args=[v.node for v in args]))
            elif n == "SET":
                value = pop(op.pc)
                vid = pop(op.pc)
                stmt(Node("set", value_id=self.value_id(vid.node, op.pc), expr=value.node))
            elif n == "ATTACH_UNIT":
                pos = pop(op.pc)
                piece = pop(op.pc)
                unit = pop(op.pc)
                pnode = piece.node
                if pnode.kind == "int" and 0 <= pnode.value < len(self.cob.pieces) and pnode.name is None:
                    pnode = const(pnode.value, "piece", self.cob.pieces[pnode.value])
                pos_node = pos.node
                if pos_node.kind == "int" and pos_node.value == 0:
                    pos_node = None
                stmt(Node("attach-unit", unit=unit.node, piece=pnode, pos=pos_node))
            elif n == "RETURN":
                v = pop(op.pc)
                stmt(Node("return", expr=v.node))
            elif n == "JUMP_NOT_EQUAL":
                cond = pop(op.pc)
                if stack:
                    self.fail(op.pc, "a value is left on the stack under an if/while condition")
                target = a[0]
                if target <= op.pc or target > end_pc:
                    self.fail(op.pc, f"conditional jump to word {target} leaves the block")
                j = self.index_of(target, op.pc)
                prev = self.ops[j - 1]
                if prev.name == "JUMP" and prev.args[0] == cond.start and j - 1 > i:
                    body, k = self.statements(i + 1, prev.pc)
                    if k != j - 1:
                        self.fail(prev.pc, "while body does not end at its back-jump")
                    stmts.append(Node("while", cond=cond.node, body=body))
                    i = j
                    continue
                if prev.name == "JUMP" and prev.args[0] > target and j - 1 > i:
                    if prev.args[0] > end_pc:
                        self.fail(prev.pc, f"else-jump to word {prev.args[0]} leaves the block")
                    then, k = self.statements(i + 1, prev.pc)
                    if k != j - 1:
                        self.fail(prev.pc, "then-branch does not end at its jump")
                    other_end = self.index_of(prev.args[0], prev.pc)
                    other, k = self.statements(j, prev.args[0])
                    if k != other_end:
                        self.fail(prev.args[0], "else-branch does not end at its target")
                    stmts.append(Node("if", cond=cond.node, then=then, other=other))
                    i = other_end
                    continue
                then, k = self.statements(i + 1, target)
                if k != j:
                    self.fail(op.pc, "if body does not end at its target")
                stmts.append(Node("if", cond=cond.node, then=then, other=None))
                i = j
                continue
            elif n == "JUMP":
                self.fail(op.pc, "a jump that is not the end of a while or an if/else")
            elif n == "CREATE_LOCAL_VAR":
                self.fail(op.pc, "a local created after the prologue")
            else:
                self.fail(op.pc, f"{n} has no BOS statement")
            i += 1
        if stack:
            self.fail(self.ops[i - 1].pc if i else self.start, "a value is left on the stack at the end of a block")
        return stmts, i

    def value_id(self, node, pc):
        if node.kind != "int":
            self.fail(pc, "get/set with a computed value id")
        return node.value

    def tag(self, node, fmt):
        """Format the constant leaves of an operand as linear/angular/flag names."""
        if node.kind == "int" and node.name is None:
            if fmt in ("lin", "ang"):
                return const(node.value, fmt)
            if fmt == "explode" and node.value in EXPLODE_NAMES:
                return const(node.value, "int", EXPLODE_NAMES[node.value])
            if fmt == "sfx" and node.value in SFX_NAMES:
                return const(node.value, "int", SFX_NAMES[node.value])
            return node
        if node.kind == "bin":
            return Node("bin", op=node.op, left=self.tag(node.left, fmt), right=self.tag(node.right, fmt))
        if node.kind in ("neg", "not", "bnot"):
            return Node(node.kind, expr=self.tag(node.expr, fmt))
        return node


class Writer:
    """BOS text in the Cavedog layout: tabs, `if( cond )`, one statement per line."""

    def __init__(self):
        self.lines = []

    def out(self, depth, text):
        self.lines.append("\t" * depth + text)

    def expr(self, e, parent_prec=0, right=False):
        k = e.kind
        if k == "int":
            if e.name is not None:
                return e.name
            if e.fmt == "lin":
                return format_linear(e.value)
            if e.fmt == "ang":
                return format_angular(e.value)
            return str(e.value)
        if k == "name":
            return e.name
        if k == "get":
            name = VALUE_NAMES.get(e.value_id, str(e.value_id))
            if e.args:
                return f"get {name}( {', '.join(self.expr(a) for a in e.args)} )"
            return f"get {name}"
        if k == "rand":
            return f"rand( {self.expr(e.lo)}, {self.expr(e.hi)} )"
        if k in ("not", "bnot", "neg"):
            sym = {"not": "!", "bnot": "~", "neg": "-"}[k]
            return sym + self.expr(e.expr, UNARY_PRECEDENCE)
        if k == "bin":
            prec = PRECEDENCE[e.op]
            text = f"{self.expr(e.left, prec)} {e.op} {self.expr(e.right, prec, right=True)}"
            if prec < parent_prec or (right and prec == parent_prec):
                return f"({text})"
            return text
        raise DecompileError(f"internal: cannot print {k}")

    def block(self, depth, stmts):
        self.out(depth, "{")
        for s in stmts:
            self.statement(depth + 1, s)
        self.out(depth, "}")

    def statement(self, depth, s):
        k = s.kind
        ex = self.expr
        if k == "assign":
            self.out(depth, f"{s.target} = {ex(s.expr)};")
        elif k in ("move", "turn"):
            axis = AXIS_NAMES[s.axis]
            if s.speed is None:
                self.out(depth, f"{k} {s.piece} to {axis} {ex(s.dest)} now;")
            else:
                self.out(depth, f"{k} {s.piece} to {axis} {ex(s.dest)} speed {ex(s.speed)};")
        elif k == "spin":
            tail = f" accelerate {ex(s.accel)}" if s.accel is not None else ""
            self.out(depth, f"spin {s.piece} around {AXIS_NAMES[s.axis]} speed {ex(s.speed)}{tail};")
        elif k == "stop-spin":
            tail = f" decelerate {ex(s.decel)}" if s.decel is not None else ""
            self.out(depth, f"stop-spin {s.piece} around {AXIS_NAMES[s.axis]}{tail};")
        elif k == "wait-for-turn":
            self.out(depth, f"wait-for-turn {s.piece} around {AXIS_NAMES[s.axis]};")
        elif k == "wait-for-move":
            self.out(depth, f"wait-for-move {s.piece} along {AXIS_NAMES[s.axis]};")
        elif k == "piece-op":
            self.out(depth, f"{PIECE_OP_KEYWORDS[s.op]} {s.piece};")
        elif k == "emit-sfx":
            self.out(depth, f"emit-sfx {ex(s.sfx)} from {s.piece};")
        elif k == "explode":
            self.out(depth, f"explode {s.piece} type {ex(s.flags)};")
        elif k in ("sleep", "signal", "set-signal-mask", "drop-unit"):
            self.out(depth, f"{k} {ex(s.expr)};")
        elif k in ("start-script", "call-script"):
            self.out(depth, f"{k} {s.name}({', '.join(ex(a) for a in s.args)});")
        elif k == "set":
            self.out(depth, f"set {VALUE_NAMES.get(s.value_id, str(s.value_id))} to {ex(s.expr)};")
        elif k == "attach-unit":
            tail = f" {ex(s.pos)}" if s.pos is not None else ""
            self.out(depth, f"attach-unit {ex(s.unit)} to {ex(s.piece)}{tail};")
        elif k == "return":
            self.out(depth, f"return ({ex(s.expr)});" if s.expr is not None else "return;")
        elif k == "if":
            self.out(depth, f"if( {ex(s.cond)} )")
            self.block(depth, s.then)
            if s.other is not None:
                self.out(depth, "else")
                self.block(depth, s.other)
        elif k == "while":
            self.out(depth, f"while( {ex(s.cond)} )")
            self.block(depth, s.body)
        elif k == "block":
            self.block(depth, s.body)
        else:
            raise DecompileError(f"internal: cannot print statement {k}")


def infer_params(cob: Cob):
    """Parameter names per script: the engine's conventions, else the callers' arg counts."""
    names = [n for n, _ in cob.scripts]
    called_with = {n: 0 for n in names}
    ranges = script_ranges(cob)
    for name, start, end in ranges:
        try:
            ops = decode(cob.code, start, end)
        except DecompileError:
            continue
        for op in ops:
            if op.name in ("START_SCRIPT", "CALL_SCRIPT") and 0 <= op.args[0] < len(names):
                callee = names[op.args[0]]
                called_with[callee] = max(called_with[callee], op.args[1])
    return called_with


def decompile_cob(cob: Cob, unit: str = None):
    """(bos text, failures) — failures is [(script, message)]; failed scripts are listed as comments."""
    w = Writer()
    w.out(0, f"// {unit or 'unit'} - decompiled by tools/tacob; compiles back byte-identical")
    w.out(0, '#include "exptype.h"')
    w.out(0, '#include "sfxtype.h"')
    w.out(0, "")
    if cob.pieces:
        w.out(0, f"piece {', '.join(cob.pieces)};")
        w.out(0, "")
    if cob.statics:
        w.out(0, f"static-var {', '.join(f'static_var_{i + 1}' for i in range(cob.statics))};")
        w.out(0, "")
    called_with = infer_params(cob)
    failures = []
    for name, start, end in script_ranges(cob):
        try:
            ops = decode(cob.code, start, end)
            ncreate = 0
            for op in ops:
                if op.name != "CREATE_LOCAL_VAR":
                    break
                ncreate += 1
            params = PARAM_NAMES.get(name.lower()) or weapon_params(name)
            if params is None:
                params = [f"arg{k + 1}" for k in range(called_with[name])]
            params = params[:ncreate]
            hinted = LOCAL_NAMES.get(name.lower(), [])
            local_names = list(params)
            for k in range(ncreate - len(params)):
                local_names.append(hinted[k] if k < len(hinted) else f"var{k + 1}")
            body = ScriptDecompiler(cob, name, start, end, params, local_names).run()
        except DecompileError as e:
            failures.append((name, str(e)))
            w.out(0, f"// tacob: could not decompile {name}: {e}")
            w.out(0, "// " + " / ".join(f"{op.pc}:{op.name}{tuple(op.args) if op.args else ''}"
                                        for op in _safe_decode(cob, start, end)))
            w.out(0, "")
            continue
        w.out(0, f"{name}({', '.join(params)})")
        w.out(0, "{")
        extra = local_names[len(params):]
        if extra:
            w.out(1, f"var {', '.join(extra)};")
        for s in body:
            w.statement(1, s)
        w.out(0, "}")
        w.out(0, "")
    return "\n".join(w.lines).rstrip("\n") + "\n", failures


def _safe_decode(cob, start, end):
    try:
        return decode(cob.code, start, end)
    except DecompileError:
        return []


def listing(cob: Cob, only: str = None):
    names = [n for n, _ in cob.scripts]
    lines = [f"{len(cob.scripts)} scripts, {len(cob.pieces)} pieces, {len(cob.code)} words, "
             f"{cob.statics} statics",
             "pieces: " + " ".join(f"{i}={p}" for i, p in enumerate(cob.pieces))]
    for name, start, end in script_ranges(cob):
        if only and name.lower() != only.lower():
            continue
        lines.append(f"--- {name} @{start}")
        try:
            ops = decode(cob.code, start, end)
        except DecompileError as e:
            lines.append(f"    ?? {e}")
            continue
        for op in ops:
            a = op.args
            if op.name in ("MOVE", "TURN", "SPIN", "STOP_SPIN", "MOVE_NOW", "TURN_NOW",
                           "WAIT_FOR_TURN", "WAIT_FOR_MOVE"):
                text = f"{_piece(cob, a[0])} {AXIS_NAMES.get(a[1], a[1])}"
            elif op.name in ("SHOW", "HIDE", "CACHE", "DONT_CACHE", "SHADE", "DONT_SHADE",
                             "EMIT_SFX", "EXPLODE"):
                text = _piece(cob, a[0])
            elif op.name in ("START_SCRIPT", "CALL_SCRIPT"):
                text = f"{names[a[0]] if 0 <= a[0] < len(names) else a[0]} nargs={a[1]}"
            else:
                text = " ".join(str(x) for x in a)
            lines.append(f"  {op.pc:5d}  {op.name:16s} {text}")
    return "\n".join(lines)


def _piece(cob, index):
    return cob.pieces[index] if 0 <= index < len(cob.pieces) else f"piece#{index}"


# --------------------------------------------------------------------------- the virtual machine

# Every constant and rule below was read out of the retail binary; the addresses
# are in research/notes/exe-reverse-engineering.md §"The COB engine". The engine
# is the reference, not Spring: where the two differ this follows the engine.

SIM_RATE = 30                 # cob+0x04 (0x4B0641); sleep ticks and MOVE/TURN speeds divide by it

ST_FREE      = 0x00000000     # the eight status words (alloc 0x4B08F9, dispatch 0x4B0DBF)
ST_RUN       = 0x01000000
ST_WAIT_TURN = 0x02100000
ST_WAIT_MOVE = 0x02200000
ST_SLEEP     = 0x02400000
ST_CALL      = 0x02800000

REC_WORDS = 32                # the record's stack, +0x24 to the end of the 0xA4 bytes
NRECORDS = 8

# the piece animation array (cob+0x14): 19 dwords per piece, three axes per group
PIECE_FIELDS = 19
F_DIRTY, F_MOVE_TARGET, F_MOVE_SPEED = 0, 1, 4
F_TURN_TARGET, F_TURN_SPEED, F_SPIN_TARGET, F_SPIN_ACCEL = 7, 10, 13, 16


def i32(v):
    v &= 0xFFFFFFFF
    return v - (1 << 32) if v & 0x80000000 else v


def idiv(a, b):
    """C's idiv: truncate toward zero (Python's // floors)."""
    q = abs(a) // abs(b)
    return -q if (a < 0) != (b < 0) else q


class Thread:
    """One 0xA4-byte record. Nothing clears it on free — an unwritten local reads
    whatever the record last held there (CREATE_LOCAL_VAR only bumps the index)."""

    __slots__ = ("status", "pc", "sp", "sleep", "piece", "axis", "child", "mask", "cb", "stack")

    def __init__(self):
        self.status = ST_FREE
        self.pc = 0
        self.sp = -1
        self.sleep = 0
        self.piece = 0
        self.axis = 0
        self.child = -1
        self.mask = 1
        self.cb = None
        self.stack = [0] * REC_WORDS


class AimCallback:
    """The completion object the engine hands an Aim* start (vtable 0x4FD6F0):
    `if (value) slot->aimed = 1`, and a refused start gets called with 0 at once."""

    def __init__(self):
        self.aimed = 0
        self.calls = []

    def __call__(self, value):
        self.calls.append(value)
        if value:
            self.aimed = 1


class UnitWorld:
    """Everything `get`, `set` and the effect opcodes reach: the twenty stock value
    ids (file-formats.md §2.5), the RNG, and a log of the effects the script asks for.
    The cobtrace oracle carries none of this traffic, so it is the replay's input."""

    def __init__(self, values=None, rands=None):
        self.values = {VALUE_IDS["ACTIVATION"]: 0, VALUE_IDS["HEALTH"]: 100,
                       VALUE_IDS["BUILD_PERCENT_LEFT"]: 0}
        if values:
            self.values.update(values)
        self.rands = list(rands or ())      # the draws to hand back, in order
        self.draws = 0
        self.effects = []                   # (tick, kind, piece, arg)
        self.unknown = set()

    def get(self, vid, a, b, c, d):
        if vid in self.values:
            return self.values[vid]
        if vid > 20:                        # TADR/ProTA extensions this engine lacks
            self.unknown.add(vid)
            return 0
        self.unknown.add(vid)
        return 0

    def set(self, vid, value):
        self.values[vid] = value

    def rand(self, n, lo):
        """`0x4B6C30(n)` — the shared sim RNG; it returns 0 for n < 2. `lo` is only
        here because the oracle records `lo + r`, which is what a replay hands back."""
        r = 0 if n < 2 else self.draws
        self.draws += 1
        return r

    def effect(self, tick, kind, piece, arg=None):
        self.effects.append((tick, kind, piece, arg))


class CobVM:
    """The eight-record thread pool of one unit, running its COB the way
    0x4B0DA0 and 0x4B1C00 do. `tick` is set by whoever drives it."""

    def __init__(self, cob, world=None, trace=None, unit=1, type_name="?", visible=None):
        self.cob = cob
        self.code = [w & 0xFFFFFFFF for w in cob.code]
        self.names = [n for n, _ in cob.scripts]
        self.entries = [e for _, e in cob.scripts]
        self.world = world if world is not None else UnitWorld()
        self.trace = trace
        self.unit = unit
        self.type = type_name
        self.tick = 0
        self.threads = [Thread() for _ in range(NRECORDS)]
        self.running = 0                                  # cob+0x53C
        self.statics = [0] * cob.statics                  # cob+0x10, zero-filled
        self.anim = [0] * (PIECE_FIELDS * len(cob.pieces))  # cob+0x14, zero-filled
        self.dirty = 0                                    # cob+0x18
        self.pos = [[0, 0, 0] for _ in cob.pieces]        # PrimitiveStruct XPos/ZPos/YPos, 16.16
        self.ang = [[0, 0, 0] for _ in cob.pieces]        # XTurn/ZTurn/YTurn, uint16
        # 0x45AF1B: the model builder clears PrimitiveStruct+0x28 bit 0 for a piece
        # whose 3DO node has fewer than three vertices — every flare, wake, tube and
        # thrust anchor starts invisible without the script hiding it
        self.visible = list(visible) if visible else [True] * len(cob.pieces)
        self.cached = [True] * len(cob.pieces)
        self.shaded = [True] * len(cob.pieces)
        self._pend = None                                 # the latched start, as the oracle latches it

    # -- names ------------------------------------------------------------
    def index_of(self, name):
        """Name2Index 0x4B07C0: the first entry whose name matches."""
        try:
            return self.names.index(name)
        except ValueError:
            return -1

    def script_of_pc(self, pc):
        """The script whose body holds pc — the largest entry <= pc, ties to the
        last index (tagpu_cobtrace.c script_of_pc, which the R and K lines use)."""
        best = -1
        for i, e in enumerate(self.entries):
            if e <= pc and (best < 0 or e >= self.entries[best]):
                best = i
        return self.names[best] if best >= 0 else "?"

    # -- the trace's latch ------------------------------------------------
    def flush_start(self):
        """The oracle writes a start at the next hook event, reading the record's
        stack then: the callers write the arguments only after the allocator returns."""
        p = self._pend
        if p is None:
            return
        self._pend = None
        if self.trace is None:
            return
        slot, idx, tick, src, parent, argc = p
        rec = self.threads[slot]
        if argc < 0:
            argc = rec.sp + 1
        argc = max(0, min(argc, REC_WORDS))
        args = ",".join(str(i32(rec.stack[i])) for i in range(argc))
        where = "E" if src == "E" else "%s:%d" % (src, parent)
        self.trace("S\t%d\t%d\t%s\t%s\t%d\t%s\t%s"
                   % (tick, self.unit, self.type, self.names[idx], slot, where, args))

    def _emit(self, line):
        if self.trace is not None:
            self.trace(line)

    # -- the pool ---------------------------------------------------------
    def alloc(self, idx, src="E", parent=-1, argc=-1):
        """COBEngine_AllocThread 0x4B08C0. -1 for a script the file lacks and for a
        full pool alike; the first free slot from 0, and the record is not cleared."""
        self.flush_start()
        if idx < 0 or idx >= len(self.names):
            return -1
        for slot in range(NRECORDS):
            rec = self.threads[slot]
            if rec.status == ST_FREE:
                rec.status = ST_RUN
                rec.pc = self.entries[idx]
                rec.sp = -1
                rec.cb = None
                rec.mask = 1
                self.running += 1
                self._pend = (slot, idx, self.tick, src, parent, argc)
                return slot
        self._emit("X\t%d\t%d\t%s\t%s" % (self.tick, self.unit, self.names[idx], src))
        return -1

    def free(self, slot):
        self.threads[slot].status = ST_FREE
        self.running -= 1

    def wake_callers(self, slot):
        """Every record blocked in a call on `slot` goes runnable (0x4B19FF, 0x4B1AB1)."""
        for rec in self.threads:
            if (rec.status & 0xFFF00000) == ST_CALL and rec.child == slot:
                rec.status = ST_RUN

    # -- the engine's entries ---------------------------------------------
    def start_script(self, name, run_now=False, args=(), cb=None, argwords=False):
        """0x4B0B00 (by index, four argument words, `sp = argc-1`) when `argwords`,
        else 0x4B0940 (no arguments at all, `sp` stays -1)."""
        slot = self.alloc(self.index_of(name), argc=len(args) if argwords else -1)
        if slot < 0:
            if argwords and cb is not None:
                cb(0)                       # 0x4B0B11: a refused Aim* reports "not aimed" at once
            return 0
        rec = self.threads[slot]
        rec.cb = cb
        if argwords:
            for i in range(4):              # a0..a3 land on the record whatever argc says
                rec.stack[i] = i32(args[i]) if i < len(args) else 0
            rec.sp = len(args) - 1
        if run_now:
            if self.running:
                for s in range(NRECORDS):
                    self.run_thread(s, 0)
            self.step_anim(0)
        return 1

    def query_script(self, name, args):
        """COBEngine_QueryScript 0x4B0C40: four words in, `sp = 3`, the thread runs
        to its first block inside the call, then stack[0..3] comes back out."""
        slot = self.alloc(self.index_of(name))
        if slot < 0:
            return None                     # the silent failure: the out-slots stay untouched
        rec = self.threads[slot]
        rec.cb = None
        for i in range(4):
            rec.stack[i] = i32(args[i]) if i < len(args) else 0
        rec.sp = 3
        self.run_thread(slot, 0)
        return [i32(rec.stack[i]) for i in range(4)]

    def do_scripts_now(self, dt):
        """COBEngine_DoScriptsNow 0x4B0D60 — the per-unit tick, called with dt = 1."""
        for slot in range(NRECORDS):
            self.run_thread(slot, dt)
        self.step_anim(dt)

    # -- the runner -------------------------------------------------------
    def run_thread(self, slot, dt):
        """0x4B0DA0: wake the record if its block has cleared, then execute
        opcodes back to back until one blocks it or ends it."""
        self.flush_start()
        rec = self.threads[slot]
        top = rec.status & 0xFF000000
        if top == 0:
            return
        if top == 0x02000000:
            sub = rec.status & 0x00F00000
            if sub == 0x100000:                     # wait-for-turn
                base = rec.piece * PIECE_FIELDS
                if self.anim[base + F_TURN_SPEED + rec.axis] == 0:
                    rec.status = ST_RUN
            elif sub == 0x200000:                   # wait-for-move
                base = rec.piece * PIECE_FIELDS
                if self.anim[base + F_MOVE_SPEED + rec.axis] == 0:
                    rec.status = ST_RUN
            elif sub == 0x400000:                   # sleeping
                rec.sleep -= dt
                if rec.sleep <= 0:
                    rec.status = ST_RUN
            # 0x800000 (blocked in a call) is never woken here — only the child's
            # RETURN or a signal that kills the child does that
        if (rec.status & 0xFF000000) != ST_RUN:
            return
        self.exec_thread(slot)

    def exec_thread(self, slot):
        """The opcode loop. `pc` stays on the executing word until the tail advances
        it (0x4B1BD5/0x4B1BD9), which is the pc a K line reports."""
        rec = self.threads[slot]
        code, anim = self.code, self.anim
        while True:
            pc = rec.pc
            word = code[pc]
            op = word & 0x100FF000
            nxt = None                      # None = the tail's pc+1; False = stop

            if op == 0x10001000:            # MOVE piece axis; pops target then speed
                piece, axis = code[pc + 1], code[pc + 2]
                base = piece * PIECE_FIELDS
                target = i32(rec.stack[rec.sp]); rec.sp -= 1
                anim[base + F_MOVE_TARGET + axis] = target
                speed = i32(rec.stack[rec.sp]); rec.sp -= 1
                speed = idiv(speed, SIM_RATE)
                if target < self.pos[piece][axis]:
                    speed = -speed
                anim[base + F_MOVE_SPEED + axis] = speed
                anim[base + F_DIRTY] = 1
                self.dirty = 1
                nxt = pc + 3
            elif op == 0x10002000:          # TURN piece axis; the short way round
                piece, axis = code[pc + 1], code[pc + 2]
                base = piece * PIECE_FIELDS
                target = i32(rec.stack[rec.sp]) & 0xFFFF; rec.sp -= 1
                anim[base + F_TURN_TARGET + axis] = target
                anim[base + F_SPIN_ACCEL + axis] = 0
                speed = idiv(i32(rec.stack[rec.sp]), SIM_RATE); rec.sp -= 1
                delta = target - self.ang[piece][axis]
                if delta == 0:
                    speed = 0
                elif (abs(delta) > 0x8000) != (delta < 0):
                    speed = -speed
                anim[base + F_TURN_SPEED + axis] = speed
                anim[base + F_DIRTY] = 1
                self.dirty = 1
                nxt = pc + 3
            elif op == 0x10003000:          # SPIN piece axis; pops speed then acceleration
                piece, axis = code[pc + 1], code[pc + 2]
                base = piece * PIECE_FIELDS
                anim[base + F_TURN_TARGET + axis] = -1     # "no target": the stepper never arrives
                anim[base + F_SPIN_TARGET + axis] = idiv(i32(rec.stack[rec.sp]), SIM_RATE); rec.sp -= 1
                anim[base + F_SPIN_ACCEL + axis] = idiv(i32(rec.stack[rec.sp]), SIM_RATE); rec.sp -= 1
                if anim[base + F_SPIN_ACCEL + axis] == 0:
                    anim[base + F_TURN_SPEED + axis] = anim[base + F_SPIN_TARGET + axis]
                anim[base + F_DIRTY] = 1
                self.dirty = 1
                nxt = pc + 3
            elif op == 0x10004000:          # STOP_SPIN piece axis; pops the deceleration
                piece, axis = code[pc + 1], code[pc + 2]
                base = piece * PIECE_FIELDS
                anim[base + F_SPIN_TARGET + axis] = 0
                accel = -idiv(i32(rec.stack[rec.sp]), SIM_RATE); rec.sp -= 1
                anim[base + F_SPIN_ACCEL + axis] = accel
                if accel == 0:
                    anim[base + F_TURN_SPEED + axis] = 0
                nxt = pc + 3                # 0x4B18F8: neither the dirty flag nor cob+0x18 is set
            elif op in (0x10005000, 0x10006000):    # SHOW / HIDE
                self.visible[code[pc + 1]] = (op == 0x10005000)
                nxt = pc + 2
            elif op in (0x10007000, 0x10008000):    # CACHE / DONT_CACHE
                self.cached[code[pc + 1]] = (op == 0x10007000)
                nxt = pc + 2
            elif op == 0x10009000:          # two pops through vt+0x28 [unknown]
                rec.sp -= 2
                nxt = pc + 2
            elif op == 0x1000A000:          # vt+0x2C(piece) [unknown]
                nxt = pc + 2
            elif op == 0x1000B000:          # MOVE_NOW piece axis
                piece, axis = code[pc + 1], code[pc + 2]
                base = piece * PIECE_FIELDS
                target = i32(rec.stack[rec.sp]); rec.sp -= 1
                anim[base + F_MOVE_TARGET + axis] = target
                anim[base + F_MOVE_SPEED + axis] = 0
                self.pos[piece][axis] = target
                nxt = pc + 3
            elif op == 0x1000C000:          # TURN_NOW piece axis
                piece, axis = code[pc + 1], code[pc + 2]
                base = piece * PIECE_FIELDS
                angle = i32(rec.stack[rec.sp]) & 0xFFFF; rec.sp -= 1
                anim[base + F_TURN_TARGET + axis] = angle
                anim[base + F_SPIN_ACCEL + axis] = 0
                anim[base + F_TURN_SPEED + axis] = 0
                self.ang[piece][axis] = angle
                nxt = pc + 3
            elif op in (0x1000D000, 0x1000E000):    # SHADE / DONT_SHADE
                self.shaded[code[pc + 1]] = (op == 0x1000D000)
                nxt = pc + 2
            elif op == 0x1000F000:          # EMIT_SFX piece; pops the type
                sfx = i32(rec.stack[rec.sp]); rec.sp -= 1
                self.world.effect(self.tick, "emit-sfx", code[pc + 1], sfx)
                nxt = pc + 2
            elif op == 0x10011000:          # WAIT_FOR_TURN piece axis
                rec.piece, rec.axis = code[pc + 1], code[pc + 2]
                rec.status = ST_WAIT_TURN
                rec.pc = pc + 3
                return
            elif op == 0x10012000:          # WAIT_FOR_MOVE piece axis
                rec.piece, rec.axis = code[pc + 1], code[pc + 2]
                rec.status = ST_WAIT_MOVE
                rec.pc = pc + 3
                return
            elif op == 0x10013000:          # SLEEP; ms x rate / 1000, truncated
                ms = i32(rec.stack[rec.sp]); rec.sp -= 1
                rec.sleep = idiv(ms * SIM_RATE, 1000)
                rec.status = ST_SLEEP
                rec.pc = pc + 1
                return
            elif op == 0x10021000:          # PUSH constant / local / static
                sel = word & 7
                if sel == 1:
                    value = i32(code[pc + 1])
                elif sel == 2:
                    value = rec.stack[code[pc + 1]]
                elif sel == 4:
                    value = self.statics[code[pc + 1]]
                else:
                    value = 0
                rec.sp += 1
                rec.stack[rec.sp] = value
                nxt = pc + 2
            elif op == 0x10022000:          # CREATE_LOCAL_VAR: the index moves, nothing is written
                rec.sp += 1
                rec.pc = pc + 1
                continue
            elif op == 0x10023000:          # POP into a local or a static
                value = rec.stack[rec.sp]; rec.sp -= 1
                sel = word & 7
                if sel == 2:
                    rec.stack[code[pc + 1]] = value
                elif sel == 4:
                    self.statics[code[pc + 1]] = value
                nxt = pc + 2
            elif op == 0x10024000:          # POP_STACK
                rec.sp -= 1
                rec.pc = pc + 1
                continue
            elif 0x10031000 <= op <= 0x10038000 or 0x10051000 <= op <= 0x1005A000:
                self.arith(rec, op)
            elif op == 0x10041000:          # RAND: pops hi then lo, pushes lo + rng(hi-lo+1)
                hi = i32(rec.stack[rec.sp]); rec.sp -= 1
                lo = i32(rec.stack[rec.sp]); rec.sp -= 1
                self.flush_start()
                r = self.world.rand(hi - lo + 1, lo)
                value = i32(lo + r)
                rec.sp += 1
                rec.stack[rec.sp] = value
                self._emit("D\t%d\t%d\t%d\t%d" % (self.tick, self.unit, slot, value))
            elif op == 0x10042000:          # GET_UNIT_VALUE: pops the id
                vid = i32(rec.stack[rec.sp]); rec.sp -= 1
                rec.sp += 1
                rec.stack[rec.sp] = i32(self.world.get(vid, 0, 0, 0, 0))
            elif op == 0x10044000:          # vt+0x48(x) [unknown], one pop
                rec.stack[rec.sp] = 0
            elif op == 0x10045000:          # vt+0x4C() [unknown], no pops
                rec.sp += 1
                rec.stack[rec.sp] = 0
            elif op == 0x10043000:          # GET id, a, b, c, d
                d = i32(rec.stack[rec.sp]); rec.sp -= 1
                c = i32(rec.stack[rec.sp]); rec.sp -= 1
                b = i32(rec.stack[rec.sp]); rec.sp -= 1
                a = i32(rec.stack[rec.sp]); rec.sp -= 1
                vid = i32(rec.stack[rec.sp]); rec.sp -= 1
                rec.sp += 1
                rec.stack[rec.sp] = i32(self.world.get(vid, a, b, c, d))
            elif op == 0x10061000:          # START_SCRIPT index argc
                idx, argc = code[pc + 1], i32(code[pc + 2])
                child = self.alloc(idx, "C", slot, argc)
                if child >= 0:
                    ch = self.threads[child]
                    for k in range(argc - 1, -1, -1):
                        ch.stack[k] = rec.stack[rec.sp]
                        rec.sp -= 1
                    ch.mask = rec.mask
                nxt = pc + 3                # a refused start leaves the argc words on our stack
            elif op == 0x10062000:          # CALL_SCRIPT index argc
                idx, argc = code[pc + 1], i32(code[pc + 2])
                child = self.alloc(idx, "L", slot, argc)
                if child >= 0:
                    ch = self.threads[child]
                    for k in range(argc - 1, -1, -1):
                        ch.stack[k] = rec.stack[rec.sp]
                        rec.sp -= 1
                    ch.mask = rec.mask
                rec.child = child           # written even when it is -1: nothing wakes that caller
                rec.pc = pc + 3
                rec.status = ST_CALL
                return
            elif op == 0x10063000:          # pops [pc+2] words into the runner's frame [unknown]
                rec.sp -= i32(code[pc + 2])
                rec.pc = pc + 3
                continue
            elif op == 0x10064000:          # JUMP
                nxt = code[pc + 1]
            elif op == 0x10065000:          # RETURN
                self.flush_start()
                sp = rec.sp
                value = str(i32(rec.stack[sp])) if 0 <= sp < REC_WORDS else "?"
                self._emit("R\t%d\t%d\t%d\t%s\t%s"
                           % (self.tick, self.unit, slot, self.script_of_pc(pc), value))
                if rec.cb is not None:
                    rec.cb(i32(rec.stack[rec.sp]))
                    rec.sp -= 1
                self.free(slot)
                self.wake_callers(slot)
                return
            elif op == 0x10066000:          # JUMP_NOT_EQUAL: jumps when the value is zero
                value = rec.stack[rec.sp]; rec.sp -= 1
                nxt = code[pc + 1] if value == 0 else pc + 2
            elif op == 0x10067000:          # SIGNAL
                mask = i32(rec.stack[rec.sp]); rec.sp -= 1
                stop = False
                for k in range(NRECORDS):
                    other = self.threads[k]
                    if other.status == ST_FREE or not (other.mask & mask):
                        continue
                    self.flush_start()
                    self._emit("K\t%d\t%d\t%d\t%s\t%d"
                               % (self.tick, self.unit, k, self.script_of_pc(other.pc), slot))
                    self.free(k)            # its RETURN never runs, so no callback either
                    self.wake_callers(k)
                    if k == slot:
                        stop = True
                if stop:
                    rec.pc = pc + 1
                    return
                nxt = pc + 1
            elif op == 0x10068000:          # SET_SIGNAL_MASK
                rec.mask = i32(rec.stack[rec.sp]); rec.sp -= 1
                rec.pc = pc + 1
                continue
            elif op == 0x10071000:          # EXPLODE piece; pops the flags
                flags = i32(rec.stack[rec.sp]); rec.sp -= 1
                self.world.effect(self.tick, "explode", code[pc + 1], flags)
                nxt = pc + 2
            elif op == 0x10082000:          # SET id value
                value = i32(rec.stack[rec.sp]); rec.sp -= 1
                vid = i32(rec.stack[rec.sp]); rec.sp -= 1
                self.world.set(vid, value)
            elif op == 0x10083000:          # ATTACH_UNIT: three pops
                a = i32(rec.stack[rec.sp]); rec.sp -= 1
                b = i32(rec.stack[rec.sp]); rec.sp -= 1
                c = i32(rec.stack[rec.sp]); rec.sp -= 1
                self.world.effect(self.tick, "attach-unit", None, (c, b, a))
            elif op == 0x10084000:          # DROP_UNIT: one pop
                a = i32(rec.stack[rec.sp]); rec.sp -= 1
                self.world.effect(self.tick, "drop-unit", None, a)
            else:                           # 0x4B1B60: an unknown opcode kills the thread silently
                self.free(slot)
                return

            rec.pc = (pc + 1) if nxt is None else nxt

    def arith(self, rec, op):
        """The two-operand words (0x4B1479..0x4B18AB). `b` is the top of the stack."""
        if op == 0x10038000:                # BITWISE_NOT: neither pops nor pushes
            rec.stack[rec.sp] = i32(~rec.stack[rec.sp])
            return
        if op == 0x1005A000:                # NOT (logical): the same, as a 0/1
            rec.stack[rec.sp] = 1 if rec.stack[rec.sp] == 0 else 0
            return
        b = i32(rec.stack[rec.sp]); rec.sp -= 1
        a = i32(rec.stack[rec.sp])
        if op == 0x10031000:   v = a + b
        elif op == 0x10032000: v = a - b
        elif op == 0x10033000: v = a * b
        elif op == 0x10034000: v = idiv(a, b) if b else 0   # MOD shares this handler: op & mask
        elif op == 0x10035000: v = a & b
        elif op == 0x10036000: v = a | b
        elif op == 0x10037000: v = a ^ b
        elif op == 0x10051000: v = 1 if a < b else 0
        elif op == 0x10052000: v = 1 if a <= b else 0
        elif op == 0x10053000: v = 1 if a > b else 0
        elif op == 0x10054000: v = 1 if a >= b else 0
        elif op == 0x10055000: v = 1 if a == b else 0
        elif op == 0x10056000: v = 1 if a != b else 0
        elif op == 0x10057000: v = 1 if (a and b) else 0
        elif op == 0x10058000: v = 1 if (a or b) else 0     # 0x4B1829 pushes a, which is 0 there
        elif op == 0x10059000: v = a ^ b                    # 0x4B1875: XOR is the bitwise word
        else: v = a
        rec.stack[rec.sp] = i32(v)

    # -- the animation stepper --------------------------------------------
    def step_anim(self, dt):
        """0x4B1C00. Returns at once on dt == 0 or with nothing animating; else clears
        each piece's flag, advances its three axes, and re-sets the flag if any is
        still travelling — which is exactly what wait-for-turn/-move test."""
        if dt == 0 or not self.dirty:
            return
        self.dirty = 0
        anim = self.anim
        for piece in range(len(self.pos)):
            base = piece * PIECE_FIELDS
            if anim[base + F_DIRTY] == 0:
                continue
            anim[base + F_DIRTY] = 0
            for axis in range(3):
                speed = anim[base + F_MOVE_SPEED + axis]
                if speed:
                    target = anim[base + F_MOVE_TARGET + axis]
                    value = self.pos[piece][axis] + dt * speed
                    if (speed > 0 and value >= target) or (speed < 0 and value <= target):
                        value = target
                        anim[base + F_MOVE_SPEED + axis] = 0
                    else:
                        anim[base + F_DIRTY] = 1
                    self.pos[piece][axis] = i32(value)
                accel = anim[base + F_SPIN_ACCEL + axis]
                if accel:
                    anim[base + F_TURN_SPEED + axis] += accel
                    target = anim[base + F_SPIN_TARGET + axis]
                    speed = anim[base + F_TURN_SPEED + axis]
                    if (accel > 0 and speed >= target) or (accel < 0 and speed <= target):
                        anim[base + F_TURN_SPEED + axis] = target
                        anim[base + F_SPIN_ACCEL + axis] = 0
                speed = anim[base + F_TURN_SPEED + axis]
                if speed == 0:
                    continue
                cur = self.ang[piece][axis]
                step = dt * speed
                value = cur + step
                target = anim[base + F_TURN_TARGET + axis]
                if target == -1:                        # a spin: it never arrives
                    anim[base + F_DIRTY] = 1
                elif speed > 0:
                    left = (target - cur + 0x10000) & 0xFFFF
                    if left > step:
                        anim[base + F_DIRTY] = 1
                    else:
                        value = target
                        anim[base + F_TURN_SPEED + axis] = 0
                else:
                    left = (cur - target + 0x10000) & 0xFFFF
                    if left > -step:
                        anim[base + F_DIRTY] = 1
                    else:
                        value = target
                        anim[base + F_TURN_SPEED + axis] = 0
                self.ang[piece][axis] = value & 0xFFFF
            if anim[base + F_DIRTY]:
                self.dirty = 1


# --------------------------------------------------------------------------- the director

# How the engine reaches each script it calls by name, read off every call site of
# 0x4B0940 / 0x4B0A70 / 0x4B0BC0 (exe-reverse-engineering.md §"The COB engine"):
#
#   "query"  COBEngine_QueryScript 0x4B0BC0 -> 0x4B0C40: four words in, sp = 3, runs
#            inside the call, the four words come back out
#   "now"    0x4B0940 with runNow = 1 (no argument words at all)
#   "later"  runNow = 0: the thread takes its first step at the next DoScriptsNow
#
# `phase` is where in the sim frame the call sits relative to *this* unit's own
# DoScriptsNow: "pre" for the unit's own tick (its movement, state and weapon
# updates, AutoAim last), "post" for what another unit's code does to it —
# damage, death and targeting, which run in the attacker's tick.
ENGINE_STARTS = {
    # the unit's own update
    "create":           ("now",   "pre"),    # 0x485DE6, runNow 1
    # the movement pass 0x43DD20 -> 0x43DA70/0x43DB50 is called at 0x48AFAA, *after*
    # DoScriptsNow at 0x48ADEB, so everything it starts lands after the unit's own tick
    "startmoving":      ("now",   "post"),   # 0x43DAF2, runNow 1
    "stopmoving":       ("now",   "post"),   # 0x43DAF2, runNow 1
    "moverate1":        ("now",   "post"),   # 0x43DB27, runNow 1
    "moverate2":        ("now",   "post"),
    "moverate3":        ("now",   "post"),
    "setsfxoccupy":     ("now",   "post"),   # 0x43DBE8, runNow 1, argc 1
    "setspeed":         ("later", "pre"),    # 0x437902, runNow 0, argc 1
    "setdirection":     ("later", "pre"),    # 0x43795E/0x43798A, runNow 0, argc 1
    # UNITS_SetStateMask 0x48B090 is not in the per-unit tick function (which ends at
    # 0x48B080), and the fighter, gunship and bomber fixtures all show its Activate
    # landing after that unit's DoScriptsNow — it first steps the tick after
    "activate":         ("later", "post"),   # 0x48B106/0x48B12B, runNow 0
    "deactivate":       ("later", "post"),   # 0x48B12B/0x48B14E, runNow 0
    "startbuilding":    ("later", "post"),   # 0x48B14E/0x48B169, runNow 0
    "stopbuilding":     ("later", "post"),   # 0x48B169, runNow 0
    "setmaxreloadtime": ("later", "pre"),    # 0x49E186 UNITS_StartWeaponsScripts, runNow 0, argc 1
    "endtransport":     ("later", "pre"),
    # the weapons, all in the unit's own tick ahead of DoScriptsNow
    "aimprimary":       ("later", "pre"),    # 0x49E31C / 0x49E386 AutoAim, runNow 0, argc 2
    "aimsecondary":     ("later", "pre"),
    "aimtertiary":      ("later", "pre"),
    "fireprimary":      ("later", "pre"),    # 0x49CB94 etc. through 0x4B0940, runNow 0
    "firesecondary":    ("later", "pre"),
    "firetertiary":     ("later", "pre"),
    "rockunit":         ("later", "pre"),    # 0x49CBEB / 0x499C5C, runNow 0, argc 2 — the recoil
    # the queries (0x4B0C40): four words in and out, synchronous
    "queryprimary":     ("query", "pre"),    # 0x43E227/0x43E291 UNITS_QueryWeaponPosition
    "querysecondary":   ("query", "pre"),
    "querytertiary":    ("query", "pre"),
    "aimfromprimary":   ("query", "pre"),    # 0x43E32C/0x43E370
    "aimfromsecondary": ("query", "pre"),
    "aimfromtertiary":  ("query", "pre"),
    "querynanopiece":   ("query", "pre"),    # 0x43E427 UNITS_CallAimScripts
    "querybuildinfo":   ("query", "pre"),    # 0x4027FB
    "querytransport":   ("query", "pre"),    # 0x4113B1
    "querylandingpad":  ("query", "pre"),    # 0x41189C and four more
    # what other units do to this one, after its own tick
    "sweetspot":        ("query", "post"),   # 0x43E3E4, the shooter's aim
    "killed":           ("query", "post"),   # 0x4865C3 Send_UnitDeath
    "hitbyweapon":      ("later", "post"),   # 0x489F43, runNow 0, argc 2
    "takedamage":       ("later", "post"),   # 0x489F8E, runNow 0, argc 1
    "targetcleared":    ("later", "post"),   # 0x489898 and three more
