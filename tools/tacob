def weapon_params(name: str):
    n = name.lower()
    if re.match(r"^aim(primary|secondary|tertiary|weapon\d+)$", n):
        return ["heading", "pitch"]
    if re.match(r"^(query|aimfrom)(primary|secondary|tertiary|weapon\d+)$", n):
        return ["piecenum"]
    if re.match(r"^fire(primary|secondary|tertiary|weapon\d+)$", n):
        return []
    return None


# --------------------------------------------------------------------------- the container

class Cob:
    """A parsed COB: scripts [(name, entry word)], piece names, static count, code words."""

    def __init__(self, scripts, pieces, statics, code):
        self.scripts = list(scripts)
        self.pieces = list(pieces)
        self.statics = statics
        self.code = list(code)


HEADER = struct.Struct("<11I")


def _cstring(blob: bytes, off: int) -> str:
    end = blob.index(b"\0", off)
    return blob[off:end].decode("latin-1")


def read_cob(blob: bytes) -> Cob:
    if len(blob) < HEADER.size:
        raise TacobError("not a COB: shorter than its header")
    (version, nscr, npc, codelen, nstat, _zero, o_cidx, o_snames, o_pnames, o_code,
     _o_str) = HEADER.unpack_from(blob, 0)
    if version != 4:
        raise TacobError(f"not a retail TA COB: version {version} (TA:Kingdoms is out of scope)")
    try:
        entries = struct.unpack_from(f"<{nscr}I", blob, o_cidx)
        snames = [_cstring(blob, o) for o in struct.unpack_from(f"<{nscr}I", blob, o_snames)]
        pieces = [_cstring(blob, o) for o in struct.unpack_from(f"<{npc}I", blob, o_pnames)]
        code = struct.unpack_from(f"<{codelen}I", blob, o_code)
    except (struct.error, ValueError) as e:
        raise TacobError(f"truncated COB: {e}")
    return Cob(list(zip(snames, entries)), pieces, nstat, code)


def write_cob(cob: Cob) -> bytes:
    """Scriptor's layout, byte for byte (see the module docstring)."""
    code = struct.pack(f"<{len(cob.code)}I", *(w & 0xFFFFFFFF for w in cob.code))
    nscr, npc = len(cob.scripts), len(cob.pieces)
    o_code = HEADER.size
    o_cidx = o_code + len(code)
    o_snames = o_cidx + 4 * nscr
    o_pnames = o_snames + 4 * nscr
    o_str = o_pnames + 4 * npc
    strings = bytearray()
    offsets = []
    for name in [n for n, _ in cob.scripts] + cob.pieces:
        offsets.append(o_str + len(strings))
        strings += name.encode("latin-1") + b"\0"
    header = HEADER.pack(4, nscr, npc, len(cob.code), cob.statics, 0,
                         o_cidx, o_snames, o_pnames, o_code, o_str)
    tables = struct.pack(f"<{nscr}I", *(e for _, e in cob.scripts))
    tables += struct.pack(f"<{nscr}I", *offsets[:nscr])
    tables += struct.pack(f"<{npc}I", *offsets[nscr:])
    return header + code + tables + bytes(strings)


def signed(w: int) -> int:
    w &= 0xFFFFFFFF
    return w - (1 << 32) if w & 0x80000000 else w


class Op:
    __slots__ = ("pc", "name", "args", "end")

    def __init__(self, pc, name, args, end):
        self.pc, self.name, self.args, self.end = pc, name, args, end

    def __repr__(self):
        return f"{self.pc}:{self.name}{self.args}"


def script_ranges(cob: Cob):
    """[(name, start, end)] in code order; a script ends where the next begins."""
    starts = sorted((entry, name) for name, entry in cob.scripts)
    total = len(cob.code)
    out = []
    for i, (start, name) in enumerate(starts):
        end = starts[i + 1][0] if i + 1 < len(starts) else total
        out.append((name, start, end))
    return out


def decode(code, start, end):
    """The ops of one script; unknown words stop the decode with a DecompileError."""
    ops = []
    pc = start
    while pc < end:
        word = code[pc] & 0xFFFFFFFF
        name = MNEMONIC.get(word)
        if name is None:
            raise DecompileError(f"unknown opcode 0x{word:08X} at word {pc}")
        n = INLINE[word]
        if pc + n >= end + (1 if n == 0 else 0) and pc + 1 + n > end:
            raise DecompileError(f"{name} at word {pc} runs past the end of the script")
        args = [signed(code[pc + 1 + k]) if name == "PUSH_CONSTANT" else code[pc + 1 + k]
                for k in range(n)]
        ops.append(Op(pc, name, args, pc + 1 + n))
        pc += 1 + n
    return ops


# --------------------------------------------------------------------------- literals

def linear_word(x: float) -> int:
    return int(x * 65536)


def angular_word(x: float) -> int:
    return int(x * 65536 / 360)


def _format_literal(word: int, to_word) -> str:
    """The shortest decimal that our own conversion truncates back to `word`."""
    base = word / 65536 if to_word is linear_word else word * 360 / 65536
    for places in range(0, 10):
        for cand in (round(base, places), round(base + 10 ** -places / 2, places),
                     round(base - 10 ** -places / 2, places)):
            if to_word(cand) == word:
                text = f"{cand:.{places}f}"
                return text
    raise DecompileError(f"no decimal literal reproduces word {word}")


def format_linear(word: int) -> str:
    return "[" + _format_literal(word, linear_word) + "]"


def format_angular(word: int) -> str:
    return "<" + _format_literal(word, angular_word) + ">"


