    return mod


def read_cob_source(spec: str, gamedir=None):
    """A .cob path, or a stock unit name read out of the game's archives."""
    path = Path(spec)
    if path.is_file():
        return path.read_bytes(), path.stem
    ta3do = load_ta3do()
    assets = ta3do.Assets(gamedir)
    name = f"scripts/{path.stem.lower()}.cob"
    if not assets.has(name):
        raise TacobError(f"{spec}: not a file, and no {name} in the game's archives")
    return assets.read(name), path.stem.lower()


