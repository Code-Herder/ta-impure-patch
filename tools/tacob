MAX_FRAMES = 9000               # five minutes of recorded timeline, then the head rolls
MAX_TRACE = 60000               # trace lines kept; a stock unit writes a few a second


class Session:
    """One unit, running. Owns the VM, the world, the director and the timeline.

    Edit and play are separate states: typing only re-parses for diagnostics, and
    a build recompiles and restarts from `Create`. A hot swap would leave running
    threads pointing into old code and show behaviour no game shows
    (tacob-design.md §"Decisions locked")."""

    def __init__(self, project, gamedir=None):
        self.project = project
        self.gamedir = gamedir
        self.lock = threading.RLock()
        self.source = project.bos.read_text(encoding="latin-1") if project.bos.is_file() else ""
        self.frame = None
        self.slots = []
        self.error = None
        self.diagnostics = []
        self.playing = False
        self.speed = 1.0
        self.frames = []
        self.frames_from = 0
        self.trace = []
        self.cls = project.meta.get("class") or "tank"
        self.cob = None
        self.build_id = 0
        self._load_model()
        self.build(self.source, restart=True)

    # -- assets -----------------------------------------------------------
    def _load_model(self):
        """The piece frame the pose and every position `get` need. Without the
        game's archives the session still runs — the pieces just have no offsets,
        and `get PIECE_XZ` says so by answering from the unit's own origin."""
        try:
            ta3do = load_ta3do()
            assets = ta3do.Assets(self.gamedir)
            _label, blob = ta3do.resolve_model(assets, self.project.unit)
            self.root3do = ta3do.parse_3do(blob)
            self.weapons = weapon_table(assets)
        except Exception as err:                       # no game dir: keep going
            self.root3do, self.weapons = None, {}
            self.error = f"assets: {err}"

    # -- build ------------------------------------------------------------
    def _diag(self, rule, err):
        return [{"rule": rule, "level": "error", "script": "", "line": _err_line(err),
                 "file": self.project.bos.name, "message": str(err)}]

    def build(self, source, restart=True):
        """Parse, compile, lint, and restart from `Create`.

        The lints come last because two of them need the piece frame, and the
        frame is only known once the compile has fixed the piece order. A parse or
        compile error changes nothing: the unit that is running keeps running."""
        with self.lock:
            self.source = source
            include = (str(self.project.path), str(INCLUDE_DIR))
            try:
                program = parse_bos(source, self.project.bos.name, include)
            except TacobError as err:
                self.diagnostics = self._diag("parse", err)
                return {"ok": False, "diagnostics": self.diagnostics}
            try:
                cob = Compiler(program).compile()
            except TacobError as err:
                self.diagnostics = self._diag("compile", err)
                return {"ok": False, "diagnostics": self.diagnostics}
            self.cob = cob
            self.build_id += 1
            self.frame = (PieceFrame.from_3do(cob.pieces, self.root3do)
                          if self.root3do is not None else PieceFrame(cob.pieces))
            self.diagnostics = Linter(program, self.frame).run()
            self.project.cob.write_bytes(write_cob(cob))
            self.project.bos.write_text(source, encoding="latin-1")
            if restart:
                self.restart()
            return {"ok": True, "diagnostics": self.diagnostics, "build": self.build_id,
                    "scripts": [n for n, _ in cob.scripts], "pieces": list(cob.pieces),
                    "statics": cob.statics, "words": len(cob.code)}

    def restart(self):
        """Back to tick 0 with a fresh pool, a fresh world and an empty timeline."""
        with self.lock:
            fbi = self.project.meta.get("fbi") or {}
            self.slots = slots_from_fbi(fbi, self.weapons)
            self.trace = []
            self.frames = []
            self.frames_from = 0
            world = EditorWorld(self.frame, None, seed=self.project.meta.get("seed", 1))
            world.maxhp = int(float(fbi.get("maxdamage", 100) or 100))
            world.hp = world.maxhp
            world.height = int(float(fbi.get("height", 0) or 0))
            # The marker starts where this unit's own longest weapon can reach it,
            # and the patrol is scaled to the same number — a 240-range cannon on a
            # 480-unit shuttle would spend the whole run out of range and look broken.
            reach = max([s.range for s in self.slots] or [DEFAULT_RANGE])
            world.target = [int(0.35 * reach * FIXED), 0, int(0.35 * reach * FIXED)]
            world.units = {2: {"pos": world.target, "height": 30}}
            vm = CobVM(self.cob, world, self.trace.append, unit=1,
                       type_name=self.project.unit.upper(),
                       visible=self.frame.visibility())
            world.vm = vm
            self.vm, self.world = vm, world
            plan = dict(CLASS_PLANS.get(self.cls, CLASS_PLANS["tank"]))
            motion = plan.get("motion", "ground")
            radius = plan.get("radius", 480)
            if motion in ("ground", "glide", "dive"):
                radius = max(60.0, min(radius, 0.5 * reach))
            elif motion in ("circuit", "runin"):
                radius = max(120.0, 0.55 * reach)
            self.director = Director(vm, world, motion=motion, slots=self.slots,
                                     speed=plan.get("speed", 60),
                                     alt=min(plan.get("alt", 0), 0.3 * reach),
                                     radius=radius,
                                     sfx_occupy=plan.get("sfx_occupy", False),
                                     activates=plan.get("activates", False))
            self.tick = 0
            self.director.step(0)   # Create, at the tick the page shows first
            self.record()

    # -- the tick loop ----------------------------------------------------
    def step(self, n=1):
        with self.lock:
            for _ in range(n):
                self.tick += 1
                self.director.step(self.tick)
                self.record()

    def record(self):
        vm, w = self.vm, self.world
        pos, ang = [], []
        for p in range(len(vm.pos)):
            pos += vm.pos[p]
            ang += vm.ang[p]
        threads = []
        for i, rec in enumerate(vm.threads):
            threads.append({"slot": i, "status": rec.status, "pc": rec.pc,
                            "sp": rec.sp, "mask": rec.mask, "child": rec.child,
                            "script": vm.script_of_pc(rec.pc) if rec.status else ""})
        # What the page actually sets on the glTF nodes. The conversion lives here,
        # in one place, because it is the only part of the pose that is not the
        # engine's own arithmetic: `tools/ta3do` writes glTF with the file's z
        # negated, and the engine's loaded model has the file's x *and* z negated,
        # so glTF = engine with x negated. That substitution turns the engine's
        # `Ry(ay)·Rx(ax)·Rz(az)` into three.js's YXZ Euler (ax, ay, -az), and a
        # local offset into (-x, y, z). At rest it reproduces the exporter's own
        # node translation exactly, which is the check that it is right.
        gt, gr = [], []
        K = 2 * math.pi / 65536.0
        for p in range(len(vm.pos)):
            node = self.frame.of_cob[p] if p < len(self.frame.of_cob) else -1
            off = self.frame.offset[node] if node >= 0 else [0, 0, 0]
            gt += [-(off[0] + vm.pos[p][0]) / float(FIXED),
                   (off[1] + vm.pos[p][1]) / float(FIXED),
                   (off[2] + vm.pos[p][2]) / float(FIXED)]
            a = vm.ang[p]
            gr += [s16(a[0]) * K, s16(a[1]) * K, -s16(a[2]) * K]
        frame = {"tick": self.tick, "pos": pos, "ang": ang, "gl": {"t": gt, "r": gr},
                 "visible": [1 if v else 0 for v in vm.visible],
                 "threads": threads, "running": vm.running,
                 "statics": list(vm.statics),
                 "unit": {"pos": list(w.pos), "body": list(w.body),
                          "target": list(w.target)},
                 "effects": [{"tick": t, "kind": k, "piece": p, "arg": a, "at": at}
                             for (t, k, p, a, at) in w.effects[-24:]],
                 "slots": [s.info() for s in self.slots],
                 "trace": len(self.trace)}
        self.frames.append(frame)
        if len(self.frames) > MAX_FRAMES:
            drop = len(self.frames) - MAX_FRAMES
            del self.frames[:drop]
            self.frames_from += drop
        if len(self.trace) > MAX_TRACE:                 # the tab keeps the tail
            del self.trace[:len(self.trace) - MAX_TRACE]

    def frame_at(self, tick):
        if not self.frames:
            return None
        index = tick - self.frames[0]["tick"]
        index = max(0, min(len(self.frames) - 1, index))
        return self.frames[index]

    # -- what the page asks for -------------------------------------------
    def state(self):
        with self.lock:
            cob = self.cob
            return {
                "unit": self.project.unit,
                "class": self.cls,
                "classes": sorted(CLASS_PLANS),
                "model": self.project.glb.name if self.project.glb.is_file() else None,
                "pieces": list(cob.pieces) if cob else [],
                "bound": list(self.frame.bound) if self.frame else [],
                "offsets": [list(o) for o in self.frame.offset] if self.frame else [],
                "parents": list(self.frame.parent) if self.frame else [],
                "scripts": [n for n, _ in cob.scripts] if cob else [],
                "statics": cob.statics if cob else 0,
                "slots": [s.info() for s in self.slots],
                "diagnostics": self.diagnostics,
                "tick": self.tick,
                "head": self.tick,
                "first": self.frames[0]["tick"] if self.frames else 0,
                "playing": self.playing,
                "speed": self.speed,
                "build": self.build_id,
                "trace": len(self.trace),
                "world": self.world.snapshot(),
                "ignored_sets": self.world.ignored_sets[-8:],
                "fbi": self.project.meta.get("fbi") or {},
                "error": self.error,
                "rules": LINT_RULES,
                "engine_starts": {k: list(v) for k, v in ENGINE_STARTS.items()},
            }


# --------------------------------------------------------------------------- the server

# Stdlib only, loopback only. The page is a thin client: it edits and draws, and
# it never interprets COB. One pose frame a tick, about a millisecond a call —
# which is why the VM lives here and not in JavaScript (tacob-design.md
# §"Decisions locked": two implementations of the opcode semantics would drift).

EDITOR_HTML = HERE / "tacob-edit.html"
STATIC = {"/": EDITOR_HTML, "/tacob-edit.html": EDITOR_HTML}


class Server:
    def __init__(self, session, host="127.0.0.1", port=0, gamedir=None):
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
        outer = self

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, *_args):
                pass

            def send(self, body, ctype="application/json", code=200):
                if isinstance(body, (dict, list)):
                    body = json.dumps(body).encode()
                elif isinstance(body, str):
                    body = body.encode("utf-8", "replace")
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                path, _, query = self.path.partition("?")
                args = dict(urllib.parse.parse_qsl(query))
                try:
                    self.route_get(path, args)
                except Exception as err:                # never take the server down
                    self.send({"error": f"{type(err).__name__}: {err}"}, code=500)

            def do_POST(self):
                length = int(self.headers.get("Content-Length") or 0)
                raw = self.rfile.read(length) if length else b"{}"
                try:
                    body = json.loads(raw.decode("utf-8") or "{}")
                except ValueError:
                    body = {}
                try:
                    self.route_post(self.path.partition("?")[0], body)
                except Exception as err:
                    self.send({"error": f"{type(err).__name__}: {err}"}, code=500)

            # -- the five endpoints the design names, plus what drives them --
            def route_get(self, path, args):
                s = outer.session
                if path in STATIC:
                    self.send(STATIC[path].read_text(encoding="utf-8"),
                              "text/html; charset=utf-8")
                elif path == "/model.glb":
                    if not s.project.glb.is_file():
                        return self.send({"error": "no model exported"}, code=404)
                    self.send(s.project.glb.read_bytes(), "model/gltf-binary")
                elif path == "/state":
                    self.send(s.state())
                elif path == "/source":
                    self.send(s.source, "text/plain; charset=utf-8")
                elif path == "/pose":
                    want = args.get("tick")
                    with s.lock:
                        frame = s.frame_at(int(want)) if want not in (None, "", "head") \
                            else (s.frames[-1] if s.frames else None)
                        self.send(frame or {"error": "no frames"})
                elif path == "/trace":
                    start = int(args.get("from") or 0)
                    with s.lock:
                        lines = s.trace[start:start + int(args.get("limit") or 2000)]
                        self.send({"from": start, "total": len(s.trace), "lines": lines})
                elif path == "/events":
                    self.send({"starts": {k: list(v) for k, v in ENGINE_STARTS.items()},
                               "params": PARAM_NAMES,
                               "scripts": [n for n, _ in s.cob.scripts] if s.cob else []})
                else:
                    self.send({"error": f"no route {path}"}, code=404)

            def route_post(self, path, body):
                s = outer.session
                if path == "/build":
                    self.send(s.build(body.get("source") or "",
                                      restart=body.get("restart", True)))
                elif path == "/transport":
                    self.send(outer.transport(body))
                elif path == "/event":
                    with s.lock:
                        ev = s.director.issue(body.get("script") or "",
                                              body.get("args") or ())
                        self.send({"queued": ev.script, "kind": ev.kind,
                                   "phase": ev.phase, "tick": s.tick})
                elif path == "/world":
                    self.send(outer.set_world(body))
                elif path == "/pack":
                    into = body.get("install") or outer.gamedir
                    if into:
                        out, names, written = s.project.install(into, body.get("out"))
                        self.send({"path": str(out), "entries": names,
                                   "bytes": out.stat().st_size,
                                   "installed": [str(w) for w in written]})
                    else:
                        out, names = s.project.pack(body.get("out"))
                        self.send({"path": str(out), "entries": names,
                                   "bytes": out.stat().st_size})
                elif path == "/template":
                    self.send({"bos": weapon_template(
                        int(body.get("n") or 4), body.get("mount") or "turret",
                        body.get("gun") or "sleeve", body.get("flare") or "flare")})
                else:
                    self.send({"error": f"no route {path}"}, code=404)

        self.session = session
        self.gamedir = gamedir          # where "pack" installs, when one was given
        self.httpd = ThreadingHTTPServer((host, port), Handler)
        self.host, self.port = host, self.httpd.server_address[1]
        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
        self.ticker = threading.Thread(target=self._tick_loop, daemon=True)
        self.running = True

    @property
    def base(self):
        return f"http://{self.host}:{self.port}"

    def start(self):
        self.thread.start()
        self.ticker.start()

    def close(self):
        self.running = False
        self.httpd.shutdown()
        self.httpd.server_close()

    def _tick_loop(self):
        """The sim clock. Real time, so the page can just draw what it is given."""
        while self.running:
            s = self.session
            if s.playing:
                s.step(1)
                time.sleep(max(0.001, 1.0 / (SIM_RATE * max(0.05, s.speed))))
            else:
                time.sleep(0.02)

    def transport(self, body):
        s = self.session
        action = body.get("action") or "pause"
        with s.lock:
            if action == "play":
                s.playing = True
            elif action == "pause":
                s.playing = False
            elif action == "step":
                s.playing = False
                s.step(max(1, int(body.get("n") or 1)))
            elif action == "restart":
                s.playing = False
                s.restart()
            elif action == "speed":
                s.speed = max(0.05, min(8.0, float(body.get("speed") or 1.0)))
            elif action == "class":
                s.cls = body.get("class") or s.cls
                s.project.meta["class"] = s.cls
                s.project.save_meta()
                s.restart()
            return {"playing": s.playing, "tick": s.tick, "speed": s.speed,
                    "class": s.cls, "first": s.frames[0]["tick"] if s.frames else 0}

    def set_world(self, body):
        """The unit-state panel. Everything here is a field one of the twenty
        value-id handlers reads — nothing else is settable, because nothing else
        is what a script can see."""
        s = self.session
        with s.lock:
            w = s.world
            for key in ("pos", "body", "target"):
                if key in body:
                    setattr(w, key, [int(v) for v in body[key]][:3])
            for key in ("ground", "water", "hp", "maxhp", "height"):
                if key in body:
                    setattr(w, key, int(body[key]))
            if "build_left" in body:
                w.build_left = float(body["build_left"])
            for name, value in (body.get("bits") or {}).items():
                if name in w.bits:
                    w.bits[name] = int(value)
            if "seed" in body:
                w.rng.seed = int(body["seed"]) & 0x7FFFFFFF or 1
            return w.snapshot()


