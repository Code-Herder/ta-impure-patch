TRACE_HEADER = ("# tagpu_cobtrace v1\tfilter=%s\tcolumns: S tick unit type script slot source args… | "
                "R tick unit slot script value | X tick unit script source | K tick unit slot script by | "
                "D tick unit slot value")


class TraceLine:
    __slots__ = ("kind", "tick", "unit", "fields", "raw")

    def __init__(self, raw):
        self.raw = raw
        f = raw.split("\t")
        self.kind = f[0]
        self.tick = int(f[1])
        self.unit = int(f[2])
        self.fields = f


def read_cobtrace(path):
    """The oracle's log: the header, then S/R/X/K/D lines in event order."""
    header, lines = None, []
    # the hook writes UTF-8 (its header carries a literal "…"); surrogateescape keeps
    # the round trip byte-exact whatever the log actually holds
    for raw in Path(path).read_text(encoding="utf-8", errors="surrogateescape").splitlines():
        if not raw.strip():
            continue
        if raw.startswith("#"):
            if header is None:
                header = raw
            continue
        lines.append(TraceLine(raw))
    return header, lines


class Event:
    """One engine-issued start, as the replay will re-issue it."""
    __slots__ = ("tick", "script", "args", "kind", "phase")

    def __init__(self, tick, script, args, kind, phase):
        self.tick, self.script, self.args = tick, script, args
        self.kind, self.phase = kind, phase


def events_from_trace(lines):
    """Every `S … E` line becomes a replay event. Its `kind` and `phase` come from
    the call-site table above; an argument-less line took the no-argument entry
    0x4B0940, which writes nothing onto the record at all."""
    out, unknown = [], set()
    for ln in lines:
        if ln.kind != "S" or ln.fields[6] != "E":
            continue
        script = ln.fields[4]
        args = [int(x) for x in ln.fields[7].split(",")] if len(ln.fields) > 7 and ln.fields[7] else []
        kind, phase = ENGINE_STARTS.get(script.lower(), (None, None))
        if kind is None:
            unknown.add(script)
            kind, phase = ("query" if len(args) == 4 else "later"), "pre"
        out.append(Event(ln.tick, script, args, kind, phase))
    return out, sorted(unknown)


def replay(cob, lines, world_values=None, type_name="?", unit=1, until=None, snap=(),
           visible=None):
    """Run the VM through the fixture's engine events and return the lines it writes.

    The replay supplies exactly what the trace cannot: which engine entry issued each
    start (the table above), the `rand` results (the D lines), and the unit-state
    values the scripts read (`get`). Everything else — slots, ticks, the call and
    return structure, the signal kills, the wait releases — is the VM's own answer."""
    events, unknown = events_from_trace(lines)
    if not events:
        raise TacobError("no engine starts in the trace: nothing to replay")
    rands = [int(ln.fields[4]) for ln in lines if ln.kind == "D"]
    # the D line is `lo + r`; the lo is the script's, so the VM asks for r and the
    # world hands back what the engine's RNG gave, in draw order
    out = []
    world = ReplayWorld(world_values, rands)
    vm = CobVM(cob, world, out.append, unit=unit, type_name=type_name, visible=visible)
    by_tick = {}
    for ev in events:
        by_tick.setdefault(ev.tick, []).append(ev)
    create_tick = events[0].tick
    last = until if until is not None else max(ln.tick for ln in lines)
    snap, snaps = set(snap), {}
    for tick in range(create_tick, last + 1):
        vm.tick = world.tick = tick
        here = by_tick.get(tick, ())
        for ev in here:
            if ev.phase == "pre":
                dispatch(vm, ev)
        if tick > create_tick:
            vm.do_scripts_now(1)
        for ev in here:
            if ev.phase == "post":
                dispatch(vm, ev)
        if tick in snap:
            snaps[tick] = ([list(p) for p in vm.pos], [list(a) for a in vm.ang],
                           list(vm.visible))
    vm.flush_start()
    return vm, out, unknown, snaps


def dispatch(vm, ev):
    if ev.kind == "query":
        vm.query_script(ev.script, ev.args)
    elif ev.kind == "now":
        vm.start_script(ev.script, run_now=True, args=ev.args, argwords=bool(ev.args))
    else:
        cb = AimCallback() if ev.script.lower().startswith("aim") else None
        vm.start_script(ev.script, run_now=False, args=ev.args, argwords=bool(ev.args), cb=cb)


class ReplayWorld(UnitWorld):
    """`get` over a timeline: {value id: [(tick, value), …]}. The cobtrace log carries
    no `get` traffic, so these are the replay's inputs — see the note beside the
    fixture's replay.json for where each timeline came from."""

    def __init__(self, timelines=None, rands=None):
        UnitWorld.__init__(self, rands=rands)
        self.timelines = {int(k): sorted(v) for k, v in (timelines or {}).items()}
        self.tick = 0

    def rand(self, n, lo):
        """What the engine's RNG gave, in draw order — the D lines record `lo + r`."""
        if self.draws < len(self.rands):
            r = self.rands[self.draws] - lo
        else:
            r = 0
        self.draws += 1
        return 0 if n < 2 else r

    def get(self, vid, a, b, c, d):
        tl = self.timelines.get(vid)
        if tl:
            value = tl[0][1]
            for t, v in tl:
                if t <= self.tick:
                    value = v
            return value
        return UnitWorld.get(self, vid, a, b, c, d)


# --------------------------------------------------------------------------- the world the script sees

# `get` reaches the COB object's `vt+0x44` = 0x480770 and `set` its `vt+0x40` =
# 0x480B20. Both open with `id - 1 > 0x13 -> return`, so the value ids really are
# 1..20 and anything else is 0 (get) or nothing at all (set). Every rule below was
# read out of the retail binary this landing; the per-id arithmetic, the field
# offsets and the helper addresses are in exe-reverse-engineering.md
# §"`get` and `set` — the twenty value ids".

TAANG_PER_RAD = 10430.37835047     # ds:0x509EF0, the scale fpatan's result is given
FIXED = 65536                      # 16.16, the units every position id speaks in

# The six ids SET has a case for. The byte table at 0x480C18 sends the other
# fourteen to the shared default 0x480BF1, which only marks the unit dirty — so
# `set HEALTH to 50` is a measured no-op on retail TA, not a gap in this model.
SET_HANDLED = {VALUE_IDS[n] for n in ("ACTIVATION", "INBUILDSTANCE", "BUSY",
                                      "YARD_OPEN", "BUGGER_OFF", "ARMORED")}


def ftol(x):
    """`_ftol` 0x4E43A0 forces the FPU to chop, so every float->int the value ids
    take truncates toward zero. The one exception is the piece rotation's bare
    `fistp` (0x4B71A0), which keeps the default round-to-nearest."""
    return int(x)


def s16(v):
    v &= 0xFFFF
    return v - 0x10000 if v & 0x8000 else v


def ta_atan(a, b):
    """0x4B715A: `fild a; fild b; fpatan` — atan2(a, b) — scaled by 65536/2pi and
    stored with a bare `fistp`, so this one rounds to nearest, not toward zero."""
    return int(round(math.atan2(a, b) * TAANG_PER_RAD))


def ta_hypot(a, b):
    """0x4809F3: `_hypot` on the two arguments as doubles, then `_ftol`."""
    return ftol(math.hypot(a, b))


def pack_xz(x, z):
    """What 0x480821 builds out of a piece's world position: the x dword's high
    half left in place plus the z dword's *signed* integer part **added** — not
    or-ed, which is why every handler that unpacks one adds 1 back to x when the
    z half came out negative."""
    return i32((x & 0xFFFF0000) + (z >> 16))


def unpack_xz(v):
    """The same three instructions in XZ_ATAN, XZ_HYPOT and GROUND_HEIGHT
    (0x480965, 0x480994, 0x480A0D): x back into 16.16, z shifted up out of the low
    half, and the borrow undone."""
    x = i32(v & 0xFFFF0000)
    z = i32((v & 0xFFFF) << 16)
    if z < 0:
        x = i32(x + 0x10000)
    return x, z


class SimRandom:
    """`0x4B6C30`, the sim RNG the `rand` opcode calls (state at `0x51FC88`, 129
    call sites across the sim): Park-Miller `s = 16807 s mod 2^31-1` by Schrage's
    trick, `s <= 0` corrected by `+= 0x7FFFFFFF`, and the draw is `s % n`. Returns
    0 for `n < 2` without touching the state. The seed the game starts a match
    with is not ours to know, so the editor picks one and says which."""

    def __init__(self, seed=1):
        self.seed = seed & 0x7FFFFFFF or 1

    def draw(self, n):
        if n < 2:
            return 0
        s = self.seed
        q = s // 127773
        s = i32(16807 * (s % 127773) - 2836 * q)
        if s <= 0:
            s += 0x7FFFFFFF
        self.seed = s
        return s % n


class PieceFrame:
    """The static half of the pose: the model's tree, and where the COB's pieces sit in it.

    `0x45A950` binds the model's nodes to the COB's piece-name table **by name**
    (the compare at `0x45A9FD`), so the `PrimitiveStruct` array a MOVE's piece
    operand indexes is in the *COB's* order — and it still has a slot for every
    node the COB does **not** name (ARMBRAWL's model has fourteen nodes and its
    COB eleven pieces; the three thrust anchors sit past the end). Those slots
    matter here because they can be a named piece's *parent*, and dropping them
    would break the chain. So this indexes the model, and `of_cob` maps the other
    way.

    **The loader negates X and Z.** Every offset and every vertex of the
    `Model3DONode` the engine holds is `(-x, y, -z)` of the same field in the
    `.3do` — a half turn about Y, baked in at load. Measured 2026-09-07 against
    the eight `posedump.txt` fixtures, which print the engine's own `N_OFF` beside
    the file's: every piece of all eight units, x and z flipped, y kept. The
    offsets here are therefore the engine's, so `piece_offset` composes in the
    frame `PIECE_XZ` and the vertex buffer speak."""

    def __init__(self, names, cob_names=None):
        self.names = list(names)                 # model nodes, or the COB's own
        n = len(self.names)
        self.offset = [[0, 0, 0] for _ in range(n)]
        self.parent = [-1] * n
        self.vertices = [3] * n
        self.cob = list(range(n))                # node -> COB piece, -1 if unnamed
        cob_names = list(cob_names if cob_names is not None else names)
        self.cob_names = cob_names
        self.of_cob = list(range(len(cob_names)))
        self.bound = [True] * len(cob_names)

    @classmethod
    def from_3do(cls, cob_names, root):
        """`root` is a `tools/ta3do` `Piece` tree; binding is by lower-cased name."""
        nodes = [piece for piece, _ in root.walk()]
        frame = cls([p.name for p in nodes], cob_names)
        at = {id(p): i for i, p in enumerate(nodes)}
        index = {}
        for i, name in enumerate(cob_names):
            index.setdefault(name.lower(), i)
        frame.cob = [-1] * len(nodes)
        frame.of_cob = [-1] * len(cob_names)
        for i, piece in enumerate(nodes):
            frame.offset[i] = [-int(round(piece.offset[0] * FIXED)),
                               int(round(piece.offset[1] * FIXED)),
                               -int(round(piece.offset[2] * FIXED))]
            frame.vertices[i] = len(piece.vertices)
            for child in piece.children:
                frame.parent[at[id(child)]] = i
            c = index.get(piece.name.lower(), -1)
            if c >= 0 and frame.of_cob[c] < 0:   # the engine takes the first match
                frame.cob[i] = c
                frame.of_cob[c] = i
        frame.bound = [n >= 0 for n in frame.of_cob]
        return frame

    def visibility(self):
        """Per COB piece. 0x45AF1B: fewer than three vertices and the model builder
        never sets the visible bit — every flare, wake, tube and thrust anchor
        starts hidden with no `hide` in the script."""
        out = []
        for node in self.of_cob:
            out.append(True if node < 0 else self.vertices[node] >= 3)
        return out


def rotate2(angle, p0, p1):
    """`0x4B7173`: returns untouched on a zero angle word, else rotates the pair by
    `+angle` (p0 toward p1) and stores it back with `fistp` — round to nearest."""
    if (angle & 0xFFFF) == 0:
        return p0, p1
    rad = s16(angle) * (2 * math.pi / 65536.0)
    sin, cos = math.sin(rad), math.cos(rad)
    return int(round(p0 * cos - p1 * sin)), int(round(p1 * cos + p0 * sin))


def piece_local(frame, pos, node):
    """A model node's origin in its parent's frame, 16.16. `0x43DF2A..0x43DF55`
    pairs `PrimitiveStruct+0x04/+0x08/+0x0C` with the node's own X/Y/Z in that
    order, so the COB's three axis operands are plain X, Y and Z — no
    transposition — and MOVE's delta is added to the rest offset *before* any
    rotation, which is what settles it as a delta in the parent's frame."""
    off = frame.offset[node]
    c = frame.cob[node]
    if c < 0:
        return list(off)
    return [off[k] + pos[c][k] for k in range(3)]


def _compose(frame, pos, ang, node, acc, body):
    """The ancestor walk of `0x43DEF0`: rotate what is under this node by its three
    angle words, **then** add its own offset, and climb.

    The order is fixed by `0x4B6CC0`: the z-axis word first (it turns the x/y
    pair), then the x-axis word (y/z), then the y-axis word (x/z) — so the local
    matrix is `Ry · Rx · Rz`. At the root the unit's body turn goes on
    (`+0x68` pitch, `+0x66` heading, `+0x64` roll, in the same axis order as
    `ang`), which is the same thing as applying the yaw outermost because Y is the
    outermost factor."""
    seen = 0
    while node >= 0 and seen <= len(frame.names):
        c = frame.cob[node]
        a = list(ang[c]) if c >= 0 else [0, 0, 0]
        if frame.parent[node] < 0:
            a = [a[k] + body[k] for k in range(3)]
        acc[0], acc[1] = rotate2(a[2], acc[0], acc[1])
        acc[1], acc[2] = rotate2(a[0], acc[1], acc[2])
        acc[0], acc[2] = rotate2(a[1], acc[0], acc[2])
        local = piece_local(frame, pos, node)
        for k in range(3):
            acc[k] += local[k]
        node = frame.parent[node]
        seen += 1
    return acc


def piece_vertex(frame, pos, ang, piece, vertex, body=(0, 0, 0)):
    """A point of the piece's own mesh, in the unit's model frame — which *does*
    take the piece's own angles. This is the form the engine's posed vertex buffer
    holds, and `tacob pose-check` diffs it against the eight posedump fixtures."""
    node = frame.of_cob[piece] if 0 <= piece < len(frame.of_cob) else -1
    if node < 0:
        return list(vertex)
    return _compose(frame, pos, ang, node, list(vertex), body)


def piece_offset(frame, pos, ang, piece, body=(0, 0, 0)):
    """`UNITS_PieceOffset 0x43DEF0`: a COB piece's **origin** in the unit's frame.

    The piece's own angles are never applied here — turning a piece does not move
    its own origin — and the returned z is negated, as `0x43E00A` does, which is
    what puts it on the world's map-depth axis."""
    node = frame.of_cob[piece] if 0 <= piece < len(frame.of_cob) else -1
    if node < 0:
        return [0, 0, 0]
    acc = _compose(frame, pos, ang, frame.parent[node],
                   piece_local(frame, pos, node), body)
    return [i32(acc[0]), i32(acc[1]), i32(-acc[2])]


def piece_world(frame, pos, ang, piece, unit_pos, body=(0, 0, 0)):
    """`0x43E060`: that offset plus the unit's own position (`+0x6A` x, `+0x6E`
    altitude, `+0x72` map depth), all 16.16 — what PIECE_XZ and PIECE_Y read."""
    v = piece_offset(frame, pos, ang, piece, body)
    return [i32(unit_pos[k] + v[k]) for k in range(3)]


class EditorWorld(UnitWorld):
    """Everything `get` and `set` touch, computed the way the retail handlers do.

    One unit is the script's own (`self.unit_id`); others live in `self.units` so
    UNIT_XZ/UNIT_Y/UNIT_HEIGHT have something to answer with. The map is flat at
    `self.ground` — the editor has no heightmap, and a `get GROUND_HEIGHT` says so
    rather than pretending. Every field here is what the unit-state panel edits."""

    def __init__(self, frame=None, vm=None, seed=1):
        UnitWorld.__init__(self)
        self.frame = frame
        self.vm = vm
        self.tick = 0
        self.rng = SimRandom(seed)
        self.seed0 = seed
        self.pos = [0, 0, 0]              # unit +0x6A / +0x6E / +0x72, 16.16
        self.body = [0, 0x8000, 0]        # +0x68 pitch, +0x66 heading, +0x64 roll
        self.target = [0, 0, 0]           # the draggable marker, 16.16
        self.velocity = [0, 0, 0]
        self.ground = 0                   # world units, the flat map's height
        self.water = 0
        self.hp = 100
        self.maxhp = 100
        self.height = 0                   # def+0x16E, what UNIT_HEIGHT hands back
        self.build_left = 0.0             # unit+0x104, the remaining build fraction
        self.bits = {"activation": 0, "inbuildstance": 0, "busy": 0,
                     "yard_open": 0, "bugger_off": 0, "armored": 0,
                     "standingmoveorders": 0, "standingfireorders": 0}
        self.unit_id = 1
        self.units = {}
        self.ignored_sets = []            # (tick, id) — the fourteen SET drops
        self.effects = []

    # -- the panel --------------------------------------------------------
    def snapshot(self):
        return {"pos": list(self.pos), "body": list(self.body),
                "target": list(self.target), "ground": self.ground,
                "water": self.water, "hp": self.hp, "maxhp": self.maxhp,
                "height": self.height, "build_left": self.build_left,
                "bits": dict(self.bits), "seed": self.rng.seed,
                "values": {str(k): self.get(k, 0, 0, 0, 0) for k in range(1, 21)}}

    def rand(self, n, lo):
        """The `rand` opcode's own call: `0x4B6C30(hi - lo + 1)`, and the trace
        records `lo + result`."""
        self.draws += 1
        return self.rng.draw(n)

    def effect(self, tick, kind, piece, arg=None):
        """emit-sfx / explode / attach-unit / drop-unit, with where the piece is —
        the page draws a marker there. The handlers themselves (`0x480EB0`,
        `0x481140`) are located but their constant tables are still unread, so the
        type and flag *names* the editor prints are the community's, not ours."""
        where = None
        if piece is not None and self.frame is not None and self.vm is not None:
            if 0 <= piece < len(self.vm.pos):
                where = piece_world(self.frame, self.vm.pos, self.vm.ang, piece,
                                    self.pos, self.body)
        self.effects.append((tick, kind, piece, arg, where))
        if len(self.effects) > 4096:
            del self.effects[:2048]

    # -- get, id by id ----------------------------------------------------
    def _piece_xyz(self, piece):
        if self.frame is None or self.vm is None or not (0 <= piece < len(self.vm.pos)):
            return [self.pos[0], self.pos[1], self.pos[2]]
        return piece_world(self.frame, self.vm.pos, self.vm.ang, piece,
                           self.pos, self.body)

    def _other(self, uid):
        """0x480868's lookup: id 0 is nothing, and a unit that is not alive
        (`+0x110 & 0x10000000` clear) makes the handler return 0."""
        if not (uid & 0xFFFF):
            return None
        if (uid & 0xFFFF) == self.unit_id:
            return {"pos": self.pos, "height": self.height}
        return self.units.get(uid & 0xFFFF)

    def get(self, vid, a, b, c, d):
        v = VALUE_NAMES.get(vid)
        if v is None:                       # `id - 1 > 0x13` -> 0x480ABB, plain 0
            self.unknown.add(vid)
            return 0
        if v == "ACTIVATION":
            return self.bits["activation"] & 1
        if v == "STANDINGMOVEORDERS":
            return self.bits["standingmoveorders"] & 3
        if v == "STANDINGFIREORDERS":
            return self.bits["standingfireorders"] & 3
        if v == "HEALTH":                   # 0x4807CA: hp * 100 / def+0x1FA
            return (self.hp * 100) // self.maxhp if self.maxhp else 0
        if v == "INBUILDSTANCE":
            return self.bits["inbuildstance"] & 1
        if v == "BUSY":
            return self.bits["busy"] & 1
        if v == "PIECE_XZ":
            p = self._piece_xyz(a)
            return pack_xz(p[0], p[2])
        if v == "PIECE_Y":
            return self._piece_xyz(a)[1]
        if v == "UNIT_XZ":
            other = self._other(a)
            return 0 if other is None else pack_xz(other["pos"][0], other["pos"][2])
        if v == "UNIT_Y":
            other = self._other(a)
            return 0 if other is None else other["pos"][1]
        if v == "UNIT_HEIGHT":
            other = self._other(a)
            return 0 if other is None else other["height"]
        if v == "XZ_ATAN":                  # 0x480965 — **minus the unit's heading**
            x, z = unpack_xz(a)
            return (ta_atan(x, z) - self.body[1]) & 0xFFFF
        if v == "XZ_HYPOT":
            x, z = unpack_xz(a)
            return ta_hypot(x, z)
        if v == "ATAN":                     # 0x4809C7 — no heading subtraction
            return ta_atan(a, b) & 0xFFFF
        if v == "HYPOT":
            return ta_hypot(a, b)
        if v == "GROUND_HEIGHT":            # 0x480A0D: 0x485070(x, z) << 16
            return i32(self.ground << 16)
        if v == "BUILD_PERCENT_LEFT":       # 0x480A44: 0, or 1 - (int)(frac * -99)
            if self.build_left == 0.0:
                return 0
            return 1 - ftol(self.build_left * -99.0)
        if v == "YARD_OPEN":
            return self.bits["yard_open"] & 1
        if v == "BUGGER_OFF":
            return self.bits["bugger_off"] & 1
        if v == "ARMORED":
            return self.bits["armored"] & 1
        return 0

    def set(self, vid, value):
        """0x480B20. Six ids have a case; the other fourteen reach the shared
        default and change nothing — the editor records those so the panel can say
        so instead of the script's author wondering why the write vanished."""
        if vid not in SET_HANDLED:
            self.ignored_sets.append((self.tick, vid))
            self.unknown.add(vid)
            return
        name = VALUE_NAMES[vid].lower()
        self.bits[name] = value & (3 if name.startswith("standing") else 1)
# --------------------------------------------------------------------------- the lints

# Every rule here is a snag that cost a live run, and each says which note holds
# the measurement. They run on the AST, so they see the source the modder typed,
# not the bytecode; the two the compiler itself refuses (`play-sound`,
# `map-command`) arrive as errors instead and are listed in LINT_RULES for the
# page's own help text.

LINT_RULES = {
    "unimplemented": "an opcode retail TA does not dispatch — the thread dies there",
    "aim-waits": "an AimWeaponN that waits holds one of the eight records for the whole slew",
    "aim-no-signal": "a waiting aim script without the signal / set-signal-mask pair leaks a record",
    "thread-peak": "more records can be live at once than the pool's eight",
    "query-piece-shown": "a muzzle piece a Query script hands back that Create never hides",
    "set-ignored": "a `set` retail TA drops: only six of the twenty ids have a handler",
    "get-extension": "a value id above 20: this engine's jump table stops there and returns 0",
    "piece-unknown": "a piece the model has no node for — it is declared, but nothing moves",
}

AIM_RE = re.compile(r"^aim(primary|secondary|tertiary|weapon(\d+))$", re.I)
QUERY_RE = re.compile(r"^(query|aimfrom)(primary|secondary|tertiary|weapon\d+)$", re.I)
MUZZLE_RE = re.compile(r"^query(primary|secondary|tertiary|weapon\d+)$", re.I)
BLOCKING = {"sleep", "wait-for-turn", "wait-for-move"}


def walk_nodes(body):
    """Every statement node in a script body, blocks and branches included."""
    for stmt in body:
        yield stmt
        for key in ("body", "then", "other"):
            inner = getattr(stmt, key, None)
            if isinstance(inner, list):
                yield from walk_nodes(inner)


def walk_exprs(node):
    """Every expression node under a statement (or an expression)."""
    if not isinstance(node, Node):
        return
    yield node
    for key, value in node.__dict__.items():
        if key in ("body", "then", "other"):
            continue
        if isinstance(value, Node):
            yield from walk_exprs(value)
        elif isinstance(value, list):
            for item in value:
                yield from walk_exprs(item)


class Linter:
    """The static checks the editor runs on every parse.

    `frame` (a PieceFrame) is optional: without a model the two rules that need
    one — the unknown piece and the flare a Create never hides — are skipped
    rather than guessed at."""

    def __init__(self, program, frame=None):
        self.program = program
        self.frame = frame
        self.by_name = {fn.name.lower(): fn for fn in program.functions}
        self.pieces = {p.lower(): i for i, p in enumerate(program.pieces)}
        self.out = []

    def add(self, rule, level, node, script, message):
        tok = getattr(node, "tok", None) if node is not None else None
        self.out.append({"rule": rule, "level": level, "script": script,
                         "line": tok.line if tok else 0,
                         "file": tok.file if tok else "",
                         "message": message})

    # -- helpers ----------------------------------------------------------
    def blocks(self, name, seen=None):
        """True when a record running this script can still be busy next tick."""
        seen = seen or set()
        key = name.lower()
        if key in seen or key not in self.by_name:
            return False
        seen.add(key)
        for stmt in walk_nodes(self.by_name[key].body):
            if stmt.kind in BLOCKING:
                return True
            if stmt.kind == "call-script" and self.blocks(stmt.name, seen):
                return True
        return False

    def live(self, name, seen=None):
        """Records this script holds while it runs: itself if it can block, plus
        every child it starts or calls. `start-script` children outlive the
        parent, `call-script` children hold the parent's record as well."""
        seen = seen or set()
        key = name.lower()
        if key in seen or key not in self.by_name:
            return 0
        seen = seen | {key}
        total = 1 if self.blocks(name) else 0
        for stmt in walk_nodes(self.by_name[key].body):
            if stmt.kind in ("start-script", "call-script"):
                total += self.live(stmt.name, seen)
        return total

    def hidden_at_create(self):
        create = self.by_name.get("create")
        hidden = set()
        if create is not None:
            for stmt in walk_nodes(create.body):
                if stmt.kind == "piece-op" and stmt.op == "HIDE":
                    hidden.add(stmt.piece.lower())
                if stmt.kind in ("start-script", "call-script"):
                    child = self.by_name.get(stmt.name.lower())
                    if child is not None:
                        for inner in walk_nodes(child.body):
                            if inner.kind == "piece-op" and inner.op == "HIDE":
                                hidden.add(inner.piece.lower())
        if self.frame is not None:                          # 0x45AF1B does the rest
            for i, visible in enumerate(self.frame.visibility()):
                if not visible:
                    hidden.add(self.frame.cob_names[i].lower())
        return hidden

    # -- the rules --------------------------------------------------------
    def run(self):
        for fn in self.program.functions:
            self.script(fn)
        self.thread_peak()
        self.query_pieces()
        self.unknown_pieces()
        self.out.sort(key=lambda d: (d["line"], d["rule"]))
        return self.out

    def script(self, fn):
        name = fn.name
        aim = AIM_RE.match(name)
        waits = [s for s in walk_nodes(fn.body)
                 if s.kind in ("wait-for-turn", "wait-for-move")]
        if aim and aim.group(2) and int(aim.group(2)) >= 4 and waits:
            self.add("aim-waits", "error", waits[0], name,
                     f"{name} waits for the turn. Slots 4 and up are aimed by "
                     "tagpu_weapons.c, which needs the script to return inside its own "
                     "tick; a wait parks one of the eight records for the whole slew and "
                     "the pool runs out (extra-weapons.md snag 1: 0/2/0/6 shots against "
                     "19/18/25/19 for the slew shape). Turn and return 1 — the module's "
                     "own arrival gate holds fire until the barrel is on target.")
        if aim and waits:
            has_signal = any(s.kind == "signal" for s in walk_nodes(fn.body))
            has_mask = any(s.kind == "set-signal-mask" for s in walk_nodes(fn.body))
            if not (has_signal and has_mask):
                self.add("aim-no-signal", "warning", waits[0], name,
                         f"{name} waits but has no signal / set-signal-mask pair. Every "
                         "re-aim starts another copy and the old one keeps its record; "
                         "the pool is eight and it empties in seconds "
                         "(extra-weapons.md snag 1, the `track` row).")
        for stmt in walk_nodes(fn.body):
            for node in walk_exprs(stmt):
                if node.kind == "get" and node.value_id > 20:
                    self.add("get-extension", "warning", node, name,
                             f"get {node.value_id} is a TADR/ProTA extension id. Retail "
                             "TA's jump table (0x480AC4) covers 1..20 and everything else "
                             "returns 0 without a word of complaint.")
            if stmt.kind == "set":
                if stmt.value_id > 20 or stmt.value_id not in SET_HANDLED:
                    what = VALUE_NAMES.get(stmt.value_id, str(stmt.value_id))
                    self.add("set-ignored", "warning", stmt, name,
                             f"set {what} does nothing on retail TA. Only ACTIVATION, "
                             "INBUILDSTANCE, BUSY, YARD_OPEN, BUGGER_OFF and ARMORED have "
                             "a case in 0x480B20; the other fourteen ids fall into the "
                             "shared default, which only marks the unit dirty.")

    def thread_peak(self):
        roots, peak = [], 0
        for fn in self.program.functions:
            key = fn.name.lower()
            engine = key in ENGINE_STARTS or AIM_RE.match(fn.name) or QUERY_RE.match(fn.name) \
                or re.match(r"^fireweapon\d+$", key)
            if not engine:
                continue
            cost = self.live(fn.name)
            if cost:
                roots.append((fn.name, cost))
                peak += cost
        if peak > NRECORDS:
            worst = ", ".join(f"{n} ({c})" for n, c in sorted(roots, key=lambda r: -r[1])[:6])
            self.add("thread-peak", "warning", None, "",
                     f"a static estimate of {peak} records live at once, and the pool is "
                     f"{NRECORDS} (0x4B08C0 returns -1 for the ninth). Worst holders: "
                     f"{worst}. The estimate assumes every engine-called script can be "
                     "live together, which is the case a fight actually reaches; the "
                     "failure is silent — a refused Query leaves the slot aiming from "
                     "piece 0 (extra-weapons.md snag 10).")

    def query_pieces(self):
        hidden = self.hidden_at_create()
        for fn in self.program.functions:
            if not MUZZLE_RE.match(fn.name) or not fn.params:
                continue
            out = fn.params[0].lower()
            for stmt in walk_nodes(fn.body):
                if stmt.kind != "assign" or stmt.target.lower() != out:
                    continue
                expr = stmt.expr
                if expr.kind != "name" or expr.name.lower() not in self.pieces:
                    continue
                if expr.name.lower() in hidden:
                    continue
                self.add("query-piece-shown", "warning", stmt, fn.name,
                         f"{fn.name} hands back the muzzle {expr.name}, which Create never "
                         f"hides and "
                         "the model builder does not hide either (it has three or more "
                         "vertices, so 0x45AF1B leaves it visible). A muzzle flare left "
                         "showing is the cone every modder sees stuck on the hull.")

    def unknown_pieces(self):
        if self.frame is None:
            return
        known = {n.lower() for i, n in enumerate(self.frame.cob_names) if self.frame.bound[i]}
        for i, name in enumerate(self.program.pieces):
            if name.lower() not in known:
                self.add("piece-unknown", "warning", None, "",
                         f"piece {name} has no node in the model. It compiles and it takes "
                         "a piece index, but 0x45A950 binds by name, so every move, turn "
                         "and hide on it moves nothing.")


def lint_bos(text, file="<bos>", include_dirs=(), reader=None, frame=None):
    """Parse and lint. Returns (program, diagnostics) — a parse error becomes one
    diagnostic at its own line, so the editor shows both kinds in one gutter."""
    try:
        program = parse_bos(text, file, include_dirs, reader)
    except TacobError as err:
        return None, [{"rule": "parse", "level": "error", "script": "",
                       "line": _err_line(err), "file": file, "message": str(err)}]
    return program, Linter(program, frame).run()


def _err_line(err):
    match = re.search(r":(\d+):", str(err))
    return int(match.group(1)) if match else 0
# --------------------------------------------------------------------------- the live director

# Landing 3's director *replays* a fixture's E lines. This one *generates* them:
# a per-class motion sketch drives the unit, and every event it produces is
# issued through ENGINE_STARTS above, so a synthesised `StartMoving` takes the
# same entry, with the same runNow, at the same point in the frame as the
# engine's own. **The events are exact; the path is a sketch** and is never the
# engine's movement model — nothing here was measured against a moving unit.

MOTIONS = ("ground", "static", "circuit", "hover", "runin", "glide", "dive")

# range and reload come from the weapon TDF; these are the fallbacks for a slot
# whose weapon we cannot read, in world units and ticks.
DEFAULT_RANGE, DEFAULT_RELOAD = 400, 30
AIM_TOLERANCE = 1024            # tagpu_weapons.c, 1024 of 65536 = 5.6 degrees, yaw only
AIM_RESOLVE = 1024              # a stock aim is re-issued when the solution moves this far
AIM_RESTART = 300               # ...or after ten seconds, for an aim that never came back


class WeaponSlot:
    """One weapon of the unit, driven the way its slot number is driven.

    Slots 1..3 are the engine's: `Aim*` is started every tick until it returns 1,
    and only then does the shot go. Slots 4 and up are `tagpu_weapons.c`'s:
    `AimWeaponN` is expected back inside its tick, the muzzle and mount pieces are
    cached after the first `Query`/`AimFrom`, and the module's own `barrel_on_target`
    holds fire until the muzzle really points at the target — yaw only, to
    AIM_TOLERANCE (extra-weapons.md §"Per-weapon behaviour on slots 4..N")."""

    def __init__(self, index, weapon="", rng=DEFAULT_RANGE, reload_ticks=DEFAULT_RELOAD):
        self.index = index                      # 0-based, as the module counts
        self.weapon = weapon
        self.range = rng
        self.reload = reload_ticks
        self.stock = index < 3
        n = index + 1
        base = ("Primary", "Secondary", "Tertiary")[index] if self.stock else f"Weapon{n}"
        self.aim = "Aim" + base
        self.fire = "Fire" + base
        self.query = "Query" + base
        self.aim_from = "AimFrom" + base
        self.reset()

    def reset(self):
        self.cb = None
        self.aimed = 0
        self.cooldown = 0
        self.pc_query = None
        self.pc_aimfrom = None
        self.shots = 0
        self.hold_fire = 0
        self.aiming = False
        self.aim_tick = -10000
        self.aim_head = 0

    def info(self):
        return {"index": self.index, "n": self.index + 1, "weapon": self.weapon,
                "range": self.range, "reload": self.reload, "stock": self.stock,
                "scripts": [self.aim, self.fire, self.query, self.aim_from],
                "aimed": self.aimed, "cooldown": self.cooldown, "shots": self.shots,
                "hold_fire": self.hold_fire, "muzzle": self.pc_query,
                "mount": self.pc_aimfrom}


class Director:
    """Plays the engine's part for one unit: moves it, and calls its scripts.

    Everything it issues goes through `dispatch`, so the entry (`query` / run-now /
    run-later) and the frame position come from the call-site table, not from
    this class's own idea of them."""

    def __init__(self, vm, world, motion="ground", slots=(), speed=60, alt=0,
                 radius=480, sfx_occupy=False, activates=False):
        self.vm, self.world = vm, world
        self.motion = motion if motion in MOTIONS else "ground"
        self.slots = list(slots)
        self.speed = speed                       # world units a second
        self.alt = alt
        self.radius = radius
        self.sfx_occupy = sfx_occupy
        self.activates = activates
        self.reset()

    def reset(self):
        self.started = False
        self.moving = False
        self.rate = 0
        self.active = 0
        self.tick0 = None
        self.pending = []
        self.log = []
        self.fired = []
        for slot in self.slots:
            slot.reset()

    # -- the raw event buttons -------------------------------------------
    def issue(self, script, args=()):
        """One engine start, exactly as the engine would make it. Queued so it
        lands on the right side of DoScriptsNow."""
        kind, phase = ENGINE_STARTS.get(script.lower(), (None, None))
        if kind is None:
            kind, phase = ("query" if len(args) == 4 else "later"), "pre"
        ev = Event(self.vm.tick, script, [int(a) for a in args], kind, phase)
        self.pending.append(ev)
        return ev

    def flush(self, phase):
        for ev in [e for e in self.pending if e.phase == phase]:
            self.pending.remove(ev)
            if self.vm.index_of(ev.script) < 0:
                self.log.append((self.vm.tick, "missing", ev.script))
                continue
            self.log.append((self.vm.tick, phase, ev.script))
            if ev.kind == "later" and ev.script.lower().startswith("aim"):
                slot = next((s for s in self.slots if s.aim.lower() == ev.script.lower()), None)
                cb = AimCallback()
                if slot is not None:
                    slot.cb = cb
                self.vm.start_script(ev.script, run_now=False, args=ev.args,
                                     argwords=bool(ev.args), cb=cb)
            else:
                dispatch(self.vm, ev)

    # -- the motion sketch ------------------------------------------------
    def step_motion(self, tick):
        """Where the unit is this tick.

        Every path is a **bounded loop**, so the unit stays in front of the camera
        and in range of the target marker instead of walking off the map: ground,
        ship and submarine shuttle out and back, the fighter flies a circuit, the
        gunship hovers and slowly turns, the bomber runs in and goes round again.
        The events these transitions fire are the engine's exact ones; the path
        itself is a sketch and was never measured against a moving unit."""
        w = self.world
        if self.tick0 is None:
            self.tick0 = tick
        t = (tick - self.tick0) / float(SIM_RATE)           # seconds since Create
        per = self.speed / float(SIM_RATE)                  # world units a tick
        x, y, z = (v / float(FIXED) for v in w.pos)
        moving = True
        if self.motion == "static":
            moving = False
        elif self.motion in ("ground", "glide", "dive"):
            leg = self.radius / max(self.speed, 1.0)        # seconds to the far end
            cycle = 2 * (leg + 1.0)
            phase = t % cycle
            if phase < leg:
                z += per
                w.body[1] = 0
            elif phase < leg + 1.0:
                moving = False
            elif phase < 2 * leg + 1.0:
                z -= per
                w.body[1] = 0x8000
            else:
                moving = False
            if self.motion == "glide":
                y = w.water / float(FIXED)
            elif self.motion == "dive":
                y = -18.0 * (0.5 - 0.5 * math.cos(t * 0.7))
        elif self.motion == "circuit":
            a = t * self.speed / max(self.radius, 1.0)
            x = self.radius * math.sin(a)
            z = self.radius * math.cos(a)
            y = self.alt
            w.body[1] = int(round(a * 65536 / (2 * math.pi))) & 0xFFFF
            w.body[2] = int(round(-0.35 * 65536 / (2 * math.pi))) & 0xFFFF   # the bank
        elif self.motion == "hover":
            y = self.alt + 4.0 * math.sin(t * 1.6)
            w.body[1] = int(round(t * 0.25 * 65536 / (2 * math.pi))) & 0xFFFF
            moving = False
        elif self.motion == "runin":
            z = -self.radius + t * self.speed
            y = self.alt if abs(z) > self.radius * 0.25 else self.alt * 0.6
            w.body[1] = 0
            if z > self.radius:
                self.tick0 = tick                           # round again
        w.pos = [int(round(x * FIXED)), int(round(y * FIXED)), int(round(z * FIXED))]
        return moving

    def motion_events(self, moving):
        """`StartMoving` / `StopMoving` / `MoveRateN` — the movement pass's own
        starts (0x43DAF2, 0x43DB27), so they land after this unit's DoScriptsNow."""
        if moving and not self.moving:
            self.issue("StartMoving")
        elif self.moving and not moving:
            self.issue("StopMoving")
        self.moving = moving
        want = 0 if not moving else min(3, 1 + int(self.speed // 100))
        # a unit carries only the MoveRate scripts its animation needs — ARMHAWK has
        # MoveRate2 and nothing else — so drop to the nearest one it actually has
        rate = next((n for n in range(want, 0, -1)
                     if self.vm.index_of(f"MoveRate{n}") >= 0), 0)
        if rate != self.rate:
            self.rate = rate
            if rate:
                self.issue(f"MoveRate{rate}")

    # -- the weapons ------------------------------------------------------
    def aim_solution(self, slot):
        """Heading and pitch as the engine hands them to an aim script: heading
        relative to the unit's own facing, pitch from the mount to the target."""
        w = self.world
        origin = list(w.pos)
        if slot.pc_aimfrom is not None and w.frame is not None:
            origin = piece_world(w.frame, self.vm.pos, self.vm.ang, slot.pc_aimfrom,
                                 w.pos, w.body)
        dx = w.target[0] - origin[0]
        dy = w.target[1] - origin[1]
        dz = w.target[2] - origin[2]
        heading = (ta_atan(dx, dz) - w.body[1]) & 0xFFFF
        flat = math.hypot(dx / float(FIXED), dz / float(FIXED))
        pitch = ta_atan(int(dy), int(flat * FIXED)) & 0xFFFF
        return heading, pitch, math.hypot(flat, dy / float(FIXED))

    def barrel_on_target(self, slot, heading):
        """`tagpu_weapons.c`: mount -> muzzle against mount -> target, yaw only,
        to AIM_TOLERANCE. Without both cached pieces the module lets the shot go."""
        w = self.world
        if w.frame is None or slot.pc_query is None or slot.pc_aimfrom is None:
            return True
        mount = piece_world(w.frame, self.vm.pos, self.vm.ang, slot.pc_aimfrom, w.pos, w.body)
        muzzle = piece_world(w.frame, self.vm.pos, self.vm.ang, slot.pc_query, w.pos, w.body)
        barrel = ta_atan(muzzle[0] - mount[0], muzzle[2] - mount[2])
        want = ta_atan(w.target[0] - mount[0], w.target[2] - mount[2])
        delta = (barrel - want) & 0xFFFF
        return min(delta, 0x10000 - delta) <= AIM_TOLERANCE

    def weapon_events(self, tick):
        for slot in self.slots:
            if slot.cooldown > 0:
                slot.cooldown -= 1
            heading, pitch, dist = self.aim_solution(slot)
            if dist > slot.range:
                slot.aimed, slot.aiming = 0, False
                continue
            has_aim = self.vm.index_of(slot.aim) >= 0
            if not has_aim:
                # Most aircraft and the submarine have no Aim script at all —
                # ARMHAWK, ARMBRAWL, ARMTHUND and CORSUB carry only `QueryPrimary`
                # and (sometimes) `FirePrimary`. The engine aims those itself and
                # the script exists only to point at the muzzle and flash it, so
                # the slot is always "aimed" and the shot goes on reload alone.
                slot.aimed = 1
            elif slot.stock:
                # Cavedog's shape waits for the turn, so the aim holds a record for
                # the whole slew — and its own `signal` kills any earlier copy. Start
                # one every tick and each new one kills the last before it can arrive,
                # which is the `full` row of extra-weapons.md snag 1 reproduced
                # exactly (and what an earlier version of this director did). So:
                # one in flight at a time, and a fresh one only once it has answered —
                # or once the solution has moved further than the module's own
                # tolerance, which is what AutoAim re-calls the script for. A slow
                # turret on a still target slews for as long as it needs.
                if slot.cb is not None and slot.cb.calls:
                    slot.aiming = False
                    slot.aimed = slot.cb.aimed
                if not slot.aimed:
                    moved = abs(((heading - slot.aim_head + 0x8000) & 0xFFFF) - 0x8000)
                    if (not slot.aiming or moved > AIM_RESOLVE
                            or tick - slot.aim_tick > AIM_RESTART):
                        self.issue(slot.aim, (heading, pitch))
                        slot.aiming, slot.aim_tick, slot.aim_head = True, tick, heading
                    continue
            else:
                self.issue(slot.aim, (heading, pitch))          # every tick, and it returns
                if slot.pc_aimfrom is None and self.vm.index_of(slot.aim_from) >= 0:
                    out = self.vm.query_script(slot.aim_from, (0, 0, 0, 0))
                    slot.pc_aimfrom = out[0] if out else None
                if slot.pc_query is None and self.vm.index_of(slot.query) >= 0:
                    out = self.vm.query_script(slot.query, (0, 0, 0, 0))
                    slot.pc_query = out[0] if out else None
                if not self.barrel_on_target(slot, heading):
                    slot.hold_fire += 1
                    continue
            if slot.cooldown > 0:
                continue
            if slot.stock and self.vm.index_of(slot.query) >= 0:
                out = self.vm.query_script(slot.query, (0, 0, 0, 0))
                slot.pc_query = out[0] if out else slot.pc_query
            self.issue(slot.fire)
            self.issue("RockUnit", (0, angular_word(2)))
            slot.cooldown = slot.reload
            slot.shots += 1
            slot.aimed = 0
            if slot.cb is not None:
                slot.cb.aimed = 0
            self.fired.append((tick, slot.index))

    # -- one tick ---------------------------------------------------------
    def step(self, tick):
        """The unit's own frame: what the engine does before DoScriptsNow, the
        script pass itself, then what the movement pass and other units do after."""
        vm, w = self.vm, self.world
        vm.tick = w.tick = tick
        if not self.started:
            self.started = True
            self.tick0 = tick
            self.issue("Create")
            self.issue("SetMaxReloadTime", (max((s.reload for s in self.slots),
                                                default=DEFAULT_RELOAD) * 33,))
            if self.sfx_occupy:
                self.issue("SetSFXOccupy", (2,))
            self.flush("pre")
            self.flush("post")
            return
        moving = self.step_motion(tick)
        self.motion_events(moving)
        if self.activates:
            # a building's idle animation is the Activate/Deactivate pair, so cycle
            # it; an aircraft activates once, at take-off, and stays that way
            want = 1 if self.motion != "static" else int((tick // (10 * SIM_RATE)) % 2)
            if want != self.active:
                self.active = want
                w.bits["activation"] = want
                self.issue("Activate" if want else "Deactivate")
        self.weapon_events(tick)
        self.flush("pre")
        vm.do_scripts_now(1)
        self.flush("post")

# --------------------------------------------------------------------------- the gate

FIXTURES = Path(__file__).resolve().parent.parent / "research/notes/evidence/cobtrace"
CLASSES = ["kbot", "tank", "building", "death", "fighter", "gunship", "bomber", "ship", "sub"]


def read_posedump(path):
    """The pose oracle's dump: (tick, unit, [(name, hidden, move, turn)])."""
    tick = unit = None
    pieces = []
    for line in Path(path).read_text(encoding="latin-1").splitlines():
        line = line.strip()
        if line.startswith("posedump: tick="):
            for part in line[len("posedump: "):].split():
                k, _, v = part.partition("=")
                if k == "tick": tick = int(v)
                elif k == "idx": unit = int(v)
        m = re.match(r"posedump: p(\d+) (\S+)( HIDDEN)? off=\(([-\d,]+)\) move=\(([-\d,]+)\) "
                     r"turn=\((\d+),(\d+),(\d+)\)", line)
        if m:
            pieces.append((int(m.group(1)), m.group(2), bool(m.group(3)),
                           [int(x) for x in m.group(5).split(",")],
                           [int(m.group(6)), int(m.group(7)), int(m.group(8))]))
    return tick, unit, pieces


def piece_visibility(unit, pieces):
    """The pose the model builder hands the VM: `0x45AF1B` clears the visible bit of
    a piece whose 3DO node carries fewer than three vertices. Measured against all
    eight fixtures with a posedump — every HIDDEN piece is either that or one the
    unit's own `Create` hides."""
    ta3do = load_ta3do()
    assets = ta3do.Assets(None)
    try:
        _label, blob = ta3do.resolve_model(assets, unit)
    except Exception:
        return None
    counts = {p.name.lower(): len(p.vertices) for p, _ in ta3do.parse_3do(blob).walk()}
    return [counts.get(name.lower(), 3) >= 3 for name in pieces]


def replay_inputs(cls):
    """The per-class world timelines, and where each came from (replay.json)."""
    path = FIXTURES / "replay.json"
    if not path.is_file():
        return {}
    return json.loads(path.read_text()).get(cls, {})


def run_class(cls, pose=True):
    """Replay one fixture and diff both oracles. Returns a report dict."""
    folder = FIXTURES / cls
    header, lines = read_cobtrace(folder / "cobtrace.log")
    if not lines:
        raise TacobError(f"{cls}: the fixture's cobtrace.log has no lines")
    type_name = lines[0].fields[3] if lines[0].kind == "S" else "?"
    unit = lines[0].unit
    spec = replay_inputs(cls)
    blob, _ = read_cob_source(type_name.lower())
    cob = read_cob(blob)
    visible = piece_visibility(type_name.lower(), cob.pieces)
    pose_tick, pose_unit, pieces = (None, None, [])
    if pose and (folder / "posedump.txt").is_file():
        pose_tick, pose_unit, pieces = read_posedump(folder / "posedump.txt")
    if pose_unit is not None and pose_unit != unit:
        # the death fixture's dump is of another unit: its Peewee was gone by then
        report_note = f"posedump is unit idx={pose_unit}, the trace is idx={unit} — not compared"
        pieces, pose_tick = [], None
    else:
        report_note = None
    until = max([ln.tick for ln in lines] + ([pose_tick] if pose_tick else []))
    timelines = {int(k): [tuple(p) for p in v] for k, v in (spec.get("get") or {}).items()}
    # the pose is sampled on the render thread, so the dump's tick may name the sim
    # tick before or after the pass that filled it (tagpu_native.c, the posedump header)
    want_ticks = [pose_tick + d for d in (0, -1, 1)] if pose_tick else []
    vm, out, unknown, snaps = replay(cob, lines, timelines, type_name, unit,
                                     until=until, snap=want_ticks, visible=visible)
    out.insert(0, header if header else TRACE_HEADER % (",%s," % type_name))
    report = {"class": cls, "unit": type_name, "lines": len(lines), "unknown_starts": unknown}
    if report_note:
        report["pose_note"] = report_note

    end = max(ln.tick for ln in lines)
    # nothing is masked: `Killed`'s uninitialised second argument (the design note
    # expected to mask it) is one of the E line's own words, so it replays verbatim
    want = [ln.raw for ln in lines]
    got = [l for l in out[1:] if int(l.split("\t")[1]) <= end]
    report["trace_diff"] = first_diff(want, got)
    report["trace_ok"] = report["trace_diff"] is None and len(want) == len(got)
    report["want_lines"], report["got_lines"] = len(want), len(got)
    out = out[:1] + got            # what `--trace-out` writes: the fixture's own span

    if pieces:
        best, best_tick = None, None
        for t in want_ticks:
            if t not in snaps:
                continue
            pos, ang, vis = snaps[t]
            bad = []
            for idx, name, hidden, move, turn in pieces:
                if idx >= len(pos):
                    continue
                if pos[idx] != move or ang[idx] != turn or (not vis[idx]) != hidden:
                    bad.append({"piece": idx, "name": name,
                                "want": {"move": move, "turn": turn, "hidden": hidden},
                                "got": {"move": pos[idx], "turn": ang[idx],
                                        "hidden": not vis[idx]}})
            if best is None or len(bad) < len(best):
                best, best_tick = bad, t
        report["pose_tick"] = pose_tick
        report["pose_matched_tick"] = best_tick
        report["pose_pieces"] = len(pieces)
        report["pose_bad"] = best or []
        report["pose_ok"] = not best
    return report, vm, out


def first_diff(want, got):
    for i in range(max(len(want), len(got))):
        w = want[i] if i < len(want) else "<end>"
        g = got[i] if i < len(got) else "<end>"
        if w != g:
            return {"line": i + 1, "want": w, "got": g}
    return None


# The one engine value the fixtures' scripts branch on that the oracle does not
# carry. `SmokeUnit` (the shipped snippet every stock unit starts) draws
# `rand(1, 66)` only while `get HEALTH` is under 66 and then sleeps
# `healthpercent * 50` ms, so the gap between two of its draws names the health it
# read at the first of them: ticks = trunc(h * 50 * SIM_RATE / 1000). Deriving the
# timeline that way makes those D lines' *ticks* an input rather than a prediction —
# see research/notes/tacob-design.md §"What the replay supplies". Nothing else in
# any of the nine logs depends on it: the first draw's tick is still predicted (health
# starts at 100), and the fighter's draws are `MoveRate2`'s `rand(1, 10)`, not health.

def smoke_slots(lines):
    """{slot: True} for the records a `SmokeUnit` is running, as the log walks by."""
    owner, out = {}, []
    for ln in lines:
        if ln.kind == "S":
            owner[int(ln.fields[5])] = ln.fields[4]
        elif ln.kind in ("R", "K"):
            owner.pop(int(ln.fields[3]), None)
        elif ln.kind == "D":
            out.append((ln.tick, owner.get(int(ln.fields[3]))))
    return [tick for tick, script in out if script == "SmokeUnit"]


def fit_health(lines):
    """[(tick, health)] — 100 until the first SmokeUnit draw, then one value per gap."""
    draws = smoke_slots(lines)
    if not draws:
        return [], []
    timeline, gaps = [(0, 100)], []
    for i, tick in enumerate(draws[:-1]):
        gap = draws[i + 1] - tick
        found = [h for h in range(1, 66) if idiv(max(200, h * 50) * SIM_RATE, 1000) == gap]
        if len(found) != 1:
            gaps.append((tick, gap, found))
            continue
        timeline.append((tick, found[0]))
    if len(timeline) > 1:                       # the last draw has no gap to name it
        timeline.append((draws[-1], timeline[-1][1]))
    return timeline, gaps


def cmd_fit(args):
    """Write the world timelines the replay needs, derived from the fixtures."""
    path = FIXTURES / "replay.json"
    data = json.loads(path.read_text()) if path.is_file() else {}
    for cls in (CLASSES if args.all else args.classes):
        _header, lines = read_cobtrace(FIXTURES / cls / "cobtrace.log")
        timeline, gaps = fit_health(lines)
        entry = {"note": "get timelines the cobtrace log cannot carry; HEALTH is derived "
                         "from SmokeUnit's rand spacing (tacob fit-world)"}
        if timeline:
            entry["get"] = {str(VALUE_IDS["HEALTH"]): [list(x) for x in timeline]}
            data[cls] = entry
        else:
            data.pop(cls, None)
        print(f"{cls}: {len(timeline)} HEALTH samples"
              + (f", {len(gaps)} gaps with no single health: {gaps}" if gaps else ""))
    path.write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")
    print(f"wrote {path}")


def cmd_run(args):
    classes = CLASSES if args.all else (args.classes or [])
    if not classes:
        raise TacobError("nothing to run: give a class name or --all")
    reports = []
    failed = False
    for cls in classes:
        report, vm, out = run_class(cls, pose=not args.no_pose)
        reports.append(report)
        if args.trace_out:
            Path(args.trace_out).write_text("\n".join(out) + "\n",
                                            encoding="utf-8", errors="surrogateescape")
        elif args.print_trace:
            sys.stdout.write("\n".join(out) + "\n")
        ok = report["trace_ok"] and report.get("pose_ok", True)
        failed = failed or not ok
        if not args.json:
            d = report["trace_diff"]
            print(f"{'ok  ' if ok else 'FAIL'} {cls:<9} {report['unit']:<9} "
                  f"trace {report['got_lines']}/{report['want_lines']}"
                  + (f"  pose {report['pose_pieces'] - len(report['pose_bad'])}/{report['pose_pieces']}"
                     if "pose_pieces" in report else ""))
            if d:
                print(f"       line {d['line']}\n         want {d['want']}\n         got  {d['got']}")
            for bad in report.get("pose_bad", [])[:4]:
                print(f"       p{bad['piece']} {bad['name']}: want {bad['want']} got {bad['got']}")
            if report.get("pose_note"):
                print(f"       {report['pose_note']}")
            if report["unknown_starts"]:
                print(f"       engine starts not in the call-site table: "
                      f"{', '.join(report['unknown_starts'])}")
    if args.json:
        print(json.dumps(reports, indent=1))
    if failed:
        raise SystemExit(1)


