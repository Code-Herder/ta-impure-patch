# What the FBI says about how a unit moves, turned into the director's sketch.
# A guess, and the page can override it — nothing here is measured.
def classify(fbi):
    """The category field is a *word list* — ARMPW's reads
    `ARM KBOT LEVEL1 WEAPON NOTAIR NOTSUB CTRL_W`, so a substring test for "SUB"
    calls a Peewee a submarine. Split it."""
    cat = set((fbi.get("category") or "").upper().split())
    def on(key):
        return (fbi.get(key) or "0").strip() not in ("0", "")
    if on("canfly"):
        if on("hoverattack"):
            return "gunship"
        if "BOMB" in (fbi.get("weapon1") or "").upper():
            return "bomber"
        return "fighter"
    if not on("bmcode") or not on("canmove"):
        return "building"
    if on("candive") or {"SUB", "UNDERWATER"} & cat:   # CORSUB reads UNDERWATER
        return "sub"
    if on("floater") or on("waterline") or "SHIP" in cat:
        return "ship"
    if "KBOT" in cat:
        return "kbot"
    return "tank"


