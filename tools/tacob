def roundtrip_one(blob: bytes, unit: str):
    """One unit through decompile → compile; a dict the gate and the tests both read."""
    result = {"unit": unit, "ok": False}
    try:
        cob = read_cob(blob)
    except TacobError as e:
        result["error"] = f"read: {e}"
        return result, None
    text, failures = decompile_cob(cob, unit)
    result["scripts"] = len(cob.scripts)
    if failures:
        result["error"] = "decompile: " + "; ".join(f"{n}: {m}" for n, m in failures)
        return result, text
    try:
        rebuilt = write_cob(compile_bos(text, f"{unit}.bos"))
    except CompileError as e:
        result["error"] = f"compile: {e}"
        return result, text
    if rebuilt == blob:
        result["ok"] = True
        return result, text
    n = min(len(rebuilt), len(blob))
    diff = next((k for k in range(n) if rebuilt[k] != blob[k]), n)
    result["error"] = f"bytes differ at offset {diff} (sizes {len(blob)} vs {len(rebuilt)})"
    if HEADER.size <= diff < HEADER.size + 4 * len(cob.code):
        word = (diff - HEADER.size) // 4
        script = next((nm for nm, s, e in script_ranges(cob) if s <= word < e), "?")
        result["error"] += f"; code word {word} in {script}"
    return result, text


def cmd_roundtrip(args):
    units = []
    if args.all:
        ta3do = load_ta3do()
        assets = ta3do.Assets(args.gamedir)
        for path in assets.glob("scripts/*.cob"):
            units.append((assets.read(path), Path(path).stem))
    for spec in args.units:
        units.append(read_cob_source(spec, args.gamedir))
    if not units:
        raise TacobError("nothing to round-trip: give unit names or --all")
    out_dir = Path(args.out) if args.out else None
    if out_dir:
        out_dir.mkdir(parents=True, exist_ok=True)
    results = []
    for blob, unit in units:
        result, text = roundtrip_one(blob, unit)
        results.append(result)
        if out_dir and text is not None:
            (out_dir / f"{unit}.bos").write_text(text, encoding="latin-1")
        if not args.json:
            print(f"{'ok  ' if result['ok'] else 'FAIL'} {unit:<12} {result.get('error', '')}")
    failed = [r for r in results if not r["ok"]]
    summary = {"units": len(results), "identical": len(results) - len(failed), "failed": failed}
    if args.json:
        print(json.dumps(summary, indent=1))
    else:
        print(f"{summary['identical']} of {summary['units']} byte-identical")
    if failed:
        raise SystemExit(1)


# The pose oracle, read the other way round. `read_posedump` above takes the
# per-piece `move=`/`turn=` the trace gate diffs; these two take the *vertex*
# lines, which carry the engine's own posed vertex buffer (`P_VBUF`) beside the
# model-space vertex it came from. Composing one from the other is the only check
# there is on `piece_offset`'s rotation order and its handling of MOVE, because
# the disassembly says what the engine does and only the vertex buffer says
# whether we read it right.

POSE_VERTEX_RE = re.compile(r"posedump:\s+v(\d+) node=\(([-\d,]+)\) vbuf=\(([-\d,]+)\)")
POSE_PIECE_RE = re.compile(r"posedump: p(\d+) (\S+)( HIDDEN)? off=\(([-\d,]+)\) "
                           r"move=\(([-\d,]+)\) turn=\((\d+),(\d+),(\d+)\)")


def read_posedump_vertices(path):
    """(yaw, [{i, name, off, move, turn, err, v: [(node, vbuf)]}]) — the dump's
    other half. `yaw` is the unit's `+0x66` from the header line."""
    yaw, pieces, cur = 0, [], None
    for line in Path(path).read_text(encoding="latin-1").splitlines():
        line = line.strip()
        if line.startswith("posedump: tick="):
            for part in line.split():
                if part.startswith("yaw="):
                    yaw = int(part[4:])
        m = POSE_PIECE_RE.match(line)
        if m:
            cur = {"i": int(m.group(1)), "name": m.group(2),
                   "off": [int(x) for x in m.group(4).split(",")],
                   "move": [int(x) for x in m.group(5).split(",")],
                   "turn": [int(m.group(6)), int(m.group(7)), int(m.group(8))],
                   "err": float(line.rsplit("err=", 1)[1]) if "err=" in line else None,
                   "v": []}
            pieces.append(cur)
            continue
        m = POSE_VERTEX_RE.match(line)
        if m and cur is not None:
            cur["v"].append(([int(x) for x in m.group(2).split(",")],
                             [int(x) for x in m.group(3).split(",")]))
    return yaw, pieces


def pose_check(cls):
    """Rebuild the fixture's posed vertices and diff them against the engine's own.

    The residual is in world units. Where the vertex buffer is fresh it is
    **zero**; on the three fast movers it is a few units and matches
    `tagpu_native.c`'s own `err=` on the same line, which is that pass measuring
    the same staleness against the same buffer — the vertex buffer is a frame or
    two behind the pose the dump sampled, and neither implementation can do
    anything about that."""
    folder = FIXTURES / cls
    _header, lines = read_cobtrace(folder / "cobtrace.log")
    unit = (lines[0].fields[3] if lines and lines[0].kind == "S" else cls).lower()
    yaw, pieces = read_posedump_vertices(folder / "posedump.txt")
    blob, _ = read_cob_source(unit)
    cob = read_cob(blob)
    ta3do = load_ta3do()
    _label, model = ta3do.resolve_model(ta3do.Assets(None), unit)
    frame = PieceFrame.from_3do(cob.pieces, ta3do.parse_3do(model))
    pos = [[0, 0, 0] for _ in cob.pieces]
    ang = [[0, 0, 0] for _ in cob.pieces]
    # the dump's `pN` is the PrimitiveStruct index, which 0x45A950 lays out in the
    # COB's piece order — the nodes the COB does not name sit past the end of it
    offsets = addressable = 0
    for p in pieces:
        c = p["i"] if p["i"] < len(cob.pieces) else -1
        node = frame.of_cob[c] if c >= 0 else -1
        if node < 0:
            continue
        if p["name"].lower() != cob.pieces[c].lower():
            # the death fixture's dump is of a different unit that happened to be
            # on screen; its pieces are not this COB's and there is nothing to diff
            return {"class": cls, "unit": unit.upper(), "yaw": yaw, "pieces": 0,
                    "offsets_matched": 0, "points": 0, "worst": 0.0,
                    "engine_pass_worst": 0.0, "turned": 0, "moved": 0,
                    "note": f"the dump's p{p['i']} is {p['name']}, this COB's is "
                            f"{cob.pieces[c]} — a different unit, not compared"}
        addressable += 1
        offsets += frame.offset[node] == p["off"]
        pos[c], ang[c] = p["move"], p["turn"]
    worst, points, theirs = 0.0, 0, 0.0
    for p in pieces:
        c = p["i"] if p["i"] < len(cob.pieces) else -1
        if c < 0 or frame.of_cob[c] < 0:
            continue
        theirs = max(theirs, p["err"] or 0.0)
        for node, vbuf in p["v"]:
            got = piece_vertex(frame, pos, ang, c, list(node), (0, yaw, 0))
            worst = max(worst, max(abs(got[k] - vbuf[k]) for k in range(3)) / float(FIXED))
            points += 1
    return {"class": cls, "unit": unit.upper(), "yaw": yaw, "pieces": addressable,
            "offsets_matched": offsets, "points": points,
            "worst": round(worst, 5), "engine_pass_worst": round(theirs, 2),
            "turned": sum(1 for p in pieces if any(p["turn"])),
            "moved": sum(1 for p in pieces if any(p["move"]))}


def cmd_pose_check(args):
    reports = []
    for cls in (CLASSES if args.all else args.classes):
        if not (FIXTURES / cls / "posedump.txt").is_file():
            continue
        report = pose_check(cls)
        reports.append(report)
        if not args.json:
            if report.get("note"):
                print(f"{report['class']:<9} {report['unit']:<9} {report['note']}")
            else:
                print(f"{report['class']:<9} {report['unit']:<9} yaw={report['yaw']:<6} "
                      f"offsets {report['offsets_matched']}/{report['pieces']}  "
                      f"points {report['points']:<3} worst {report['worst']:<9} "
                      f"(tagpu_native's own on the same dump: {report['engine_pass_worst']})")
    if args.json:
        print(json.dumps(reports, indent=1))
    bad = [r for r in reports if r["worst"] > r["engine_pass_worst"] + 0.01]
    if bad:
        raise SystemExit(1)


def cmd_open(args):
    project = Project.open_unit(args.unit, args.project, args.gamedir, args.force)
    print(f"{project.path}: {project.bos.name}, {project.cob.name}, "
          f"model/{project.glb.name}, class {project.meta['class']}")


def cmd_lint(args):
    """Parse and lint one BOS file — the same checks the editor shows in its gutter."""
    path = Path(args.source)
    frame = None
    if args.unit:
        ta3do = load_ta3do()
        assets = ta3do.Assets(args.gamedir)
        _label, blob = ta3do.resolve_model(assets, args.unit)
        program = parse_bos(path.read_text(encoding="latin-1"), str(path),
                            (str(path.parent), str(INCLUDE_DIR)))
        frame = PieceFrame.from_3do(program.pieces, ta3do.parse_3do(blob))
    program, diags = lint_bos(path.read_text(encoding="latin-1"), str(path),
                              (str(path.parent), str(INCLUDE_DIR)), frame=frame)
    if args.json:
        print(json.dumps(diags, indent=1))
    else:
        for d in diags:
            where = f"{Path(d['file']).name}:{d['line']}" if d["file"] else str(path.name)
            print(f"{where}: {d['level']}: [{d['rule']}] {d['message']}")
        print(f"{len(diags)} finding(s)")
    if any(d["level"] == "error" for d in diags):
        raise SystemExit(1)


def cmd_template(args):
    print(weapon_template(args.n, args.mount, args.gun, args.flare).strip())


def cmd_pack(args):
    project = Project(args.project)
    if args.install:
        out, names, written = project.install(args.install, args.output)
        print(f"{out} ({out.stat().st_size} bytes): {', '.join(names)}")
        for path in written:
            print(f"  -> {path}")
        print("  the .ufo carries anything new; the loose scripts/*.cob is what "
              "overrides a stock unit (file-formats.md §5)")
        return
    out, names = project.pack(args.output)
    print(f"{out} ({out.stat().st_size} bytes): {', '.join(names)}")


def cmd_serve(args):
    if args.unit:
        path = Path(args.project) if args.project else PROJECTS / args.unit.lower()
        if not (path / PROJECT_FILE).is_file():
            Project.open_unit(args.unit, path, args.gamedir)
        project = Project(path)
    else:
        project = Project(args.project or PROJECTS)
    session = Session(project, args.gamedir)
    server = Server(session, args.host, args.port, args.install)
    server.start()
    print(f"tacob: {project.unit} at {server.base}  ({len(session.cob.scripts)} scripts, "
          f"{len(session.cob.pieces)} pieces)")
    for d in session.diagnostics:
        print(f"  {d['level']}: [{d['rule']}] {d['message'][:110]}")
    if args.open:
        import webbrowser
        webbrowser.open(server.base)
    if args.ticks:
        session.step(args.ticks)
        print(f"  stepped {args.ticks} ticks, {len(session.trace)} trace lines")
        server.close()
        return
    print("  ctrl-c to stop")
    try:
        while True:
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.close()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="tacob", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("compile", help="BOS -> COB")
    p.add_argument("source")
    p.add_argument("-o", "--output")
    p.add_argument("-I", "--include", action="append", help="include search directory")
    p.set_defaults(fn=cmd_compile)

    p = sub.add_parser("decompile", help="COB -> BOS (a file, or a stock unit name)")
    p.add_argument("source")
    p.add_argument("-o", "--output")
    p.add_argument("--gamedir")
    p.set_defaults(fn=cmd_decompile)

    p = sub.add_parser("dump", help="opcode listing")
    p.add_argument("source")
    p.add_argument("script", nargs="?")
    p.add_argument("--gamedir")
    p.set_defaults(fn=cmd_dump)

    p = sub.add_parser("roundtrip", help="decompile, recompile, compare bytes")
    p.add_argument("units", nargs="*")
    p.add_argument("--all", action="store_true", help="every scripts/*.cob in the game's archives")
    p.add_argument("--out", help="write the decompiled BOS files here")
    p.add_argument("--json", action="store_true")
    p.add_argument("--gamedir")
    p.set_defaults(fn=cmd_roundtrip)

    p = sub.add_parser("run", help="replay a landing-2 fixture on the VM and diff both oracles")
    p.add_argument("classes", nargs="*", help="kbot, tank, building, death, fighter, gunship, "
                                              "bomber, ship, sub")
    p.add_argument("--all", action="store_true", help="every fixture — the landing-3 gate")
    p.add_argument("--print-trace", action="store_true", help="write the replayed lines to stdout")
    p.add_argument("--trace-out", help="write the replayed lines to this file")
    p.add_argument("--no-pose", action="store_true", help="skip the posedump comparison")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("fit-world", help="derive replay.json's get timelines from the fixtures")
    p.add_argument("classes", nargs="*")
    p.add_argument("--all", action="store_true")
    p.set_defaults(fn=cmd_fit)

    p = sub.add_parser("pose-check", help="rebuild the fixtures' posed vertices and diff")
    p.add_argument("classes", nargs="*")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_pose_check)

    p = sub.add_parser("open", help="decompile a stock unit into projects/<unit>/")
    p.add_argument("unit")
    p.add_argument("--project", help="the folder to write (default projects/<unit>)")
    p.add_argument("--gamedir")
    p.add_argument("--force", action="store_true", help="overwrite an existing BOS")
    p.set_defaults(fn=cmd_open)

    p = sub.add_parser("serve", help="the editor page and the VM behind it")
    p.add_argument("unit", nargs="?", help="a stock unit; opens the project if new")
    p.add_argument("--project")
    p.add_argument("--gamedir")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=0)
    p.add_argument("--open", action="store_true", help="open a browser on it")
    p.add_argument("--ticks", type=int, help="run this many ticks and exit (a smoke test)")
    p.add_argument("--install", metavar="GAMEDIR",
                   help="the game directory the page's `pack` button installs into")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("lint", help="the editor's static checks on a BOS file")
    p.add_argument("source")
    p.add_argument("--unit", help="bind the pieces to this unit's model")
    p.add_argument("--gamedir")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_lint)

    p = sub.add_parser("pack", help="the project as a .ufo the game loads")
    p.add_argument("project")
    p.add_argument("-o", "--output")
    p.add_argument("--install", metavar="GAMEDIR",
                   help="also drop it into a game directory: the .ufo, and the loose "
                        "scripts/<unit>.cob that is what overrides a stock unit")
    p.set_defaults(fn=cmd_pack)

    p = sub.add_parser("weapon", help="the four scripts of one extra weapon slot")
    p.add_argument("n", type=int)
    p.add_argument("mount")
    p.add_argument("gun")
    p.add_argument("flare")
    p.set_defaults(fn=cmd_template)

    args = ap.parse_args(argv)
    try:
        args.fn(args)
    except TacobError as e:
        print(f"tacob: {e}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
