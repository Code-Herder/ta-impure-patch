def read_tdf_blocks(text):
    """The weapon TDFs' block form: `[NAME] { key=value; ... }`, one level deep."""
    out, name, depth, fields = {}, None, 0, {}
    for raw in text.splitlines():
        line = re.sub(r"//.*", "", raw).strip()
        if not line:
            continue
        head = re.match(r"^\[([^\]]+)\]", line)
        if head:
            name, fields = head.group(1).strip().lower(), {}
            out[name] = fields
            continue
        depth += line.count("{") - line.count("}")
        for m in re.finditer(r"([A-Za-z0-9_]+)\s*=\s*([^;]*);", line):
            if name is not None and depth <= 1:
                fields[m.group(1).lower()] = m.group(2).strip()
    return out


def weapon_table(assets):
    """{weapon id: {range, reloadtime, ...}} out of every weapons/*.tdf."""
    table = {}
    for path in assets.glob("weapons/*.tdf"):
        try:
            text = assets.read(path).decode("latin-1", "replace")
        except Exception:
            continue
        table.update(read_tdf_blocks(text))
    return table


def slots_from_fbi(fbi, weapons):
    """The FBI's `Weapon1..N` keys as slots. 1..3 are the engine's; 4 and up are
    tagpu_weapons.c's, and read exactly the same way (extra-weapons.md)."""
    out = []
    for n in range(1, 17):
        name = (fbi.get(f"weapon{n}") or "").strip()
        if not name:
            continue
        spec = weapons.get(name.lower(), {})
        try:
            rng = int(float(spec.get("range", DEFAULT_RANGE)))
        except ValueError:
            rng = DEFAULT_RANGE
        try:
            reload_ticks = max(1, int(float(spec.get("reloadtime", 1.0)) * SIM_RATE))
        except ValueError:
            reload_ticks = DEFAULT_RELOAD
        out.append(WeaponSlot(n - 1, name, rng, reload_ticks))
    return out


def weapon_template(n, mount, gun, flare, yaw="<300>", pitch="<200>", flash=150):
    """The four scripts of one extra weapon, in the only body shape that fired
    evenly on slots 4..7 (19/18/25/19 shots; extra-weapons.md snag 1).

    It turns and returns inside its own tick — no `wait-for-turn`, and therefore
    no `signal` pair to protect a thread that is not there. The guarantee the wait
    used to give is `tagpu_weapons.c`'s own arrival gate, which holds fire until
    the muzzle piece really points at the target."""
    return f"""
// Weapon {n} — the slew-and-return shape (research/notes/extra-weapons.md snag 1).
// AimWeapon{n} must return inside its tick: a wait here parks one of the eight
// records for the whole slew and the pool runs out.
AimWeapon{n}(heading, pitch)
{{
\tturn {mount} to y-axis heading speed {yaw};
\tturn {gun} to x-axis <0> - pitch speed {pitch};
\treturn (1);
}}

FireWeapon{n}()
{{
\tshow {flare};
\tsleep {flash};
\thide {flare};
\treturn (0);
}}

AimFromWeapon{n}(piecenum)
{{
\tpiecenum = {mount};
\treturn (0);
}}

QueryWeapon{n}(piecenum)
{{
\tpiecenum = {flare};
\treturn (0);
}}
"""


class Project:
    """BOS, the built COB, the FBI, and the glTF the viewer poses."""

    def __init__(self, path):
        self.path = Path(path)
        self.meta = {}
        if (self.path / PROJECT_FILE).is_file():
            self.meta = json.loads((self.path / PROJECT_FILE).read_text())
        self.unit = self.meta.get("unit") or self.path.name

    @property
    def bos(self):
        return self.path / f"{self.unit}.bos"

    @property
    def cob(self):
        return self.path / f"{self.unit}.cob"

    @property
    def glb(self):
        name = self.meta.get("model") or self.unit
        return self.path / "model" / f"{name}.glb"

    def save_meta(self):
        (self.path / PROJECT_FILE).write_text(json.dumps(self.meta, indent=1,
                                                         sort_keys=True) + "\n")

    @classmethod
    def open_unit(cls, unit, root=None, gamedir=None, force=False):
        """Decompile a stock unit into a fresh project: BOS, FBI, and the glTF
        with **every** piece kept — the VM decides visibility per tick and a
        script can `show` a flare later, so `--show-hidden` is not optional here."""
        unit = unit.lower()
        path = Path(root) if root else PROJECTS / unit
        ta3do = load_ta3do()
        assets = ta3do.Assets(gamedir)
        blob, label = read_cob_source(unit, gamedir)
        cob = read_cob(blob)
        text, failures = decompile_cob(cob, label)
        if failures:
            raise TacobError(f"{unit}: " + "; ".join(f"{n}: {m}" for n, m in failures))
        path.mkdir(parents=True, exist_ok=True)
        project = cls(path)
        project.unit = label
        if project.bos.is_file() and not force:
            raise TacobError(f"{project.bos} exists — pass --force to overwrite it")
        project.bos.write_text(text, encoding="latin-1")
        project.cob.write_bytes(blob)
        fbi = {}
        try:
            fbi = ta3do.fbi_fields(assets, label)
        except Exception:
            pass
        model = ta3do.load_model(assets, label, show_hidden=True, keep_flares=True)
        ta3do.export_model(model, path / "model")
        project.meta = {"unit": label, "model": model.name, "fbi": fbi,
                        "class": classify(fbi),
                        "note": "written by `tacob open`; BOS is the source, the COB "
                                "is a build artifact, and model/ is `ta3do export "
                                "--show-hidden` so every piece is present"}
        project.save_meta()
        return project

    def pack(self, out=None):
        """The project as a .ufo: the COB, and the FBI when the project carries one.

        `tools/hpipack.py` writes the archive. **A `.ufo` adds content; it does not
        override a path a stock archive already has** — measured 2026-09-07 by
        packing an ARMPW whose `Create` hides its torso and loading it three ways
        on one instance: as `ztacob-armpw.ufo` and as `aaa-tacob.ufo` (a name that
        sorts before every stock archive) the unit was **pixel-identical** to
        stock, and as a loose `gamedir/scripts/armpw.cob` the torso was gone. So
        `install()` writes both, and overriding a stock unit is the loose file's
        job. See file-formats.md §5."""
        import importlib.util
        from importlib.machinery import SourceFileLoader
        loader = SourceFileLoader("hpipack", str(HERE / "hpipack.py"))
        spec = importlib.util.spec_from_loader("hpipack", loader)
        hpipack = importlib.util.module_from_spec(spec)
        loader.exec_module(hpipack)
        if not self.cob.is_file():
            raise TacobError(f"{self.cob} is not built yet — build it first")
        tree = {}
        hpipack.insert(tree, f"scripts/{self.unit}.cob", self.cob.read_bytes())
        fbi = self.path / f"{self.unit}.fbi"
        if fbi.is_file():
            hpipack.insert(tree, f"units/{self.unit}.fbi", fbi.read_bytes())
        out = Path(out) if out else self.path / f"{self.unit}.ufo"
        out.write_bytes(hpipack.build(tree))
        return out, sorted(hpipack.walk(tree))

    def install(self, gamedir, out=None):
        """Put the build where a game will actually run it: the `.ufo` for anything
        new, and the loose `scripts/<unit>.cob` for the override, because that is
        the copy the engine opens first (§pack). Returns what it wrote."""
        gamedir = Path(gamedir)
        if not gamedir.is_dir():
            raise TacobError(f"{gamedir} is not a directory")
        ufo, entries = self.pack(out)
        written = [gamedir / ufo.name]
        written[0].write_bytes(ufo.read_bytes())
        loose = gamedir / "scripts" / f"{self.unit}.cob"
        loose.parent.mkdir(parents=True, exist_ok=True)
        loose.write_bytes(self.cob.read_bytes())
        written.append(loose)
        return ufo, entries, written


