TRACE_HEADER = ("# tagpu_cobtrace v1\tfilter=%s\tcolumns: S tick unit type script slot source args… | "
                "R tick unit slot script value | X tick unit script source | K tick unit slot script by | "
                "D tick unit slot value")


class TraceLine:
    __slots__ = ("kind", "tick", "unit", "fields", "raw")

    def __init__(self, raw):
        self.raw = raw
        f = raw.split("\t")
        self.kind = f[0]
        self.tick = int(f[1])
        self.unit = int(f[2])
        self.fields = f


def read_cobtrace(path):
    """The oracle's log: the header, then S/R/X/K/D lines in event order."""
    header, lines = None, []
    # the hook writes UTF-8 (its header carries a literal "…"); surrogateescape keeps
    # the round trip byte-exact whatever the log actually holds
    for raw in Path(path).read_text(encoding="utf-8", errors="surrogateescape").splitlines():
        if not raw.strip():
            continue
        if raw.startswith("#"):
            if header is None:
                header = raw
            continue
        lines.append(TraceLine(raw))
    return header, lines


class Event:
    """One engine-issued start, as the replay will re-issue it."""
    __slots__ = ("tick", "script", "args", "kind", "phase")

    def __init__(self, tick, script, args, kind, phase):
        self.tick, self.script, self.args = tick, script, args
        self.kind, self.phase = kind, phase


def events_from_trace(lines):
    """Every `S … E` line becomes a replay event. Its `kind` and `phase` come from
    the call-site table above; an argument-less line took the no-argument entry
    0x4B0940, which writes nothing onto the record at all."""
    out, unknown = [], set()
    for ln in lines:
        if ln.kind != "S" or ln.fields[6] != "E":
            continue
        script = ln.fields[4]
        args = [int(x) for x in ln.fields[7].split(",")] if len(ln.fields) > 7 and ln.fields[7] else []
        kind, phase = ENGINE_STARTS.get(script.lower(), (None, None))
        if kind is None:
            unknown.add(script)
            kind, phase = ("query" if len(args) == 4 else "later"), "pre"
        out.append(Event(ln.tick, script, args, kind, phase))
    return out, sorted(unknown)


def replay(cob, lines, world_values=None, type_name="?", unit=1, until=None, snap=(),
           visible=None):
    """Run the VM through the fixture's engine events and return the lines it writes.

    The replay supplies exactly what the trace cannot: which engine entry issued each
    start (the table above), the `rand` results (the D lines), and the unit-state
    values the scripts read (`get`). Everything else — slots, ticks, the call and
    return structure, the signal kills, the wait releases — is the VM's own answer."""
    events, unknown = events_from_trace(lines)
    if not events:
        raise TacobError("no engine starts in the trace: nothing to replay")
    rands = [int(ln.fields[4]) for ln in lines if ln.kind == "D"]
    # the D line is `lo + r`; the lo is the script's, so the VM asks for r and the
    # world hands back what the engine's RNG gave, in draw order
    out = []
    world = ReplayWorld(world_values, rands)
    vm = CobVM(cob, world, out.append, unit=unit, type_name=type_name, visible=visible)
    by_tick = {}
    for ev in events:
        by_tick.setdefault(ev.tick, []).append(ev)
    create_tick = events[0].tick
    last = until if until is not None else max(ln.tick for ln in lines)
    snap, snaps = set(snap), {}
    for tick in range(create_tick, last + 1):
        vm.tick = world.tick = tick
        here = by_tick.get(tick, ())
        for ev in here:
            if ev.phase == "pre":
                dispatch(vm, ev)
        if tick > create_tick:
            vm.do_scripts_now(1)
        for ev in here:
            if ev.phase == "post":
                dispatch(vm, ev)
        if tick in snap:
            snaps[tick] = ([list(p) for p in vm.pos], [list(a) for a in vm.ang],
                           list(vm.visible))
    vm._flush()
    return vm, out, unknown, snaps


def dispatch(vm, ev):
    if ev.kind == "query":
        vm.query_script(ev.script, ev.args)
    elif ev.kind == "now":
        vm.start_script(ev.script, run_now=True, args=ev.args, argwords=bool(ev.args))
    else:
        cb = AimCallback() if ev.script.lower().startswith("aim") else None
        vm.start_script(ev.script, run_now=False, args=ev.args, argwords=bool(ev.args), cb=cb)


class ReplayWorld(UnitWorld):
    """`get` over a timeline: {value id: [(tick, value), …]}. The cobtrace log carries
    no `get` traffic, so these are the replay's inputs — see the note beside the
    fixture's replay.json for where each timeline came from."""

    def __init__(self, timelines=None, rands=None):
        UnitWorld.__init__(self, rands=rands)
        self.timelines = {int(k): sorted(v) for k, v in (timelines or {}).items()}
        self.tick = 0

    def rand(self, n, lo):
        """What the engine's RNG gave, in draw order — the D lines record `lo + r`."""
        if self.draws < len(self.rands):
            r = self.rands[self.draws] - lo
        else:
            r = 0
        self.draws += 1
        return 0 if n < 2 else r

    def get(self, vid, a, b, c, d):
        tl = self.timelines.get(vid)
        if tl:
            value = tl[0][1]
            for t, v in tl:
                if t <= self.tick:
                    value = v
            return value
        return UnitWorld.get(self, vid, a, b, c, d)


# --------------------------------------------------------------------------- the gate

FIXTURES = Path(__file__).resolve().parent.parent / "research/notes/evidence/cobtrace"
CLASSES = ["kbot", "tank", "building", "death", "fighter", "gunship", "bomber", "ship", "sub"]


def read_posedump(path):
    """The pose oracle's dump: (tick, unit, [(name, hidden, move, turn)])."""
    tick = unit = None
    pieces = []
    for line in Path(path).read_text(encoding="latin-1").splitlines():
        line = line.strip()
        if line.startswith("posedump: tick="):
            for part in line[len("posedump: "):].split():
                k, _, v = part.partition("=")
                if k == "tick": tick = int(v)
                elif k == "idx": unit = int(v)
        m = re.match(r"posedump: p(\d+) (\S+)( HIDDEN)? off=\(([-\d,]+)\) move=\(([-\d,]+)\) "
                     r"turn=\((\d+),(\d+),(\d+)\)", line)
        if m:
            pieces.append((int(m.group(1)), m.group(2), bool(m.group(3)),
                           [int(x) for x in m.group(5).split(",")],
                           [int(m.group(6)), int(m.group(7)), int(m.group(8))]))
    return tick, unit, pieces


def piece_visibility(unit, pieces):
    """The pose the model builder hands the VM: `0x45AF1B` clears the visible bit of
    a piece whose 3DO node carries fewer than three vertices. Measured against all
    eight fixtures with a posedump — every HIDDEN piece is either that or one the
    unit's own `Create` hides."""
    ta3do = load_ta3do()
    assets = ta3do.Assets(None)
    try:
        _label, blob = ta3do.resolve_model(assets, unit)
    except Exception:
        return None
    counts = {p.name.lower(): len(p.vertices) for p, _ in ta3do.parse_3do(blob).walk()}
    return [counts.get(name.lower(), 3) >= 3 for name in pieces]


def replay_inputs(cls):
    """The per-class world timelines, and where each came from (replay.json)."""
    path = FIXTURES / "replay.json"
    if not path.is_file():
        return {}
    return json.loads(path.read_text()).get(cls, {})


def run_class(cls, pose=True):
    """Replay one fixture and diff both oracles. Returns a report dict."""
    folder = FIXTURES / cls
    header, lines = read_cobtrace(folder / "cobtrace.log")
    if not lines:
        raise TacobError(f"{cls}: the fixture's cobtrace.log has no lines")
    type_name = lines[0].fields[3] if lines[0].kind == "S" else "?"
    unit = lines[0].unit
    spec = replay_inputs(cls)
    blob, _ = read_cob_source(type_name.lower())
    cob = read_cob(blob)
    visible = piece_visibility(type_name.lower(), cob.pieces)
    pose_tick, pose_unit, pieces = (None, None, [])
    if pose and (folder / "posedump.txt").is_file():
        pose_tick, pose_unit, pieces = read_posedump(folder / "posedump.txt")
    if pose_unit is not None and pose_unit != unit:
        # the death fixture's dump is of another unit: its Peewee was gone by then
        report_note = f"posedump is unit idx={pose_unit}, the trace is idx={unit} — not compared"
        pieces, pose_tick = [], None
    else:
        report_note = None
    until = max([ln.tick for ln in lines] + ([pose_tick] if pose_tick else []))
    timelines = {int(k): [tuple(p) for p in v] for k, v in (spec.get("get") or {}).items()}
    # the pose is sampled on the render thread, so the dump's tick may name the sim
    # tick before or after the pass that filled it (tagpu_native.c, the posedump header)
    want_ticks = [pose_tick + d for d in (0, -1, 1)] if pose_tick else []
    vm, out, unknown, snaps = replay(cob, lines, timelines, type_name, unit,
                                     until=until, snap=want_ticks, visible=visible)
    out.insert(0, header if header else TRACE_HEADER % (",%s," % type_name))
    report = {"class": cls, "unit": type_name, "lines": len(lines), "unknown_starts": unknown}
    if report_note:
        report["pose_note"] = report_note

    end = max(ln.tick for ln in lines)
    # nothing is masked: `Killed`'s uninitialised second argument (the design note
    # expected to mask it) is one of the E line's own words, so it replays verbatim
    want = [ln.raw for ln in lines]
    got = [l for l in out[1:] if int(l.split("\t")[1]) <= end]
    report["trace_diff"] = first_diff(want, got)
    report["trace_ok"] = report["trace_diff"] is None and len(want) == len(got)
    report["want_lines"], report["got_lines"] = len(want), len(got)
    out = out[:1] + got            # what `--trace-out` writes: the fixture's own span

    if pieces:
        best, best_tick = None, None
        for t in want_ticks:
            if t not in snaps:
                continue
            pos, ang, vis = snaps[t]
            bad = []
            for idx, name, hidden, move, turn in pieces:
                if idx >= len(pos):
                    continue
                if pos[idx] != move or ang[idx] != turn or (not vis[idx]) != hidden:
                    bad.append({"piece": idx, "name": name,
                                "want": {"move": move, "turn": turn, "hidden": hidden},
                                "got": {"move": pos[idx], "turn": ang[idx],
                                        "hidden": not vis[idx]}})
            if best is None or len(bad) < len(best):
                best, best_tick = bad, t
        report["pose_tick"] = pose_tick
        report["pose_matched_tick"] = best_tick
        report["pose_pieces"] = len(pieces)
        report["pose_bad"] = best or []
        report["pose_ok"] = not best
    return report, vm, out


def first_diff(want, got):
    for i in range(max(len(want), len(got))):
        w = want[i] if i < len(want) else "<end>"
        g = got[i] if i < len(got) else "<end>"
        if w != g:
            return {"line": i + 1, "want": w, "got": g}
    return None


# The one engine value the fixtures' scripts branch on that the oracle does not
# carry. `SmokeUnit` (the shipped snippet every stock unit starts) draws
# `rand(1, 66)` only while `get HEALTH` is under 66 and then sleeps
# `healthpercent * 50` ms, so the gap between two of its draws names the health it
# read at the first of them: ticks = trunc(h * 50 * SIM_RATE / 1000). Deriving the
# timeline that way makes those D lines' *ticks* an input rather than a prediction —
# see research/notes/tacob-design.md §"What the replay supplies". Nothing else in
# any of the nine logs depends on it: the first draw's tick is still predicted (health
# starts at 100), and the fighter's draws are `MoveRate2`'s `rand(1, 10)`, not health.

def smoke_slots(lines):
    """{slot: True} for the records a `SmokeUnit` is running, as the log walks by."""
    owner, out = {}, []
    for ln in lines:
        if ln.kind == "S":
            owner[int(ln.fields[5])] = ln.fields[4]
        elif ln.kind in ("R", "K"):
            owner.pop(int(ln.fields[3]), None)
        elif ln.kind == "D":
            out.append((ln.tick, owner.get(int(ln.fields[3]))))
    return [tick for tick, script in out if script == "SmokeUnit"]


def fit_health(lines):
    """[(tick, health)] — 100 until the first SmokeUnit draw, then one value per gap."""
    draws = smoke_slots(lines)
    if not draws:
        return [], []
    timeline, gaps = [(0, 100)], []
    for i, tick in enumerate(draws[:-1]):
        gap = draws[i + 1] - tick
        found = [h for h in range(1, 66) if idiv(max(200, h * 50) * SIM_RATE, 1000) == gap]
        if len(found) != 1:
            gaps.append((tick, gap, found))
            continue
        timeline.append((tick, found[0]))
    if len(timeline) > 1:                       # the last draw has no gap to name it
        timeline.append((draws[-1], timeline[-1][1]))
    return timeline, gaps


def cmd_fit(args):
    """Write the world timelines the replay needs, derived from the fixtures."""
    path = FIXTURES / "replay.json"
    data = json.loads(path.read_text()) if path.is_file() else {}
    for cls in (CLASSES if args.all else args.classes):
        _header, lines = read_cobtrace(FIXTURES / cls / "cobtrace.log")
        timeline, gaps = fit_health(lines)
        entry = {"note": "get timelines the cobtrace log cannot carry; HEALTH is derived "
                         "from SmokeUnit's rand spacing (tacob fit-world)"}
        if timeline:
            entry["get"] = {str(VALUE_IDS["HEALTH"]): [list(x) for x in timeline]}
            data[cls] = entry
        else:
            data.pop(cls, None)
        print(f"{cls}: {len(timeline)} HEALTH samples"
              + (f", {len(gaps)} gaps with no single health: {gaps}" if gaps else ""))
    path.write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")
    print(f"wrote {path}")


def cmd_run(args):
    classes = CLASSES if args.all else (args.classes or [])
    if not classes:
        raise TacobError("nothing to run: give a class name or --all")
    reports = []
    failed = False
    for cls in classes:
        report, vm, out = run_class(cls, pose=not args.no_pose)
        reports.append(report)
        if args.trace_out:
            Path(args.trace_out).write_text("\n".join(out) + "\n",
                                            encoding="utf-8", errors="surrogateescape")
        elif args.print_trace:
            sys.stdout.write("\n".join(out) + "\n")
        ok = report["trace_ok"] and report.get("pose_ok", True)
        failed = failed or not ok
        if not args.json:
            d = report["trace_diff"]
            print(f"{'ok  ' if ok else 'FAIL'} {cls:<9} {report['unit']:<9} "
                  f"trace {report['got_lines']}/{report['want_lines']}"
                  + (f"  pose {report['pose_pieces'] - len(report['pose_bad'])}/{report['pose_pieces']}"
                     if "pose_pieces" in report else ""))
            if d:
                print(f"       line {d['line']}\n         want {d['want']}\n         got  {d['got']}")
            for bad in report.get("pose_bad", [])[:4]:
                print(f"       p{bad['piece']} {bad['name']}: want {bad['want']} got {bad['got']}")
            if report["unknown_starts"]:
                print(f"       engine starts not in the call-site table: "
                      f"{', '.join(report['unknown_starts'])}")
    if args.json:
        print(json.dumps(reports, indent=1))
    if failed:
        raise SystemExit(1)


# --------------------------------------------------------------------------- game assets

def load_ta3do():
    from importlib.machinery import SourceFileLoader
    import importlib.util
    loader = SourceFileLoader("ta3do", str(HERE / "ta3do"))
    spec = importlib.util.spec_from_loader("ta3do", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def read_cob_source(spec: str, gamedir=None):
    """A .cob path, or a stock unit name read out of the game's archives."""
    path = Path(spec)
    if path.is_file():
        return path.read_bytes(), path.stem
    ta3do = load_ta3do()
    assets = ta3do.Assets(gamedir)
    name = f"scripts/{path.stem.lower()}.cob"
    if not assets.has(name):
        raise TacobError(f"{spec}: not a file, and no {name} in the game's archives")
    return assets.read(name), path.stem.lower()


