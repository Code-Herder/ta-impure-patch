# windows
# --------------------------------------------------------------------------

class Window:
    """One window on the stage: a cell, a schedule, and up to two sources.

    A hero window starts as a terminal, the command types itself, and at
    `t_game` it cross-fades into the game source over `flip`. A filler window
    has no terminal at all and is simply always running.
    """

    def __init__(self, spec: dict, term: Terminal | None, game, stage,
                 style=None, desktop=(16, 18, 22),
                 term_title="bash", game_title=""):
        self.style = style or TERMINAL_STYLES["classic"]
        self.desktop = tuple(desktop)
        self.term_title = term_title
        self.game_title = game_title
        self.col = spec["col"]
        self.row = spec["row"]
        self.t_open = spec.get("t_open", 0.0)
        self.t_game = spec.get("t_game")
        self.flip = spec.get("flip", 0.45)
        self.fade = spec.get("fade", 0.3)
        self.phase = spec.get("phase", 0.0)
        self.term = term
        self.game = game
        self.stage = stage

    def rect(self) -> tuple[float, float, float, float]:
        s = self.stage
        return (self.col * s.pitch_x, self.row * s.pitch_y, s.tile_w, s.tile_h)

    def alpha(self, t: float) -> float:
        if t < self.t_open:
            return 0.0
        if self.fade <= 0:
            return 1.0
        return min(1.0, (t - self.t_open) / self.fade)

    def content(self, t: float, w: int, h: int,
                disp_w: int | None = None) -> Image.Image | None:
        """The whole window at time t — chrome plus client — or None if unopened.

        The chrome is drawn ONCE, here, and the source fills the client area.
        That is what keeps the game inside the same window the command was typed
        in: the terminal does not become a bare rectangle, it keeps its frame,
        its title bar and its buttons, and so does every tile on the desktop.
        """
        if t < self.t_open:
            return None
        lod = float(disp_w if disp_w is not None else w)
        img = Image.new("RGB", (w, h), self.desktop)
        cx0, cy0, cx1, cy1 = draw_window_chrome(img, self.style, self.title_at(t), lod)
        cw, ch = max(1, cx1 - cx0), max(1, cy1 - cy0)
        lod_c = max(1.0, lod * cw / max(1, w))

        gt = t + self.phase
        if self.term is None:
            inner = self.game.frame(gt, cw, ch, lod_c)
        elif self.t_game is None or t < self.t_game:
            inner = self.term.frame(t, cw, ch, lod_c)
        else:
            u = (t - self.t_game) / self.flip if self.flip > 0 else 1.0
            if u >= 1.0:
                inner = self.game.frame(gt, cw, ch, lod_c)
            else:
                inner = Image.blend(self.term.frame(t, cw, ch, lod_c),
                                    self.game.frame(gt, cw, ch, lod_c),
                                    ease("smooth", u))
        img.paste(inner, (cx0, cy0))
        return img

    def title_at(self, t: float) -> str:
        """Title bar text: the shell while typing, the game once it is running."""
        if self.term is not None and (self.t_game is None or t < self.t_game):
            return self.term_title
        return self.game_title


class Stage:
    def __init__(self, spec: dict):
        self.tile_w = spec["tile"]["w"]
        self.tile_h = spec["tile"]["h"]
        self.gap_x = spec.get("gap", {}).get("x", 0)
        self.gap_y = spec.get("gap", {}).get("y", 0)
        self.pitch_x = self.tile_w + self.gap_x
        self.pitch_y = self.tile_h + self.gap_y
        self.bg = tuple(spec.get("bg", [16, 18, 22]))


# --------------------------------------------------------------------------
# the montage
# --------------------------------------------------------------------------

class Montage:
    def __init__(self, path: Path, backend: str, clips_dir: Path | None,
                 cache: Path, fps: float, aspect: float = 1080 / 1920):
        self.spec = json.loads(path.read_text())
        self.name = self.spec.get("name", path.stem)
        self.stage = Stage(self.spec["stage"])
        self.camera = Camera(self.spec["camera"])
        self.captions = self.spec.get("captions", [])
        self.duration = self.spec["duration"]
        self.backend = backend
        self.clips_dir = clips_dir
        self.cache = cache
        self.fps = fps
        self.aspect = aspect
        self._games: dict[str, object] = {}
        self.windows: list[Window] = []
        self._build()

    # -- reveal timing -----------------------------------------------------

    def _first_visible(self, cells: list[tuple[int, int]], dt: float = 0.1):
        """For each cell, the first time the camera's viewport touches it.

        Computed from the camera rather than hand-authored, so retiming the
        pull-back retimes the reveal with it. That is the whole reason the grid
        can be re-cut without anyone editing 1600 open times.
        """
        s = self.stage
        ts = np.arange(0.0, self.duration + dt, dt)
        cam = np.array([self.camera.at(float(t)) for t in ts])
        cx, cy, cols = cam[:, 0], cam[:, 1], cam[:, 2]
        halfw = cols * s.pitch_x / 2.0
        halfh = halfw * self.aspect
        left, right = cx - halfw, cx + halfw
        top, bottom = cy - halfh, cy + halfh

        c = np.array(cells, dtype=float)
        x0 = c[:, 0] * s.pitch_x
        y0 = c[:, 1] * s.pitch_y
        x1, y1 = x0 + s.tile_w, y0 + s.tile_h

        vis = ((x1[:, None] > left[None, :]) & (x0[:, None] < right[None, :]) &
               (y1[:, None] > top[None, :]) & (y0[:, None] < bottom[None, :]))
        any_vis = vis.any(axis=1)
        idx = vis.argmax(axis=1)
        out = np.where(any_vis, ts[idx], self.duration + 1.0)
        return out

    # -- sources -----------------------------------------------------------

    def _game(self, clip_id: str, variant: int, label: str):
        # `variant` only recolours a white box, so it must NOT split a real clip
        # into separate objects: keying on it gave 24 Clip instances for 6 files,
        # each decoding and holding its own copy of every frame.
        key = f"{clip_id}#{variant}" if self.backend == "wire" else clip_id
        got = self._games.get(key)
        if got is not None:
            return got
        if self.backend == "clip":
            if self.clips_dir is None:
                raise SystemExit("--backend clip needs --clips <dir>")
            hit = None
            for ext in (".mp4", ".mkv", ".webm", ".mov"):
                cand = self.clips_dir / f"{clip_id}{ext}"
                if cand.exists():
                    hit = cand
                    break
            if hit is None:
                raise SystemExit(f"no clip file for id {clip_id!r} in {self.clips_dir}")
            got = Clip(clip_id, hit, self.cache, self.fps)
        else:
            got = WireGame(variant, label)
        self._games[key] = got
        return got

    # -- window construction ----------------------------------------------

    def _build(self) -> None:
        style = TERMINAL_STYLES.get(self.spec.get("terminal_style", "classic"),
                                    TERMINAL_STYLES["classic"])
        taken = set()
        for i, spec in enumerate(self.spec.get("windows", [])):
            taken.add((spec["col"], spec["row"]))
            term = None
            if "command" in spec:
                term = Terminal(spec.get("prompt", "$"), spec["command"],
                                spec.get("output", []),
                                spec.get("t_type", spec.get("t_open", 0.0) + 0.4),
                                spec.get("type_rate", 17.0),
                                spec.get("t_enter", 1e9),
                                spec.get("scrollback", []),
                                spec.get("style", self.spec.get("terminal_style",
                                                                "classic")),
                                self.stage.bg,
                                spec.get("title", "bash"),
                                spec.get("t_game"))
            game = self._game(spec.get("clip", f"hero{i}"), spec.get("variant", i),
                              spec.get("label", ""))
            inst = re.search(r"load\s+(\S+)", spec.get("command", ""))
            self.windows.append(Window(
                spec, term, game, self.stage, style, self.stage.bg,
                spec.get("title", "bash"),
                spec.get("game_title",
                         f"Total Annihilation — tacli:{inst.group(1)}"
                         if inst else spec.get("label", ""))))

        fill = self.spec.get("fill")
        if not fill:
            return
        c0, c1 = fill["cols"]
        r0, r1 = fill["rows"]
        ids = fill.get("clips", ["fill"])
        labels = fill.get("labels", [""])
        rng = random.Random(fill.get("seed", 20260910))

        cells = [(col, row)
                 for col in range(c0, c1 + 1)
                 for row in range(r0, r1 + 1)
                 if (col, row) not in taken]

        # When the filler desktop is allowed to exist. Everything before
        # `not_before` is the scripted part of the film — one terminal, then
        # four — and a stray neighbour showing at the frame edge ruins it.
        rev = fill.get("reveal", {})
        not_before = rev.get("not_before", 0.0)
        lead = rev.get("lead", 0.6)
        wave = rev.get("wave", 0.9)
        fade = rev.get("fade", 0.25)

        auto = self._first_visible(cells)
        for (col, row), a in zip(cells, auto):
            k = rng.randrange(len(ids) * VARIANTS_PER_CLIP)
            game = self._game(ids[k % len(ids)], k, labels[k % len(labels)])
            # Already there before the camera reaches it (so nothing pops in
            # frame), except the first ring, which is deliberately spread over
            # `wave` seconds at `not_before` — the desktop filling up is the shot.
            t_open = max(not_before + rng.random() * wave, float(a) - lead)
            self.windows.append(Window(
                {"col": col, "row": row, "t_open": t_open, "fade": fade,
                 "phase": rng.randrange(PHASES) * (9.0 / PHASES)},
                None, game, self.stage, style, self.stage.bg,
                "bash", f"Total Annihilation — {labels[k % len(labels)]}"))

    # -- rendering ---------------------------------------------------------

    def render_frame(self, t: float, w: int, h: int) -> Image.Image:
        s = self.stage
        cx, cy, cols = self.camera.at(t)
        scale = w / (cols * s.pitch_x)
        img = Image.new("RGB", (w, h), s.bg)

        # A cache of rendered content, keyed by the source and the exact pixel
        # size asked for. Within one frame every tile at a given zoom is the
        # same size, so the grid costs a handful of renders, not one per tile.
        cache: dict = {}
        # Scaled tiles, keyed by output size and sub-pixel offset quantised to a
        # quarter pixel. Without this the sub-pixel path costs 1600 resizes per
        # wide-shot frame instead of a few dozen; a quarter pixel is far below
        # anything visible, so the sharing is free.
        tcache: dict = {}

        for win in self.windows:
            sx, sy, sw, sh = win.rect()
            px = (sx - cx) * scale + w / 2.0
            py = (sy - cy) * scale + h / 2.0
            pw = sw * scale
            ph = sh * scale
            if px + pw < 0 or py + ph < 0 or px > w or py > h:
                continue
            iw, ih = max(1, round(pw)), max(1, round(ph))
            a = win.alpha(t)
            if a <= 0.0:
                continue

            if iw <= 3 or ih <= 3:
                col = win.game.avg_color()
                img.paste(col, (int(px), int(py), int(px) + iw, int(py) + ih))
                continue

            # The destination span, fully-covered pixels only. Taking ceil/floor
            # here (rather than rounding the origin and the size independently)
            # is what lets the source be sampled at the exact sub-pixel offset
            # below, so the CONTENT stops sliding around inside the tile.
            X0, Y0 = math.ceil(px), math.ceil(py)
            X1, Y1 = math.floor(px + pw), math.floor(py + ph)
            if X1 - X0 < 1 or Y1 - Y0 < 1:
                continue

            cw, ch = canonical_size(iw, ih, getattr(win.game, "native_w", None))
            # Level of detail is a question about APPARENT size, so normalise the
            # tile width to a 1920-wide frame before deciding. In absolute pixels
            # a 4K wide shot (88 px tiles) crosses a threshold that the identical
            # 1080p shot (44 px) does not, re-enabling every 1 px border and grid
            # line the threshold exists to remove — and those hairlines are the
            # shimmer.
            lod_w = max(1, int(iw * 1920 / w))
            gt = round((t + win.phase) * 1000) / 1000.0
            key = (id(win.game), gt if win.term else round(gt * self.fps) / self.fps,
                   cw, ch, lod_w)
            src = cache.get(key) if win.term is None else None
            if src is None:
                src = win.content(t, cw, ch, lod_w)
                if src is None:
                    continue
                if win.term is None:
                    cache[key] = src

            # Map the destination span back into source coordinates and let
            # resize() do the sub-pixel sampling. Because the canonical size is
            # ~2x the destination, this reduction is small and also anti-aliases.
            sw, sh = src.size
            sx0 = max(0.0, min((X0 - px) / pw * sw, sw))
            sx1 = max(sx0, min((X1 - px) / pw * sw, sw))
            sy0 = max(0.0, min((Y0 - py) / ph * sh, sh))
            sy1 = max(sy0, min((Y1 - py) / ph * sh, sh))
            tkey = (key, X1 - X0, Y1 - Y0, round(sx0 * 4), round(sy0 * 4))
            tile = tcache.get(tkey)
            if tile is None:
                tile = src.resize((X1 - X0, Y1 - Y0), RESAMPLE,
                                  box=(sx0, sy0, sx1, sy1))
                tcache[tkey] = tile

            if a >= 1.0:
                img.paste(tile, (X0, Y0))
            else:
                under = img.crop((X0, Y0, X1, Y1))
                img.paste(Image.blend(under, tile, a), (X0, Y0))

        return self._draw_captions(img, t)

    def _draw_captions(self, img: Image.Image, t: float) -> Image.Image:
        """Draw every live caption onto one RGBA layer, composited once."""
        w, h = img.size
        layer = None
        dirty = (w, h, 0, 0)          # accumulated bounds of what captions touch
        for cap in self.captions:
            t0, t1 = cap["t0"], cap["t1"]
            if not (t0 <= t <= t1):
                continue
            # `fade` sets both edges; fade_in / fade_out override one. A card
            # that has to survive being PAUSED ON needs fade_out 0: the last
            # frame of the film is t1 - 1/fps, so any fade-out at all leaves it
            # part-way through the dissolve. The title card shipped once at
            # alpha 0.02 on the final frame -- present in the file, invisible in
            # the thumbnail and on every paused player.
            fade = cap.get("fade", 0.4)
            f_in = float(cap.get("fade_in", fade))
            f_out = float(cap.get("fade_out", fade))
            a = 1.0
            if f_in > 0 and t < t0 + f_in:
                a = (t - t0) / f_in
            elif f_out > 0 and t > t1 - f_out:
                a = (t1 - t) / f_out
            a = ease("smooth", min(1.0, max(0.0, a)))
            if a <= 0.01:
                continue

            # a full-frame card is centred and typeset large, like `big`
            big = cap.get("big", False) or cap.get("full", False)
            fs = int(h * (0.080 if big else 0.047))
            ss = int(h * (0.030 if big else 0.025))

            if layer is None:
                layer = Image.new("RGBA", img.size, (0, 0, 0, 0))
            d = ImageDraw.Draw(layer)

            # Captions WRAP, and shrink if wrapping is not enough. A long line
            # typeset at card size overruns the frame otherwise — "A test harness
            # that happens to look like a war." at `full` size is wider than
            # 1920 px, and simply ran off both edges.
            maxw = w * cap.get("width", 0.84)
            f1, head = _fit_text(d, cap["text"], "sans-bold", fs, maxw,
                                 cap.get("max_lines", 3))
            body = [(l, f1, (243, 246, 250)) for l in head]
            if cap.get("sub"):
                f2, subl = _fit_text(d, cap["sub"], "mono", ss, maxw, 2)
                body += [(l, f2, (120, 205, 255)) for l in subl]

            lh1 = int(f1.size * 1.22)
            gap = int(f1.size * 0.42)
            total = lh1 * len(head)
            if cap.get("sub"):
                total += gap + int(f2.size * 1.35) * (len(body) - len(head))
            cy = h * (0.5 if big else 0.845)
            y = cy - total / 2

            wmax = max(text_w(d, l, f) for l, f, _ in body)
            padx, pady = int(h * 0.035), int(h * 0.026)
            box = [w / 2 - wmax / 2 - padx, y - pady,
                   w / 2 + wmax / 2 + padx, y + total + pady]

            if cap.get("full"):
                # Full-frame card: the whole picture darkens and the words sit
                # on it. Reads as a title card rather than as a subtitle.
                d.rectangle([0, 0, w, h],
                            fill=(6, 8, 11, int(cap.get("dim", 205) * a)))
                dirty = (0, 0, w, h)
            else:
                # A soft scrim rather than a hard black plate: the grid stays
                # readable behind the words, which is the point of the wide shot.
                scrim = int(215 * a) if big else int(190 * a)
                d.rounded_rectangle(box, radius=int(h * 0.012),
                                    fill=(9, 11, 14, scrim))
                dirty = (min(dirty[0], box[0]), min(dirty[1], box[1]),
                         max(dirty[2], box[2]), max(dirty[3], box[3]))
            ly = y
            for i, (line, f, col) in enumerate(body):
                if i == len(head) and len(body) > len(head):
                    ly += gap          # breathing room before the sub-line(s)
                d.text((w / 2, ly), line, font=f,
                       fill=col + (int((255 if i < len(head) else 245) * a),),
                       anchor="ma")
                ly += int(f.size * (1.22 if i < len(head) else 1.35))

        if layer is None:
            return img
        # Composite only the region the captions actually touch. A lower-third
        # card covers ~12 % of the frame, but converting the whole thing to RGBA
        # and back cost ~93 ms per 4K frame whatever its size. A full-frame card
        # dirties everything, and then this is the same work as before.
        bx0, by0, bx1, by1 = dirty
        bx0 = max(0, int(bx0)); by0 = max(0, int(by0))
        bx1 = min(w, int(bx1) + 1); by1 = min(h, int(by1) + 1)
        if bx1 <= bx0 or by1 <= by0:
            return img
        region = (bx0, by0, bx1, by1)
        merged = Image.alpha_composite(img.crop(region).convert("RGBA"),
                                       layer.crop(region))
        img.paste(merged.convert("RGB"), (bx0, by0))
        return img

    # -- introspection -----------------------------------------------------

    def beat_sheet(self) -> str:
        out = [f"{self.name}: {self.duration:.1f}s, "
               f"{len(self.windows)} windows ({self.backend} backend)"]
        out.append("")
        out.append("camera")
        for k in self.camera.keys:
            out.append(f"  t={k['t']:6.2f}  cols={k['cols']:6.2f}  "
                       f"centre=({k['cx']:.0f},{k['cy']:.0f})  {k.get('ease', 'smooth')}")
        out.append("")
        out.append("hero windows")
        for spec in self.spec.get("windows", []):
            if "command" not in spec:
                continue
            out.append(f"  ({spec['col']},{spec['row']}) open={spec.get('t_open', 0):.1f} "
                       f"type={spec.get('t_type', 0):.1f} enter={spec.get('t_enter', 0):.1f} "
                       f"game={spec.get('t_game', 0):.1f}")
            out.append(f"      $ {spec['command']}")
        out.append("")
        out.append("captions")
        for c in self.captions:
            out.append(f"  {c['t0']:6.2f}-{c['t1']:6.2f}  {c['text']}")
            if c.get("sub"):
                out.append(f"                  {c['sub']}")
        return "\n".join(out)


