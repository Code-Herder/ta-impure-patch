# --------------------------------------------------------------------------
# fonts
# --------------------------------------------------------------------------

_FONT_CACHE: dict[tuple[str, int], ImageFont.FreeTypeFont] = {}


def _fc_match(pattern: str) -> str | None:
    """Resolve a fontconfig pattern to a file, or None."""
    if not shutil.which("fc-match"):
        return None
    try:
        out = subprocess.run(["fc-match", "-f", "%{file}", pattern],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    path = out.stdout.strip()
    return path if path and Path(path).exists() else None


def _font_file(kind: str) -> str | None:
    """A font file for 'mono', 'sans' or 'sans-bold'.

    Resolved through fontconfig so the montage renders on whatever the machine
    has; no font path is baked in.
    """
    patterns = {
        "mono": ["JetBrains Mono", "DejaVu Sans Mono", "Liberation Mono", "monospace"],
        "mono-bold": ["JetBrains Mono:style=Bold", "DejaVu Sans Mono:style=Bold",
                      "monospace:style=Bold"],
        "sans": ["Inter", "DejaVu Sans", "Liberation Sans", "sans-serif"],
        "sans-bold": ["Inter:style=Bold", "DejaVu Sans:style=Bold",
                      "Liberation Sans:style=Bold", "sans-serif:style=Bold"],
    }[kind]
    for pat in patterns:
        hit = _fc_match(pat)
        if hit:
            return hit
    return None


def font(kind: str, size: int) -> ImageFont.FreeTypeFont:
    size = max(1, int(size))
    key = (kind, size)
    got = _FONT_CACHE.get(key)
    if got is None:
        path = _font_file(kind)
        try:
            got = ImageFont.truetype(path, size) if path else ImageFont.load_default()
        except OSError:
            got = ImageFont.load_default()
        _FONT_CACHE[key] = got
    return got


def text_w(draw: ImageDraw.ImageDraw, s: str, f) -> int:
    return int(draw.textlength(s, font=f))


def _wrap(draw, text: str, f, maxw: float) -> list[str]:
    """Greedy word wrap. Explicit newlines in the text are honoured."""
    out = []
    for para in text.split("\n"):
        cur = ""
        for word in para.split():
            trial = f"{cur} {word}".strip()
            if cur and text_w(draw, trial, f) > maxw:
                out.append(cur)
                cur = word
            else:
                cur = trial
        out.append(cur)
    return out or [""]


def _fit_text(draw, text: str, kind: str, size: int, maxw: float,
              max_lines: int):
    """Wrap `text` to `maxw`, shrinking the font until it fits in `max_lines`.

    Returns (font, lines). Wrapping alone is not enough: one unbreakable long
    word, or a narrow output, still overflows, so the size steps down until the
    widest line fits.
    """
    while size > 8:
        f = font(kind, size)
        lines = _wrap(draw, text, f, maxw)
        if len(lines) <= max_lines and max(text_w(draw, l, f) for l in lines) <= maxw:
            return f, lines
        size = int(size * 0.92)
    f = font(kind, max(8, size))
    return f, _wrap(draw, text, f, maxw)


# --------------------------------------------------------------------------
# easing and interpolation
# --------------------------------------------------------------------------

def ease(name: str, u: float) -> float:
    u = min(1.0, max(0.0, u))
    if name == "linear":
        return u
    if name == "in":                      # slow start
        return u * u
    if name == "out":                     # slow stop
        return 1.0 - (1.0 - u) ** 2
    return u * u * (3.0 - 2.0 * u)        # "smooth" (smoothstep), the default


class Camera:
    """Keyframed (cx, cy, cols) over time.

    cx/cy are stage units and interpolate linearly under the keyframe's easing.
    cols interpolates in LOG space: a pull-back from 2 to 40 columns then covers
    equal *ratios* in equal times, which is what reads as a steady zoom. Linear
    interpolation of the same numbers spends most of its time near 40 and looks
    like it is braking.
    """

    def __init__(self, keys: list[dict]):
        if not keys:
            raise ValueError("camera needs at least one keyframe")
        self.keys = sorted(keys, key=lambda k: k["t"])
        self.ts = [k["t"] for k in self.keys]

    def at(self, t: float) -> tuple[float, float, float]:
        ks = self.keys
        if t <= self.ts[0]:
            k = ks[0]
            return k["cx"], k["cy"], k["cols"]
        if t >= self.ts[-1]:
            k = ks[-1]
            return k["cx"], k["cy"], k["cols"]
        i = bisect_right(self.ts, t) - 1
        a, b = ks[i], ks[i + 1]
        span = b["t"] - a["t"]
        u = 0.0 if span <= 0 else (t - a["t"]) / span
        e = ease(b.get("ease", "smooth"), u)
        cx = a["cx"] + (b["cx"] - a["cx"]) * e
        cy = a["cy"] + (b["cy"] - a["cy"]) * e
        cols = math.exp(math.log(a["cols"]) + (math.log(b["cols"]) - math.log(a["cols"])) * e)
        return cx, cy, cols


# --------------------------------------------------------------------------
# sources — what fills a window rect
# --------------------------------------------------------------------------

# Sources are drawn at a CANONICAL size off a power-of-two ladder and then scaled
# to the destination, rather than drawn directly at the destination size.
#
# Drawing at the destination size is what made the picture shimmer: the camera moves
# continuously, so a tile's pixel width creeps past a whole number every few frames,
# and every feature inside it is positioned as int(w * k) — so a one-pixel change in
# w moves the grid lines, the HUD, the text and the unit dots by differing amounts.
# Measured before this change: 32.5 % of the wide-shot frame differed from the frame
# before it, on content that is barely moving.
#
# The ladder targets ~2x the displayed size, so the scale-down also anti-aliases:
# a 1 px border drawn at 128 and shown at 45 becomes a clean third-of-a-pixel line
# instead of a hard one that pops in and out.
LADDER = (32, 48, 64, 80, 96, 128, 160, 192, 256, 320, 384, 512, 640, 768,
          1024, 1280, 1536, 2048, 2560, 3072, 4096)
# Measured 2026-09-10 on the wide shot, as mean temporal second difference
# (|2f(n) - f(n-1) - f(n+1)|, which cancels smooth motion and catches popping):
#
#   drawn at destination size (the old way) .......... 108.7   39 ms/frame
#   supersample 2x, bilinear .......................... 43.2  434 ms
#   supersample 3x, bilinear .......................... 30.7  628 ms   <- default
#   supersample 3x, lanczos ........................... 36.3  931 ms
#
# LANCZOS is WORSE than BILINEAR here and costs more: its ringing on the hard
# edges of a window border is itself a temporal artifact. Do not "upgrade" it.
# 4x is identical to 3x because the ladder quantises both to the same canonical
# size, so 3x is the knee. --supersample 1 disables all of this for fast drafts.
SUPERSAMPLE = 3
RESAMPLE = Image.BILINEAR

# How much variety the filler wall carries, and therefore how much the per-frame
# source cache can share. distinct sources = len(clips) * VARIANTS_PER_CLIP, and
# each appears at PHASES different points in its animation. Keep the product well
# BELOW the number of tiles on screen (~1400 at the widest) or the cache cannot
# share and every tile pays for its own draw and its own resize.
VARIANTS_PER_CLIP = 4
PHASES = 4

# Decoded full-size clip frames held in RAM. This must comfortably exceed the
# number of distinct (clip, phase) combinations on screen, or it thrashes: at 8
# it re-decoded a PNG from disk for nearly every tile and the clip backend was
# SLOWER than the procedural one (1178 ms vs 621 ms per 4K frame). Costs about
# 2.3 MB per entry at 1024x768.
FULL_LRU = 192


def canonical_size(want_w: int, want_h: int) -> tuple[int, int]:
    target = min(max(want_w * SUPERSAMPLE, LADDER[0]), LADDER[-1])
    cw = next((s for s in LADDER if s >= target), LADDER[-1])
    return cw, max(1, round(cw * want_h / max(1, want_w)))


PALETTES = [
    # (terrain, terrain_dark, team_a, team_b)
    ((58, 62, 48), (44, 47, 36), (120, 190, 255), (255, 122, 88)),
    ((52, 58, 64), (38, 43, 48), (140, 255, 180), (255, 96, 140)),
    ((66, 58, 44), (49, 43, 33), (255, 214, 120), (110, 170, 255)),
    ((44, 56, 60), (32, 42, 45), (170, 140, 255), (255, 170, 90)),
]


def _lerp(a, b, u):
    return tuple(int(a[i] + (b[i] - a[i]) * u) for i in range(3))


def detail_ramp(lod_w: float, lo: float = 32.0, hi: float = 105.0) -> float:
    """How visible fine detail should be at this apparent tile width, 0..1.

    A hard threshold makes hairlines VANISH mid-shot: the borders were on at
    t=46 and gone at t=47 as lod_w crossed 70, which reads as a glitch. Fading
    them over a range removes both the pop and the shimmer on the way down.
    """
    u = max(0.0, min(1.0, (lod_w - lo) / (hi - lo)))
    return u * u * (3.0 - 2.0 * u)


def draw_window_chrome(img, st, title: str, lod_w: float):
    """Draw the window frame into `img`; return its client rect.

    Every window on the desktop wears this, the game included — the terminal
    does not turn into a bare rectangle, it keeps its window. Solid fills (the
    body, the title bar) are drawn at any size because a solid area cannot
    shimmer; HAIRLINES (the border, the buttons, the title) fade out with
    `detail_ramp` instead of switching off.
    """
    w, h = img.size
    d = ImageDraw.Draw(img)
    dv = detail_ramp(lod_w)
    rad = int(min(w, h) * st["radius"])
    bw = max(1, int(w * st["border_w"]))
    body = st["bg"]

    if rad:
        d.rounded_rectangle([0, 0, w - 1, h - 1], radius=rad, fill=body)
    else:
        d.rectangle([0, 0, w, h], fill=body)

    bar = 0
    if st["header"]:
        bar = max(1, int(h * 0.055))
        hb = st["header_bg"]
        if rad:
            d.rounded_rectangle([bw, bw, w - 1 - bw, bar], radius=rad, fill=hb)
            d.rectangle([bw, max(bw, bar - rad), w - 1 - bw, bar], fill=hb)
        else:
            d.rectangle([bw, bw, w - 1 - bw, bar], fill=hb)

        if dv > 0.03 and bar >= 6:
            if st["header"] == "dots":
                r = bar * 0.22
                for i, col in enumerate([(255, 95, 86), (255, 189, 46), (39, 201, 63)]):
                    cx = bar * (0.75 + i * 0.85)
                    d.ellipse([cx - r, bar / 2 - r, cx + r, bar / 2 + r],
                              fill=_lerp(hb, col, dv))
            elif st["header"] == "buttons":
                col = _lerp(hb, st["header_fg"], dv)
                lw = max(1, int(bar * 0.055))
                g = bar * 0.26
                cell = bar * 1.7
                right = w - bw - cell * 0.55
                cy = bar / 2
                for n in range(3):
                    cx = right - cell * (2 - n)
                    if n == 0:
                        d.line([(cx - g, cy), (cx + g, cy)], fill=col, width=lw)
                    elif n == 1:
                        d.rectangle([cx - g, cy - g, cx + g, cy + g], outline=col, width=lw)
                    else:
                        d.line([(cx - g, cy - g), (cx + g, cy + g)], fill=col, width=lw)
                        d.line([(cx - g, cy + g), (cx + g, cy - g)], fill=col, width=lw)
        if title and lod_w >= 150 and w >= 200:
            ft = font("mono", max(8, int(bar * 0.5)))
            d.text((w / 2, bar / 2), title, font=ft,
                   fill=_lerp(hb, st["header_fg"], dv), anchor="mm")

    if dv > 0.02:
        bc = _lerp(body, st["border"], dv)
        if rad:
            d.rounded_rectangle([0, 0, w - 1, h - 1], radius=rad, outline=bc, width=bw)
        else:
            d.rectangle([0, 0, w - 1, h - 1], outline=bc, width=bw)

    return (bw, (bar + 1) if bar else bw, w - bw, h - bw)


class WireGame:
    """A white-box stand-in for a running game window.

    Deliberately schematic: outlines, a HUD frame and moving unit dots. It is a
    wireframe, not a mock of the real renderer — nobody should be able to mistake
    a prototype render for footage.
    """

    def __init__(self, variant: int, label: str = ""):
        self.variant = variant
        self.label = label
        self.pal = PALETTES[variant % len(PALETTES)]
        rng = random.Random(variant * 7919 + 13)
        self.units = [(rng.random(), rng.random(), rng.random() * math.tau,
                       0.012 + rng.random() * 0.03, rng.random() < 0.5)
                      for _ in range(26)]

    def avg_color(self) -> tuple[int, int, int]:
        return self.pal[0]

    def frame(self, t: float, w: int, h: int, disp_w: int | None = None) -> Image.Image:
        """The window's CLIENT area only — the frame is drawn by the Window."""
        terrain, dark, team_a, team_b = self.pal
        img = Image.new("RGB", (w, h), terrain)
        d = ImageDraw.Draw(img)
        if w < 8 or h < 6:
            return img

        lod = disp_w if disp_w is not None else w
        dv = detail_ramp(lod)                 # hairlines fade, they never snap off

        for i in range(4 if dv > 0.5 else 2):
            bx = (0.17 + 0.23 * i + 0.05 * math.sin(t * 0.2 + i)) * w
            by = (0.25 + 0.19 * ((i * 5) % 3)) * h
            r = 0.11 * w
            d.ellipse([bx - r, by - r * 0.7, bx + r, by + r * 0.7], fill=dark)

        if dv > 0.03:
            # ImageDraw DISCARDS alpha on an RGB image, so blend by hand — a
            # fill of (255,255,255,8) paints SOLID WHITE, not 3% white.
            grid = _lerp(terrain, (255, 255, 255), 0.12 * dv)
            step = max(6, int(w / 12))
            for x in range(0, w, step):
                d.line([(x, 0), (x, h)], fill=grid, width=1)
            for y in range(0, h, step):
                d.line([(0, y), (w, y)], fill=grid, width=1)

        rad = max(1, round(w * 0.009))
        for (ux, uy, phase, speed, side) in self.units:
            ang = phase + t * speed * math.tau
            x = (ux + 0.10 * math.cos(ang)) * w
            y = (uy + 0.10 * math.sin(ang * 1.3)) * h
            d.ellipse([x - rad, y - rad, x + rad, y + rad],
                      fill=team_a if side else team_b)

        # TA's side panel and bottom strip: SOLID fills, so they are safe at any
        # size — a solid area cannot shimmer, only hairlines can.
        panel = max(1, int(w * 0.135))
        d.rectangle([0, 0, panel, h], fill=(24, 26, 30))
        d.rectangle([0, h - max(1, int(h * 0.09)), w, h], fill=(24, 26, 30))
        if dv > 0.05:
            d.line([(panel, 0), (panel, h)],
                   fill=_lerp((24, 26, 30), (210, 214, 220), dv * 0.7),
                   width=max(1, int(w * 0.006)))
        return img


