class Terminal:
    """A terminal window typing one command, then printing a few lines.

    The look comes from TERMINAL_STYLES; `style` on the window spec picks one.
    """

    def __init__(self, prompt: str, command: str, output: list[str],
                 t_type: float, type_rate: float, t_enter: float,
                 scrollback: list[str] | None = None, style: str = "classic",
                 desktop=(16, 18, 22), title: str = "bash",
                 t_done: float | None = None):
        self.prompt = prompt
        self.command = command
        self.output = output
        self.t_type = t_type
        self.type_rate = type_rate
        self.t_enter = t_enter
        self.scrollback = scrollback or []
        self.st = TERMINAL_STYLES.get(style, TERMINAL_STYLES["classic"])
        self.desktop = tuple(desktop)
        self.title = title
        self.t_done = t_done

    def avg_color(self):
        return self.st["bg"]

    def typing_ends(self) -> float:
        return self.t_type + len(self.command) / self.type_rate

    def _typed(self, t: float) -> str:
        if t < self.t_type:
            return ""
        n = int((t - self.t_type) * self.type_rate)
        return self.command[:min(n, len(self.command))]

    def _tokens(self):
        """(text, colour_key) spans for the whole command, for syntax colour."""
        st = self.st
        if not st["tokens"]:
            return [(self.command, st["fg"])]
        out, i = [], 0
        for n, word in enumerate(self.command.split(" ")):
            col = st["fg"]
            if n == 0:
                col = st["prompt"]
            elif n <= 2:
                col = (238, 206, 130)
            elif word.startswith("-"):
                col = st["dim"]
            out.append((word, col))
        spans, pos = [], 0
        for n, (word, col) in enumerate(out):
            if n:
                spans.append((" ", st["fg"]))
            spans.append((word, col))
        return spans

    def frame(self, t: float, w: int, h: int, disp_w: int | None = None):
        """The window's CLIENT area only — the frame is drawn by the Window."""
        st = self.st
        img = Image.new("RGB", (w, h), st["bg"])
        if w < 40 or h < 24:
            return img
        d = ImageDraw.Draw(img)

        scale = st.get("fscale", 1.0)
        x0 = int(w * st["pad"])
        avail = w - 2 * x0
        avail_h = h * (1.0 - 2 * st["pad"])
        cmd_line = self.prompt + " " + self.command
        out_lines = list(self.scrollback) + list(self.output)
        # `out_fscale` sets the output at a fraction of the command's size: the
        # command is the shot and a REAL transcript's longest line is far longer
        # than it, so one shared size shrinks the command to suit text nobody is
        # meant to read. Unset, everything shares one size like a real terminal.
        ratio = st.get("out_fscale")

        def _fits(size: int) -> bool:
            fm_try = font("mono", size)
            osz = max(7, int(size * ratio)) if ratio else size
            fo_try = font("mono", osz)
            wide = (text_w(d, cmd_line, fm_try) > avail
                    or any(text_w(d, s, fo_try) > avail for s in out_lines))
            tall = int(size * 1.6) + len(out_lines) * int(osz * 1.6) > avail_h
            return not (wide or tall)

        if scale == "fit":
            fs = max(7, int(h * 0.052 * st.get("max_fscale", 1.9)))
            while fs > 8 and not _fits(fs):
                fs = int(fs * 0.96)
        else:
            fs = max(7, int(h * 0.052 * scale))
        fs_out = max(7, int(fs * ratio)) if ratio else fs
        fm, fb = font("mono", fs), font("mono-bold", fs)
        fo = font("mono", fs_out)
        line_h = int(fs * 1.6)
        out_h = int(fs_out * 1.6)

        block_h = line_h + (len(self.scrollback) + len(self.output)) * out_h
        if st.get("valign") == "center":
            y = int((h - block_h) / 2)
        else:
            y = int(h * 0.055)

        for i, line in enumerate(self.scrollback):
            d.text((x0, y + out_h * i), line, font=fo, fill=st["dim"])
        y += out_h * len(self.scrollback)

        d.text((x0, y), self.prompt, font=fb, fill=st["prompt"])
        cx = x0 + text_w(d, self.prompt, fb) + int(fs * 0.6)
        typed = self._typed(t)

        shown, pos = len(typed), 0
        for span, col in self._tokens():
            if pos >= shown:
                break
            part = span[:max(0, shown - pos)]
            if part:
                d.text((cx, y), part, font=fm, fill=col)
                cx += text_w(d, part, fm)
            pos += len(span)

        if shown < len(self.command) or (t % 1.0) < 0.55:
            if st["cursor"] == "bar":
                d.rectangle([cx, y, cx + max(1, int(fs * 0.12)), y + fs], fill=st["fg"])
            elif st["cursor"] == "underline":
                d.rectangle([cx, y + fs, cx + int(fs * 0.6), y + fs + max(1, fs // 10)],
                            fill=st["fg"])
            else:
                d.rectangle([cx, y, cx + int(fs * 0.6), y + fs], fill=st["fg"])

        if t >= self.t_enter:
            step = 0.22
            if self.t_done is not None and self.output:
                # every line up, and readable, before the flip
                step = min(step, max(0.04, (self.t_done - 0.3 - self.t_enter)
                                     / len(self.output)))
            for i, line in enumerate(self.output):
                ly = y + line_h + out_h * i
                if ly + fs_out > h or t < self.t_enter + step * i:
                    break
                d.text((x0, ly), line, font=fo,
                       fill=st["out"] if line.startswith("  ") else st["fg"])

        if st["scanlines"]:
            step = max(2, int(h / 240))
            dark = tuple(int(c * 0.82) for c in st["bg"])
            for yy in range(0, h, step * 2):
                d.line([(0, yy), (w, yy)], fill=dark, width=1)
        return img


class _ThumbView:
    """The thumb ladder as PIL images, built on demand off a mmapped array.

    Indexing costs one small copy (160x120), which is nothing next to holding
    every frame of every clip resident in every worker.
    """

    __slots__ = ("arr",)

    def __init__(self, arr):
        self.arr = arr

    def __len__(self):
        return len(self.arr)

    def __getitem__(self, i):
        return Image.fromarray(np.asarray(self.arr[i]))


class Clip:
    """Real footage for one clip id.

    Frames are pre-extracted once into a cache directory at two ladders: a small
    'thumb' ladder held in RAM for grid tiles, and full-size PNGs loaded on
    demand (LRU) for hero windows. Tiles in the wide shot are ~48 px across, so
    serving them from full-size frames would decode a thousand 1024x768 images
    per output frame.
    """

    THUMB_W = 160
    # Raw, memmapped ladders. THUMB_W alone is never reached at 4K -- the
    # canonical sizes there run 254..2554 -- so every single source fetch was
    # decoding a full 2048x1536 PNG (33-47 ms) to produce a 318 px tile, and PNG
    # decode was 26-56% of a real sequential render. An LRU cannot help: each
    # (clip, phase) advances one frame per output frame, so every access is a
    # compulsory miss. The answer is a cheaper read, not a bigger cache.
    LADDERS = (160, 512, 1024)
    native_w = None          # set from the first extracted frame

    def __init__(self, clip_id: str, path: Path, cache: Path, fps: float):
        self.id = clip_id
        self.path = path
        self.fps = fps
        self.dir = cache / clip_id
        self.thumbs: list[Image.Image] = []
        self.full = OrderedDict()
        self._lru_n = None       # frames, derived from FULL_LRU_BYTES on first read
        self.n = 0
        self._extract()

    def _extract(self) -> None:
        stamp = self.dir / ".done"
        if not stamp.exists():
            if self.dir.exists():
                shutil.rmtree(self.dir)
            self.dir.mkdir(parents=True, exist_ok=True)
            # -r alone, never with -fps_mode/-vsync: ffmpeg refuses the pair as
            # contradictory ("One of -r/-fpsmax was specified together a non-CFR
            # -vsync/-fps_mode"), and CFR is what we want anyway — frame index
            # has to map linearly to time for Clip.frame()'s modulo to be right.
            cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                   "-i", str(self.path), "-r", str(self.fps),
                   str(self.dir / "f%05d.png")]
            subprocess.run(cmd, check=True)
            stamp.write_text("ok\n")
        self.frames = sorted(self.dir.glob("f*.png"))
        self.n = len(self.frames)
        if self.n == 0:
            raise SystemExit(f"clip {self.id}: no frames extracted from {self.path}")
        with Image.open(self.frames[0]) as probe:
            self.native_w = probe.width

        # Each ladder is built ONCE, straight from the mp4 -- one ffmpeg pass that
        # scales and hands over raw frames, ~3 s per clip. Building it by decoding
        # the extracted PNGs instead costs minutes and buys nothing.
        self.ladders = []
        for lw in self.LADDERS:
            if lw >= self.native_w:
                break
            npy = self.dir / f"ladder-{lw}.npy"
            if not npy.exists():
                self._build_ladder(npy, lw)
            # mmap, and do NOT materialise: `np.asarray(a)` per frame copies the
            # whole ladder into this process's heap, which is ~100 MB per clip
            # per worker and is pure duplication -- the mapped pages are shared.
            self.ladders.append((lw, np.load(npy, mmap_mode="r")))
        if self.ladders:
            self._thumb_arr = self.ladders[0][1]
            self.thumbs = _ThumbView(self._thumb_arr)

    def _build_ladder(self, npy: Path, width: int) -> None:
        with Image.open(self.frames[0]) as im:
            sw, sh = im.size
        h = max(2, round(width * sh / sw) // 2 * 2)
        proc = subprocess.Popen(
            ["ffmpeg", "-v", "error", "-i", str(self.path), "-r", str(self.fps),
             "-vf", f"scale={width}:{h}:flags=lanczos",
             "-f", "rawvideo", "-pix_fmt", "rgb24", "-"], stdout=subprocess.PIPE)
        raw = proc.stdout.read()
        proc.wait()
        per = width * h * 3
        n = len(raw) // per
        if n == 0:
            raise SystemExit(f"clip {self.id}: ladder {width} came back empty")
        np.save(npy, np.frombuffer(raw[:n * per], np.uint8).reshape(n, h, width, 3))

    def avg_color(self) -> tuple[int, int, int]:
        small = self.thumbs[0].resize((1, 1), Image.BOX)
        return small.getpixel((0, 0))

    def _full(self, i: int) -> Image.Image:
        got = self.full.get(i)
        if got is None:
            got = Image.open(self.frames[i]).convert("RGB")
            if self._lru_n is None:
                per = max(1, got.width * got.height * 3)
                self._lru_n = max(FULL_LRU_MIN, FULL_LRU_BYTES // per)
            self.full[i] = got
            while len(self.full) > self._lru_n:
                self.full.popitem(last=False)
        else:
            self.full.move_to_end(i)
        return got

    def frame(self, t: float, w: int, h: int, disp_w: int | None = None) -> Image.Image:
        i = int(t * self.fps) % self.n
        src = None
        for lw, arr in self.ladders:            # smallest ladder that still has
            if w <= lw:                         # more pixels than we are asked for
                src = Image.fromarray(arr[i % len(arr)])
                break
        if src is None:
            src = self._full(i)
        return src.resize((max(1, w), max(1, h)), Image.BILINEAR)


