def _encode_cmd(out: str, w: int, h: int, fps: float, crf: int, preset: str) -> list[str]:
    return ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-f", "rawvideo", "-pix_fmt", "rgb24",
            "-s", f"{w}x{h}", "-r", f"{fps:g}", "-i", "-",
            "-c:v", "libx264", "-preset", preset, "-crf", str(crf),
            "-pix_fmt", "yuv420p", "-movflags", "+faststart", out]


def _render_segment(job):
    """Render one contiguous run of frames straight into its own mp4 segment.

    Frames are independent, so this is embarrassingly parallel. Each worker
    encodes its own segment rather than shipping raw frames back to the parent:
    a 4K frame is 24 MB, and piping 1600 of them through IPC costs more than the
    rendering does. The segments are concatenated with `-c copy` afterwards.
    """
    (idx, spec, backend, clips, cache, fps, w, h, crf, preset,
     t_start, n_frames, seg_path, supersample) = job
    global SUPERSAMPLE
    SUPERSAMPLE = supersample
    # Rebuilt per segment on purpose: construction is 48 ms measured, so caching
    # it across a worker's segments buys 2 s of CPU on the whole film and would
    # keep a stale frame cache alive for parts of the film the worker has left.
    m = Montage(Path(spec), backend, Path(clips) if clips else None,
                Path(cache), fps, aspect=h / w)
    proc = subprocess.Popen(_encode_cmd(seg_path, w, h, fps, crf, preset),
                            stdin=subprocess.PIPE)
    try:
        for i in range(n_frames):
            proc.stdin.write(m.render_frame(t_start + i / fps, w, h).tobytes())
    finally:
        proc.stdin.close()
        rc = proc.wait()
    return idx, seg_path, n_frames, rc


# --------------------------------------------------------------------------
# keyboard
# --------------------------------------------------------------------------
# SYNTHESISED, not sampled, on purpose. The film already carries one licensed
# asset with an attribution obligation; a second would mean another credit,
# another content-ID dispute answer and another file that must never enter the
# repository. This is deterministic from a seed, regenerates for any re-cut, and
# belongs to nobody. numpy only: `tools/tamontage` runs under the system
# interpreter, which has numpy and PIL but no scipy, so the band-shaping is done
# on the spectrum rather than with a filter design.

KEY_SR = 48000
SR_MUX = 44100


def _key_hp(x: np.ndarray, cut_hz: float) -> np.ndarray:
    """High-pass on the spectrum. numpy only: `tools/tamontage` runs under the
    system interpreter, which has numpy and PIL but no scipy."""
    X = np.fft.rfft(x)
    f = np.maximum(np.fft.rfftfreq(len(x), 1.0 / KEY_SR), 1.0)
    return np.fft.irfft(X * (1.0 / (1.0 + (cut_hz / f) ** 4)), len(x))


def _key_load(path: str) -> np.ndarray:
    out = subprocess.run(["ffmpeg", "-v", "error", "-i", path, "-f", "f32le",
                          "-ac", "1", "-ar", str(KEY_SR), "-"],
                         capture_output=True)
    a = np.frombuffer(out.stdout, np.float32).astype(np.float64)
    if a.size == 0:
        raise SystemExit(f"--keys {path}: ffmpeg decoded nothing")
    return a


def _key_bank(path: str, thresh: float = 0.22, min_gap_ms: float = 45.0):
    """Cut a recording of someone typing into individual keystroke one-shots.

    A continuous take is not usable as-is: the film needs a click on one exact
    frame, forty-odd times. So find the onsets, cut a window at each, and keep
    the ones that are cleanly separated from their neighbour.

    Detection runs on the HIGH band -- a keystroke IS a click, and the low end is
    room and body that smears the onset and costs you the attack.
    """
    x = _key_load(path)
    env = np.abs(_key_hp(x, 1500.0))
    w = int(KEY_SR * 0.003)
    env = np.convolve(env, np.ones(w) / w, mode="same")
    env /= max(env.max(), 1e-9)

    gap = int(KEY_SR * min_gap_ms / 1000.0)
    idx, last = [], -gap
    for i in np.where(env > thresh)[0]:
        if i - last < gap:
            continue
        j = i                       # walk back to where the rise actually starts
        while j > 0 and env[j] > env[i] * 0.12 and i - j < int(KEY_SR * 0.01):
            j -= 1
        idx.append(j)
        last = i

    pre = int(KEY_SR * 0.002)
    normal, heavy = [], []
    scored = []
    for n, i in enumerate(idx):
        nxt = idx[n + 1] if n + 1 < len(idx) else len(x)
        end = min(i + int(KEY_SR * 0.170), nxt - int(KEY_SR * 0.004), len(x))
        st = max(0, i - pre)
        if end - st < int(KEY_SR * 0.05):
            continue                # crowded by its neighbour: no clean tail
        seg = x[st:end].copy()
        seg[:pre] *= np.linspace(0, 1, pre)                  # no click-in
        tail = min(len(seg) // 4, int(KEY_SR * 0.02))
        seg[-tail:] *= np.linspace(1, 0, tail)               # no click-out
        pk = float(np.abs(seg).max())
        if pk < 0.02 or pk > 0.999:
            continue                # silence, or clipped in the source
        X = np.abs(np.fft.rfft(seg * np.hanning(len(seg))))
        f = np.fft.rfftfreq(len(seg), 1.0 / KEY_SR)
        lo = float(X[f < 500].sum() / max(X.sum(), 1e-9))
        scored.append((lo, seg / pk))
    if len(scored) < 8:
        raise SystemExit(f"--keys {path}: only {len(scored)} usable keystrokes "
                         f"found; is this a recording of typing?")
    # The biggest, lowest one-shots are the space bar and the other long keys.
    scored.sort(key=lambda r: r[0])
    cut = max(3, len(scored) // 8)
    heavy = [r[1] for r in scored[-cut:]]
    normal = [r[1] for r in scored[:-cut]]
    return normal, heavy


def _key_pitch(seg: np.ndarray, f: float) -> np.ndarray:
    n = max(1, int(len(seg) / f))
    return np.interp(np.arange(n) * f, np.arange(len(seg)), seg)


def _key_events(spec: dict, fps: float, t0: float, duration: float):
    """When does each glyph actually appear? Not when it analytically should.

    `Terminal._typed` shows character i once int((t - t_type) * rate) >= i + 1,
    and it is only ever sampled at frame times -- so the analytic instant is up
    to one frame early. Snapping each keystroke to the frame its glyph lands on
    is both the correct sync AND free, natural-sounding jitter: at 17 chars/s
    into 30 fps the gaps come out 33 and 67 ms instead of a metronomic 59.
    """
    kb = (spec.get("audio") or {}).get("keyboard") or {}
    want = kb.get("windows")
    ev = []
    for i, w in enumerate(spec.get("windows", [])):
        if "command" not in w:
            continue
        if want is not None and i not in want:
            continue
        cmd = w["command"]
        rate = float(w.get("type_rate", 17.0))
        ts = float(w.get("t_type", w.get("t_open", 0.0) + 0.4))
        for n, ch in enumerate(cmd):
            t = math.ceil((ts + (n + 1) / rate) * fps) / fps - t0
            if 0.0 <= t < duration:
                ev.append((t, "space" if ch == " " else "key"))
        te = float(w.get("t_enter", 1e9)) - t0
        if 0.0 <= te < duration:
            ev.append((te, "enter"))
    ev.sort()
    return ev


def _keyboard_wav(spec: dict, fps: float, t0: float, duration: float,
                  path: str, source: str) -> str | None:
    """Render the keystroke track to a wav, or None if there is nothing to play."""
    kb = (spec.get("audio") or {}).get("keyboard") or {}
    if not kb:
        return None
    ev = _key_events(spec, fps, t0, duration)
    if not ev:
        return None
    normal, heavy = _key_bank(source)
    rng = np.random.default_rng(int(kb.get("seed", 0)))
    spread = float(kb.get("spread", 0.30))
    pitch = float(kb.get("pitch", 0.06))
    n = int(KEY_SR * duration) + KEY_SR
    out = np.zeros((n, 2), np.float64)
    recent: list[int] = []
    for t, kind in ev:
        pool = heavy if kind in ("space", "enter") else normal
        j = int(rng.integers(len(pool)))
        for _ in range(12):                  # never the same click twice running
            if j not in recent[-4:]:
                break
            j = int(rng.integers(len(pool)))
        recent.append(j)
        k = _key_pitch(pool[j], float(rng.uniform(1 - pitch, 1 + pitch)))
        k = k * rng.uniform(0.72, 1.06) * (1.18 if kind == "enter" else 1.0)
        i = int(round(t * KEY_SR))
        if i + len(k) > n:
            k = k[: n - i]
        pan = rng.uniform(-spread, spread)        # a hand moving across the board
        out[i:i + len(k), 0] += k * math.sqrt(0.5 * (1 - pan))
        out[i:i + len(k), 1] += k * math.sqrt(0.5 * (1 + pan))

    peak = float(np.abs(out).max())
    if peak > 0:
        out /= peak
    out *= 10.0 ** (float(kb.get("gain_db", -5.0)) / 20.0)
    out = out[: int(KEY_SR * duration)]
    with wave.open(path, "wb") as w:
        w.setnchannels(2); w.setsampwidth(2); w.setframerate(KEY_SR)
        w.writeframes((np.clip(out, -1, 1) * 32767).astype("<i2").tobytes())
    print(f"  keyboard: {len(ev)} keystrokes from {len(normal)}+{len(heavy)} "
          f"one-shots off {Path(source).name}, "
          f"{float(kb.get('gain_db', -5.0)):g} dB")
    return path


def _extend_audio(src: str, loop: dict, out: str) -> tuple[str, float]:
    """Splice a track longer by repeating bars of its own intro.

    The film needed the music 14.5 s earlier without moving its climax, and the
    only way to buy that is to make the track longer at the FRONT.

    `segments` is the play order, in track seconds, as [start, end] pairs; a null
    end means "to the end of the track". The join that matters is the jump from
    the end of one segment back to the start of the next: the music there has to
    follow naturally from what preceded the cut, which is true when the span is a
    whole number of bars AND the phrase repeats. Chroma self-similarity is how
    those points were found -- a spectral envelope says only "orchestra", while
    chroma tracks the harmony that says two moments are the same bar. Measured on
    this track: period 2.07 s, which is one bar at its stated 115 bpm, downbeats
    at 0.30 + 2.087k.

    The last segment runs to the end of the original, so that join is seamless by
    construction and only the loop joins need to be right.
    """
    segs = loop.get("segments") or []
    if not segs:
        raise SystemExit("audio.loop needs a `segments` list")
    xf = int(SR_MUX * float(loop.get("crossfade_ms", 18.0)) / 1000.0)
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", src, "-f", "f32le",
                          "-ac", "2", "-ar", str(SR_MUX), "-"],
                         capture_output=True).stdout
    x = np.frombuffer(raw, np.float32).astype(np.float64).reshape(-1, 2)
    if x.size == 0:
        raise SystemExit(f"--audio {src}: ffmpeg decoded nothing")
    orig = len(x) / SR_MUX

    out_a = None
    for a, b in segs:
        i0 = int(float(a) * SR_MUX)
        i1 = len(x) if b is None else int(float(b) * SR_MUX)
        seg = x[i0:i1].copy()
        if len(seg) == 0:
            raise SystemExit(f"audio.loop segment [{a}, {b}] is empty")
        if out_a is None:
            out_a = seg
            continue
        n = min(xf, len(out_a), len(seg))
        fo = np.cos(np.linspace(0, np.pi / 2, n))[:, None]      # equal power:
        fi = np.sin(np.linspace(0, np.pi / 2, n))[:, None]      # no dip at the join
        out_a = np.concatenate([out_a[:-n], out_a[-n:] * fo + seg[:n] * fi,
                                seg[n:]])
    with wave.open(out, "wb") as w:
        w.setnchannels(2); w.setsampwidth(2); w.setframerate(SR_MUX)
        w.writeframes((np.clip(out_a, -1, 1) * 32767).astype("<i2").tobytes())
    added = len(out_a) / SR_MUX - orig
    print(f"  music: {orig:.2f}s -> {len(out_a)/SR_MUX:.2f}s "
          f"(+{added:.2f}s, {len(segs) - 1} join{'s' if len(segs) != 2 else ''})")
    return out, added


def _mux_audio(video: str, audio: str | None, spec: dict, duration: float,
               out: str, keys: str | None = None) -> int:
    """Lay the soundtrack over a finished cut. Video is COPIED, never re-encoded.

    Measured: 1.5 s for a 57 s 4K cut. Which is the whole reason the track is
    chosen AFTER the render rather than before — auditioning a candidate costs
    seconds, so there is no case for deciding it up front.

    `start` is where the music begins in the film. A track shorter than the film
    is normal; what matters is that it ENDS with the film, because the climax is
    at the end. `promo/MUSIC.md` works this out for the current track, and the
    rule is start = duration_of_film - duration_of_track.
    """
    start = float(spec.get("start", 0.0))
    gain = float(spec.get("gain_db", 0.0))
    fade_in = float(spec.get("fade_in", 0.0))
    fade_out = float(spec.get("fade_out", 0.0))

    chain = []
    if start > 0:
        # adelay wants milliseconds, per channel
        ms = int(round(start * 1000))
        chain.append(f"adelay={ms}|{ms}")
    if fade_in > 0:
        chain.append(f"afade=t=in:st={start:g}:d={fade_in:g}")
    if fade_out > 0:
        chain.append(f"afade=t=out:st={max(0.0, duration - fade_out):g}:"
                     f"d={fade_out:g}")
    if gain:
        chain.append(f"volume={gain:g}dB")
    # -shortest alone would cut the VIDEO if the audio ends first, which it does
    # here by design; apad pads the audio to the film instead.
    chain.append("apad")
    filt = ",".join(chain) if chain else "anull"

    ins, graph, labels = ["-i", video], [], []
    if audio:
        ins += ["-i", audio]
        graph.append(f"[{len(labels) + 1}:a]{filt}[m]")
        labels.append("[m]")
    if keys:
        ins += ["-i", keys]
        # The keystrokes are already mixed and levelled in the wav; they only
        # need padding to the film so `-shortest` cannot trim the picture.
        graph.append(f"[{len(labels) + 1}:a]apad[k]")
        labels.append("[k]")
    if not labels:
        return 2
    if len(labels) == 1:
        graph.append(f"{labels[0]}anull[a]")
    else:
        # normalize=0, or amix halves BOTH sources to make room for each other
        # and the music comes back 6 dB down from the level it was chosen at.
        graph.append(f"{''.join(labels)}amix=inputs={len(labels)}:"
                     f"normalize=0:duration=longest[a]")

    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *ins,
           "-filter_complex", ";".join(graph),
           "-map", "0:v", "-map", "[a]",
           "-c:v", "copy", "-c:a", "aac", "-b:a", "192k",
           "-t", f"{duration:g}", "-movflags", "+faststart", out]
    rc = subprocess.run(cmd).returncode
    if rc == 0 and audio:
        cred = spec.get("credit")
        print(f"  audio: {Path(audio).name} from {start:g}s"
              + (f", {gain:g} dB" if gain else "")
              + (f", {fade_out:g}s fade" if fade_out else ""))
        if cred:
            print(f"  CREDIT REQUIRED — put this where the film is posted:")
            for line in cred.splitlines():
                print(f"    {line}")
    return rc


def _finish_audio(m, args, aspec, fps, t0, rendered, tmp_out, keys_wav) -> int:
    """Mux whatever audio this render actually has -- possibly none.

    `audio.keyboard` in the script means the film WANTS keystrokes, not that
    this render has any: a `--t0 30` preview is past the typing, so the track
    comes back empty. That case has to put the silent render in place rather
    than fall through the mux, which otherwise deletes the temp file and returns
    a bare 2 -- the whole render gone, with no output and no message.
    """
    kw = (_keyboard_wav(m.spec, fps, t0, rendered, keys_wav, args.keys)
          if keys_wav else None)
    if not args.audio and not kw:
        os.replace(tmp_out, args.out)
        return 0
    music, ext_wav = args.audio, None
    if args.audio and aspec.get("loop"):
        ext_wav = f"{args.out}.music.wav"
        music, added = _extend_audio(args.audio, aspec["loop"], ext_wav)
        # `start` is authored against the UNLOOPED track, and the loop only ever
        # extends the front -- so it pulls the start earlier by exactly its own
        # length and nothing downstream of it moves. Taking `added` from the
        # built file rather than from the arithmetic makes that true whatever the
        # crossfades cost.
        aspec["start"] = max(0.0, float(aspec.get("start", 0.0)) - added)
    rc = _mux_audio(tmp_out, music, aspec, rendered, args.out, kw)
    os.unlink(tmp_out)
    if kw:
        os.unlink(kw)
    if ext_wav and os.path.exists(ext_wav):
        os.unlink(ext_wav)
    return rc


def cmd_render(args) -> int:
    global SUPERSAMPLE
    SUPERSAMPLE = max(1, args.supersample)
    fps = args.fps
    out_w, out_h = args.width, args.height
    cache = Path(args.cache) if args.cache else Path(
        os.environ.get("TMPDIR", "/tmp")) / "tamontage-cache"
    cache.mkdir(parents=True, exist_ok=True)

    m = Montage(Path(args.script), args.backend,
                Path(args.clips) if args.clips else None, cache, fps,
                aspect=out_h / out_w)

    t0 = args.t0
    t1 = args.t1 if args.t1 is not None else m.duration
    n = int(round((t1 - t0) * fps))
    print(f"[tamontage] {m.name}: {n} frames, {out_w}x{out_h}@{fps:g}, "
          f"{len(m.windows)} windows, backend={args.backend}", flush=True)

    aspec = dict(m.spec.get("audio") or {})
    if args.audio:
        # `start` is written against the whole film; a --t0 preview shifts it.
        aspec["start"] = max(0.0, float(aspec.get("start", 0.0)) - t0)
    rendered = n / fps
    # The keystroke track is synthesised from the script's own typing, so it
    # exists whether or not a music file was given -- and the keys land in the
    # silent opening, which is where the music deliberately is not.
    want_keys = bool(aspec.get("keyboard")) and bool(args.keys) and not args.no_keys
    if aspec.get("keyboard") and not args.keys and not args.no_keys:
        print("  note: the script asks for a keyboard track but no --keys "
              "recording was given; rendering without it", file=sys.stderr)
    has_audio = bool(args.audio) or want_keys
    keys_wav = f"{args.out}.keys.wav" if want_keys else None
    tmp_out = f"{args.out}.silent.mp4" if has_audio else args.out

    jobs = max(1, args.jobs)
    if jobs == 1:
        proc = subprocess.Popen(
            _encode_cmd(tmp_out, out_w, out_h, fps, args.crf, args.preset),
            stdin=subprocess.PIPE)
        assert proc.stdin is not None
        try:
            for i in range(n):
                t = t0 + i / fps
                proc.stdin.write(m.render_frame(t, out_w, out_h).tobytes())
                if i % int(fps) == 0:
                    print(f"\r  {t:6.2f}s  {100.0 * i / max(1, n):5.1f}%",
                          end="", flush=True)
        finally:
            proc.stdin.close()
            rc = proc.wait()
        if rc == 0 and has_audio:
            rc = _finish_audio(m, args, aspec, fps, t0, rendered, tmp_out, keys_wav)
        print(f"\r  done: {args.out}" + " " * 20)
        return rc

    # Parallel: contiguous segments, one worker each, concatenated with -c copy.
    import multiprocessing as mp

    segdir = Path(args.out).parent / f".{Path(args.out).stem}-segments"
    if segdir.exists():
        shutil.rmtree(segdir)
    segdir.mkdir(parents=True, exist_ok=True)
    # More segments than workers, so the pool's queue BALANCES them. Equal frame
    # counts are not equal work: measured on the 57 s cut, the dearest 123-frame
    # segment is 81 s against a 38 s average, so fourteen equal segments put the
    # wall floor at 2.1x the ideal and the workers holding the opening sit idle
    # for most of the render. The cost is one extra keyframe per segment.
    per = max(1, -(-n // (jobs * args.chunks)))
    tasks = []
    for i in range(-(-n // per)):
        first = i * per
        cnt = min(per, n - first)
        if cnt <= 0:
            break
        tasks.append((i, args.script, args.backend, args.clips or "", str(cache),
                      fps, out_w, out_h, args.crf, args.preset,
                      t0 + first / fps, cnt, str(segdir / f"seg{i:03d}.mp4"),
                      SUPERSAMPLE))
    print(f"  {len(tasks)} segments x ~{per} frames across {jobs} workers")
    # ProcessPoolExecutor, NOT multiprocessing.Pool: when a worker is killed --
    # and the OOM killer does kill these, they are the largest processes on the
    # machine -- Pool quietly starts a replacement and the dead worker's task is
    # simply never completed, so the parent waits on a result that can never
    # arrive. It sits there at "10/16 segments" with every worker idle, no error
    # anywhere, looking exactly like a slow render. The executor raises
    # BrokenProcessPool instead, which is a failure you can act on.
    done, total = 0, 0
    ctx = mp.get_context("spawn")
    try:
        with cf.ProcessPoolExecutor(max_workers=jobs, mp_context=ctx) as pool:
            futures = [pool.submit(_render_segment, job) for job in tasks]
            for fut in cf.as_completed(futures):
                idx, path, cnt, rc = fut.result()
                if rc != 0:
                    print(f"\n  segment {idx} failed (ffmpeg rc={rc})")
                    return rc
                done += 1
                total += cnt
                print(f"\r  {done}/{len(tasks)} segments, {total}/{n} frames",
                      end="", flush=True)
    except cf.process.BrokenProcessPool:
        print(f"\n  a render worker died ({done}/{len(tasks)} segments were done).")
        print("  Almost certainly the OOM killer: each worker holds a frame cache")
        print("  per clip, so peak memory scales with --jobs. Retry with a lower")
        print("  -j, or lower FULL_LRU_BYTES.")
        return 1
    print()

    listing = segdir / "segments.txt"
    listing.write_text("".join(
        f"file '{segdir / f'seg{i:03d}.mp4'}'\n" for i in range(len(tasks))))
    rc = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                         "-f", "concat", "-safe", "0", "-i", str(listing),
                         "-c", "copy", "-movflags", "+faststart",
                         tmp_out]).returncode
    if rc == 0 and has_audio:
        rc = _finish_audio(m, args, aspec, fps, t0, rendered, tmp_out, keys_wav)
    if rc == 0:
        shutil.rmtree(segdir, ignore_errors=True)
        print(f"  done: {args.out}")
    return rc


def cmd_probe(args) -> int:
    cache = Path(os.environ.get("TMPDIR", "/tmp")) / "tamontage-cache"
    m = Montage(Path(args.script), "wire", None, cache, 30.0)
    print(m.beat_sheet())
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="tamontage", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("render", help="render a montage script to video")
    r.add_argument("script")
    r.add_argument("-o", "--out", required=True)
    r.add_argument("--backend", choices=("wire", "clip"), default="wire",
                   help="wire = white-box placeholders (default); clip = real footage")
    r.add_argument("--clips", help="directory of <clip-id>.mp4 for --backend clip")
    r.add_argument("--cache", help="frame cache dir (default: $TMPDIR/tamontage-cache)")
    r.add_argument("--width", type=int, default=1920)
    r.add_argument("--height", type=int, default=1080)
    r.add_argument("--fps", type=float, default=30.0)
    r.add_argument("--jobs", "-j", type=int, default=max(1, (os.cpu_count() or 4) // 2),
                   help="parallel render workers (frames are independent). "
                        "1 renders serially into a single encoder")
    r.add_argument("--supersample", type=int, default=SUPERSAMPLE,
                   help="draw sources at N x the displayed size and scale down "
                        "(default 3). 1 is the fast, shimmery draft path")
    r.add_argument("--chunks", type=int, default=4,
                   help="segments per worker (default 4). Frames are not equal "
                        "work, so one segment per worker leaves most of them "
                        "idle; more, smaller segments let the pool balance. 1 "
                        "restores the old behaviour and the fewest concat seams")
    r.add_argument("--crf", type=int, default=18)
    r.add_argument("--preset", default="medium")
    r.add_argument("--audio", help="soundtrack to lay over the finished cut. The "
                   "PATH is a command-line argument on purpose: the script "
                   "carries the timing and the credit, never a path into "
                   "someone's home directory, and the track itself is licensed "
                   "for use in a work rather than for redistribution")
    r.add_argument("--keys", help="a recording of someone typing, sliced into "
                   "one-shots at render time and placed on the film's own "
                   "keystroke times (audio.keyboard in the script). Like "
                   "--audio, the PATH is an argument and never the script: it "
                   "would name someone's home directory, and the recording is "
                   "licensed for use inside a work rather than for "
                   "redistribution, so it never enters this repository")
    r.add_argument("--no-keys", action="store_true",
                   help="skip the synthesised keystroke track even if the script "
                        "asks for one (audio.keyboard)")
    r.add_argument("--t0", type=float, default=0.0, help="start time (preview a beat)")
    r.add_argument("--t1", type=float, default=None, help="end time")
    r.set_defaults(func=cmd_render)

    q = sub.add_parser("probe", help="print the beat sheet without rendering")
    q.add_argument("script")
    q.set_defaults(func=cmd_probe)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
