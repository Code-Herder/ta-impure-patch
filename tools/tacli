def cmd_arm(args):
    inst = Instance(args.name)
    results = {}
    for spec in args.flags:
        name, _, value = spec.partition("=")
        path = inst.gamedir / f"tagpu_{name}"
        if value.lower() in ("off", "0", "false", "-"):
            path.unlink(missing_ok=True)
            results[name] = "removed"
        else:
            path.write_text("" if value in ("", "on", "1", "true") else value + "\n")
            results[name] = value or "on"
    out({"name": args.name, "flags": results}, args.json,
        human=", ".join(f"{k}={v}" for k, v in results.items()))


PEEK_RX = re.compile(r"^peek: (?P<spec>\S+) (?:@0x(?P<addr>[0-9A-Fa-f]{8}) )?= (?P<value>.*)$")


def _peek(inst: Instance, specs, timeout: float):
    """Read game memory from inside the process (tagpu_peek.trigger).

    The measurement half of a switch trace: name the address, launch with and
    without the switch, compare. Specs are `*0x511DE8+0x2C74:2` style — see
    tagpu/ddraw/inc/tagpu_peek.h for the grammar.
    """
    if not inst.running():
        die(f"{inst.name} is not running")
    log = inst.gamedir / "tagpu.log"
    start = log.stat().st_size if log.exists() else 0
    (inst.gamedir / "tagpu_peek.trigger").write_text("\n".join(specs) + "\n")

    deadline = time.time() + timeout
    rows = []
    while time.time() < deadline and len(rows) < len(specs):
        if log.exists():
            with open(log, "rb") as f:
                f.seek(start)
                chunk = f.read().decode("utf-8", "replace")
            rows = []
            for line in chunk.splitlines():
                m = PEEK_RX.match(line)
                if m:
                    rows.append({"spec": m.group("spec"),
                                 "addr": int(m.group("addr"), 16) if m.group("addr") else None,
                                 "value": m.group("value")})
        if len(rows) < len(specs):
            time.sleep(0.2)
    return rows


def _peek_uint(row):
    """`12345 (0x00003039)` -> 12345. None when the fork could not read it."""
    m = re.match(r"^(\d+)", (row or {}).get("value", ""))
    return int(m.group(1)) if m else None


def _peek_str(row):
    """`"maps\\Foo.tnt"` -> the text between the quotes, or None."""
    m = re.fullmatch(r'"(.*)"', (row or {}).get("value", ""))
    return m.group(1) if m else None


def cmd_peek(args):
    inst = Instance(args.name)
    rows = _peek(inst, args.specs, args.timeout)
    if not rows:
        die("no peek lines — is the game past its first frame?")
    out({"name": args.name, "peeks": rows}, args.json,
        human="\n".join(f"{r['spec']:<24} "
                        f"{'0x%08X' % r['addr'] if r['addr'] is not None else '':<12} "
                        f"{r['value']}" for r in rows))


def cmd_weapons(args):
    """Dump every weapon slot of the requested units (tagpu_weapons.trigger).

    The A/B oracle for the extra-weapons module (research/notes/extra-weapons.md):
    the fork reads the engine's own slot records — the three inline ones and, when
    the module is armed and the type has more, its side slots — and writes them
    as JSON. Works armed or not, so an unarmed instance is the control.
    """
    inst = Instance(args.name)
    if not inst.running():
        die(f"{inst.name} is not running")
    result = inst.gamedir / "tagpu_weapons.json"
    since = result.stat().st_mtime if result.exists() else 0
    spec = "all" if not args.units else "\n".join(str(u) for u in args.units)
    (inst.gamedir / "tagpu_weapons.trigger").write_text(spec + "\n")
    if not _wait_file(result, args.timeout, since):
        die("no weapon dump appeared (needs a running game past its first frame)")
    data = json.loads(result.read_text())
    rows = []
    # One line per unit *type*: the CRCs are a property of the def, and comparing
    # them across two instances is how a mismatched-peer test reads out.
    types = {}
    for u in data.get("units", []):
        types.setdefault(u["type"], (u.get("crc_weapons"), u.get("crc_all"), u["count"]))
    for u in data.get("units", []):
        for s in u["slots"]:
            rows.append(f"u{u['idx']:<5} {u['type']:<12} own={u['owner']} n={u['count']:<2} "
                        f"slot{s['i']:<2} st={s['state']} w={s['weapon'] or '-':<14} "
                        f"tgt={s['target']:<5} spot={s['spot']} rl={s['reload']:<4} "
                        f"hd={s['heading']:<6} pt={s['pitch']:<6} stk={s['stock']} "
                        f"aim={s['aimed']} thr={s['thread']}")
    hits = " ".join(f"{k}={v}" for k, v in data.get("hits", {}).items())
    fires = " ".join(f"{i}={n}" for i, n in enumerate(data.get("fires", [])) if n)
    crcs = " ".join(f"{t}(n={n},w={w},all={a})" for t, (w, a, n) in sorted(types.items())
                    if w is not None)
    head = (f"frame={data.get('frame')} armed={data.get('armed')} cap={data.get('cap')} "
            f"units={len(data.get('units', []))}\nhits: {hits}\nfires by slot: {fires or '-'}"
            + (f"\ntype CRCs: {crcs}" if crcs else ""))
    out(data, args.json, human=head + ("\n" + "\n".join(rows) if rows else "\n(no matching units)"))


def _wait_file(path: Path, timeout: float, since: float):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if path.exists() and path.stat().st_mtime > since:
            return True
        time.sleep(0.25)
    return False


def cmd_shot(args):
    """Surface screenshot: TA's own 8bpp surface (no GPU passes, engine truth)."""
    inst = Instance(args.name)
    shots = inst.gamedir / "Screenshots"
    before = time.time()
    (inst.gamedir / "tagpu_shot.trigger").write_text("")
    deadline = time.time() + args.timeout
    newest = None
    while time.time() < deadline:
        cands = [p for p in shots.glob("*.png") if p.stat().st_mtime > before]
        if cands:
            newest = max(cands, key=lambda p: p.stat().st_mtime)
            break
        time.sleep(0.25)
    if not newest:
        die("no surface screenshot appeared (is the instance running?)")
    dest = Path(args.output).expanduser() if args.output else newest
    if args.output:
        shutil.copy2(newest, dest)
    out({"name": args.name, "path": str(dest)}, args.json, human=str(dest))


