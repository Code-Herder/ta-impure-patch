# --------------------------------------------------------------------------- paths

def repo_root() -> Path:
    """The main checkout (never a worktree): that is where the runtime lives."""
    env = os.environ.get("TACLI_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    here = Path(__file__).resolve()
    for parent in here.parents:
        if (parent / "tagpu").is_dir() and (parent / "pristine").is_dir():
            # inside .claude/worktrees/<name>/ the runtime still lives in the main checkout
            marker = ".claude/worktrees"
            text = str(parent)
            if marker in text:
                main = Path(text.split(marker)[0].rstrip("/"))
                if (main / "tagpu" / "gamedir").is_dir():
                    return main
            return parent
    raise SystemExit("tacli: cannot locate the repo root (set TACLI_ROOT)")


ROOT = repo_root()
TAGPU = ROOT / "tagpu"
TEMPLATE_GAMEDIR = TAGPU / "gamedir"
TEMPLATE_PREFIX = ROOT / "wineprefix"
INSTANCES = TAGPU / "instances"

# Multiplayer. Wine ships the *client* half of DirectPlay TCP/IP only — dpwsockx's
# create path is an explicit "not yet supported" on every release including master —
# so no wine process can host a session. Microsoft's own DirectPlay in front of the
# builtin fixes it on the stock wine 9.0 these instances use (research/notes/
# networking-lobbies.md). The two EXEs must be overridden *by name* as well: with the
# DLLs alone, native dplayx starts wine's stub dplaysvr and Open() hangs with no error.
DPLAY_SRC = Path(os.environ.get("TA_DIRECTPLAY_SRC",
                                Path.home() / ".local/share/ta-directplay"))
DPLAY_INSTALL = Path(__file__).resolve().parent / "dpinstall.sh"
DPLAY_OVERRIDES = ("dplayx,dpmodemx,dpnet,dpnhpast,dpnhupnp,dpwsockx,"
                   "dplaysvr.exe,dpnsvr.exe=n")


def built_dll() -> Path:
    """The fork build to pin into instances.

    The runtime lives in the main checkout, but the *source being developed* lives
    in whatever tree this tacli was run from: a worktree builds its own
    tagpu/ddraw/ddraw.dll and must launch with it, or you spend an hour testing
    the main checkout's binary and wondering why your change did nothing.
    """
    local = Path(__file__).resolve().parent.parent / "tagpu" / "ddraw" / "ddraw.dll"
    return local if local.exists() else TAGPU / "ddraw" / "ddraw.dll"


BUILT_DLL = built_dll()

# The window title. Several instances of the same 1997 binary sit on the desktop
# at once, one per worktree, and every one of them used to be titled exactly
# "Total Annihilation": nothing on screen said which build you were looking at.
BASE_TITLE = "Total Annihilation"
TREE = Path(__file__).resolve().parent.parent      # the tree this tacli ran from


def tree_label() -> str:
    """Label for the window title: which tree the pinned ddraw.dll came from.

    The BRANCH, because that is the name the work has (`worktree-gpu_render`) and
    the same string the DLL already compiles into GIT_BRANCH, so a title and a
    `tacli log` line name the build identically. A detached HEAD — or no git at
    all — falls back to the directory name, which is never empty.
    """
    try:
        branch = subprocess.run(
            ["git", "-C", str(TREE), "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        branch = ""
    return branch if branch and branch != "HEAD" else TREE.name


LABEL_MAX = 95          # tagpu_title.c's LABEL_MAX, minus the NUL


def default_label(inst: "Instance") -> str:
    """The window-title label: which build, and which instance.

        wt:worktree-gpu_render | tacli:play1

    Both halves answer a question you ask of a desktop with several of these on it.
    `wt:` is the tree tacli ran from, which is the tree whose ddraw.dll it pinned —
    so it names the BUILD, not just the checkout. `tacli:` is the instance name,
    which is the id every other tacli command takes, so the title tells you what to
    type to drive that window.
    """
    return f"wt:{tree_label()} | tacli:{inst.name}"


def title_label(label: str) -> str:
    """The label as the DLL will read it back: first line, printable ASCII, no
    outer blanks, capped — in that order, which is the order tagpu_title.c's
    read_label() applies (leading blanks are skipped BEFORE the cap counts).

    Both halves have to sanitise identically. tacli records the resulting window
    title and then finds the window BY that exact string, so a label the DLL
    trims differently is a search for a title no window carries. An empty result
    is the "no label" state: the stock title, and no file.
    """
    line = (label or "").replace("\r", "\n").split("\n")[0]
    text = "".join(c for c in line if " " <= c <= "~").lstrip(" ")
    return text[:LABEL_MAX].rstrip(" ")


def ere_quote(s: str) -> str:
    """Quote for xdotool's POSIX extended regex (NOT re.escape: that escapes `-`,
    which is not a metacharacter outside a bracket expression and which GNU
    regcomp is only incidentally forgiving about)."""
    return "".join("\\" + c if c in ".[]{}()*+?^$|\\" else c for c in s)


# Files that must never be shared between instances: each gets its own real copy,
# everything else in the Steam dir is symlinked.
PRIVATE_FILES = {
    "ddraw.dll", "ddraw.ini", "totala.ini",
    "TotalA.exe",  # symlinked to Steam, but listed so we handle it explicitly
}
# Intro movies: omitted from the mirror unless --intro (find-file gate skips playback).
INTRO_MOVIES = {"1.zrb", "2.zrb"}

DEFAULT_RES = (1024, 768)
RES_RX = re.compile(r"(\d{3,4})\s*[xX*]\s*(\d{3,4})")


VIRTUAL_X_RX = re.compile(r"(?:^|/)(?:Xvfb|Xephyr|Xnest)\s+(:\d+)")


def virtual_displays() -> set:
    """Display numbers served by a virtual X server rather than a monitor.

    Parallel agent sessions leave 3840x2160 Xvfb servers running, and a shell
    that inherits one of those in DISPLAY launches the game somewhere the human
    cannot see it — which looks exactly like a game that failed to start. The
    physical session is an Xorg; Xvfb/Xephyr/Xnest are stand-ins for one.
    """
    try:
        ps = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True,
                            timeout=5).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return set()
    return {m.group(1) for m in (VIRTUAL_X_RX.search(l) for l in ps.splitlines()) if m}


def default_display() -> str:
    """The desktop to put windows on — the human's monitor unless told otherwise.

    An agent shell often inherits a stale or absent DISPLAY (":0" is the usual
    default and is frequently not the live session), so prefer TACLI_DISPLAY —
    an explicit choice wins even if it is virtual — then the inherited value and
    then the live sockets, in both cases skipping the virtual servers on the
    first pass and only falling back to one if there is no real display at all.
    """
    def alive(d: str) -> bool:
        try:
            return subprocess.run(["xdpyinfo"], env={**os.environ, "DISPLAY": d},
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  timeout=5).returncode == 0
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return False

    explicit = os.environ.get("TACLI_DISPLAY")
    if explicit and alive(explicit):
        return explicit
    virtual = virtual_displays()
    cands = [os.environ.get("DISPLAY")]
    cands += [":" + s.name[1:] for s in sorted(Path("/tmp/.X11-unix").glob("X*"),
                                               key=lambda p: p.name)]
    for skip_virtual in (True, False):
        for cand in cands:
            if not cand or (skip_virtual and cand in virtual):
                continue
            if alive(cand):
                return cand
    return os.environ.get("DISPLAY", ":0")


GAME_REG = r"HKCU\Software\Cavedog Entertainment\Total Annihilation"
SKIRMISH_REG = GAME_REG + r"\Skirmish"


# --------------------------------------------------------------------------- utils

def die(msg: str) -> "NoReturn":  # noqa: F821
    print(f"tacli: {msg}", file=sys.stderr)
    raise SystemExit(1)


def run(cmd, **kw):
    kw.setdefault("stdout", subprocess.DEVNULL)
    kw.setdefault("stderr", subprocess.DEVNULL)
    return subprocess.run(cmd, **kw)


def out(data, as_json: bool, human=None):
    if as_json:
        print(json.dumps(data, indent=2, default=str))
    elif human is not None:
        print(human)
    elif isinstance(data, str):
        print(data)
    else:
        print(json.dumps(data, indent=2, default=str))


def pointer_pos(display: str):
    """Current pointer position, or None if xdotool is unavailable."""
    try:
        o = subprocess.run(["xdotool", "getmouselocation", "--shell"],
                           capture_output=True, text=True,
                           env={**os.environ, "DISPLAY": display}).stdout
    except FileNotFoundError:
        return None
    vals = dict(l.split("=", 1) for l in o.strip().splitlines() if "=" in l)
    if "X" not in vals:
        return None
    return (int(vals["X"]), int(vals["Y"]))


def pointer_restore(display: str, pos):
    """Put the pointer back where the human left it.

    Starting the game warps the pointer to a screen/monitor origin exactly once.
    The warp is not ours and not TA's (the game never calls SetCursorPos: verified
    with every warp swallowed and logged) - it happens inside wine's window setup,
    and the pointer is free again afterwards. Until that is root-caused, put the
    pointer back so the human never loses it mid-task.
    """
    if not pos:
        return False
    now = pointer_pos(display)
    if not now or now == pos:
        return False
    run(["xdotool", "mousemove", "--sync", str(pos[0]), str(pos[1])],
        env={**os.environ, "DISPLAY": display})
    return True


class Instance:
    def __init__(self, name: str):
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,31}", name):
            die(f"invalid instance name {name!r} (use letters, digits, . _ -)")
        self.name = name
        self.dir = INSTANCES / name
        self.gamedir = self.dir / "gamedir"
        self.prefix = self.dir / "prefix"
        self.meta_path = self.dir / "instance.json"

    # -- state ------------------------------------------------------------
    @property
    def exists(self) -> bool:
        return self.meta_path.exists()

    def meta(self) -> dict:
        if not self.exists:
            die(f"no such instance {self.name!r} (tacli ls)")
        return json.loads(self.meta_path.read_text())

    def save_meta(self, meta: dict):
        self.meta_path.write_text(json.dumps(meta, indent=2))

    def env(self) -> dict:
        meta = self.meta()
        e = dict(os.environ)
        e["WINEPREFIX"] = str(self.prefix)
        e["DISPLAY"] = meta.get("display") or default_display()
        # ddraw is always ours; DirectPlay is appended only for instances launched
        # with --dplay, so a stock single-player instance keeps wine's builtin.
        overrides = ["ddraw=n,b"]
        if meta.get("dplay"):
            overrides.append(DPLAY_OVERRIDES)
        e["WINEDLLOVERRIDES"] = ";".join(overrides)
        e.setdefault("WINEDEBUG", "-all")
        return e

    def pid(self):
        """PID of this instance's TotalA.exe, identified by its own prefix."""
        try:
            pids = subprocess.run(["pgrep", "-x", "TotalA.exe"],
                                  capture_output=True, text=True).stdout.split()
        except FileNotFoundError:
            return None
        for pid in pids:
            try:
                environ = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            except (OSError, PermissionError):
                continue
            for entry in environ:
                if entry.startswith(b"WINEPREFIX="):
                    if entry.decode(errors="replace").split("=", 1)[1] == str(self.prefix):
                        return int(pid)
        return None

    def running(self) -> bool:
        return self.pid() is not None

    # -- window -----------------------------------------------------------
    def window(self):
        """(window_id, x, y, w, h) of the game's client window, or None.

        Two X windows share the title; the client is the one whose size matches the
        game resolution. Other apps (browser/Discord) can carry the name as a
        substring, so match the title exactly and verify against this instance's pid.

        "Exactly" is why the launch RECORDS the title it asked the DLL for
        (`window_title`): the tree label makes it instance-specific, and matching
        `^Total Annihilation - .*$` instead would start matching the user's browser
        tab about the game. The bare title stays in the list for an instance
        launched before this existed, or with the label turned off.
        """
        display = self.meta().get("display") or default_display()
        pid = self.pid()
        patterns = []
        recorded = self.meta().get("window_title")
        if recorded and recorded != BASE_TITLE:
            patterns.append("^" + ere_quote(recorded) + "$")
        patterns.append("^" + ere_quote(BASE_TITLE) + "$")
        ids = []
        for pattern in patterns:
            try:
                found = subprocess.run(["xdotool", "search", "--name", pattern],
                                       capture_output=True, text=True,
                                       env={**os.environ, "DISPLAY": display}).stdout.split()
            except FileNotFoundError:
                return None
            ids += [w for w in found if w not in ids]
        best = None
        for wid in ids:
            env = {**os.environ, "DISPLAY": display}
            geom = subprocess.run(["xdotool", "getwindowgeometry", "--shell", wid],
                                  capture_output=True, text=True, env=env).stdout
            vals = dict(line.split("=", 1) for line in geom.strip().splitlines() if "=" in line)
            if not vals:
                continue
            wpid = subprocess.run(["xdotool", "getwindowpid", wid],
                                  capture_output=True, text=True, env=env).stdout.strip()
            if pid and wpid.isdigit() and int(wpid) != pid:
                continue
            w, h = int(vals.get("WIDTH", 0)), int(vals.get("HEIGHT", 0))
            rec = (int(wid), int(vals.get("X", 0)), int(vals.get("Y", 0)), w, h)
            gw, gh = self.meta().get("res", list(DEFAULT_RES))
            if (w, h) == (gw, gh):
                return rec          # exact client match wins
            best = best or rec
        return best


# --------------------------------------------------------------------------- create

def mirror_gamedir(inst: Instance, intro: bool, sound: bool, res, tile, shield=True,
                   verbose=False):
    """Symlink-mirror the template gamedir, with instance-private config files."""
    inst.gamedir.mkdir(parents=True, exist_ok=True)
    (inst.gamedir / "Screenshots").mkdir(exist_ok=True)

    for entry in sorted(TEMPLATE_GAMEDIR.iterdir()):
        name = entry.name
        low = name.lower()
        if name in PRIVATE_FILES or low.startswith("tagpu") or low.startswith("cnc-ddraw-"):
            continue
        if name in ("Screenshots", "_triggers_off") or low.endswith(".log"):
            continue
        if name == "music" and not sound:
            continue   # Steam MP3 soundtrack: audiere cannot play what is absent
        dst = inst.gamedir / name
        if dst.exists() or dst.is_symlink():
            continue
        src = entry.resolve() if entry.is_symlink() else entry
        if name == "Data":
            # Data must be a real directory so the intro movies can be omitted.
            dst.mkdir(exist_ok=True)
            for sub in sorted(src.iterdir()):
                if not intro and sub.name.lower() in INTRO_MOVIES:
                    continue
                link = dst / sub.name
                if not (link.exists() or link.is_symlink()):
                    link.symlink_to(sub)
            continue
        dst.symlink_to(src)

    # TotalA.exe: link to the pristine Steam executable (never modified; patches are
    # applied at runtime from the fork's DllMain).
    exe_src = (TEMPLATE_GAMEDIR / "TotalA.exe")
    exe_src = exe_src.resolve() if exe_src.is_symlink() else exe_src
    exe_dst = inst.gamedir / "TotalA.exe"
    if not (exe_dst.exists() or exe_dst.is_symlink()):
        exe_dst.symlink_to(exe_src)

    write_ddraw_ini(inst, tile)
    write_totala_ini(inst, sound)
    # Never steal the human's pointer: the game snaps and fences the real cursor on
    # activation otherwise (fork honours this trigger, see mouse.c).
    (inst.gamedir / "tagpu_nowarp.on").write_text("")
    set_shield(inst, shield)
    deploy_dll(inst)


def set_shield(inst: Instance, on: bool):
    """Input firewall: the game ignores the real keyboard and mouse entirely, and
    only sees what we inject (fork: tagpu_shield.c). On by default so the human
    can click through a running instance without perturbing it."""
    path = inst.gamedir / "tagpu_shield.on"
    if on:
        path.write_text("")
    else:
        path.unlink(missing_ok=True)


def shield_state(inst: Instance) -> bool:
    return (inst.gamedir / "tagpu_shield.on").exists()


def write_title(inst: Instance, label: str) -> str:
    """Point the DLL at a title label; return the title the window will carry.

    An empty label — none passed, blank, or nothing left of it after
    `title_label` — removes the file, which is the DLL's "leave the stock title
    alone": the same state as an instance launched before this existed, or a game
    launched outside tacli at all. Written on every launch rather than at create,
    so switching the tree's branch retitles the next launch without anyone having
    to remember to.
    """
    path = inst.gamedir / "tagpu_title.txt"
    label = title_label(label)
    if not label:
        path.unlink(missing_ok=True)
        return BASE_TITLE
    path.write_text(label + "\n")
    return f"{BASE_TITLE} - {label}"


def write_ddraw_ini(inst: Instance, tile):
    x, y = tile
    (inst.gamedir / "ddraw.ini").write_text(
        "[ddraw]\n"
        "renderer=openglcore\n"
        "windowed=true\n"
        "fullscreen=false\n"   # true here means borderless fullscreen, not a window
        "maintas=true\n"
        "vsync=false\n"
        "maxfps=60\n"
        "adjmouse=true\n"
        "border=true\n"
        "savesettings=0\n"
        "center_window=0\n"     # otherwise posX/posY are ignored and instances stack
        f"posX={x}\n"
        f"posY={y}\n"
        "\n[TotalA]\n"
        "max_resolutions=32\n"
        "lock_surfaces=true\n"
        "singlecpu=false\n"
        "maxgameticks=0\n"      # never raise: perturbs the sim
        "minfps=0\n"
    )


def write_totala_ini(inst: Instance, sound: bool, unit_limit=None):
    """TA's own INI (research/notes/cmdline-options.md).

    Both settings we write live in `[Preferences]`, so the file is composed from
    what is asked for rather than branched on sound alone: with sound on and no
    limit wanted there is nothing to say and the file goes away. `UnitLimit` is
    read at 0x491653 and clamped by the engine itself to [20, 1500], which is why
    it is not a registry key and cannot be raised in a running game.
    """
    path = inst.gamedir / "totala.ini"
    prefs = [] if sound else [("NoDirectSound", 1), ("UseWindowsSound", 0)]
    if unit_limit is not None:
        prefs.append(("UnitLimit", int(unit_limit)))
    if not prefs:
        path.unlink(missing_ok=True)
        return
    path.write_text("[Preferences]\r\n"
                    + "".join(f"{k}={v}\r\n" for k, v in prefs))


def deploy_dll(inst: Instance):
    """Pin a copy of the fork: rebuilds never disturb a running instance."""
    if not BUILT_DLL.exists():
        die(f"fork DLL not built: {BUILT_DLL}")
    shutil.copy2(BUILT_DLL, inst.gamedir / "ddraw.dll")


def clone_prefix(inst: Instance):
    if inst.prefix.exists():
        return
    if not TEMPLATE_PREFIX.is_dir():
        die(f"template wine prefix missing: {TEMPLATE_PREFIX}")
    inst.prefix.parent.mkdir(parents=True, exist_ok=True)
    # cp -al: hardlink clone. wine rewrites registry hives via temp+rename, which
    # breaks the link instead of corrupting the template.
    r = subprocess.run(["cp", "-al", str(TEMPLATE_PREFIX), str(inst.prefix)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"prefix clone failed: {r.stderr.strip()}")


def install_dplay(inst: Instance) -> str:
    """Drop Microsoft's DirectPlay into this prefix (idempotent).

    Delegates to tools/dpinstall.sh so the file list, the win32/win64 split and the
    provenance all live in one place. Cheap enough to re-run every launch (~1.2 MB of
    copies), and re-running is how a prefix recreated behind our back heals itself.
    """
    if not DPLAY_SRC.is_dir():
        die(f"no DirectPlay files at {DPLAY_SRC} — see research/notes/"
            f"networking-lobbies.md for where they come from, or set TA_DIRECTPLAY_SRC")
    r = subprocess.run(["bash", str(DPLAY_INSTALL), str(inst.prefix), str(DPLAY_SRC)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"dpinstall failed: {(r.stderr or r.stdout).strip()}")
    return (r.stdout.strip().splitlines() or ["installed native DirectPlay"])[0]


def free_dplay_port() -> int:
    """Kill any stray dplaysvr.exe.

    DirectPlay's name server outlives the game that started it and owns UDP 47624 for
    the whole machine, not per prefix — so one left over from an earlier run makes the
    next host fail Open(DPOPEN_CREATE) with DPERR_GENERIC, which looks exactly like a
    broken prefix and is not. Only ever do this on a hosting launch: doing it while a
    peer is hosting takes that game down too.
    """
    before = subprocess.run(["pgrep", "-x", "dplaysvr.exe"],
                            capture_output=True, text=True).stdout.split()
    if before:
        subprocess.run(["pkill", "-x", "dplaysvr.exe"], capture_output=True)
    return len(before)


def reg_add(inst: Instance, key: str, value: str, kind: str, data: str):
    run(["wine", "reg", "add", key, "/v", value, "/t", kind, "/d", data, "/f"],
        env=inst.env(), cwd=str(inst.gamedir))


# The skirmish key's own per-player values, in `--player`'s field order.
# `Metal`/`Energy` are TA's starting resources, and measured 2026-09-01 they set
# the player's **storage** as well as the level — which is exactly why writing
# them into a running game does not stick (the engine recomputes storage from
# owned units every tick and clamps the level to it). `AllyGroup` exists too and
# is deliberately not exposed: nothing has measured what its 5 means.
PLAYER_KEYS = ("Controller", "Side", "Color", "Metal", "Energy")


def player_keys(spec: str):
    """`N:controller[:side[:color[:metal[:energy]]]]` -> registry values to write.

    An **empty field is "leave that key alone"**, so a colour can be set without
    naming a side (`0:1::3`) — the fields are positional and there is no other
    way to skip one. Anything that is not a number is refused rather than
    written: `wine reg add` fails quietly, so a mistyped spec would otherwise
    read back as a game rule nobody asked for.
    """
    parts = spec.split(":")
    if not (2 <= len(parts) <= len(PLAYER_KEYS) + 1 and parts[0].isdigit()
            and parts[1].isdigit()
            and all(p == "" or p.isdigit() for p in parts[2:])):
        die(f"--player {spec!r}: say "
            f"N:controller[:side[:color[:metal[:energy]]]], numbers only "
            f"(controller 0=off 1=human 2=AI, side 0=ARM 1=CORE)")
    names = PLAYER_KEYS
    return [(f"Player{parts[0]}{names[i - 1]}", parts[i])
            for i in range(1, len(parts)) if parts[i] != ""]


def apply_prefix_settings(inst: Instance, res, sound: bool = False):
    """Registry state that must hold before launch."""
    # No XRandR: stops wine re-probing outputs, which blanks every physical monitor
    # for seconds at each launch (research/notes/windowed-mode.md).
    reg_add(inst, r"HKCU\Software\Wine\X11 Driver", "UseXRandR", "REG_SZ", "N")
    w, h = res
    reg_add(inst, GAME_REG, "DisplaymodeWidth", "REG_DWORD", str(w))
    reg_add(inst, GAME_REG, "DisplaymodeHeight", "REG_DWORD", str(h))
    # Right-mouse orders: the only interface type that accepts posted clicks.
    reg_add(inst, GAME_REG, "Interface Type", "REG_DWORD", "1")
    reg_add(inst, GAME_REG, "PlayMovie", "REG_DWORD", "0")
    if not sound:
        # NoDirectSound (totala.ini) only silences DirectSound effects. The Steam
        # build also plays MP3 music through audiere, and TA keeps its own volume /
        # voice settings — silence all of them.
        for value, data in (("musicmode", "0"), ("musicvol", "0"), ("fxvol", "0"),
                            ("cdmode", "0"), ("ackfx", "0"), ("buildfx", "0")):
            reg_add(inst, GAME_REG, value, "REG_DWORD", data)


def place_window(inst: "Instance", display: str):
    """Keep parallel instances from stacking.

    cnc-ddraw honours posX/posY (relative to the primary monitor), but two
    instances created concurrently can claim the same slot, and the human may have
    moved things around. So after the window exists, nudge it clear of every other
    running instance's window.
    """
    win = inst.window()
    if not win:
        return None
    wid, x, y, w, h = win
    others = []
    for meta_path in INSTANCES.glob("*/instance.json"):
        other = Instance(meta_path.parent.name)
        if other.name == inst.name or not other.running():
            continue
        ow = other.window()
        if ow:
            others.append(ow[1:])

    def clashes(px, py):
        return any(px < ox + ow_ and ox < px + w and py < oy + oh and oy < py + h
                   for ox, oy, ow_, oh in others)

    if not clashes(x, y):
        return win
    # Walk the same on-screen grid tile_for lays out, and settle for an overlap
    # rather than stepping off the desktop — see tile_for on why off-screen is
    # never an option.
    screen = screen_size(display)
    cells = max(1, screen[0] // (w + 40)) * max(1, screen[1] // (h + 80))
    nx, ny = x, y
    for cell in range(cells):
        cand = tile_for(cell, (w, h), screen=screen)
        if not clashes(*cand):
            nx, ny = cand
            break
    else:
        return win        # every cell taken: leave it overlapping where it is
    run(["xdotool", "windowmove", str(wid), str(nx), str(ny)],
        env={**os.environ, "DISPLAY": display})
    time.sleep(0.3)
    return inst.window() or (wid, nx, ny, w, h)


_SCREEN_SIZE: dict = {}


def screen_size(display: "str | None" = None) -> tuple:
    """Real desktop dimensions, read once per display.

    Reading geometry is a read, which the desktop-is-the-user's rule allows;
    we never run xrandr against the live session. Falls back to 3840x2160 only
    if xdpyinfo cannot be reached.
    """
    d = display or default_display()
    if d not in _SCREEN_SIZE:
        size = None
        try:
            txt = subprocess.run(["xdpyinfo"], env={**os.environ, "DISPLAY": d},
                                 capture_output=True, text=True, timeout=5).stdout
            m = re.search(r"dimensions:\s+(\d+)x(\d+)", txt)
            if m:
                size = (int(m.group(1)), int(m.group(2)))
        except (OSError, subprocess.TimeoutExpired):
            pass
        _SCREEN_SIZE[d] = size or (3840, 2160)
    return _SCREEN_SIZE[d]


def tile_for(index: int, res, screen=None, origin=(0, 0)):
    """Lay instances out in a grid so parallel windows do not stack.

    Never places a window off the visible desktop. That is not cosmetic: OpenGL
    leaves glReadPixels on the default framebuffer undefined outside the visible
    region, so an off-screen window used to hand back a mangled `glshot` with no
    error anywhere. When the grid runs out of cells the layout WRAPS and windows
    overlap — an overlapped window still captures correctly, an off-screen one
    did not.
    """
    w, h = res
    if screen is None:
        screen = screen_size()
    pitch_x, pitch_y = w + 40, h + 80          # margins cover the WM decoration
    cols = max(1, screen[0] // pitch_x)
    rows = max(1, screen[1] // pitch_y)
    cell = index % (cols * rows)
    x = origin[0] + (cell % cols) * pitch_x
    y = origin[1] + (cell // cols) * pitch_y
    # Bound even when a single cell does not fit (window bigger than the screen,
    # or an origin that pushes the last cell over the edge).
    return (max(0, min(x, max(0, screen[0] - w))),
            max(0, min(y, max(0, screen[1] - h))))


def tile_is_onscreen(tile, res, screen=None) -> bool:
    """Is this recorded tile still fully on the desktop it will open on?"""
    if screen is None:
        screen = screen_size()
    return (0 <= tile[0] and 0 <= tile[1]
            and tile[0] + res[0] <= screen[0] and tile[1] + res[1] <= screen[1])


