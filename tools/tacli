def cmd_wheel(args):
    """Turn the mouse wheel, which is the zoom control.

    The wheel is only live over the world viewport, exactly as it is for a
    player, so a position is almost always what you want: without `--at` the
    notches land wherever the injected pointer happens to be, and if that is the
    side panel or a menu they do nothing at all (the game logs `zoom: wheel
    ignored`). One notch is ~1.1x, geometric, eased over about six frames.
    """
    inst = Instance(args.name)
    tokens = []
    if args.at is not None:
        tokens.append(f"pmove:{args.at[0]},{args.at[1]}")
    # The DLL caps ONE `wheel:` token at 64 notches, so a bigger ask is split
    # rather than silently clipped — reporting 100 sent while delivering 64 would
    # put a script's computed zoom level ~2.7x off with nothing to show for it.
    n, step = abs(args.notches), (1 if args.notches >= 0 else -1)
    while n > 0:
        chunk = min(n, 64)
        tokens.append(f"wheel:{step * chunk:+d}")
        n -= chunk
    _write_tokens(inst, " ".join(tokens))
    out({"name": args.name, "notches": args.notches, "at": args.at}, args.json,
        human=f"sent: {' '.join(tokens)}")


