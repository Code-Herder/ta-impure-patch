def res_type(text: str):
    m = RES_RX.fullmatch(text)
    if not m:
        raise argparse.ArgumentTypeError("resolution must look like 1024x768")
    return (int(m.group(1)), int(m.group(2)))


def build_parser():
    p = argparse.ArgumentParser(prog="tacli", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common(sp):
        """--json is accepted after the subcommand too, not just before it."""
        sp.add_argument("--json", action="store_true", dest="json",
                        default=argparse.SUPPRESS, help="machine-readable output")

    def add_launchish(sp, default_res=None):
        add_common(sp)
        sp.add_argument("--res", type=res_type, default=default_res,
                        help="game resolution, e.g. 1024x768")
        sp.add_argument("--display", default=None, help="X display (default: autodetected live one)")
        sp.add_argument("--slot", type=int, default=None, help="tiling slot (window position)")

    c = sub.add_parser("create", help="create an isolated instance")
    c.add_argument("name")
    add_launchish(c, default_res=DEFAULT_RES)
    c.add_argument("--sound", action="store_true", help="enable sound (default: silent)")
    c.add_argument("--intro", action="store_true", help="keep the intro movies")
    c.add_argument("--no-shield", dest="shield", action="store_false", default=None,
                   help="let hardware keyboard/mouse reach the game (default: blocked)")
    c.add_argument("--force", action="store_true")
    c.set_defaults(func=cmd_create)

    l = sub.add_parser("launch", help="start an instance (creating it if needed)")
    l.add_argument("name")
    add_launchish(l)
    l.add_argument("--sound", dest="sound", action="store_true", default=None)
    l.add_argument("--no-sound", dest="sound", action="store_false")
    l.add_argument("--intro", action="store_true")
    l.add_argument("--shield", dest="shield", action="store_true", default=None,
                   help="block hardware keyboard/mouse (the default)")
    l.add_argument("--no-shield", dest="shield", action="store_false")
    l.add_argument("--title", default=None,
                   help="replace the whole label after \"Total Annihilation - \" in "
                        "the window title (default: \"wt:<branch of the tree this tacli "
                        "ran from, i.e. the one whose ddraw.dll it pinned> | "
                        "tacli:<instance>\"). Sticky per instance; --title auto goes "
                        "back to the default")
    l.add_argument("--no-title", dest="title", action="store_const", const="",
                   help="stock window title, no label (also sticky; --title auto undoes it)")
    l.add_argument("--map", help="skirmish map name, e.g. 'Two Continents'")
    l.add_argument("--unit-limit", dest="unit_limit", type=int,
                   help="per-player unit cap in totala.ini (TA clamps it to 20-1500)")
    l.add_argument("--player", action="append",
                   help="N:controller[:side[:color[:metal[:energy]]]] (controller "
                        "0=off 1=human 2=AI, side 0=ARM 1=CORE; an empty field is "
                        "left alone, e.g. 0:1::3 sets only a colour). Metal/energy "
                        "are the skirmish starting resources, and set storage too.")
    l.add_argument("--los", type=int, help="SkirmishLineOfSight")
    l.add_argument("--mapping", type=int,
                   help="SkirmishMapping (TA's saved value; the SKIRMISH screen's "
                        "own toggle is what decides a game — `scenario load` sets "
                        "it, or `ui set Mapping 1` when driving by hand)")
    l.add_argument("--arg", action="append",
                   help="extra TotalA.exe switch, repeatable (e.g. --arg -t --arg 120); "
                        "see research/notes/cmdline-options.md")
    l.add_argument("--dplay", dest="dplay", action="store_true", default=None,
                   help="multiplayer: install native DirectPlay into the prefix and "
                        "override wine's builtin (sticky per instance; wine cannot "
                        "host a session without it)")
    l.add_argument("--no-dplay", dest="dplay", action="store_false",
                   help="back to wine's builtin DirectPlay")
    l.add_argument("--free-dplay-port", action="store_true",
                   help="kill any stale dplaysvr.exe first — do this on the HOSTING "
                        "launch only; it owns UDP 47624 machine-wide and killing it "
                        "while a peer hosts takes that game down")
    l.add_argument("--keep-dll", action="store_true", help="do not refresh ddraw.dll")
    l.add_argument("--timeout", type=float, default=45)
    l.add_argument("--no-restore-pointer", action="store_true",
                   help="leave the pointer wherever launching moved it")
    l.add_argument("--force", action="store_true")
    l.set_defaults(func=cmd_launch)

    s = sub.add_parser("ls", help="list instances")
    add_common(s)
    s.set_defaults(func=cmd_ls)

    k = sub.add_parser("keys", help="send key tokens (space, return, esc, plus, k:a ...)")
    add_common(k)
    k.add_argument("name")
    k.add_argument("tokens", nargs="+")
    k.set_defaults(func=cmd_keys)

    cl = sub.add_parser("click", help="click at game coordinates")
    add_common(cl)
    cl.add_argument("name")
    cl.add_argument("x", type=int)
    cl.add_argument("y", type=int)
    cl.add_argument("--right", action="store_true", help="right click (orders)")
    cl.set_defaults(func=cmd_click)

    wh = sub.add_parser("wheel", help="turn the mouse wheel (the zoom control)")
    add_common(wh)
    wh.add_argument("name")
    wh.add_argument("notches", type=int,
                    help="+N zooms in, -N zooms out (~1.1x per notch)")
    wh.add_argument("--at", type=int, nargs=2, metavar=("X", "Y"),
                    help="point here first — the wheel is dead off the world viewport")
    wh.set_defaults(func=cmd_wheel)

    e = sub.add_parser("eye", help="hold the camera at a world position")
    add_common(e)
    e.add_argument("name")
    e.add_argument("x", type=int, nargs="?", default=0)
    e.add_argument("y", type=int, nargs="?", default=0)
    e.add_argument("--release", action="store_true")
    e.set_defaults(func=cmd_eye)

    sd = sub.add_parser("shield", help="input firewall: block the hardware keyboard/mouse")
    add_common(sd)
    sd.add_argument("name")
    sd.add_argument("state", nargs="?", choices=["on", "off"],
                    help="omit to report the current state")
    sd.set_defaults(func=cmd_shield)

    a = sub.add_parser("arm", help="set/clear trigger files, e.g. native.on=all owndraw.on")
    add_common(a)
    a.add_argument("name")
    a.add_argument("flags", nargs="+")
    a.set_defaults(func=cmd_arm)

    pk = sub.add_parser("peek", help="read game memory (e.g. '*0x511DE8+0x2C74:2')")
    add_common(pk)
    pk.add_argument("name")
    pk.add_argument("specs", nargs="+",
                    help="['*']<hex>['+'<hex>...][':'1|2|4|s<N>|x<N>]")
    pk.add_argument("--timeout", type=float, default=10)
    pk.set_defaults(func=cmd_peek)

    wp = sub.add_parser("weapons", help="dump the weapon slots of units (extra-weapons oracle)")
    add_common(wp)
    wp.add_argument("name")
    wp.add_argument("units", nargs="*", type=int,
                    help="engine unit indices (roster idx=); none = every live unit")
    wp.add_argument("--timeout", type=float, default=10)
    wp.set_defaults(func=cmd_weapons)

    sh = sub.add_parser("shot", help="engine surface screenshot (PNG)")
    add_common(sh)
    sh.add_argument("name")
    sh.add_argument("-o", "--output")
    sh.add_argument("--timeout", type=float, default=15)
    sh.set_defaults(func=cmd_shot)

    g = sub.add_parser("glshot", help="GL framebuffer capture (PPM, includes our passes)")
    add_common(g)
    g.add_argument("name")
    g.add_argument("-o", "--output")
    g.add_argument("--timeout", type=float, default=15)
    g.set_defaults(func=cmd_glshot)

    lg = sub.add_parser("log", help="tail tagpu.log")
    add_common(lg)
    lg.add_argument("name")
    lg.add_argument("-n", "--tail", type=int, default=40)
    lg.add_argument("-g", "--grep")
    lg.set_defaults(func=cmd_log)

    r = sub.add_parser("roster", help="latest unit roster + camera eye")
    add_common(r)
    r.add_argument("name")
    r.set_defaults(func=cmd_roster)

    w = sub.add_parser("wait", help="wait for a regex in tagpu.log")
    add_common(w)
    w.add_argument("name")
    w.add_argument("pattern")
    w.add_argument("--timeout", type=float, default=120)
    w.set_defaults(func=cmd_wait)

    st = sub.add_parser("stop", help="stop an instance")
    add_common(st)
    st.add_argument("name")
    st.add_argument("--hard", action="store_true", help="also kill its wineserver")
    st.set_defaults(func=cmd_stop)

    u = sub.add_parser("ui", help="snapshot and drive on-screen gadgets (menus, build panel)")
    add_common(u)
    u.add_argument("name")
    u.add_argument("verb", nargs="?", default="snapshot",
                   help="snapshot (default) | show | click | set | check | uncheck "
                        "| select | hover | fill | press | wait")
    u.add_argument("rest", nargs="*",
                   help="a gadget selector (NAME, type:NAME or #index), then a value "
                        "for set/fill or an item for select (text or #index)")
    u.add_argument("--all", action="store_true",
                   help="snapshot: include decorative gadgets (labels, pictures, surfaces)")
    u.add_argument("--gui", help="wait: wait for this screen to reach the top of the stack")
    u.add_argument("--page", type=int,
                   help="click: walk a paged build menu to this page first")
    u.add_argument("--timeout", type=float, default=UI_TIMEOUT,
                   help=f"seconds to auto-wait for a gadget, and to scroll a long list "
                        f"to an off-screen row (default {UI_TIMEOUT:g})")
    u.add_argument("--no-wait", dest="wait", action="store_false", default=True,
                   help="fail immediately instead of waiting for the gadget")
    u.set_defaults(func=cmd_ui)

    for verb, fn, help_text in (
            ("units", cmd_units, "live unit catalogue (cached per instance)"),
            ("features", cmd_features, "live feature catalogue — where wreck names are")):
        cs = sub.add_parser(verb, help=help_text)
        add_common(cs)
        cs.add_argument("name")
        cs.add_argument("--limit", type=int, default=40, help="rows to print (0 = all)")
        cs.add_argument("--timeout", type=float, default=CAT_TIMEOUT)
        cs.set_defaults(func=fn)

    mp = sub.add_parser("maps", help="map names, read off the skirmish map list")
    add_common(mp)
    mp.add_argument("name")
    mp.add_argument("--no-walk", action="store_true",
                    help="read the current screen only; do not navigate to SELMAP")
    mp.add_argument("--timeout", type=float, default=UI_TIMEOUT,
                    help="how long to wait for the list to fill after the walk")
    mp.set_defaults(func=cmd_maps)

    sw = sub.add_parser("switches", help="read/set the engine switches "
                                        "(shootall, noshake, cheats ...)")
    add_common(sw)
    sw.add_argument("name")
    sw.add_argument("flags", nargs="*",
                    help="name=on|off, repeatable; none = just report the current bits")
    sw.add_argument("--timeout", type=float, default=10)
    sw.set_defaults(func=cmd_switches)

    cg = sub.add_parser("catalogue", help="what this instance has cached")
    add_common(cg)
    cg.add_argument("name")
    cg.set_defaults(func=cmd_catalogue)

    sc = sub.add_parser("scenario", help="compile and apply JSON situation files")
    add_common(sc)
    scv = sc.add_subparsers(dest="verb", required=True)

    def add_scenario(verb, help_text, **kw):
        sp = scv.add_parser(verb, help=help_text, **kw)
        add_common(sp)
        return sp

    scl = add_scenario("list", "list the scenarios in scenarios/")
    scl.set_defaults(func=cmd_scenario_list)

    for verb, fn, help_text in (
            ("validate", cmd_scenario_validate, "schema + catalogue checks, no game"),
            ("expand", cmd_scenario_expand, "the flat entity list, no game")):
        sp = add_scenario(verb, help_text)
        sp.add_argument("scenario", help="a name in scenarios/, or a path to a .json")
        sp.add_argument("--catalogue", help="a unit/feature/map list file to check "
                                            "names against")
        sp.add_argument("--instance", help="check names against this instance's cached "
                                           "catalogue (tacli units/features/maps)")
        if verb == "expand":
            sp.add_argument("--wire", action="store_true",
                            help="print the compiled wire file the fork will read")
        sp.set_defaults(func=fn)

    sca = add_scenario("apply", "apply a situation to a game that is already running")
    sca.add_argument("name", help="the instance to mutate")
    sca.add_argument("scenario", help="a name in scenarios/, or a path to a .json")
    sca.add_argument("--catalogue", help="a unit/feature/map list file to check "
                                         "names against")
    sca.add_argument("--instance", help="check names against this instance's cached "
                                        "catalogue (default: the target's own)")
    sca.add_argument("--timeout", type=float, default=SCN_APPLY_TIMEOUT)
    sca.set_defaults(func=cmd_scenario_apply)

    scd = add_scenario("load", "launch a game and put the situation in it")
    scd.add_argument("name", help="the instance to launch")
    scd.add_argument("scenario", help="a name in scenarios/, or a path to a .json")
    scd.add_argument("--catalogue", help="a unit/feature/map list file to check "
                                         "names against")
    scd.add_argument("--instance", help="check names against this instance's cached "
                                        "catalogue (default: the target's own)")
    # Launch options the file may also carry. Explicit flags win, so a scenario
    # re-runs at another resolution, or on another map, without being edited.
    scd.add_argument("--res", type=res_type, help="override setup.res")
    scd.add_argument("--map", help="override setup.map")
    scd.add_argument("--unit-limit", dest="unit_limit", type=int,
                     help="override setup.unit_limit")
    scd.add_argument("--display", default=None, help="X display")
    scd.add_argument("--mapping", type=int, choices=(0, 1), default=None,
                     help="SKIRMISH's Mapping toggle: 1 = Mapped (the default), "
                          "0 = the terrain starts blacked out")
    scd.add_argument("--los", type=int, choices=(0, 1, 2), default=None,
                     help="SKIRMISH's Line of Sight toggle: 0 = Permanent (no grey "
                          "fog over ground already seen), 1 = True, 2 = Circular. "
                          "Left as the screen has it when not given")
    scd.add_argument("--keep-dll", action="store_true",
                     help="do not refresh ddraw.dll")
    scd.add_argument("--restart", action="store_true",
                     help="stop the instance first if it is already running")
    scd.add_argument("--any-map", action="store_true",
                     help="apply even if TA loaded a map other than the one asked for")
    scd.add_argument("--launch-timeout", type=float, default=SCN_LAUNCH_TIMEOUT,
                     help=f"seconds to wait for the window and the shell "
                          f"(default {SCN_LAUNCH_TIMEOUT:g})")
    scd.add_argument("--load-timeout", type=float, default=SCN_LOAD_TIMEOUT,
                     help=f"seconds to wait for the map to load "
                          f"(default {SCN_LOAD_TIMEOUT:g})")
    scd.add_argument("--timeout", type=float, default=SCN_APPLY_TIMEOUT,
                     help="seconds to wait for the applier's answer")
    scd.set_defaults(func=cmd_scenario_load)

    sp = add_scenario("dump", "(phase E — not built yet)")
    sp.add_argument("rest", nargs="*")
    sp.set_defaults(func=cmd_scenario_todo, cmd_todo="dump")

    rm = sub.add_parser("rm", help="delete an instance")
    add_common(rm)
    rm.add_argument("name")
    rm.add_argument("--force", action="store_true")
    rm.set_defaults(func=cmd_rm)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if not hasattr(args, "json"):
        args.json = False
    INSTANCES.mkdir(parents=True, exist_ok=True)
    args.func(args)


if __name__ == "__main__":
    main()
