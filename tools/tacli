def _create(inst: Instance, args) -> dict:
    """Everything `create` does; `load` needs it without the printing."""
    if inst.exists and not args.force:
        die(f"instance {args.name!r} already exists (use --force to recreate)")
    inst.dir.mkdir(parents=True, exist_ok=True)
    # Only a *running* instance holds a slot. Reserving one per instance that has
    # ever been created walks the grid off the screen after a dozen of them, and
    # stopped instances are the normal state of this directory.
    taken = set()
    for meta_path in INSTANCES.glob("*/instance.json"):
        other = Instance(meta_path.parent.name)
        if other.name == args.name or not other.running():
            continue
        try:
            taken.add(json.loads(meta_path.read_text()).get("slot"))
        except (OSError, ValueError):
            pass
    index = args.slot
    if index is None:
        index = next(i for i in range(64) if i not in taken)
    # `launch <new-name>` reaches here with res unset (its --res defaults to None so
    # that relaunching an existing instance keeps the recorded resolution).
    res = tuple(args.res or DEFAULT_RES)
    display = args.display or default_display()
    tile = tile_for(index, res, screen=screen_size(display))
    shield = args.shield is not False
    clone_prefix(inst)
    mirror_gamedir(inst, intro=args.intro, sound=args.sound, res=res, tile=tile,
                   shield=shield)
    meta = {
        "name": args.name,
        "created": time.strftime("%Y-%m-%d %H:%M:%S"),
        "res": list(res),
        "slot": index,
        "tile": list(tile),
        "sound": bool(args.sound),
        "intro": bool(args.intro),
        "shield": shield,
        "display": display,
        "gamedir": str(inst.gamedir),
        "prefix": str(inst.prefix),
    }
    inst.save_meta(meta)
    apply_prefix_settings(inst, res, sound=args.sound)
    return meta


def cmd_create(args):
    inst = Instance(args.name)
    meta = _create(inst, args)
    res, tile = meta["res"], meta["tile"]
    out(meta, args.json, human=f"created instance {args.name} "
                               f"({res[0]}x{res[1]}, window at {tile[0]},{tile[1]}, "
                               f"sound={'on' if args.sound else 'off'}, "
                               f"shield={'on' if meta['shield'] else 'off'})")


def _ensure_owndraw_for_native(inst) -> "str | None":
    """The native GPU pass (tagpu_native.on) needs the owndraw detours to wipe the
    engine's 8bpp composite, or the engine keeps rasterising the same unit and you get
    a near-invisible double draw. But owndraw installs its engine-code detours ONCE at
    DllMain and only if tagpu_owndraw.on exists THEN — it has no per-frame re-arm (unlike
    the native pass and the .off toggles), because patching live engine bytes off the
    frame loop is racy; the tracer and suppressor install the same way. So arming owndraw
    after launch silently does nothing. Close the footgun here, at the one moment it
    matters: if this launch will bring up the native pass, make sure owndraw is armed to
    match before the process starts. Returns a human note, or None if nothing was done.

    Scoped to native deliberately: writeback (tagpu_writeback.on) overwrites the composite
    the engine builds and needs no suppression, so it does not require owndraw.
    """
    nat = inst.gamedir / "tagpu_native.on"
    own = inst.gamedir / "tagpu_owndraw.on"
    if not nat.exists():
        # A stale owndraw.on is worse than none: its detours skip the engine's
        # rasterisers while the native pass that would supply the pixels is not
        # running, so the engine draws NO units at all (OWND ... repaint=0
        # miss=<everything>) and an engine-side A/B silently measures nothing.
        if own.exists():
            own.unlink()
            return ("dropped owndraw.on (native.on is not set; its detours would skip "
                    "the engine's unit rasterisers with nothing drawing in their place)")
        return None
    # native.on is "TYPE [extra tokens]" (e.g. "all wrecks"); owndraw.on is just "TYPE".
    tok = (nat.read_text().split() or ["all"])[0]
    if not own.exists():
        own.write_text(tok + "\n")
        return (f"auto-armed owndraw.on={tok} (native.on is set and owndraw must be "
                f"installed at launch, not after)")
    have = (own.read_text().split() or [""])[0]
    if have != tok:
        return (f"warning: owndraw.on={have or '(empty)'} but native.on={tok} — the "
                f"native pass will only be suppressed for {have!r}; other types will "
                f"double-draw. Set them to match, or `tacli arm {inst.name} "
                f"owndraw.on={tok}` and relaunch.")
    return None


def _ensure_fxown_for_fx(inst) -> "str | None":
    """Same footgun, effects edition: the native effects pass (tagpu_fx.on) draws
    weapon fire, explosions and debris itself — and the particle pass (tagpu_sfx.on)
    smoke, fire, wakes and nanolathe spray — while the engine's own draws
    are skipped by the fxown code patches (call-site redirects + leaf detours). Those
    install ONCE at DllMain, only if tagpu_fxown.on exists then. Without them the
    engine keeps drawing every effect under ours (a double draw that is hard to see
    on sprites and obvious on lasers). So if this launch brings up the effects pass,
    make sure fxown is armed before the process starts. The skip itself follows
    tagpu_fx.on live, so removing fx.on later restores the engine's draw.
    """
    fx = inst.gamedir / "tagpu_fx.on"
    sfx = inst.gamedir / "tagpu_sfx.on"        # particle layers ride the same patch set
    own = inst.gamedir / "tagpu_fxown.on"
    if not fx.exists() and not sfx.exists():
        if own.exists():
            own.unlink()
            return ("dropped fxown.on (neither fx.on nor sfx.on is set; the effects patches "
                    "are only installed with one of them)")
        return None
    if own.exists():
        return None
    own.write_text("on\n")
    have = " and ".join(n for n, p in (("fx.on", fx), ("sfx.on", sfx)) if p.exists())
    return f"auto-armed fxown.on ({have} is set and fxown must be installed at launch, not after)"

def _ensure_featown_for_feat(inst) -> "str | None":
    """Same footgun, features edition: the native feature pass (tagpu_feat.on) draws
    trees, rocks, metal patches and GAF wreckage itself, while the engine's own
    feature leaf (0x46A610) is skipped by the featown detour. It installs ONCE at
    DllMain, only if tagpu_featown.on exists then — so if this launch brings up the
    feature pass, arm it before the process starts. The skip itself follows
    tagpu_feat.on live (and stays off unless native.on carries "wrecks", because
    3D wreckage draws through that leaf as a unit).
    """
    feat = inst.gamedir / "tagpu_feat.on"
    own = inst.gamedir / "tagpu_featown.on"
    if not feat.exists():
        if own.exists():
            own.unlink()
            return ("dropped featown.on (feat.on is not set; the feature patch is only "
                    "installed with it)")
        return None
    if own.exists():
        return None
    own.write_text("on\n")
    return ("auto-armed featown.on (feat.on is set and featown must be installed at "
            "launch, not after)")

def _ensure_terrown_for_terr(inst) -> "str | None":
    """Same footgun, terrain edition: the native terrain pass (tagpu_terr.on) draws
    the map tiles itself, while the engine's terrain pass (0x483FA0) and the fog
    overlay (0x4848E0) are skipped by the terrown detours. They install ONCE at
    DllMain, only if tagpu_terrown.on exists then — so if this launch brings up the
    terrain pass, arm it before the process starts. The skip itself follows
    tagpu_terr.on live (and stays off under the `passive` / `over` tokens).

    Without the patch there is no key fill, so there is nothing for the composite to
    invert against — the terrain pass then refuses to emit at all (its opaque
    full-viewport layer would otherwise hide the health bars, wireframes, build
    cursor and chat that the key exists to let through) and says so in its log line.
    """
    terr = inst.gamedir / "tagpu_terr.on"
    own = inst.gamedir / "tagpu_terrown.on"
    if not terr.exists():
        if own.exists():
            own.unlink()
            return ("dropped terrown.on (terr.on is not set; the terrain patch is only "
                    "installed with it)")
        return None
    if own.exists():
        return None
    own.write_text("on\n")
    return ("auto-armed terrown.on (terr.on is set and terrown must be installed at "
            "launch, not after)")

def _ensure_markown_for_mark(inst) -> "str | None":
    """Same footgun, UI markers edition (G13d): the marker pass (tagpu_mark.on) draws
    the health bars itself and replays the engine's own order markers, group digits,
    build cursor and band box out of a capture — while tagpu_markown redirects the
    six call sites that produce them (including the engine's own selection rect, per
    unit) and detours DrawHealthBars (0x46A430). Those
    patches install ONCE at DllMain, only if tagpu_markown.on exists then, so if this
    launch brings up the marker pass, arm it before the process starts. The capture
    and the bar skip follow tagpu_mark.on live (and both stay off under `passive`).

    Without the patch the engine is still drawing all of it at UNZOOMED positions, so
    the pass refuses to emit rather than double-draw, and says so in its log line.
    """
    mark = inst.gamedir / "tagpu_mark.on"
    own = inst.gamedir / "tagpu_markown.on"
    if not mark.exists():
        if own.exists():
            own.unlink()
            return ("dropped markown.on (mark.on is not set; the marker patch is only "
                    "installed with it)")
        return None
    if own.exists():
        return None
    own.write_text("on\n")
    return ("auto-armed markown.on (mark.on is set and markown must be installed at "
            "launch, not after)")

def _launch(args) -> dict:
    """Everything `launch` does, minus the printing — `load` composes with it."""
    # Extra TotalA.exe switches. Only a handful are worth passing (see
    # research/notes/cmdline-options.md); -r aborts the launch and -d bypasses the
    # ddraw path our stack lives in, so both are refused — before anything is created.
    argv = list(args.arg or [])
    for a in argv:
        if a[:1] in ("-", "/") and a[1:2].lower() in ("r", "d") and len(a) <= 3:
            die(f"refusing {a!r}: see cmdline-options.md (-r registers DirectPlay and "
                f"quits, -d is the engine's own windowed mode)")
    inst = Instance(args.name)
    if not inst.exists:
        args.force = False
        _create(inst, args)
    meta = inst.meta()
    if inst.running():
        return dict(meta, already_running=True, pid=inst.pid())
    # The instance's OWN display, not this shell's — a second X server or an
    # Xvfb is a different size, and measuring the wrong one puts the window
    # exactly where this is meant to stop it going.
    screen = screen_size(meta.get("display"))
    if args.res:
        meta["res"] = list(args.res)
        meta["tile"] = list(tile_for(meta.get("slot", 0), tuple(args.res), screen=screen))
        inst.save_meta(meta)
        write_ddraw_ini(inst, meta["tile"])
    # Self-heal a tile recorded against a different (or wrongly assumed) desktop:
    # an off-screen window is a silently broken `glshot`, so never open one there.
    res = tuple(meta.get("res") or DEFAULT_RES)
    if not tile_is_onscreen(tuple(meta.get("tile") or (0, 0)), res, screen=screen):
        meta["tile"] = list(tile_for(meta.get("slot", 0), res, screen=screen))
        inst.save_meta(meta)
        write_ddraw_ini(inst, meta["tile"])
    if args.sound is not None:
        meta["sound"] = args.sound
    if args.unit_limit is not None:
        meta["unit_limit"] = args.unit_limit
    if args.sound is not None or args.unit_limit is not None:
        # Both live in the same file, so either one being asked for rewrites it
        # from the instance's recorded state — a limit set two launches ago is
        # still in force, and turning sound on does not silently drop it.
        inst.save_meta(meta)
        write_totala_ini(inst, meta.get("sound", False), meta.get("unit_limit"))
    if args.shield is not None:
        meta["shield"] = args.shield
        inst.save_meta(meta)
    set_shield(inst, meta.get("shield", True))
    if args.dplay is not None:
        meta["dplay"] = args.dplay
        inst.save_meta(meta)
    dplay_note = install_dplay(inst) if meta.get("dplay") else None
    if args.free_dplay_port:
        killed = free_dplay_port()
        dplay_note = ((dplay_note + "; ") if dplay_note else "") + (
            f"killed {killed} stale dplaysvr.exe (UDP 47624 freed)" if killed
            else "no stale dplaysvr.exe to kill")
    if not args.keep_dll:
        deploy_dll(inst)
    apply_prefix_settings(inst, tuple(meta["res"]), sound=meta.get("sound", False))
    if args.map:
        reg_add(inst, GAME_REG, "SkirmishMap", "REG_SZ", args.map)
    for spec in args.player or []:
        for value, data in player_keys(spec):
            reg_add(inst, SKIRMISH_REG, value, "REG_DWORD", data)
    if args.los is not None:
        reg_add(inst, GAME_REG, "SkirmishLineOfSight", "REG_DWORD", str(args.los))
    if args.mapping is not None:
        reg_add(inst, GAME_REG, "SkirmishMapping", "REG_DWORD", str(args.mapping))

    for stale in ("tagpu.log", "tagpu_gl.ppm"):
        p = inst.gamedir / stale
        if p.exists():
            p.rename(inst.gamedir / f"{stale}.prev")
    # A trigger the previous run never consumed fires the moment this one reaches
    # a game — measured 2026-09-01, when a leftover scenario spawned itself into a
    # fresh skirmish. Triggers are requests, not state, and the same goes for the
    # eye hold, which would otherwise pin the new game's camera to the old one's
    # coordinates. Results go too: a stale one would satisfy the next poll.
    for stale in ("tagpu_scenario.trigger", "tagpu_scenario.json",
                  "tagpu_switches.trigger", "tagpu_switches.json",
                  "tagpu_units.trigger", "tagpu_features.trigger",
                  "tagpu_peek.trigger", "tagpu_ui.trigger", "tagpu_eye.txt"):
        (inst.gamedir / stale).unlink(missing_ok=True)
    for log in inst.gamedir.glob("cnc-ddraw-*.log"):
        log.unlink()

    owndraw_note = _ensure_owndraw_for_native(inst)
    fxown_note = _ensure_fxown_for_fx(inst)
    featown_note = _ensure_featown_for_feat(inst)
    terrown_note = _ensure_terrown_for_terr(inst)
    markown_note = _ensure_markown_for_mark(inst)

    # Before Popen: the DLL reads the label once, at attach. Recorded in the meta
    # because Instance.window() then searches for this exact title.
    if args.title is not None:
        # Sticky like every other launch knob, so there has to be a way back out:
        # "auto" drops the override rather than becoming a label (a stored "" is
        # the deliberate no-label state, and would otherwise be unreachable-from).
        if args.title.strip().lower() == "auto":
            meta.pop("title", None)
        else:
            meta["title"] = args.title
    label = meta["title"] if meta.get("title") is not None else default_label(inst)
    meta["window_title"] = write_title(inst, label)

    env = inst.env()
    display = env["DISPLAY"]
    meta["args"] = argv
    inst.save_meta(meta)
    pointer_before = pointer_pos(display) if not args.no_restore_pointer else None
    proc = subprocess.Popen(["wine", "TotalA.exe"] + argv, cwd=str(inst.gamedir), env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)
    deadline = time.time() + args.timeout
    pid = None
    while time.time() < deadline:
        pid = inst.pid()
        if pid and inst.window():
            break
        time.sleep(0.5)
    win = place_window(inst, display)
    restored = pointer_restore(display, pointer_before)
    meta["last_launch"] = time.strftime("%Y-%m-%d %H:%M:%S")
    inst.save_meta(meta)
    return {"name": args.name, "pid": pid, "launcher_pid": proc.pid,
            "window": win, "gamedir": str(inst.gamedir), "res": meta["res"],
            "map": args.map, "unit_limit": meta.get("unit_limit"),
            "args": argv, "shield": shield_state(inst), "pointer_restored": restored,
            "window_title": meta["window_title"],
            "dplay": bool(meta.get("dplay")), "dplay_note": dplay_note,
            "owndraw_note": owndraw_note, "fxown_note": fxown_note,
            "featown_note": featown_note, "terrown_note": terrown_note,
            "markown_note": markown_note}


